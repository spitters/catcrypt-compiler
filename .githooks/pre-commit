#!/usr/bin/env bash
# Pre-commit gates. These are the cheap, per-file half of the checks CI runs, so
# a problem is caught where it is cheapest to fix. Activate once per clone:
#
#   git config core.hooksPath .githooks
#
# Bypass a false positive with:  git commit --no-verify

set -uo pipefail
cd "$(git rev-parse --show-toplevel)" || exit 0

staged_lean="$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null | grep '\.lean$' || true)"

# Prose lint on staged Lean: a docstring states what the code defines, not the
# session that produced it.
if [ -n "$staged_lean" ]; then
  # shellcheck disable=SC2086
  if ! bash scripts/lint-lean-prose.sh $staged_lean; then
    echo ""
    echo "pre-commit: Lean prose lint failed (above). Reword and re-stage, or bypass"
    echo "with 'git commit --no-verify' if a hit is a false positive."
    exit 1
  fi
fi

# A new definition of a lemma family the workspace already has (watch list in
# scripts/duplicate-decl-watch.txt) is refused; import the existing one.
if [ -n "$staged_lean" ]; then
  # shellcheck disable=SC2086
  bash scripts/duplicate-decl-guard.sh $staged_lean || exit 1
fi

# A new module of substance states its main results in its module docstring.
added="$(git diff --cached --name-only --diff-filter=A 2>/dev/null | grep '\.lean$' || true)"
if [ -n "$added" ]; then
  # shellcheck disable=SC2086
  bash scripts/module-doc-ratchet.sh $added || exit 1
fi

# Proof-cost anti-pattern lint on staged compiler modules: a new native_decide in
# a reflection/emit-front module, or a new maxRecDepth/maxHeartbeats budget on a
# proof. Static half only (BUILD_COST_STATIC_ONLY=1) -- no build, ratcheted vs HEAD.
staged_catcrypt="$(printf '%s\n' "$staged_lean" | grep '^CatCrypt/.*\.lean$' | sed 's/\.lean$//' | tr '/' '.' || true)"
if [ -n "$staged_catcrypt" ]; then
  # shellcheck disable=SC2086
  if ! BUILD_COST_STATIC_ONLY=1 bash scripts/check-build-cost.sh $staged_catcrypt; then
    echo ""
    echo "pre-commit: a staged module adds a proof-cost anti-pattern (above). Rework it,"
    echo "or bypass with 'git commit --no-verify' if the hit is a false positive."
    exit 1
  fi
fi

# A new or deleted Lean file changes the import graph, so the build-root manifest
# can go stale in the same commit. This is the only tree-wide check here; it is
# a few seconds of grep and no build.
if git diff --cached --name-only --diff-filter=AD 2>/dev/null | grep -q 'CatCrypt/.*\.lean$'; then
  bash scripts/rot-guard-build.sh --check || {
    echo ""
    echo "pre-commit: the build-root manifest no longer matches the tree. Regenerate:"
    echo "  ROT_GUARD_WRITE_MANIFEST=1 bash scripts/rot-guard-build.sh --check"
    exit 1
  }
fi

# Markdown links, when Markdown changed.
if git diff --cached --name-only --diff-filter=ACM 2>/dev/null | grep -q '\.md$'; then
  bash scripts/check-doc-links.sh || exit 1
fi

# The next two checks are scripts of the dev tree (the sibling SSProve-lean
# checkout); without it they are skipped.
dev_scripts="../SSProve-lean/scripts"

# A `by decide` or `decide +kernel` on a statement naming a compiler front or the
# back half makes the kernel run the compiler by reduction; FRONT_DECIDE_OK=1
# overrides.
if [ -n "$staged_lean" ] && [ -f "$dev_scripts/front-decide-lint.sh" ]; then
  bash "$dev_scripts/front-decide-lint.sh" || exit 1
fi

# Gate-coverage registry: when a staged file is a gate module of the back half,
# the census runs from the dev tree (through the build lock) and every construct
# probe its scripts/acceptance-registry.tsv records as accepted must still be
# accepted; kernel rows are report-only. ACCEPTANCE_SKIP=1 skips the run.
gate_re='^CatCrypt/Crypto/SecureCompilation/(X86Backend/(ImageStraight[^/]*|DecodePrinted[^/]*|OwnedLprogTV[^/]*|LprogBytes[^/]*|TwoAddrLegalize|LprogOptPipeline)|VIR/JasminLprogExport/ExportPhys[^/]*)\.lean$'
if printf '%s\n' "$staged_lean" | grep -qE "$gate_re" \
   && [ -f "$dev_scripts/acceptance-registry-check.sh" ]; then
  bash "$dev_scripts/acceptance-registry-check.sh" || exit 1
fi

# Importers of the staged Lean files that Lake reports as not up to date, over every
# repository of the workspace (the dev tree imports this one). The query is the dev
# tree's scripts/agent-closure.py; without that sibling the step is skipped. It warns;
# RDEPS_STRICT=1 refuses the commit, RDEPS_SKIP=1 skips the query. During a
# build the check is queued and runs when the build wrapper finishes.
rdeps_tool="../SSProve-lean/scripts/agent-closure.py"
rdeps_staged=$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null | grep '\.lean$' || true)
if [ -n "$rdeps_staged" ] && [ -f "$rdeps_tool" ] && [ "${RDEPS_SKIP:-0}" != "1" ]; then
  # shellcheck disable=SC2086
  if ! rdeps_out=$(python3 "$rdeps_tool" rdeps --unbuilt --queue --drain $(printf "$PWD/%s " $rdeps_staged) 2>&1); then
    echo "pre-commit: importers of the staged Lean files are not up to date:" >&2
    printf '%s\n' "$rdeps_out" | head -40 >&2
    echo "Build them from the dev tree: scripts/heavy-run.sh lake build <modules>" >&2
    [ "${RDEPS_STRICT:-0}" = "1" ] && exit 1
  fi
fi

exit 0
