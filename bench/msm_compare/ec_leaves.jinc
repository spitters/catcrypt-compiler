/*
 * The two EC leaves the emitted ec_msm kernel calls (gen/msm.jazz):
 *   ec_scalar_mul(k, P) = k * P    -- the per-term op  (lane op)
 *   ec_point_add(P, Q)  = P + Q    -- the accumulating op (horizontal sum op)
 * on the toy curve group y^2 = x^3 + x + 1 over Z/23 (ec_ref.h), the EC
 * AddCommMonoid the MSM = scalarFold reduction (MsmReduce.msm_eq_scalarFold) runs
 * over.  A point on the wire is two bytes (x, y); (0xff, 0xff) is infinity.
 *
 * The group is cyclic of order 28, generated by G = (0,1): every finite point is
 * j*G for a unique j in 1..27 (the discrete log), infinity is j = 0.  So we map a
 * point to its dlog j via the EC_DLOG table, do the group law as index arithmetic
 *   add:        m = (i + j) mod 28
 *   scalar-mul: m = (k * j) mod 28
 * and map back to the point m*G via EC_POW.  Both tables are generated from the
 * ec_ref.h schoolbook arithmetic (gen_tables.c -> gen/ec_tables.jinc): the leaves
 * therefore compute exactly the ec_ref.h group law, with NO modular inverse.
 *
 * This is the operational discharge of MsmReduce.EcLeafAgrees: the leaves the
 * emitted kernel calls realise the abstract EC primitives (pointAdd / scalarMul),
 * cross-checked byte-identical against the independent ec_msm_ref in msm_kat.c.
 */

require "gen/ec_tables.jinc"   // param int EC_ORDER; u8[56] EC_POW; u8[529] EC_DLOG

/* dlog of the finite wire point (x, y): EC_DLOG[23*x + y]. */
inline fn ec_dlog(reg u8 x, reg u8 y) -> reg u64 {
  reg ptr u8[529] tbl;
  reg u64 idx;
  reg u64 xx;
  reg u64 yy;
  reg u8 d;
  reg u64 r;
  tbl = EC_DLOG;
  xx = (64u)x;
  yy = (64u)y;
  idx = xx * 23;
  idx += yy;
  d = tbl[idx];
  r = (64u)d;
  return r;
}

/* write m*G (m already reduced mod EC_ORDER, 0 <= m < 28) into out[0..1]. */
inline fn ec_pow_store(reg ptr u8[2] out, reg u64 m) -> reg ptr u8[2] {
  reg ptr u8[56] tbl;
  reg u64 base;
  reg u8 v;
  tbl = EC_POW;
  base = m * 2;
  v = tbl[base];
  out[0] = v;
  base += 1;
  v = tbl[base];
  out[1] = v;
  return out;
}

/* reduce m mod EC_ORDER (= 28) by conditional subtraction (m bounded, terminates). */
inline fn ec_mod_order(reg u64 m) -> reg u64 {
  while (m >= EC_ORDER) {
    m -= EC_ORDER;
  }
  return m;
}

/* R = P + Q on the wire; returns the (mutated) first point buffer P.
 * Signature matches the emitted call  acc = ec_point_add(acc, t). */
fn ec_point_add(reg ptr u8[2] P, reg ptr u8[2] Q) -> reg ptr u8[2] {
  reg u8 px; reg u8 py; reg u8 qx; reg u8 qy;
  reg u64 i; reg u64 j; reg u64 m;
  px = P[0]; py = P[1];
  qx = Q[0]; qy = Q[1];

  /* P = infinity (0xff,0xff): result is Q. */
  if (px == 0xff) {
    P[0] = qx;
    P[1] = qy;
  } else {
    /* Q = infinity: result is P (already in P), leave untouched. */
    if (qx == 0xff) {
      P[0] = px;   // no-op write to keep both branches well-typed
      P[1] = py;
    } else {
      i = ec_dlog(px, py);
      j = ec_dlog(qx, qy);
      m = i + j;
      m = ec_mod_order(m);
      P = ec_pow_store(P, m);
    }
  }
  return P;
}

/* R = k * P on the wire; k is one byte (ksi[0]); returns the (mutated) point
 * buffer psi.  Signature matches the emitted call  t = ec_scalar_mul(ksi, psi). */
fn ec_scalar_mul(reg ptr u8[1] ksi, reg ptr u8[2] psi) -> reg ptr u8[2] {
  reg u8 kb; reg u8 px; reg u8 py;
  reg u64 k; reg u64 j; reg u64 m;
  kb = ksi[0];
  px = psi[0]; py = psi[1];

  /* P = infinity: k*inf = inf (psi already holds (0xff,0xff)). */
  if (px == 0xff) {
    psi[0] = 0xff;
    psi[1] = 0xff;
  } else {
    k = (64u)kb;
    j = ec_dlog(px, py);
    m = k * j;
    m = ec_mod_order(m);
    /* m = 0 means k*j == 0 mod 28: the result is the identity (infinity). */
    if (m == 0) {
      psi[0] = 0xff;
      psi[1] = 0xff;
    } else {
      psi = ec_pow_store(psi, m);
    }
  }
  return psi;
}
