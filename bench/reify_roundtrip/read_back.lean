import HaxLean.HaxAdapter
import HaxLean.Json.Adapter

/-!
Read-back driver for `bench/reify_roundtrip`, called by `scripts/reify-roundtrip.sh`
with the arguments `JSON FN DEF OUT`: reads the body of the function `FN` from the
hax frontend export `JSON` with `Hax.HaxAdapter.parseHaxExpr`, applies
`reconstructForLoops` and `normalizeAssignOps` (the passes `parseHaxItem` applies
to a function body, without its parameter bindings), and writes the result as the
Lean literal `DEF` in the namespace `CatCrypt.Hax.ReifyImp` to the module file
`OUT`.  The printer is the one of `bench/hax_roundtrip/read_back.lean`.
Run from the dev repository root with `lake env lean --run`.

## Main definitions

* `main`: the driver entry point.
-/

open Lean (Json)
open Hax

/-- `n` spaces. -/
def pad (n : Nat) : String := String.ofList (List.replicate n ' ')

/-- The constructor of an integer width. -/
def widthLean : IntWidth → String
  | .w8 => ".w8" | .w16 => ".w16" | .w32 => ".w32" | .w64 => ".w64"
  | .w128 => ".w128" | .wsize => ".wsize"

/-- The Lean syntax of a literal. -/
def litLean : ImpLit → String
  | .bool b => s!"(.bool {b})"
  | .int n => s!"(.int ({n}))"
  | .unit => ".unit"
  | .uintLit w n => s!"(.uintLit {widthLean w} {n})"
  | .sintLit w n => s!"(.sintLit {widthLean w} ({n}))"

/-- The Lean syntax of a pattern. -/
partial def patLean : ImpPat → String
  | .wildcard => ".wildcard"
  | .litPat l => s!"(.litPat {litLean l})"
  | .varPat n => s!"(.varPat {n.quote})"
  | .tuplePat ps => s!"(.tuplePat [{", ".intercalate (ps.map patLean)}])"
  | .somePat p => s!"(.somePat {patLean p})"
  | .nonePat => ".nonePat"
  | .okPat p => s!"(.okPat {patLean p})"
  | .errPat p => s!"(.errPat {patLean p})"
  | .ctorPat n ps => s!"(.ctorPat {n.quote} [{", ".intercalate (ps.map patLean)}])"

/-- The Lean syntax of an expression at nesting depth `d`: each argument that is
    an expression on its own line, indented by the depth. -/
partial def exprLean (d : Nat) (e : ImpExpr) : String :=
  let nl := "\n" ++ pad (2 * (d + 2))
  let sub (x : ImpExpr) : String := nl ++ exprLean (d + 1) x
  let lst (xs : List ImpExpr) : String :=
    nl ++ "[" ++ ", ".intercalate (xs.map (exprLean (d + 1))) ++ "]"
  let arm (pa : ImpPat × ImpExpr) : String :=
    "(" ++ patLean pa.1 ++ "," ++ nl ++ exprLean (d + 1) pa.2 ++ ")"
  match e with
  | .lit l => s!"(.lit {litLean l})"
  | .var n => s!"(.var {n.quote})"
  | .letBind n v b => s!"(.letBind {n.quote}{sub v}{sub b})"
  | .lam ps b => s!"(.lam [{", ".intercalate (ps.map String.quote)}]{sub b})"
  | .app f args => s!"(.app {f.quote}{lst args})"
  | .tuple es => s!"(.tuple{lst es})"
  | .proj x i => s!"(.proj{sub x} {i})"
  | .ifThenElse c t f => s!"(.ifThenElse{sub c}{sub t}{sub f})"
  | .match_ s arms => s!"(.match_{sub s}{nl}[{", ".intercalate (arms.map arm)}])"
  | .unitVal => ".unitVal"
  | .seq a b => s!"(.seq{sub a}{sub b})"
  | .borrow x => s!"(.borrow{sub x})"
  | .deref x => s!"(.deref{sub x})"
  | .assign n r => s!"(.assign {n.quote}{sub r})"
  | .forLoop v lo hi b => s!"(.forLoop {v.quote}{sub lo}{sub hi}{sub b})"
  | .forLoopRev v lo hi b => s!"(.forLoopRev {v.quote}{sub lo}{sub hi}{sub b})"
  | .whileLoop c b => s!"(.whileLoop{sub c}{sub b})"
  | .break_ none => "(.break_ none)"
  | .break_ (some x) => s!"(.break_ (some{sub x}))"
  | .continue_ => ".continue_"
  | .earlyReturn x => s!"(.earlyReturn{sub x})"
  | .questionMark x => s!"(.questionMark{sub x})"
  | .forFold v lo hi b => s!"(.forFold {v.quote}{sub lo}{sub hi}{sub b})"
  | .forFoldRev v lo hi b => s!"(.forFoldRev {v.quote}{sub lo}{sub hi}{sub b})"
  | .whileFold c b => s!"(.whileFold{sub c}{sub b})"
  | .forFoldReturn v lo hi b => s!"(.forFoldReturn {v.quote}{sub lo}{sub hi}{sub b})"
  | .forFoldRevReturn v lo hi b => s!"(.forFoldRevReturn {v.quote}{sub lo}{sub hi}{sub b})"
  | .whileFoldReturn c b => s!"(.whileFoldReturn{sub c}{sub b})"
  | .cfBreak x => s!"(.cfBreak{sub x})"
  | .cfContinue x => s!"(.cfContinue{sub x})"
  | .cfBreakContinue x => s!"(.cfBreakContinue{sub x})"
  | .typeAscription x ty => s!"(.typeAscription{sub x} {ty.quote})"

/-- The generated module for the reading `e` of the function `fn` as the definition
    `defName`. -/
def moduleText (fn defName : String) (e : ImpExpr) : String :=
  "/-\n" ++
  "Copyright (c) 2026 CatCrypt Contributors. All rights reserved.\n" ++
  "Released under MIT license as described in the file LICENSE.\n" ++
  "Authors: CatCrypt Contributors\n" ++
  "-/\n" ++
  "module\n\n" ++
  "public import HaxLean.AST\n\n" ++
  "/-!\n" ++
  s!"# The hax frontend's reading of the printed function `{fn}`\n\n" ++
  s!"Generated by `scripts/reify-roundtrip.sh`; do not edit.  `{defName}` is the body\n" ++
  s!"of `{fn}` in `bench/reify_roundtrip/crate/src/lib.rs` as `cargo hax json` and\n" ++
  "`Hax.HaxAdapter.parseHaxExpr`, followed by `reconstructForLoops` and\n" ++
  "`normalizeAssignOps`, read it.\n\n" ++
  "## Main definitions\n\n" ++
  s!"* `{defName}`: the reading, as an `ImpExpr` literal.\n" ++
  "-/\n\n" ++
  "@[expose] public section\n\n" ++
  "set_option autoImplicit false\n\n" ++
  "namespace CatCrypt.Hax.ReifyImp\n\n" ++
  s!"/-- The hax frontend's reading of the printed function `{fn}`. -/\n" ++
  s!"def {defName} : _root_.Hax.ImpExpr :=\n" ++
  "  " ++ exprLean 0 e ++ "\n\n" ++
  "end CatCrypt.Hax.ReifyImp\n"

/-- The JSON body of the function `name` in a hax frontend export. -/
def fnBody? (items : List Json) (name : String) : Option Json :=
  items.findSome? fun it => do
    let kind ← (it.getObjVal? "kind").toOption
    let fnData ← (kind.getObjVal? "Fn").toOption
    let ident ← (fnData.getObjVal? "ident").toOption
    if HaxAdapter.extractFnName ident == name then
      let d ← (fnData.getObjVal? "def").toOption
      (d.getObjVal? "body").toOption
    else none

def main (args : List String) : IO Unit := do
  let (jsonPath, fn, defName, out) ← match args with
    | [a, b, c, d] => pure (a, b, c, d)
    | _ => throw (IO.userError "usage: read_back.lean JSON FN DEF OUT")
  let src ← IO.FS.readFile jsonPath
  let j ← IO.ofExcept (Hax.Json.parseJsonString src)
  let items ← match j with
    | .arr a => pure a.toList
    | _ => throw (IO.userError "the hax export is not an array of items")
  let bodyJ ← match fnBody? items fn with
    | some b => pure b
    | none => throw (IO.userError s!"no function {fn} in the hax export")
  let e ← IO.ofExcept (HaxAdapter.parseHaxExpr bodyJ)
  let x := HaxAdapter.normalizeAssignOps (HaxAdapter.reconstructForLoops e)
  IO.FS.writeFile out (moduleText fn defName x)
  IO.println s!"wrote {out}"
