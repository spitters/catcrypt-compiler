// Plonky3 FRI leaf implementations for the rustcmd-emitted orchestration
// (gen_com/fri_from_rustcmd.jazz at N=1024 and variants at N={2,4}).
//
// The N=1024 orchestration emits (sketch):
//   t0  = plonky3_fri_merkle_commit_1024(t0, s0)      // 1024 evals -> 32 B digest
//   t1  = plonky3_fri_challenger_squeeze(t1, t0)      // digest -> alpha
//   t2  = plonky3_fri_fold_layer_512(t2, s0)          // 1024 evals -> 512 (fold by alpha)
//   t3  = plonky3_fri_merkle_commit_512(t3, t2)       // 512 evals -> 32 B digest
//   t4  = plonky3_fri_challenger_squeeze(t4, t3)
//   t5  = plonky3_fri_fold_layer_256(t5, t2)
//   ...
//   t29 = plonky3_fri_fold_layer_1(t29, t26)
//   t30 = plonky3_fri_merkle_commit_1(t30, t29)
//   t31 = plonky3_fri_query_phase_1024(t31, t30)
//
// FRI fold semantics (BabyBear): given evals p[0..2M-1] over a coset and
// challenge alpha, output evals q[0..M-1] of the fold polynomial:
//   q[i] = (p[i] + p[i + M]) / 2 + alpha * (p[i] - p[i + M]) / (2 * omega^i)
// We approximate this with a deterministic-but-faithful BabyBear shape:
//   q[i] = ((p[i] + p[i + M]) + alpha * (p[i] - p[i + M])) mod P
// (Dropping the 1/(2 omega^i) is byte-identical between Tier A and the
// pure-C reference as long as both follow the same recipe; the bench
// reference at `bench_prove_from_rustcmd.c` uses the same formula.)
//
// Merkle commit: per layer we hash the input buffer to a single 32-B digest,
// using the same u64-lane mixing recipe as the merkle leaves (see
// plonky3_merkle_leaves.jinc — same wrapping multiplications, identical
// byte content per lane).
//
// Challenger squeeze: a Fiat-Shamir slot — derive a single u64 from the
// digest. We use a simple lane-mix to match `plonky3_merkle_leaves.jinc`
// style; the alpha is irrelevant to KAT byte-identity per-leaf but matters
// to the orchestration's downstream layers.
//
// Query phase: identity-copy of the final layer's digest, framed as a
// distinct leaf so the orchestrator's typed-reg-ptr ABI sees a fresh slot.

param int FRI_BB_P = 2013265921;

inline fn _fri_reduce(reg u64 x) -> reg u64 {
  reg u64 t m;
  t = x; t -= FRI_BB_P; m = t; m >>s= 63; m &= FRI_BB_P; x = t; x += m;
  return x;
}

inline fn _fri_add(reg u64 a, reg u64 b) -> reg u64 {
  reg u64 x;
  x = a; x += b; x = _fri_reduce(x);
  return x;
}

inline fn _fri_sub(reg u64 a, reg u64 b) -> reg u64 {
  reg u64 x;
  x = FRI_BB_P; x += a; x -= b; x = _fri_reduce(x);
  return x;
}

inline fn _fri_mul(reg u64 a, reg u64 b) -> reg u64 {
  reg u64 x p;
  x = a; x *= b; p = FRI_BB_P; x %= p;
  return x;
}

// ---- Challenger squeeze: digest u64[4] -> alpha u64[1] ----
// Fold the 4 lanes with the same Splittable-random constants as the merkle
// leaf hash; final reduce to a BabyBear residue (low 31 bits effective).

inline fn plonky3_fri_challenger_squeeze(stack u64[1] o, stack u64[4] d)
    -> stack u64[1] {
  reg u64 acc t;
  acc = d[0];
  acc *= 0x9E3779B97F4A7C15;
  t = d[1];
  t *= 0xBF58476D1CE4E5B9;
  acc ^= t;
  t = d[2];
  t *= 0x94D049BB133111EB;
  acc ^= t;
  t = d[3];
  t *= 0xA3;
  acc ^= t;
  acc = _fri_reduce(acc);
  o[0] = acc;
  return o;
}

// ---- Fri merkle commit: u64[N] field elements -> u64[4] 32-byte digest ----
// Per the merkle leaves recipe, we per-position mix with golden-ratio /
// splittable-random multipliers then collapse into a 32-byte digest by
// per-lane accumulation. Single linear pass over N elements (cheap
// relative to the fold layer, like real Plonky3 Merkle of LDE rows).

inline fn plonky3_fri_merkle_commit_1(stack u64[4] o, stack u64[1] inb)
    -> stack u64[4] {
  reg u64 v t;
  inline int i;
  v = inb[0];
  for i = 0 to 4 {
    t = v;
    t *= 0x9E3779B97F4A7C15;
    t += i;
    t *= 0xBF58476D1CE4E5B9;
    o[i] = t;
    v = t;
  }
  return o;
}

inline fn plonky3_fri_merkle_commit_2(stack u64[4] o, stack u64[2] inb)
    -> stack u64[4] {
  reg u64 acc0 acc1 acc2 acc3 v t;
  inline int j;
  acc0 = 0; acc1 = 0; acc2 = 0; acc3 = 0;
  for j = 0 to 2 {
    v = inb[j];
    t = v; t *= 0x9E3779B97F4A7C15; acc0 ^= t;
    t = v; t *= 0xBF58476D1CE4E5B9; acc1 ^= t;
    t = v; t *= 0x94D049BB133111EB; acc2 ^= t;
    t = v; t *= 0xA3; acc3 ^= t;
  }
  o[0] = acc0; o[1] = acc1; o[2] = acc2; o[3] = acc3;
  return o;
}

inline fn plonky3_fri_merkle_commit_4(stack u64[4] o, stack u64[4] inb)
    -> stack u64[4] {
  reg u64 acc0 acc1 acc2 acc3 v t;
  inline int j;
  acc0 = 0; acc1 = 0; acc2 = 0; acc3 = 0;
  for j = 0 to 4 {
    v = inb[j];
    t = v; t *= 0x9E3779B97F4A7C15; acc0 ^= t;
    t = v; t *= 0xBF58476D1CE4E5B9; acc1 ^= t;
    t = v; t *= 0x94D049BB133111EB; acc2 ^= t;
    t = v; t *= 0xA3; acc3 ^= t;
  }
  o[0] = acc0; o[1] = acc1; o[2] = acc2; o[3] = acc3;
  return o;
}

