}

inline fn plonky3_fri_fold_layer_16(stack u64[16] o, stack u64[32] inb)
    -> stack u64[16] {
  reg u64 a b s d t alpha;
  inline int i;
  alpha = 17;
  for i = 0 to 16 {
    a = inb[i]; b = inb[16 + i];
    s = _fri_add(a, b); d = _fri_sub(a, b); t = _fri_mul(d, alpha);
    s = _fri_add(s, t); o[i] = s;
