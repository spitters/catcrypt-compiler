inline fn plonky3_fri_fold_layer_4(stack u64[4] o, stack u64[8] inb)
    -> stack u64[4] {
  reg u64 a b s d t alpha;
  inline int i;
  alpha = 23;
  for i = 0 to 4 {
    a = inb[i]; b = inb[4 + i];
    s = _fri_add(a, b); d = _fri_sub(a, b); t = _fri_mul(d, alpha);
