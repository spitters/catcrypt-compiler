}

inline fn plonky3_fri_fold_layer_2(stack u64[2] o, stack u64[4] inb)
    -> stack u64[2] {
  reg u64 a b s d t alpha;
  inline int i;
  alpha = 29;
  for i = 0 to 2 {
    a = inb[i]; b = inb[2 + i];
    s = _fri_add(a, b); d = _fri_sub(a, b); t = _fri_mul(d, alpha);
    s = _fri_add(s, t); o[i] = s;
