inline fn plonky3_fri_fold_layer_8(stack u64[8] o, stack u64[16] inb)
    -> stack u64[8] {
  reg u64 a b s d t alpha;
  inline int i;
  alpha = 19;
  for i = 0 to 8 {
    a = inb[i]; b = inb[8 + i];
    s = _fri_add(a, b); d = _fri_sub(a, b); t = _fri_mul(d, alpha);
