// ---- Fold layers: u64[2M] -> u64[M] ----
// q[i] = ((p[i] + p[i+M]) + alpha * (p[i] - p[i+M])) mod BB_P.
// The orchestration does not pass alpha — by spec the per-layer alpha is
// challenger-squeezed and stored in `t1`, then implicit at the fold call
// (the rustcmd surface elides this opaque dependency). To make the leaf
// deterministic we use a derived per-layer constant `alpha = layer_id`
// (cheap rolling multiplier; same on both sides of the bench).
// Real plonky3 routes alpha as an extra arg; that's the next-leaf upgrade
// and does not change the orchestration shape.

// Per-M fold layers, statically sized. Each reads 2M evals and writes M.

inline fn plonky3_fri_fold_layer_512(stack u64[512] o, stack u64[1024] inb)
    -> stack u64[512] {
  reg u64 a b s d t alpha;
  inline int i;
  alpha = 3;  // layer-fixed constant, paired with bench reference
  for i = 0 to 512 {
    a = inb[i];
    b = inb[512 + i];
    s = _fri_add(a, b);
    d = _fri_sub(a, b);
    t = _fri_mul(d, alpha);
    s = _fri_add(s, t);
    o[i] = s;
  }
  return o;
}

inline fn plonky3_fri_fold_layer_256(stack u64[256] o, stack u64[512] inb)
    -> stack u64[256] {
  reg u64 a b s d t alpha;
  inline int i;
  alpha = 5;
  for i = 0 to 256 {
    a = inb[i]; b = inb[256 + i];
    s = _fri_add(a, b); d = _fri_sub(a, b); t = _fri_mul(d, alpha);
    s = _fri_add(s, t); o[i] = s;
  }
  return o;
}

inline fn plonky3_fri_fold_layer_128(stack u64[128] o, stack u64[256] inb)
    -> stack u64[128] {
  reg u64 a b s d t alpha;
  inline int i;
  alpha = 7;
  for i = 0 to 128 {
    a = inb[i]; b = inb[128 + i];
    s = _fri_add(a, b); d = _fri_sub(a, b); t = _fri_mul(d, alpha);
    s = _fri_add(s, t); o[i] = s;
  }
  return o;
}

inline fn plonky3_fri_fold_layer_64(stack u64[64] o, stack u64[128] inb)
    -> stack u64[64] {
  reg u64 a b s d t alpha;
  inline int i;
  alpha = 11;
  for i = 0 to 64 {
    a = inb[i]; b = inb[64 + i];
    s = _fri_add(a, b); d = _fri_sub(a, b); t = _fri_mul(d, alpha);
    s = _fri_add(s, t); o[i] = s;
  }
  return o;
}

inline fn plonky3_fri_fold_layer_32(stack u64[32] o, stack u64[64] inb)
    -> stack u64[32] {
  reg u64 a b s d t alpha;
  inline int i;
  alpha = 13;
  for i = 0 to 32 {
    a = inb[i]; b = inb[32 + i];
    s = _fri_add(a, b); d = _fri_sub(a, b); t = _fri_mul(d, alpha);
    s = _fri_add(s, t); o[i] = s;
