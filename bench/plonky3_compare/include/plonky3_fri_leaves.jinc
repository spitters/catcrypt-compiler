  return o;
}

inline fn plonky3_fri_fold_layer_1(stack u64[1] o, stack u64[2] inb)
    -> stack u64[1] {
  reg u64 a b s d t alpha;
  alpha = 31;
  a = inb[0]; b = inb[1];
  s = _fri_add(a, b); d = _fri_sub(a, b); t = _fri_mul(d, alpha);
  s = _fri_add(s, t); o[0] = s;
  return o;
}

// ---- Query phase: u64[4] -> u64[4] (identity copy as proof digest) ----
// Real Plonky3 derives query indices from the final layer's digest and
// emits openings; the orchestrator-level emit treats the final digest as
// the proof. We thread it through a leaf so the cyc/op cost includes the
// transition.

inline fn plonky3_fri_query_phase_2(stack u64[4] o, stack u64[4] d)
    -> stack u64[4] {
  inline int i;
  reg u64 t;
  for i = 0 to 4 { t = d[i]; o[i] = t; }
  return o;
}

inline fn plonky3_fri_query_phase_4(stack u64[4] o, stack u64[4] d)
    -> stack u64[4] {
  inline int i;
  reg u64 t;
  for i = 0 to 4 { t = d[i]; o[i] = t; }
  return o;
}

inline fn plonky3_fri_query_phase_1024(stack u64[4] o, stack u64[4] d)
    -> stack u64[4] {
  inline int i;
  reg u64 t;
  for i = 0 to 4 { t = d[i]; o[i] = t; }
  return o;
}
