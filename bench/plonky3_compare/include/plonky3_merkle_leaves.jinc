inline fn plonky3_merkle_level_512(stack u64[2048] o, stack u64[4096] d) -> stack u64[2048] {
  stack u64[4] l; stack u64[4] r; stack u64[4] od;
  inline int j i;
  reg u64 w;
  for j = 0 to 512 {
    for i = 0 to 4 { w = d[(2*j)*4 + i]; l[i] = w; }
    for i = 0 to 4 { w = d[(2*j+1)*4 + i]; r[i] = w; }
    od = _p3_compress_u64(l, r, od);
    for i = 0 to 4 { w = od[i]; o[j*4 + i] = w; }
