}

// --- extract_root: identity copy from u64[4] -> u64[4] ---

inline fn plonky3_merkle_extract_root(stack u64[4] o, stack u64[4] d) -> stack u64[4] {
  inline int i;
  reg u64 w;
  for i = 0 to 4 { w = d[i]; o[i] = w; }
  return o;
}
