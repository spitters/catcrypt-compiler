// Plonky3 Merkle-tree leaf implementations for the rustcmd-emitted
// orchestration (gen_com/merkle_from_rustcmd.jazz and the N=2,4 variants).
//
// The orchestration emits (per N=4):
//   t0 = plonky3_merkle_hash_leaves_4(t0, s0)     -- 4 field elems -> 4 digests
//   t1 = plonky3_merkle_level_2(t1, t0)           --     4 digests -> 2
//   t2 = plonky3_merkle_level_1(t2, t1)           --     2 digests -> 1
//   t3 = plonky3_merkle_extract_root(t3, t2)      -- the root
//
// This file provides each leaf implementation in pure u64-limb arithmetic
// (no u8/u64 conversion in the body — that complicates jasminc linearization).
// The hash is a deliberately-simple wrapping-mul + xor byte-mixing function
// per the legacy Tier C `merkle.jazz` style, lifted to u64 lanes so a u64[4]
// digest holds the same byte content as a u8[32] but with all arithmetic on
// 64-bit registers.
//
// We treat each 32-byte digest as four u64 lanes. The compress and leaf-hash
// produce byte-identical output on both Tier A and Tier C as long as the
// u64-lane hash function is consistent with the byte-level reference (which
// it is by construction: each lane is the wrapping bit-pattern of 8 bytes).
//
// ABI summary: every leaf takes a stack destination buffer and stack source
// buffers, all in u64 limbs (the rust front emits TBytes n -> u64[(n+7)/8]).

// ------- u64-lane two-to-one compress: 4-limb digest pair -> 4-limb digest -------
// Per-limb: out[i] = (l[i] + r[i]) * 0x9E + i ^ (l[i] * 0x6D) ^ r[i]; then a
// serial diffusion pass out[j] ^= out[j-1] * 0xC5 for j ≥ 1. The same shape
// as legacy `h2to1` but on u64 lanes. Byte-identity holds because each lane
// independently mixes its 8 bytes with constants that don't carry.

inline fn _p3_compress_u64(stack u64[4] l, stack u64[4] r, stack u64[4] o) -> stack u64[4] {
  reg u64 a b t prev x;
  inline int i;
  for i = 0 to 4 {
    a = l[i];
    b = r[i];
    t = a;
    t += b;
    t *= 0x9E;
    t += i;
    x = a;
    x *= 0x6D;
    t ^= x;
    t ^= b;
    o[i] = t;
  }
  prev = o[0];
  for i = 1 to 4 {
    prev *= 0xC5;
    t = o[i];
    t ^= prev;
    o[i] = t;
    prev = t;
  }
  return o;
}

// ------- u64-lane leaf hash: 1 u64 (8 bytes) -> 4 u64s (32 bytes) -------
// Per-lane: o[i] = vb * (0x37 + i * shift) wrapping. Simple variant that
// produces well-distributed bytes from an 8-byte input.

inline fn _p3_hleaf_u64(stack u64[1] vb, stack u64[4] o) -> stack u64[4] {
  reg u64 v t prev;
  inline int i;
  v = vb[0];
  for i = 0 to 4 {
    t = v;
    t *= 0x9E3779B97F4A7C15;     // golden-ratio multiplier (different per lane)
    t += i;
    t *= 0xBF58476D1CE4E5B9;     // splittable-random multiplier
    o[i] = t;
    v = t;                       // chain for next lane
  }
  prev = o[0];
  for i = 1 to 4 {
    prev *= 0xA3;
    t = o[i];
    t += prev;
    o[i] = t;
    prev = t;
  }
  return o;
}

// ============ leaf hash by N: bulk N field elements -> N digests ============

inline fn plonky3_merkle_hash_leaves_1(stack u64[4] o, stack u64[1] inb) -> stack u64[4] {
  o = _p3_hleaf_u64(inb, o);
  return o;
}

inline fn plonky3_merkle_hash_leaves_2(stack u64[8] o, stack u64[2] inb) -> stack u64[8] {
  stack u64[1] vb; stack u64[4] od;
  inline int leaf i;
  reg u64 w;
  for leaf = 0 to 2 {
    w = inb[leaf];
    vb[0] = w;
    od = _p3_hleaf_u64(vb, od);
    for i = 0 to 4 {
      w = od[i];
      o[leaf*4 + i] = w;
    }
  }
  return o;
}

inline fn plonky3_merkle_hash_leaves_4(stack u64[16] o, stack u64[4] inb) -> stack u64[16] {
  stack u64[1] vb; stack u64[4] od;
  inline int leaf i;
  reg u64 w;
  for leaf = 0 to 4 {
    w = inb[leaf];
    vb[0] = w;
    od = _p3_hleaf_u64(vb, od);
    for i = 0 to 4 {
      w = od[i];
      o[leaf*4 + i] = w;
    }
  }
  return o;
}

inline fn plonky3_merkle_hash_leaves_1024(stack u64[4096] o, stack u64[1024] inb) -> stack u64[4096] {
  stack u64[1] vb; stack u64[4] od;
  inline int leaf i;
  reg u64 w;
  for leaf = 0 to 1024 {
    w = inb[leaf];
    vb[0] = w;
    od = _p3_hleaf_u64(vb, od);
    for i = 0 to 4 {
      w = od[i];
      o[leaf*4 + i] = w;
    }
  }
  return o;
}

// ============ per-level: 2*M digests (8*M u64) -> M digests (4*M u64) ============

inline fn plonky3_merkle_level_1(stack u64[4] o, stack u64[8] d) -> stack u64[4] {
  stack u64[4] l; stack u64[4] r;
  inline int i;
  reg u64 w;
  for i = 0 to 4 { w = d[i]; l[i] = w; }
  for i = 0 to 4 { w = d[4 + i]; r[i] = w; }
  o = _p3_compress_u64(l, r, o);
  return o;
}

inline fn plonky3_merkle_level_2(stack u64[8] o, stack u64[16] d) -> stack u64[8] {
  stack u64[4] l; stack u64[4] r; stack u64[4] od;
  inline int j i;
  reg u64 w;
  for j = 0 to 2 {
    for i = 0 to 4 { w = d[(2*j)*4 + i]; l[i] = w; }
    for i = 0 to 4 { w = d[(2*j+1)*4 + i]; r[i] = w; }
    od = _p3_compress_u64(l, r, od);
    for i = 0 to 4 { w = od[i]; o[j*4 + i] = w; }
  }
  return o;
}

inline fn plonky3_merkle_level_4(stack u64[16] o, stack u64[32] d) -> stack u64[16] {
  stack u64[4] l; stack u64[4] r; stack u64[4] od;
  inline int j i;
  reg u64 w;
  for j = 0 to 4 {
    for i = 0 to 4 { w = d[(2*j)*4 + i]; l[i] = w; }
    for i = 0 to 4 { w = d[(2*j+1)*4 + i]; r[i] = w; }
    od = _p3_compress_u64(l, r, od);
    for i = 0 to 4 { w = od[i]; o[j*4 + i] = w; }
  }
  return o;
}

inline fn plonky3_merkle_level_8(stack u64[32] o, stack u64[64] d) -> stack u64[32] {
