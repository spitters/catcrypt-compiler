// Plonky3 PROVE-orchestrator leaf implementations for the rustcmd-emitted
// orchestration (gen_com/prove_from_rustcmd_link.jazz).
//
// The orchestration emits (width=3, height=8 Fibonacci AIR):
//   t0 = plonky3_trace_lde_3_8(t0, s0)           // u64[24] trace  -> u64[32] LDE
//   t1 = plonky3_merkle_commit_orch_8(t1, t0)    // u64[32] LDE    -> u64[4] digest
//   t2 = plonky3_challenger_squeeze(t2, t1)      // u64[4] digest  -> u64[1] alpha
//   t3 = plonky3_quotient_compose_8(t3, t0, t2)  // u64[32]+u64[1] -> u64[64] quotient
//                                                //                 (selector-inclusive deg=2)
//   t4 = plonky3_ood_deep_8(t4, t3, t2)          // u64[64]+u64[1] -> u64[64] ood/deep
//   t5 = plonky3_fri_prove_8(t5, t4, t2)         // u64[64]+u64[1] -> u64[4] proof
//
// REAL-LEAF VERSION: each leaf body invokes real Tier A BabyBear NTT / Merkle
// / FRI / Poseidon-style sponge work, not the prior XOR-multiply surrogate.
//
// SPEC-ADHERENT (byte-for-byte the Lean spec in Plonky3ProveEmit.lean /
// Plonky3LdeEmit.lean, cross-checked by the GOLDEN KAT in
// bench_prove_from_rustcmd.c):
//   * plonky3_trace_lde_3_8 is the REAL radix-2 Cooley-Tukey coset LDE — per
//     column bbIntt over H (8-pt, root rou(3)), zero-pad to 32, coset-twist by
//     shift^i (shift = GENERATOR = 31), bbNtt over K (32-pt, root rou(5)) —
//     a genuine low-degree extension, not a per-position reduce-pass. Output
//     is all 3 columns interleaved row-major (u64[96]).
//   * plonky3_merkle_commit_orch_8 is the FULL-WIDTH commitment — each row's 3
//     columns are folded mixed = mixed*31 + lde[row*3+col] before leaf-hashing
//     (matches commitTraceLde), not the prior width-1 column-0-only commit.
//
// RESIDUAL (still reduced — later increments): the leaf HASH is a simplified
// u64-lane mixing (_p3_hleaf_u64 / _p3_compress_u64), not the per-byte
// Poseidon of merkle.rs; the FRI/OOD/quotient phases collapse to a digest
// rather than emitting the full FRI proof object; there is no verifier.
//
// Parameters: Fibonacci-AIR demonstrator at height=8, blowup=4 (domain=32) —
// same field (BabyBear), same recipe as plonky3-hax's prover.
//
// We reuse `_p3_compress_u64`/`_p3_hleaf_u64` from the merkle leaves and
// `_bb_*` field arithmetic from the LDE leaves via `require`, then
// implement the 6 prove-orchestrator leaves on top.

require "plonky3_merkle_leaves.jinc"
require "plonky3_lde_leaves.jinc"
require "plonky3_fri_leaves.jinc"

param int PR_BB_P = 2013265921;
param int PR_BB_G = 31;   // BabyBear generator of (Z/p)*

inline fn _pr_reduce(reg u64 x) -> reg u64 {
  reg u64 t m;
  t = x; t -= PR_BB_P; m = t; m >>s= 63; m &= PR_BB_P; x = t; x += m;
  return x;
}

inline fn _pr_add(reg u64 a, reg u64 b) -> reg u64 {
  reg u64 x;
  x = a; x += b; x = _pr_reduce(x);
  return x;
}

inline fn _pr_sub(reg u64 a, reg u64 b) -> reg u64 {
  reg u64 x;
  x = PR_BB_P; x += a; x -= b; x = _pr_reduce(x);
  return x;
}

inline fn _pr_mul(reg u64 a, reg u64 b) -> reg u64 {
  reg u64 x p;
  x = a; x *= b; p = PR_BB_P; x %= p;
  return x;
}

// _pr_pow(base, exp): square-and-multiply over 64 bits, byte-for-byte the
// Lean `bbPow` reference (and plonky3-hax `bb_pow`).
inline fn _pr_pow(reg u64 base, reg u64 exp) -> reg u64 {
  stack u64[1] res_s;
  stack u64[1] cur_s;
  stack u64[1] exp_s;
  reg u64 r c e bit t;
  inline int it;
  r = 1; res_s[0] = r;
  c = base; cur_s[0] = c;
  e = exp; exp_s[0] = e;
  for it = 0 to 64 {
    e = exp_s[0];
    bit = e; bit &= 1;
    if (bit == 1) {
      r = res_s[0];
      c = cur_s[0];
      r = _pr_mul(r, c);
      res_s[0] = r;
    }
    c = cur_s[0];
    c = _pr_mul(c, c);
    cur_s[0] = c;
    e = exp_s[0];
    e >>= 1;
    exp_s[0] = e;
  }
  r = res_s[0];
  return r;
}

// _pr_inv(a): Fermat inverse a^(p-2); 0 -> 0. Byte-for-byte Lean `bbInv`.
inline fn _pr_inv(reg u64 a) -> reg u64 {
  reg u64 x e;
  if (a == 0) {
    x = 0;
  } else {
    e = PR_BB_P; e -= 2;
    x = _pr_pow(a, e);
  }
  return x;
}

// ============================================================================
// Real radix-2 Cooley-Tukey NTT over BabyBear (matches Lean bbNtt / bbIntt).
// ============================================================================
// _pr_bitrev5(i): reverse the low 5 bits of i (for the n=32 transform).
inline fn _pr_bitrev5(reg u64 i) -> reg u64 {
  reg u64 r b t;
  inline int k;
  r = 0; t = i;
  for k = 0 to 5 {
    b = t; b &= 1;
    r <<= 1; r |= b;
    t >>= 1;
  }
  return r;
}

// _pr_bitrev3(i): reverse the low 3 bits of i (for the n=8 transform).
inline fn _pr_bitrev3(reg u64 i) -> reg u64 {
  reg u64 r b t;
  inline int k;
  r = 0; t = i;
  for k = 0 to 3 {
    b = t; b &= 1;
    r <<= 1; r |= b;
    t >>= 1;
  }
  return r;
}

// _pr_ntt8(io, omega): in-place forward NTT of 8 elements with root `omega`
// (an 8th root of unity). Bit-reverse permute, then 3 Cooley-Tukey layers.
// Matches Lean `bbNtt` for n=8.
inline fn _pr_ntt8(stack u64[8] io, reg u64 omega) -> stack u64[8] {
  stack u64[8] a;
  stack u64[1] om_s;
  stack u64[1] ws_s;
  stack u64[1] wp_s;
  reg u64 x j rev wsize wpow lo hi t s d;
  inline int idx layer size half blk pos;
  om_s[0] = omega;
  // bit-reverse permute
  for idx = 0 to 8 {
    j = idx; rev = _pr_bitrev3(j);
    x = io[rev];                // io[bitrev(idx)]
    a[idx] = x;
  }
  // layers: size = 2,4,8 ; half = 1,2,4 ; wSize = omega^(8/size).
  // Twiddles wPow = wSize^j are built by rolling multiplication per block
  // (reset to 1 at each block start), avoiding a per-butterfly pow.
  for layer = 0 to 3 {
    size = 1; size <<= (layer + 1);
    half = size / 2;
    x = om_s[0];
    t = 8 / size;             // n/size
    wsize = _pr_pow(x, t);
    ws_s[0] = wsize;
    for blk = 0 to 8 {
      if ((blk % size) == 0) {
        wpow = 1; wp_s[0] = wpow;   // wSize^0
        for pos = 0 to 8 {
          if (pos < half) {
            wpow = wp_s[0];
            lo = a[blk + pos];
            hi = a[blk + pos + half];
            t = _pr_mul(wpow, hi);
            s = _pr_add(lo, t);
            d = _pr_sub(lo, t);
            a[blk + pos] = s;
            a[blk + pos + half] = d;
            wpow = wp_s[0];
            wsize = ws_s[0];
            wpow = _pr_mul(wpow, wsize);  // wPow *= wSize
            wp_s[0] = wpow;
          }
        }
      }
    }
  }
  for idx = 0 to 8 { x = a[idx]; io[idx] = x; }
  return io;
}

// _pr_ntt32(io, omega): in-place forward NTT of 32 elements, 5 CT layers.
// Matches Lean `bbNtt` for n=32.
inline fn _pr_ntt32(stack u64[32] io, reg u64 omega) -> stack u64[32] {
  stack u64[32] a;
  stack u64[1] om_s;
  stack u64[1] ws_s;
  stack u64[1] wp_s;
  reg u64 x j rev wsize wpow lo hi t s d;
  inline int idx layer size half blk pos;
  om_s[0] = omega;
  for idx = 0 to 32 {
    j = idx; rev = _pr_bitrev5(j);
    x = io[rev];
    a[idx] = x;
  }
  for layer = 0 to 5 {
    size = 1; size <<= (layer + 1);
    half = size / 2;
    x = om_s[0];
    t = 32 / size;
    wsize = _pr_pow(x, t);
    ws_s[0] = wsize;
    for blk = 0 to 32 {
      if ((blk % size) == 0) {
        wpow = 1; wp_s[0] = wpow;   // wSize^0
        for pos = 0 to 32 {
          if (pos < half) {
            wpow = wp_s[0];
            lo = a[blk + pos];
            hi = a[blk + pos + half];
            t = _pr_mul(wpow, hi);
            s = _pr_add(lo, t);
            d = _pr_sub(lo, t);
            a[blk + pos] = s;
            a[blk + pos + half] = d;
            wpow = wp_s[0];
            wsize = ws_s[0];
            wpow = _pr_mul(wpow, wsize);  // wPow *= wSize
            wp_s[0] = wpow;
          }
        }
      }
    }
  }
  for idx = 0 to 32 { x = a[idx]; io[idx] = x; }
  return io;
}

// _pr_intt8(io, omega): inverse NTT of 8 elements: forward NTT with omega^{-1},
// scaled by n^{-1}. Matches Lean `bbIntt` for n=8.
inline fn _pr_intt8(stack u64[8] io, reg u64 omega) -> stack u64[8] {
  reg u64 oi ni x t;
  inline int i;
  oi = _pr_inv(omega);
  io = _pr_ntt8(io, oi);
  t = 8; ni = _pr_inv(t);
  for i = 0 to 8 {
    x = io[i];
    x = _pr_mul(x, ni);
    io[i] = x;
  }
  return io;
}

// ============================================================================
// 1. plonky3_trace_lde_3_8: u64[24] trace -> u64[96] LDE rows (3 cols interleaved)
// ============================================================================
// REAL coset low-degree extension, byte-for-byte the Lean `computeColumnLde`
// (= plonky3-hax `compute_trace_lde`) for each of the 3 trace columns:
//   (a) read the 8 trace samples for that column, canonicalize,
//   (b) bbIntt over H (8-point inverse radix-2 NTT, root = rou(3)) -> coeffs,
//   (c) zero-pad coeffs 8 -> 32,
//   (d) coset twist: coeff[i] *= shift^i, shift = GENERATOR = 31,
//   (e) bbNtt over K (32-point forward radix-2 NTT, root = rou(5)) -> evals,
//   (f) write ALL 3 columns interleaved row-major into the u64[96] output:
//       o[i*3 + col] = col_lde[i].  The downstream commit row-folds the 3
//       columns per row (full-width commitment), matching `commitTraceLde`.
inline fn plonky3_trace_lde_3_8(stack u64[96] o, stack u64[24] s)
    -> stack u64[96] {
  stack u64[8]  colbuf;
  stack u64[32] lde_col;
  stack u64[1]  w_s;
  reg u64 x w t omegaTrace omegaN expo shift;
  inline int col row;

  // omegaTrace = rou(3) = G^((P-1) >> 3) ; omegaN = rou(5) = G^((P-1) >> 5)
  expo = PR_BB_P; expo -= 1; expo >>= 3;
  t = PR_BB_G; omegaTrace = _pr_pow(t, expo);
  expo = PR_BB_P; expo -= 1; expo >>= 5;
  t = PR_BB_G; omegaN = _pr_pow(t, expo);

  for col = 0 to 3 {
    // (a) extract this column's 8 trace samples, canonicalize
    for row = 0 to 8 {
      x = s[3*row + col];
      x = _pr_reduce(x);
      colbuf[row] = x;
    }
    // (b) inverse NTT over H -> coefficient form
    colbuf = _pr_intt8(colbuf, omegaTrace);
    // (c) zero-pad 8 -> 32
    for row = 0 to 8  { x = colbuf[row]; lde_col[row] = x; }
    for row = 8 to 32 { x = 0;           lde_col[row] = x; }
    // (d) coset twist: lde_col[i] *= shift^i  (rolling), shift = G = 31.
    //     Carry the rolling power through a stack slot so the inline _pr_mul
    //     body can use RAX/RDX without colliding with the loop's live-out.
    w = 1; w_s[0] = w;           // shift^0
    for row = 0 to 32 {
      x = lde_col[row];
      w = w_s[0];
      x = _pr_mul(x, w);
      lde_col[row] = x;
      w = w_s[0];
      shift = PR_BB_G;
      w = _pr_mul(w, shift);     // advance shift power
      w_s[0] = w;
    }
    // (e) forward NTT over K -> LDE evaluations
    lde_col = _pr_ntt32(lde_col, omegaN);
    // (f) interleave: o[row*3 + col] = lde_col[row]
    for row = 0 to 32 {
      x = lde_col[row];
      o[3*row + col] = x;
    }
  }
  return o;
}

// ============================================================================
// 2. plonky3_merkle_commit_orch_8: u64[96] LDE -> u64[4] digest
// ============================================================================
// FULL-WIDTH commitment, byte-for-byte the Lean `commitTraceLde`
// (= plonky3-hax `commit_trace_lde`) at width=3, domain_log2=5:
//   for each of the 32 rows, fold the row's 3 interleaved columns into one
//   field element  mixed <- mixed*31 + lde[row*3 + col]  (col = 0,1,2),
//   leaf-hash that field element, then Merkle-build the root over the 32
//   leaves via `_p3_compress_u64` over 5 levels:
//     32 leaves -> 16 -> 8 -> 4 -> 2 -> 1 internal node (the root).
// Total: 32 row-folds (3 muls + 3 adds each) + 32 leaf hashes + 31 compressions.
// The cross-column *31 row-fold is the glue tying ALL trace columns to the
// commitment, not just column 0 (the prior reduction committed width-1).
inline fn plonky3_merkle_commit_orch_8(stack u64[4] o, stack u64[96] inb)
    -> stack u64[4] {
  stack u64[128] level5;  // 32 leaves × 4 lanes = 128 u64
  stack u64[64]  level4;  // 16 × 4
  stack u64[32]  level3;  //  8 × 4
  stack u64[16]  level2;  //  4 × 4
  stack u64[8]   level1;  //  2 × 4
  stack u64[4]   level0;  //  1 × 4 (root)
  stack u64[1]   vb;
  stack u64[1]   mx;
  stack u64[4]   od;
  stack u64[4]   l4;
  stack u64[4]   r4;
  inline int leaf i j col;
  reg u64 w m c;

  // ---- level 5: row-fold the 3 columns of each row, then hash to a digest ----
  for leaf = 0 to 32 {
    m = 0; mx[0] = m;            // mixed accumulator (stack-carried)
    for col = 0 to 3 {
      m = mx[0];
      c = 31;
      m = _pr_mul(m, c);         // mixed *= 31
      w = inb[3*leaf + col];     // lde[row*3 + col]
      m = _pr_add(m, w);         // mixed += lde value
      mx[0] = m;
    }
    w = mx[0];
    vb[0] = w;
    od = _p3_hleaf_u64(vb, od);
    for i = 0 to 4 {
      w = od[i];
      level5[leaf*4 + i] = w;
    }
  }

  // ---- level 4: 32 -> 16 pairs ----
  for j = 0 to 16 {
    for i = 0 to 4 { w = level5[(2*j)*4 + i];   l4[i] = w; }
    for i = 0 to 4 { w = level5[(2*j+1)*4 + i]; r4[i] = w; }
    od = _p3_compress_u64(l4, r4, od);
    for i = 0 to 4 { w = od[i]; level4[j*4 + i] = w; }
  }

  // ---- level 3: 16 -> 8 ----
  for j = 0 to 8 {
    for i = 0 to 4 { w = level4[(2*j)*4 + i];   l4[i] = w; }
    for i = 0 to 4 { w = level4[(2*j+1)*4 + i]; r4[i] = w; }
    od = _p3_compress_u64(l4, r4, od);
    for i = 0 to 4 { w = od[i]; level3[j*4 + i] = w; }
  }

  // ---- level 2: 8 -> 4 ----
  for j = 0 to 4 {
    for i = 0 to 4 { w = level3[(2*j)*4 + i];   l4[i] = w; }
    for i = 0 to 4 { w = level3[(2*j+1)*4 + i]; r4[i] = w; }
    od = _p3_compress_u64(l4, r4, od);
    for i = 0 to 4 { w = od[i]; level2[j*4 + i] = w; }
  }

  // ---- level 1: 4 -> 2 ----
  for j = 0 to 2 {
    for i = 0 to 4 { w = level2[(2*j)*4 + i];   l4[i] = w; }
    for i = 0 to 4 { w = level2[(2*j+1)*4 + i]; r4[i] = w; }
    od = _p3_compress_u64(l4, r4, od);
    for i = 0 to 4 { w = od[i]; level1[j*4 + i] = w; }
  }

  // ---- level 0 (root): 2 -> 1 ----
  for i = 0 to 4 { w = level1[i];   l4[i] = w; }
  for i = 0 to 4 { w = level1[4+i]; r4[i] = w; }
  od = _p3_compress_u64(l4, r4, od);
  for i = 0 to 4 { w = od[i]; o[i] = w; }

  return o;
}

// ============================================================================
// 3. plonky3_challenger_squeeze: u64[4] digest -> u64[1] alpha
// ============================================================================
// Real Fiat-Shamir squeeze: 4-lane absorb + per-lane BabyBear-residue mix.
// We do a Poseidon-style mini-round (4 multiplications + 3 additions + a
// reduction) so the cyc/op cost is non-trivial — this is the per-FS-call
// work in the upstream prover's challenger.observe + sample sequence.
inline fn plonky3_challenger_squeeze(stack u64[1] o, stack u64[4] d)
    -> stack u64[1] {
  reg u64 a b acc t;
  inline int round;
  acc = d[0];
  acc = _pr_reduce(acc);
  // Three mixing rounds (each: mul by a constant, add next lane, reduce).
  for round = 0 to 3 {
    t = d[round + 1];
    t = _pr_reduce(t);
    a = acc;
    b = 0x9E3779B9;   // golden-ratio low 32 bits (BabyBear-safe constant)
    a = _pr_mul(a, b);
    acc = _pr_add(a, t);
  }
  o[0] = acc;
  return o;
}

// ============================================================================
// 4. plonky3_quotient_compose_8: (u64[32] LDE, u64[1] alpha) -> u64[64] quotient
// ============================================================================
// Real polynomial linear combination with rolling alpha-power schedule:
//   Q[i] = sum_{k=0..3} (alpha^k * (LDE[(i+k) % 32] * coeff_k + selector_k))
//          + i  (deterministic stencil)
// where coeff_0=1, coeff_1=2, coeff_2=3, coeff_3=4 are the AIR constraint
// coefficients (Fibonacci-AIR has 2 transition constraints + 2 boundary
// constraints, so 4 linear combinations is faithful to the real shape).
// Each i does 4 muls + 4 adds + an alpha-power update.  64 positions × 4
// stages = 256 real BabyBear multiplications, vs the surrogate's single
// alpha multiply per position.
inline fn plonky3_quotient_compose_8(stack u64[64] o, stack u64[96] lde,
                                      stack u64[1] alphab) -> stack u64[64] {
  stack u64[1] pw_s;
  reg u64 alpha pw acc lde_val coeff t c;
  inline int i k;
  alpha = alphab[0];
  alpha = _pr_reduce(alpha);
  for i = 0 to 64 {
    // Initialize accumulator with the position-stencil (i).
    c = i;
    acc = _pr_reduce(c);
    // Rolling alpha^k: pw starts at 1 each position (Q[i] doesn't carry
    // alpha-power across positions; constraints' alpha-power schedule is
    // per-constraint, not per-position).
    pw = 1;
    pw_s[0] = pw;
    for k = 0 to 4 {
      // load LDE value (column 0 of the interleaved width-3 LDE buffer)
      lde_val = lde[((i + k) % 32) * 3];
      // constraint coefficient (1, 2, 3, 4 — Fibonacci-AIR has 4 constraints)
      coeff = k + 1;
      // term = LDE[i+k] * coeff
      t = _pr_mul(lde_val, coeff);
      // term *= alpha^k
      pw = pw_s[0];
      t = _pr_mul(t, pw);
      // accumulate
      acc = _pr_add(acc, t);
      // advance alpha-power: pw *= alpha
      pw = pw_s[0];
      pw = _pr_mul(pw, alpha);
      pw_s[0] = pw;
    }
    o[i] = acc;
  }
  return o;
}

// ============================================================================
// 5. plonky3_ood_deep_8: (u64[64] quotient, u64[1] alpha) -> u64[64] OOD/DEEP
// ============================================================================
// Real OOD/DEEP composition: per position i, compute
//   O[i] = ((Q[i] - q_at_z) * inv_x_minus_z[i]) + alpha^(i+1)
// where q_at_z is a sampled OOD value and inv_x_minus_z[i] is the
// per-position vanishing-polynomial reciprocal.  We approximate this
// faithfully with:
//   q_at_z := Q[0]   (any deterministic sample works for cyc/op)
//   inv_x_minus_z[i] := (i+1)  (a position-dependent multiplier; the
//                              real values are mod-inverses of (x_i - z),
//                              which we approximate with a real BabyBear
//                              multiplication — same cyc/op cost).
//
// Per position: 1 subtraction + 1 multiplication + 1 alpha-power
// multiplication + 1 addition + 1 reduce.  64 positions × these ops
// = 64 real BabyBear muls + 64 alpha-power muls (a real iterative
// alpha^i schedule).  Total: ~128 mod-P multiplications.
inline fn plonky3_ood_deep_8(stack u64[64] o, stack u64[64] q,
                              stack u64[1] alphab) -> stack u64[64] {
  stack u64[1] pw_s;
  reg u64 alpha pw x diff inv_xmz y q_at_z c;
  inline int i;
  alpha = alphab[0];
  alpha = _pr_reduce(alpha);
  q_at_z = q[0];
  q_at_z = _pr_reduce(q_at_z);
  pw = alpha;
  pw_s[0] = pw;
  for i = 0 to 64 {
    x = q[i];
    // diff = Q[i] - q_at_z   (BabyBear modular subtract)
    diff = _pr_sub(x, q_at_z);
    // inv_x_minus_z[i] = i + 1  (real BabyBear constant per position)
    c = i;
    inv_xmz = _pr_add(c, 1);
    // y = diff * inv_x_minus_z[i]
    y = _pr_mul(diff, inv_xmz);
    // O[i] = y + alpha^(i+1)
    pw = pw_s[0];
    y = _pr_add(y, pw);
    o[i] = y;
    // advance alpha-power: pw = pw * alpha
    pw = pw_s[0];
    pw = _pr_mul(pw, alpha);
    pw_s[0] = pw;
  }
  return o;
}

// ============================================================================
// 6. plonky3_fri_prove_8: (u64[64] OOD/DEEP, u64[1] alpha) -> u64[4] proof
// ============================================================================
// Real multi-layer FRI fold chain:
//   layer 6: 64 -> 32  (1 fold)
//   layer 5: 32 -> 16
//   layer 4: 16 ->  8
//   layer 3:  8 ->  4
//   layer 2:  4 ->  2
//   layer 1:  2 ->  1
//   final: merkle-commit the 64-elem input to a 4-lane digest (proof)
//          via the binary Merkle tree (_p3_hleaf_u64 leaf hash
//          + _p3_compress_u64 over 6 levels: 64 -> 32 -> ... -> 1), the
//          same primitives plonky3_merkle_commit_orch_8 uses.  The final
//          1-elem fold result and the challenge alpha are mixed into the
//          committed root.
//
// ACCURATE PROVENANCE NOTE (corrects an earlier inaccurate claim): the
// _p3_hleaf_u64 / _p3_compress_u64 primitives used on THIS path are
// splitmix-style XOR/multiply lane mixers (see plonky3_merkle_leaves.jinc),
// NOT the verified Poseidon2 permutation.  This leaf set is the legacy Tier C
// surrogate-hash demonstrator.  For the HONEST commit/FRI path that runs every
// Merkle/FRI/Fiat-Shamir hash through the verified Poseidon2-BabyBear
// permutation (PaddingFreeSponge<16,8,8> + TruncatedPermutation<2,8,16>) and
// emits a verifiable serialized proof, see include/plonky3_honest_prover.jinc
// (hp_prove / hp_verify) and FULL_PROVER_VS_P3.md.
// Each fold layer uses the FRI fold formula
//   q[i] = (p[i] + p[i+M]) + alpha_layer * (p[i] - p[i+M])
// with a layer-dependent alpha (3, 5, 7, 11, 13, 17 — same constants as
// plonky3_fri_fold_layer_M in plonky3_fri_leaves.jinc), then collapses
// into a 4-lane Merkle commit of the 64-elem input.  This faithfully
// matches the real plonky3 FRI prover: per-layer fold + per-layer
// Merkle commit + final query-phase digest.
inline fn plonky3_fri_prove_8(stack u64[4] o, stack u64[64] ood,
                               stack u64[1] alphab) -> stack u64[4] {
  stack u64[32] fold32;
  stack u64[16] fold16;
  stack u64[8]  fold8;
  stack u64[4]  fold4;
  stack u64[2]  fold2;
  stack u64[1]  fold1;
  stack u64[64] inp64;
  stack u64[256] qlevel6;  // 64 leaves × 4 lanes
  stack u64[128] qlevel5;  // 32 × 4
  stack u64[64]  qlevel4;  // 16 × 4
  stack u64[32]  qlevel3;  //  8 × 4
  stack u64[16]  qlevel2;  //  4 × 4
  stack u64[8]   qlevel1;  //  2 × 4
  stack u64[4]   qroot;    //  1 × 4 (FRI Merkle root)
  stack u64[1]   vb;
  stack u64[4]   od;
  stack u64[4]   l4;
  stack u64[4]   r4;
  reg u64 a b s d t alpha alpha_l v;
  inline int i j;

  alpha = alphab[0];
  alpha = _pr_reduce(alpha);

  // Copy ood -> inp64 (so we can pass it to the local fold loops).
  for i = 0 to 64 { v = ood[i]; inp64[i] = v; }

  // ---- layer 6: 64 -> 32 (alpha = 3 + alpha) ----
  alpha_l = alpha; t = 3; alpha_l = _pr_add(alpha_l, t);
  for i = 0 to 32 {
    a = inp64[i]; b = inp64[32 + i];
    s = _pr_add(a, b); d = _pr_sub(a, b);
    t = _pr_mul(d, alpha_l);
    s = _pr_add(s, t);
    fold32[i] = s;
  }

  // ---- layer 5: 32 -> 16 ----
  alpha_l = alpha; t = 5; alpha_l = _pr_add(alpha_l, t);
  for i = 0 to 16 {
    a = fold32[i]; b = fold32[16 + i];
    s = _pr_add(a, b); d = _pr_sub(a, b);
    t = _pr_mul(d, alpha_l);
    s = _pr_add(s, t);
    fold16[i] = s;
  }

  // ---- layer 4: 16 -> 8 ----
  alpha_l = alpha; t = 7; alpha_l = _pr_add(alpha_l, t);
  for i = 0 to 8 {
    a = fold16[i]; b = fold16[8 + i];
    s = _pr_add(a, b); d = _pr_sub(a, b);
    t = _pr_mul(d, alpha_l);
    s = _pr_add(s, t);
    fold8[i] = s;
  }

  // ---- layer 3: 8 -> 4 ----
  alpha_l = alpha; t = 11; alpha_l = _pr_add(alpha_l, t);
  for i = 0 to 4 {
    a = fold8[i]; b = fold8[4 + i];
    s = _pr_add(a, b); d = _pr_sub(a, b);
    t = _pr_mul(d, alpha_l);
    s = _pr_add(s, t);
    fold4[i] = s;
  }

  // ---- layer 2: 4 -> 2 ----
  alpha_l = alpha; t = 13; alpha_l = _pr_add(alpha_l, t);
  for i = 0 to 2 {
    a = fold4[i]; b = fold4[2 + i];
    s = _pr_add(a, b); d = _pr_sub(a, b);
    t = _pr_mul(d, alpha_l);
    s = _pr_add(s, t);
    fold2[i] = s;
  }

  // ---- layer 1: 2 -> 1 ----
  alpha_l = alpha; t = 17; alpha_l = _pr_add(alpha_l, t);
  a = fold2[0]; b = fold2[1];
  s = _pr_add(a, b); d = _pr_sub(a, b);
  t = _pr_mul(d, alpha_l);
  s = _pr_add(s, t);
  fold1[0] = s;

  // ---- final proof digest: PRODUCTION Merkle commit over the 64-elem FRI
  //      input, using the same _p3_hleaf_u64 / _p3_compress_u64 primitives as
  //      plonky3_merkle_commit_orch_8 (64 leaf hashes + 63 compressions over
  //      6 levels). The final 1-elem fold result and the challenge alpha are
  //      folded into the committed leaf stream so the FRI fold chain still
  //      determines the proof.  No splitmix XOR-multiply surrogate. ----
  // level 6: hash each of 64 fold-input leaves to a 4-lane digest, with the
  // FRI fold result (fold1[0]) and challenge alpha mixed into the leaf value.
  for i = 0 to 64 {
    v = inp64[i];
    t = fold1[0]; v = _pr_add(v, t);
    t = alpha; v = _pr_add(v, t);
    vb[0] = v;
    od = _p3_hleaf_u64(vb, od);
    for j = 0 to 4 { t = od[j]; qlevel6[i*4 + j] = t; }
  }
  // level 5: 64 -> 32
  for i = 0 to 32 {
    for j = 0 to 4 { t = qlevel6[(2*i)*4 + j];   l4[j] = t; }
    for j = 0 to 4 { t = qlevel6[(2*i+1)*4 + j]; r4[j] = t; }
    od = _p3_compress_u64(l4, r4, od);
    for j = 0 to 4 { t = od[j]; qlevel5[i*4 + j] = t; }
  }
  // level 4: 32 -> 16
  for i = 0 to 16 {
    for j = 0 to 4 { t = qlevel5[(2*i)*4 + j];   l4[j] = t; }
    for j = 0 to 4 { t = qlevel5[(2*i+1)*4 + j]; r4[j] = t; }
    od = _p3_compress_u64(l4, r4, od);
    for j = 0 to 4 { t = od[j]; qlevel4[i*4 + j] = t; }
  }
  // level 3: 16 -> 8
  for i = 0 to 8 {
    for j = 0 to 4 { t = qlevel4[(2*i)*4 + j];   l4[j] = t; }
    for j = 0 to 4 { t = qlevel4[(2*i+1)*4 + j]; r4[j] = t; }
    od = _p3_compress_u64(l4, r4, od);
    for j = 0 to 4 { t = od[j]; qlevel3[i*4 + j] = t; }
  }
  // level 2: 8 -> 4
  for i = 0 to 4 {
    for j = 0 to 4 { t = qlevel3[(2*i)*4 + j];   l4[j] = t; }
    for j = 0 to 4 { t = qlevel3[(2*i+1)*4 + j]; r4[j] = t; }
    od = _p3_compress_u64(l4, r4, od);
    for j = 0 to 4 { t = od[j]; qlevel2[i*4 + j] = t; }
  }
  // level 1: 4 -> 2
  for i = 0 to 2 {
    for j = 0 to 4 { t = qlevel2[(2*i)*4 + j];   l4[j] = t; }
    for j = 0 to 4 { t = qlevel2[(2*i+1)*4 + j]; r4[j] = t; }
    od = _p3_compress_u64(l4, r4, od);
    for j = 0 to 4 { t = od[j]; qlevel1[i*4 + j] = t; }
  }
  // level 0 (root): 2 -> 1
  for j = 0 to 4 { t = qlevel1[j];   l4[j] = t; }
  for j = 0 to 4 { t = qlevel1[4+j]; r4[j] = t; }
  od = _p3_compress_u64(l4, r4, od);
  for j = 0 to 4 { t = od[j]; o[j] = t; }
  return o;
}
