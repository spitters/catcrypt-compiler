inline fn plonky3_merkle_hash_leaves_1024(stack u64[1024] a0) -> stack u64[4096] {
  stack u64[4096] r;
  return r;
}

inline fn plonky3_merkle_level_512(stack u64[4096] a0) -> stack u64[2048] {
  stack u64[2048] r;
  return r;
}

inline fn plonky3_merkle_level_256(stack u64[2048] a0) -> stack u64[1024] {
  stack u64[1024] r;
  return r;
}

inline fn plonky3_merkle_level_128(stack u64[1024] a0) -> stack u64[512] {
  stack u64[512] r;
  return r;
}

inline fn plonky3_merkle_level_64(stack u64[512] a0) -> stack u64[256] {
  stack u64[256] r;
  return r;
}

inline fn plonky3_merkle_level_32(stack u64[256] a0) -> stack u64[128] {
  stack u64[128] r;
  return r;
}

inline fn plonky3_merkle_level_16(stack u64[128] a0) -> stack u64[64] {
  stack u64[64] r;
  return r;
}

inline fn plonky3_merkle_level_8(stack u64[64] a0) -> stack u64[32] {
  stack u64[32] r;
  return r;
}

inline fn plonky3_merkle_level_4(stack u64[32] a0) -> stack u64[16] {
  stack u64[16] r;
  return r;
}

inline fn plonky3_merkle_level_2(stack u64[16] a0) -> stack u64[8] {
