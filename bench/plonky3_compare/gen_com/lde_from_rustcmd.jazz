export fn plonky3_lde_coset_fft_256x4_rc(reg ptr u64[1024] out, reg const ptr u64[256] p0) -> reg ptr u64[1024] {
  stack u64[256] s0;
  stack u64[256] t0;
  stack u64[1024] t1;
  stack u64[1024] t2;
  stack u64[1024] t3;
  inline int k;
  for k = 0 to 256 { s0[k] = p0[k]; }
  t0 = babybear_ntt_inverse_256(t0, s0);
  t1 = babybear_zero_extend_256_to_1024(t1, t0);
  t2 = babybear_coset_twist_1024(t2, t1);
  t3 = babybear_ntt_forward_1024(t3, t2);
  for k = 0 to 1024 { out[k] = t3[k]; }
  return out;
}