require "../include/plonky3_fri_leaves.jinc"

export fn plonky3_fri_prover_1024_rc(reg ptr u64[4] out, reg const ptr u64[1024] p0) -> reg ptr u64[4] {
  stack u64[1024] s0;
  stack u64[4] t0;
  stack u64[1] t1;
  stack u64[512] t2;
  stack u64[4] t3;
  stack u64[1] t4;
  stack u64[256] t5;
  stack u64[4] t6;
  stack u64[1] t7;
  stack u64[128] t8;
  stack u64[4] t9;
  stack u64[1] t10;
  stack u64[64] t11;
  stack u64[4] t12;
  stack u64[1] t13;
  stack u64[32] t14;
  stack u64[4] t15;
  stack u64[1] t16;
  stack u64[16] t17;
  stack u64[4] t18;
  stack u64[1] t19;
  stack u64[8] t20;
  stack u64[4] t21;
  stack u64[1] t22;
  stack u64[4] t23;
  stack u64[4] t24;
  stack u64[1] t25;
  stack u64[2] t26;
  stack u64[4] t27;
  stack u64[1] t28;
  stack u64[1] t29;
  stack u64[4] t30;
  stack u64[4] t31;
  inline int k;
  for k = 0 to 1024 { s0[k] = p0[k]; }
  t0 = plonky3_fri_merkle_commit_1024(t0, s0);
  t1 = plonky3_fri_challenger_squeeze(t1, t0);
  t2 = plonky3_fri_fold_layer_512(t2, s0);
  t3 = plonky3_fri_merkle_commit_512(t3, t2);
  t4 = plonky3_fri_challenger_squeeze(t4, t3);
  t5 = plonky3_fri_fold_layer_256(t5, t2);
  t6 = plonky3_fri_merkle_commit_256(t6, t5);
  t7 = plonky3_fri_challenger_squeeze(t7, t6);
  t8 = plonky3_fri_fold_layer_128(t8, t5);
  t9 = plonky3_fri_merkle_commit_128(t9, t8);
  t10 = plonky3_fri_challenger_squeeze(t10, t9);
  t11 = plonky3_fri_fold_layer_64(t11, t8);
  t12 = plonky3_fri_merkle_commit_64(t12, t11);
  t13 = plonky3_fri_challenger_squeeze(t13, t12);
  t14 = plonky3_fri_fold_layer_32(t14, t11);
  t15 = plonky3_fri_merkle_commit_32(t15, t14);
  t16 = plonky3_fri_challenger_squeeze(t16, t15);
  t17 = plonky3_fri_fold_layer_16(t17, t14);
  t18 = plonky3_fri_merkle_commit_16(t18, t17);
  t19 = plonky3_fri_challenger_squeeze(t19, t18);
  t20 = plonky3_fri_fold_layer_8(t20, t17);
  t21 = plonky3_fri_merkle_commit_8(t21, t20);
  t22 = plonky3_fri_challenger_squeeze(t22, t21);
  t23 = plonky3_fri_fold_layer_4(t23, t20);
  t24 = plonky3_fri_merkle_commit_4(t24, t23);
  t25 = plonky3_fri_challenger_squeeze(t25, t24);
  t26 = plonky3_fri_fold_layer_2(t26, t23);
  t27 = plonky3_fri_merkle_commit_2(t27, t26);
  t28 = plonky3_fri_challenger_squeeze(t28, t27);
  t29 = plonky3_fri_fold_layer_1(t29, t26);
  t30 = plonky3_fri_merkle_commit_1(t30, t29);
  t31 = plonky3_fri_query_phase_1024(t31, t30);
  for k = 0 to 4 { out[k] = t31[k]; }
  return out;
}
