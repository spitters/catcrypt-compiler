export fn plonky3_fri_prover_4_rc(reg ptr u64[4] out, reg const ptr u64[4] p0) -> reg ptr u64[4] {
  stack u64[4] s0;
  stack u64[4] t0;
  stack u64[1] t1;
  stack u64[2] t2;
  stack u64[4] t3;
  stack u64[1] t4;
  stack u64[1] t5;
  stack u64[4] t6;
  stack u64[4] t7;
  inline int k;
  for k = 0 to 4 { s0[k] = p0[k]; }
  t0 = plonky3_fri_merkle_commit_4(t0, s0);
  t1 = plonky3_fri_challenger_squeeze(t1, t0);
  t2 = plonky3_fri_fold_layer_2(t2, s0);
  t3 = plonky3_fri_merkle_commit_2(t3, t2);
  t4 = plonky3_fri_challenger_squeeze(t4, t3);
  t5 = plonky3_fri_fold_layer_1(t5, t2);
  t6 = plonky3_fri_merkle_commit_1(t6, t5);
  t7 = plonky3_fri_query_phase_4(t7, t6);
  for k = 0 to 4 { out[k] = t7[k]; }
  return out;
}