export fn plonky3_merkle_build_root_2_rc(reg ptr u64[4] out, reg const ptr u64[2] p0) -> reg ptr u64[4] {
  stack u64[2] s0;
  stack u64[8] t0;
  stack u64[4] t1;
  stack u64[4] t2;
  inline int k;
  for k = 0 to 2 { s0[k] = p0[k]; }
  t0 = plonky3_merkle_hash_leaves_2(t0, s0);
  t1 = plonky3_merkle_level_1(t1, t0);
  t2 = plonky3_merkle_extract_root(t2, t1);
  for k = 0 to 4 { out[k] = t2[k]; }
  return out;
}