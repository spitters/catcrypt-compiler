export fn plonky3_merkle_build_root_4_rc(reg ptr u64[4] out, reg const ptr u64[4] p0) -> reg ptr u64[4] {
  stack u64[4] s0;
  stack u64[16] t0;
  stack u64[8] t1;
  stack u64[4] t2;
  stack u64[4] t3;
  inline int k;
  for k = 0 to 4 { s0[k] = p0[k]; }
  t0 = plonky3_merkle_hash_leaves_4(t0, s0);
  t1 = plonky3_merkle_level_2(t1, t0);
  t2 = plonky3_merkle_level_1(t2, t1);
  t3 = plonky3_merkle_extract_root(t3, t2);
  for k = 0 to 4 { out[k] = t3[k]; }
  return out;
}