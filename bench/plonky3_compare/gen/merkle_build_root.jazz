/* Plonky3 Merkle-tree commitment (layer 1 of the STARK chain, #154),
 * emitted by CatCrypt's verified front
 * (CatCrypt/Crypto/SecureCompilation/VIR/Plonky3MerkleEmit.lean).
 * Pure u8 byte arithmetic; NO opaque leaf. Hash byte-identical to the
 * reference plonky3-hax/src/specs/merkle.rs (FRI layer commitment hash).
 * KAT: kat_merkle_build_root_four / kat_hash_two_to_one_constant_inputs. */

inline fn hleaf(reg ptr u8[8] vb, reg ptr u8[32] o) -> reg ptr u8[32] {
  stack u8[32] inp; reg u8 t prev x;
  inline int i k m;
  for i = 0 to 32 { inp[i] = 0; }
  for i = 0 to 8 { x = vb[i]; inp[i + 1] = x; }
  for k = 0 to 32 {
    t = inp[k]; t += 0x37; t *= 0xBF;
    x = inp[(k + 7) % 32];
    t ^= x; o[k] = t;
  }
  for m = 1 to 32 {
    prev = o[m - 1]; prev *= 0xA3;
    t = o[m]; t += prev; o[m] = t;
  }
  return o;
}

inline fn h2to1(reg ptr u8[32] l, reg ptr u8[32] r, reg ptr u8[32] o)
    -> reg ptr u8[32] {
  reg u8 a b t prev;
  inline int i j;
  for i = 0 to 32 {
    a = l[i]; b = r[i];
    t = a; t += b; t *= 0x9E; t += i;
    t ^= (a * 0x6D);
    t ^= b;
    o[i] = t;
  }
  for j = 1 to 32 {
    prev = o[j - 1]; prev *= 0xC5;
    t = o[j]; t ^= prev; o[j] = t;
  }
  return o;
}

export fn merkle_build_root(reg ptr u8[32768] leaves, reg u64 num_leaves,
    reg ptr u8[32] root) -> reg ptr u8[32] {
  stack u8[32768] buf;
  reg u64 width half j src2 dst;
  reg u8 x;
  inline int b;
  width = num_leaves;
  // (caller pre-loads buf with the leaf hashes)
  while (width > 1) {
    half = width; half >>= 1;
    for j = 0 to half {
      // parent[j] = h2to1(buf[2j], buf[2j+1]) — one lane of the level map
      // (lane-parallel; covered by merkleLevel_denotation_preserves)
      src2 = j; src2 <<= 1;
      buf[32 * j : 32] = h2to1(buf[32 * src2 : 32],
                               buf[32 * (src2 + 1) : 32], buf[32 * j : 32]);
    }
    width = half;
  }
  for b = 0 to 32 { x = buf[b]; root[b] = x; }
  return root;
}

