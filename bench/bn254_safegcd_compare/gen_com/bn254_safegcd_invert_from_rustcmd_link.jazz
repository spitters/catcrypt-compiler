require "../include/bn254_safegcd_leaves.jinc"

export fn bn254_safegcd_invert_rustcmd(reg ptr u64[4] out, reg const ptr u64[4] p0) -> reg ptr u64[4] {
  stack u64[4] s0;
  stack u64[4] t0;
  inline int k;
  for k = 0 to 4 { s0[k] = p0[k]; }
  t0 = safegcd_bn254_invert(t0, s0);
  for k = 0 to 4 { out[k] = t0[k]; }
  return out;
}