/*
 * BN254 (alt-bn128) group + pairing leaves the emitted kernels call.
 *
 *   bn254_g1_scalar_mul(k, P) = k * P  (G1 per-term op)   k:u8[32] P:u8[64]  -> u8[64]
 *   bn254_g1_add(P, Q)        = P + Q  (G1 accumulating op) P,Q:u8[64]        -> u8[64]
 *   bn254_g2_scalar_mul, bn254_g2_add  (G2 analogues on u8[128] points)
 *   bn254_pairing(P, Q)       = e(P, Q) (Miller loop + final exp) P:u8[64] Q:u8[128] -> u8[384]
 *   bn254_fp12_mul(a, b)      = a * b  (GT/Fp12 product)   a,b:u8[384]        -> u8[384]
 *
 * These are the LEAF EDGE of CatCrypt.Crypto.Pairing.Bn254Emit: the agreements
 * EcLeafAgrees / PairingLeavesAgree tie the opaque extCall leaves to the abstract
 * BN254 primitives.  The PRODUCTION witness is the AUCurves verified-bedrock2
 * BN254 tower (bn254-safe-rust: the extracted Fp/Fp2/Fp6/Fp12 tower over the
 * verified fiat leaves, plus pairing_optimal + fp12_mul).  AUCurves verifies the
 * FIELD/PAIRING tower; the G1/G2 group add law stays trusted.  These jasmin
 * bodies are STRUCTURAL stubs whose only purpose is to let jasminc type and
 * compile the emitted kernels over the production widths (Fp = 32 bytes, G1 = 64,
 * G2 = 128, Fp12 = 384); the byte-identical KAT against the verified reference
 * runs in Rust against the bn254 crate (bn254_kat), anchored to the published
 * EIP-196 / EIP-197 vectors.
 *
 * Each stub returns one of its pointer arguments (the jasmin reg-ptr discipline).
 */

fn bn254_g1_scalar_mul(reg ptr u8[32] k, reg ptr u8[64] P) -> reg ptr u8[64] {
  reg u8 t;
  inline int j;
  for j = 0 to 64 { t = P[j]; P[j] = t; }
  return P;
}

fn bn254_g1_add(reg ptr u8[64] P, reg ptr u8[64] Q) -> reg ptr u8[64] {
  reg u8 t;
  inline int j;
  for j = 0 to 64 { t = Q[j]; P[j] = t; }
  return P;
}

fn bn254_g2_scalar_mul(reg ptr u8[32] k, reg ptr u8[128] P) -> reg ptr u8[128] {
  reg u8 t;
  inline int j;
  for j = 0 to 128 { t = P[j]; P[j] = t; }
  return P;
}

fn bn254_g2_add(reg ptr u8[128] P, reg ptr u8[128] Q) -> reg ptr u8[128] {
  reg u8 t;
  inline int j;
  for j = 0 to 128 { t = Q[j]; P[j] = t; }
  return P;
}

fn bn254_pairing(reg ptr u8[384] out, reg ptr u8[64] P, reg ptr u8[128] Q) -> reg ptr u8[384] {
  reg u8 t;
  inline int j;
  for j = 0 to 64  { t = P[j]; out[j] = t; }
  for j = 0 to 128 { t = Q[j]; out[64 + j] = t; }
  return out;
}

fn bn254_fp12_mul(reg ptr u8[384] a, reg ptr u8[384] b) -> reg ptr u8[384] {
  reg u8 t;
  inline int j;
  for j = 0 to 384 { t = b[j]; a[j] = t; }
  return a;
}
