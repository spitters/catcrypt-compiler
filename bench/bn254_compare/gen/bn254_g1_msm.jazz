export fn bn254_g1_msm(reg ptr u8[64] out, reg const ptr u8[128] ks, reg const ptr u8[256] ps) -> reg ptr u8[64] {
  stack u8[64] acc;
  stack u8[64] psi;
  stack u8[32] ksi;
  inline int i;
  inline int j;
  for j = 0 to 64 { acc[j] = 0; }
  for i = 0 to 4 {
    for j = 0 to 32 { ksi[j] = ks[32 * i + j]; }
    for j = 0 to 64 { psi[j] = ps[64 * i + j]; }
    psi = bn254_g1_scalar_mul(ksi, psi);
    acc = bn254_g1_add(acc, psi);
  }
  for j = 0 to 64 { out[j] = acc[j]; }
  return out;
}
