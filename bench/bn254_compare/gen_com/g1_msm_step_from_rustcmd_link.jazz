require "../include/bn254_leaves.jinc"

export fn bn254_g1_msm_step_rustcmd(reg ptr u64[8] out, reg const ptr u64[8] p0, reg const ptr u64[4] p1, reg const ptr u64[8] p2) -> reg ptr u64[8] {
  stack u64[8] s0;
  stack u64[4] s1;
  stack u64[8] s2;
  stack u64[8] t0;
  stack u64[8] t1;
  inline int k;
  for k = 0 to 8 { s0[k] = p0[k]; }
  for k = 0 to 4 { s1[k] = p1[k]; }
  for k = 0 to 8 { s2[k] = p2[k]; }
  t0 = bn254_g1_scalar_mul(t0, s1, s2);
  t1 = bn254_g1_add(t1, s0, t0);
  for k = 0 to 8 { out[k] = t1[k]; }
  return out;
}