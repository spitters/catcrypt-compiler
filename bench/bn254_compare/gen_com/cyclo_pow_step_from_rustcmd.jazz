export fn bn254_cyclo_pow_step(reg ptr u64[48] out, reg const ptr u64[48] p0, reg const ptr u64[48] p1) -> reg ptr u64[48] {
  stack u64[48] s0;
  stack u64[48] s1;
  stack u64[48] t0;
  stack u64[48] t1;
  inline int k;
  for k = 0 to 48 { s0[k] = p0[k]; }
  for k = 0 to 48 { s1[k] = p1[k]; }
  t0 = bn254_Fp12_cyclotomic_square(t0, s0);
  t1 = bn254_fp12_mul(t1, t0, s1);
  for k = 0 to 48 { out[k] = t1[k]; }
  return out;
}