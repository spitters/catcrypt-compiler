// BN254 (alt-bn128) leaf implementations for the rustcmd-emitted orchestrations
// (gen_com/g1_msm_step_from_rustcmd.jazz, gen_com/eip197_from_rustcmd.jazz).
//
// Encoding (on-wire widths; matches the legacy bn254_leaves.jinc + bn254 crate):
//   bn254_g1_scalar_mul     takes u8[32] scalar + u8[64] G1 point, returns u8[64]
//   bn254_g1_add            takes two u8[64] G1 points, returns u8[64]
//   bn254_pairing           takes u8[64] G1 + u8[128] G2, writes u8[384] Fp12
//   bn254_fp12_mul          takes two u8[384] Fp12, returns u8[384]
//
// The rustcmd-emitted orchestration emits these as reg-ptr leaf calls; the leaf
// bodies below are STRUCTURAL stubs so jasminc type-checks and compiles the
// orchestration. The byte-identical KAT against the verified reference runs in
// Rust against the bn254 crate (bn254_kat), anchored to the published EIP-196
// / EIP-197 test vectors.
//
// PRODUCTION witness: AUCurves verified-bedrock2 BN254 tower (bn254-safe-rust):
// the extracted Fp/Fp2/Fp6/Fp12 tower over verified fiat leaves, plus
// pairing_optimal + fp12_mul. AUCurves verifies the FIELD/PAIRING tower; the
// G1/G2 group add law stays trusted (same hybrid contract as BLS12-381).
//
// Hax bridge status: per AUDIT_HAX_BRIDGE.md, NO bn254-hax/ tree exists. The
// drivers carry a named hypothesis BN254LeanSpecCorrect (Lean spec ↔ KAT
// vector tie-in) instead of a Rust-spec bridge.

inline fn bn254_g1_scalar_mul(
    reg ptr u8[64] dst,
    reg ptr u8[32] k,
    reg ptr u8[64] P
  ) -> reg ptr u8[64] {
  reg u8 t;
  inline int j;
  for j = 0 to 64 { t = P[j]; dst[j] = t; }
  return dst;
}

inline fn bn254_g1_add(
    reg ptr u8[64] dst,
    reg ptr u8[64] P,
    reg ptr u8[64] Q
  ) -> reg ptr u8[64] {
  reg u8 t;
  inline int j;
  for j = 0 to 64 { t = P[j]; dst[j] = t; }
  return dst;
}

inline fn bn254_pairing(
    reg ptr u8[384] dst,
    reg ptr u8[64] P,
    reg ptr u8[128] Q
  ) -> reg ptr u8[384] {
  reg u8 t;
  inline int j;
  for j = 0 to 64  { t = P[j]; dst[j] = t; }
  for j = 0 to 128 { t = Q[j]; dst[64 + j] = t; }
  for j = 192 to 384 { dst[j] = 0; }
  return dst;
}

inline fn bn254_fp12_mul(
    reg ptr u8[384] dst,
    reg ptr u8[384] a,
    reg ptr u8[384] b
  ) -> reg ptr u8[384] {
  reg u8 t;
  inline int j;
  for j = 0 to 384 { t = a[j]; dst[j] = t; }
  return dst;
}
