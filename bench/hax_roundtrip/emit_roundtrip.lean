import CatCrypt.Crypto.Hax.ImpRustHaxCheck

/-!
Emit driver for `bench/hax_roundtrip/crate`: prints `roundTripImp`
(`CatCrypt.Crypto.Hax.ImpRustHaxCheck`) with `ppImpRustFn` as the Rust function
`roundtrip_prog`, and writes it with a stub of its leaf `fp_mul` to
`bench/hax_roundtrip/crate/src/lib.rs`.  The stub is a crate function, so the
hax frontend reads each call to it as a call of the name `fp_mul`.  Run from the
compiler repository root with `lake env lean --run`.
-/

open CatCrypt.Crypto.Hax

/-- The crate attributes and the leaf stub. -/
def libHeader : String :=
  "//! Generated by bench/hax_roundtrip/emit_roundtrip.lean; do not edit.\n" ++
  "#![allow(unused_mut, unused_variables, unused_assignments, dead_code, redundant_semicolons)]\n\n" ++
  "/// The leaf of the round-trip program; the check reads only its calls.\n" ++
  "pub fn fp_mul(a: [u64; 6], b: [u64; 6]) -> [u64; 6] {\n" ++
  "    let _ = b;\n" ++
  "    a\n" ++
  "}\n\n"

def main : IO Unit := do
  match ppImpRustFn "roundtrip_prog" roundTripParams roundTripTy roundTripImp with
  | none => throw (IO.userError "roundTripImp is outside the printed fragment")
  | some fnText =>
    IO.FS.createDirAll "bench/hax_roundtrip/crate/src"
    IO.FS.writeFile "bench/hax_roundtrip/crate/src/lib.rs" (libHeader ++ fnText)
    IO.println "wrote bench/hax_roundtrip/crate/src/lib.rs"
