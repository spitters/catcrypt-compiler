/.lake
/lake-manifest.json

# nested docs (Verso manual) build artifacts
docs/.lake/
docs/_out/
docs/lake-manifest.json

# lean-beam daemon state
/.beam/
/.beam.stale-*/

# Artifacts that the emit drivers write under bench/<kernel>/gen, gen_com and
# gen_ra when a module is elaborated or run. The artifacts re-included below are
# tracked.
/bench/*/gen/*
/bench/*/gen_com/*
/bench/*/gen_ra/*
!/bench/bls12_377_compare/gen_com/bls12_377_orch_owned.s
!/bench/bn254_fieldmul_compare/gen_com/bn254_mont_mul_x86_from_lean.s
!/bench/hmac_compare/gen/hmac_xor_pad.s
!/bench/hmac_compare/gen/sha256_compress.s
!/bench/x25519_fieldmul_compare/gen/fe25519_mul_proven.s
!/bench/p384_ecdsa_rust/gen/*.rs
!/bench/p384_ecdsa_rust/gen/PROVENANCE.md
/bench/p384_ecdsa_rust/target/
/bench/p384_ecdsa_rust/Cargo.lock
# The ZK benches (BN254, Pallas, M31, Goldilocks, MSM, Plonky3 and the ZK
# reference crates) track their Jasmin sources and byte dumps
# under gen/ and gen_com/.
!/bench/bn254_compare/gen/*.jazz
!/bench/bn254_compare/gen_com/*.jazz
!/bench/bn254_safegcd_compare/gen_com/*.jazz
!/bench/bytes_direct_pallas_fesub/gen/*.hex
!/bench/msm_compare/gen/msm.jazz
!/bench/msm_compare/gen_com/*.jazz
!/bench/pallas_compare/gen_com/*.jazz
!/bench/plonky3_compare/gen/*.jazz
!/bench/plonky3_compare/gen_com/*.jazz
# Build outputs of the bench Makefiles: compiled KAT and bench binaries,
# objects, the .s that jasminc writes next to the sources, and cargo outputs.
# Tracked binaries and link .s files are unaffected.
/bench/*/*.o
/bench/*/*/*.o
/bench/*/*.lprogbin
/bench/bls12381_msm_compare/*.s
/bench/bn254_compare/*.s
/bench/bn254_safegcd_compare/*.s
/bench/bytes_direct_pallas_fesub/*.s
/bench/goldilocks_fieldmul_compare/*.s
/bench/m31_compare/*.s
/bench/msm_compare/*.s
/bench/pallas_compare/*.s
/bench/plonky3_compare/*.s
/bench/poseidon2_linear_compare/*.s
/bench/*/*_kat
/bench/*/*_bench
/bench/*/*_from_rustcmd
/bench/*/bench_*
!/bench/*/bench_*.*
/bench/*/conform_*
!/bench/*/conform_*.*
/bench/*/Cargo.lock
/bench/*/shim/Cargo.lock
/bench/**/target/
!/bench/msm_compare/msm_term_rustcmd_link.s
!/bench/plonky3_compare/*_link.s
!/bench/pallas_compare/shim/Cargo.lock

# Generated by scripts/build-cost-ratchet.sh; a report, not an input.
/scripts/build-cost-tactics.tsv
