@[expose] public section

set_option autoImplicit false

/-!
# fiat-crypto WordByWordMontgomery field-multiply leaf over `Fp_{secp256k1}`

This module is the field-multiply leaf for the secp256k1 base prime
`p = 2^256 − 2^32 − 977`, wired into CatCrypt's verified front via the
extCall pattern (`Jasmin.LowCT` `RCall`), following the field-multiply leaf
shape of `Vale/PallasFieldMul.lean`. It replaces the slow SOS field-multiply
emit for the k256 base field with the proven CIOS kernel. The element is a
4×u64 = 32-byte saturated little-endian Montgomery buffer.

## Value grounding

`Secp256k1_fmul_denote` is the Montgomery product `x · y · R⁻¹ mod p`,
`R = 2^256`, defined as `Number.montgomeryMul` at the secp256k1 base prime
(the modulus value `Cios4LimbProven.valLimbs secp256k1Limbs`, pinned to the
secp256k1 prime by `Cios4LimbProven.secp256k1Limbs_value`) and the full-radix
Montgomery constant `secp256k1Nprime256 = −p⁻¹ mod 2^256`
(`secp256k1Nprime256_pin`: `p · secp256k1Nprime256 ≡ −1 mod 2^256`).
`Secp256k1_fmul_denote_spec` gives its range (`< 2·p`) and congruence
(`· 2^256 ≡ x · y mod p`) from `Number.montgomeryMul_correct` — the same
value core the owned-x86 secp256k1 Montgomery-multiply kernel
`Curve4LimbTierA.secp256k1_emit_montmul_runBlock` proves for its emitted
`runBlock` output.

## The fiat-crypto / AUCurves provenance

* **fiat-rust source**: fiat-crypto's `fiat-rust/src/` (AUCurves)
  `secp256k1_montgomery_64.rs`, function `fiat_secp256k1_montgomery_mul`,
  generated by
  `word_by_word_montgomery --lang Rust secp256k1_montgomery 64 '2^256 - 2^32 - 977'`.
  Header modulus
  `m = 0xfffffffffffffffffffffffffffffffffffffffffffffffffffffffefffffc2f`
  = `115792089237316195423570985008687907853269984665640564039457584007908834671663`.
* **Safe-Rust wrapper + C ABI**: `secp256k1-safe-rust/src/lib.rs`,
  `fp_mul(out, x, y) = fiat_secp256k1_montgomery_mul(out, x, y)`, exported by
  `secp256k1-safe-rust/src/ffi.rs` as
  `#[no_mangle] pub unsafe extern "C" fn secp256k1_fp_mul(r, a, b)`.
* **Correctness (cross-prover)**: fiat-crypto's
  `Arithmetic/WordByWordMontgomery.v::mulmod_correct` (`Qed`) and its
  C-operation form `COperationSpecifications.v` module `WordByWordMontgomery`,
  `mul_correct`, instantiated at the secp256k1 prime.

## Leaf C signature

```c
extern void secp256k1_fp_mul(uint64_t out[4], const uint64_t x[4], const uint64_t y[4]);
```

That is: `out = x · y · R⁻¹ mod p_{secp256k1}`, `R = 2^256`, over
Montgomery-form 4×u64 saturated LE buffers (32 bytes per operand). The emitted
call site is `RCall "secp256k1_fp_mul"`, binding the C symbol (the fiat-crypto
`fiat_secp256k1_montgomery_mul` in the `secp256k1-safe-rust` staticlib); symbol
identity at link time is standard C-linker trust.
-/

namespace CatCrypt.Crypto.Vale.Secp256k1FieldMul

open CatCrypt.Crypto.Jasmin.LowCT
open CatCrypt.Crypto.Jasmin.LowCTReflect
open CatCrypt.Crypto.SecureCompilation.X86Backend.Cios4LimbProven
  (valLimbs secp256k1Limbs secp256k1Limbs_value)

/-! ## §1. The secp256k1 base prime and its full-radix Montgomery constant -/

/-- The secp256k1 base-field prime `p = 2^256 − 2^32 − 977`. -/
def secp256k1P : Nat := 2 ^ 256 - (2 ^ 32 + 977)

/-- `secp256k1P` is the modulus value of the CIOS twin's `native_decide`-pinned
    limbs (`Cios4LimbProven.secp256k1Limbs_value`). -/
theorem secp256k1P_eq_twin : secp256k1P = valLimbs secp256k1Limbs := by
  unfold secp256k1P; exact secp256k1Limbs_value.symm

/-- The full-radix Montgomery constant `−p⁻¹ mod 2^256` for secp256k1. -/
def secp256k1Nprime256 : Nat :=
  91248989341183975618893650062416139444822672217621753343178995607987479196977

/-- `p · secp256k1Nprime256 ≡ −1 (mod 2^256)` — the Montgomery-constant defining
    identity. -/
theorem secp256k1Nprime256_pin :
    (secp256k1P * secp256k1Nprime256) % 2 ^ 256 = 2 ^ 256 - 1 := by
  unfold secp256k1P secp256k1Nprime256; rfl

/-! ## §2. Surface type -/

/-- A secp256k1 `Fp` field element: the integer value in `[0, p)` of the 4×u64
    saturated LE Montgomery-form buffer (32 bytes). -/
abbrev Secp256k1Fp : Type := Nat

/-- Zero inhabitant. -/
def Secp256k1Fp.default : Secp256k1Fp := 0

/-! ## §3. The field-multiply denotation (grounded in the CIOS twin) -/

/-- **Denotation**: the fiat-crypto `fiat_secp256k1_montgomery_mul` leaf computes
    the secp256k1 base-field Montgomery multiplication `out = (x · y · R⁻¹) mod p`,
    `R = 2^256`. Defined as `Number.montgomeryMul` at the secp256k1 prime and
    `secp256k1Nprime256`; its value spec is `Secp256k1_fmul_denote_spec`. -/
def Secp256k1_fmul_denote (x y : Secp256k1Fp) : Secp256k1Fp :=
  CatCrypt.Crypto.Number.montgomeryMul secp256k1P (2 ^ 256) secp256k1Nprime256 x y

/-- **Value spec.** For reduced Montgomery-form inputs (`x, y < p`), the
    denotation lies in `[0, 2·p)` and satisfies `out · 2^256 ≡ x · y (mod p)`,
    i.e. `out ≡ x · y · R⁻¹ (mod p)`. Discharged by
    `Number.montgomeryMul_correct` — the value core of the owned-x86 secp256k1
    Montgomery-multiply kernel `Curve4LimbTierA.secp256k1_emit_montmul_runBlock`,
    and of fiat-crypto's `WordByWordMontgomery.mulmod_correct` at the secp256k1
    prime. -/
theorem Secp256k1_fmul_denote_spec (x y : Secp256k1Fp)
    (hx : x < secp256k1P) (hy : y < secp256k1P) :
    Secp256k1_fmul_denote x y < 2 * secp256k1P ∧
    (Secp256k1_fmul_denote x y) * 2 ^ 256 ≡ x * y [MOD secp256k1P] := by
  have hN : 0 < secp256k1P := by unfold secp256k1P; norm_num
  have hNleR : secp256k1P ≤ 2 ^ 256 := by unfold secp256k1P; norm_num
  exact CatCrypt.Crypto.Number.montgomeryMul_correct secp256k1P (2 ^ 256) secp256k1Nprime256
    x y hN (by norm_num) hNleR secp256k1Nprime256_pin hx hy

/-! ## §4. `@[rust_cmd_pattern]` registration -/

/-- Register `Secp256k1_fmul_denote` → leaf `secp256k1_fp_mul` (the
    `#[no_mangle] extern "C"` export of `fiat_secp256k1_montgomery_mul`). -/
@[rust_cmd_pattern]
def secp256k1FmulPattern : LowCTPattern where
  name      := "secp256k1_fp_mul"
  fnHead    := ``Secp256k1_fmul_denote
  arity     := 2
  towerType := .TBytes 32   -- 32-byte secp256k1 Fp Montgomery buffer (4×u64)

/-! ## §5. Tower-type abbreviation -/

/-- Tower type of a secp256k1 Fp element (`TBytes 32`, 4×u64 saturated
    Montgomery form). -/
def secp256k1FpTowerType : TowerType := .TBytes 32

/-! ## §6. `LeafSig` entry -/

/-- Per-leaf signature for `secp256k1_fp_mul`: no aliasing permitted
    (out / x / y distinct in the Rust signature). -/
def secp256k1FmulLeafSig : CatCrypt.Crypto.Jasmin.LeafSig where
  name        := "secp256k1_fp_mul"
  destAliasOk := []

/-! ## §7. Pure-Lean wrapper -/

/-- One secp256k1 `Fp` Montgomery-multiply invocation. -/
def secp256k1FmulLean (x y : Secp256k1Fp) : Secp256k1Fp :=
  Secp256k1_fmul_denote x y

/-! ## §8. Hand-built `LowCT` body (front-end input) -/

def loc (n : String) (t : TowerType) : Located :=
  { locVar := n, locSrc := t }

/-- The `LowCT` body for `secp256k1FmulLean`. Shape:
    `RSeq RSkip (RCall "secp256k1_fp_mul" __result [x, y])`. -/
def secp256k1FmulBody : LowCT :=
  let x_l      := loc "x"        secp256k1FpTowerType
  let y_l      := loc "y"        secp256k1FpTowerType
  let result_l := loc "__result" secp256k1FpTowerType
  .RSeq .RSkip
    (.RCall "secp256k1_fp_mul" result_l [x_l, y_l])

/-- `ReifiedFunc` bundle for the fiat-crypto secp256k1 field-multiply leaf. -/
def secp256k1FmulReified : ReifiedFunc :=
  { args    := [("x", secp256k1FpTowerType), ("y", secp256k1FpTowerType)]
    body    := secp256k1FmulBody
    retName := "__result" }

/-! ## §9. Inspection -/

#eval secp256k1FmulReified.args.map Prod.fst   -- [x, y]
#eval secp256k1FmulReified.args.length         -- 2
#eval secp256k1FmulReified.retName             -- __result

end CatCrypt.Crypto.Vale.Secp256k1FieldMul
