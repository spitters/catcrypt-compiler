set_option autoImplicit false

/-!
# fiat-crypto WordByWordMontgomery field-multiply leaf over `Fp_{Vesta}`

This module is the field-multiply leaf for the Vesta base prime
`p = 2^254 + 0x224698fc0994a8dd8c46eb2100000001`, wired into CatCrypt's
verified front via the extCall pattern (`Jasmin.LowCT` `RCall`), following
the field-multiply leaf shape of `Vale/BN254.lean`.

The companion `Vale/Vesta.lean` carries the Bernstein-Yang safegcd
inversion leaf; this module carries the Montgomery multiply. Vesta and
Pallas form the Pasta cycle (each prime is the other's scalar field); the
Pallas twin is `Vale/PallasFieldMul.lean`. Both are 4×u64 = 32 bytes; only
the prime constant differs.

## Value grounding

`Vesta_fmul_denote` is the Montgomery product `x · y · R⁻¹ mod p`,
`R = 2^256`, defined as `Number.montgomeryMul` at the Vesta base prime
(the modulus value `PastaBignumTierA.valLimbs vestaLimbs`, pinned to the Vesta
prime by `PastaBignumTierA.vestaLimbs_value`) and the
full-radix Montgomery constant `vestaNprime256 = −p⁻¹ mod 2^256`
(`vestaNprime256_pin`: `p · vestaNprime256 ≡ −1 mod 2^256`).
`Vesta_fmul_denote_spec` gives its range (`< 2·p`) and congruence
(`· 2^256 ≡ x · y mod p`) from `Number.montgomeryMul_correct` — the same
value core the owned-x86 Pasta Montgomery-multiply kernel
`PastaBignumTierA.vesta_emit_montmul_runBlock` proves for its emitted
`runBlock` output.

## The fiat-crypto / AUCurves provenance

* **fiat-rust source**: fiat-crypto's `fiat-rust/src/` (AUCurves)
  `vesta_64.rs`, function `fiat_vesta_mul`, generated by
  `word_by_word_montgomery --lang Rust vesta 64 '2^254 + 0x224698fc0994a8dd8c46eb2100000001'`.
  Header modulus
  `m = 0x40000000000000000000000000000000224698fc0994a8dd8c46eb2100000001`
  = `28948022309329048855892746252171976963363056481941647379679742748393362948097`.
* **Safe-Rust wrapper**: `vesta-safe-rust/src/lib.rs`,
  `fp_mul(out, x, y) = fiat_vesta_mul(out, x, y)`. The C ABI export
  binds as `vesta_fp_mul` (following the `pallas-safe-rust/src/ffi.rs`
  `#[no_mangle] extern "C"` convention).
* **Correctness (cross-prover)**: fiat-crypto's
  `Arithmetic/WordByWordMontgomery.v::mulmod_correct` (`Qed`) and its
  C-operation form `COperationSpecifications.v` module
  `WordByWordMontgomery`, `mul_correct`, instantiated at the Vesta
  prime (see `Vale/VestaFieldMulCoqAxioms.lean`).

## Leaf C signature

```c
extern void vesta_fp_mul(uint64_t out[4], const uint64_t x[4], const uint64_t y[4]);
```

That is: `out = x · y · R⁻¹ mod p_{Vesta}`, `R = 2^256`, over
Montgomery-form 4×u64 saturated LE buffers (32 bytes per operand). The
emitted call site is unchanged: `RCall "vesta_fp_mul"` binds the C symbol
(the fiat-crypto `fiat_vesta_mul` in the `vesta-safe-rust` staticlib);
symbol identity at link time is standard C-linker trust.
-/

namespace CatCrypt.Crypto.Vale.VestaFieldMul

open CatCrypt.Crypto.Jasmin.LowCT
open CatCrypt.Crypto.Jasmin.LowCTReflect
open CatCrypt.Crypto.SecureCompilation.X86Backend.Cios4LimbProven (valLimbs)
open CatCrypt.Crypto.SecureCompilation.X86Backend.PastaBignumTierA
  (vestaLimbs vestaLimbs_value)

/-! ## §1. The Vesta base prime and its full-radix Montgomery constant -/

/-- The Vesta base-field prime `p = 2^254 + 0x224698fc0994a8dd8c46eb2100000001`. -/
def vestaP : Nat := 2 ^ 254 + 0x224698fc0994a8dd8c46eb2100000001

/-- `vestaP` is the modulus value of the Pasta twin's `native_decide`-pinned
    limbs (`PastaBignumTierA.vestaLimbs_value`). -/
theorem vestaP_eq_twin : vestaP = valLimbs vestaLimbs := by
  unfold vestaP; exact vestaLimbs_value.symm

/-- The full-radix Montgomery constant `−p⁻¹ mod 2^256` for Vesta. -/
def vestaNprime256 : Nat :=
  56952820591381839841088906935506241190373694517665104195407146251032297734143

/-- `p · vestaNprime256 ≡ −1 (mod 2^256)` — the Montgomery-constant defining
    identity. -/
theorem vestaNprime256_pin :
    (vestaP * vestaNprime256) % 2 ^ 256 = 2 ^ 256 - 1 := by
  unfold vestaP vestaNprime256; rfl

/-! ## §2. Surface type -/

/-- A Vesta `Fp` field element: the integer value in `[0, p)` of the 4×u64
    saturated LE Montgomery-form buffer (32 bytes). -/
abbrev VestaFp : Type := Nat

/-- Zero inhabitant. -/
def VestaFp.default : VestaFp := 0

/-! ## §3. The field-multiply denotation (grounded in the Pasta twin) -/

/-- **Denotation**: the fiat-crypto `fiat_vesta_mul` leaf computes the Vesta
    base-field Montgomery multiplication `out = (x · y · R⁻¹) mod p`,
    `R = 2^256`. Defined as `Number.montgomeryMul` at the Vesta prime and
    `vestaNprime256`; its value spec is `Vesta_fmul_denote_spec`. -/
def Vesta_fmul_denote (x y : VestaFp) : VestaFp :=
  CatCrypt.Crypto.Number.montgomeryMul vestaP (2 ^ 256) vestaNprime256 x y

/-- **Value spec.** For reduced Montgomery-form inputs (`x, y < p`), the
    denotation lies in `[0, 2·p)` and satisfies `out · 2^256 ≡ x · y (mod p)`,
    i.e. `out ≡ x · y · R⁻¹ (mod p)`. Discharged by
    `Number.montgomeryMul_correct` — the value core of the owned-x86 Pasta
    Montgomery-multiply kernel `PastaBignumTierA.vesta_emit_montmul_runBlock`,
    and of fiat-crypto's `WordByWordMontgomery.mulmod_correct` at the Vesta
    prime. -/
theorem Vesta_fmul_denote_spec (x y : VestaFp)
    (hx : x < vestaP) (hy : y < vestaP) :
    Vesta_fmul_denote x y < 2 * vestaP ∧
    (Vesta_fmul_denote x y) * 2 ^ 256 ≡ x * y [MOD vestaP] := by
  have hN : 0 < vestaP := by unfold vestaP; norm_num
  have hNleR : vestaP ≤ 2 ^ 256 := by unfold vestaP; norm_num
  exact CatCrypt.Crypto.Number.montgomeryMul_correct vestaP (2 ^ 256) vestaNprime256 x y
    hN (by norm_num) hNleR vestaNprime256_pin hx hy

/-! ## §4. `@[rust_cmd_pattern]` registration -/

/-- Register `Vesta_fmul_denote` → leaf `vesta_fp_mul` (the C symbol
    exporting `fiat_vesta_mul`). -/
@[rust_cmd_pattern]
def vestaFmulPattern : LowCTPattern where
  name      := "vesta_fp_mul"
  fnHead    := ``Vesta_fmul_denote
  arity     := 2
  towerType := .TBytes 32   -- 32-byte Vesta Fp Montgomery buffer (4×u64)

/-! ## §5. Tower-type abbreviation -/

/-- Tower type of a Vesta Fp element (`TBytes 32`, 4×u64 saturated
    Montgomery form). -/
def vestaFpTowerType : TowerType := .TBytes 32

/-! ## §6. `LeafSig` entry -/

/-- Per-leaf signature for `vesta_fp_mul`: no aliasing permitted
    (out / x / y distinct in the Rust signature). -/
def vestaFmulLeafSig : CatCrypt.Crypto.Jasmin.LeafSig where
  name        := "vesta_fp_mul"
  destAliasOk := []

/-! ## §7. Pure-Lean wrapper -/

/-- One Vesta `Fp` Montgomery-multiply invocation. -/
def vestaFmulLean (x y : VestaFp) : VestaFp :=
  Vesta_fmul_denote x y

/-! ## §8. Hand-built `LowCT` body (front-end input) -/

def loc (n : String) (t : TowerType) : Located :=
  { locVar := n, locSrc := t }

/-- The `LowCT` body for `vestaFmulLean`. Shape:
    `RSeq RSkip (RCall "vesta_fp_mul" __result [x, y])`. -/
def vestaFmulBody : LowCT :=
  let x_l      := loc "x"        vestaFpTowerType
  let y_l      := loc "y"        vestaFpTowerType
  let result_l := loc "__result" vestaFpTowerType
  .RSeq .RSkip
    (.RCall "vesta_fp_mul" result_l [x_l, y_l])

/-- `ReifiedFunc` bundle for the fiat-crypto Vesta field-multiply leaf. -/
def vestaFmulReified : ReifiedFunc :=
  { args    := [("x", vestaFpTowerType), ("y", vestaFpTowerType)]
    body    := vestaFmulBody
    retName := "__result" }

/-! ## §9. Inspection -/

#eval vestaFmulReified.args.map Prod.fst    -- [x, y]
#eval vestaFmulReified.args.length          -- 2
#eval vestaFmulReified.retName              -- __result

end CatCrypt.Crypto.Vale.VestaFieldMul
