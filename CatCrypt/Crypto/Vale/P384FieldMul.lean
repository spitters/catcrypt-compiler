set_option autoImplicit false

/-!
# fiat-crypto WordByWordMontgomery field-multiply leaf over `Fp_{P-384}`

This module declares the word-by-word-Montgomery (CIOS) field multiply for
the NIST P-384 base prime `p = 2^384 − 2^128 − 2^96 + 2^32 − 1` as a leaf
for CatCrypt's verified front, following the extCall pattern
(`Jasmin.LowCT` `RCall`) and the field-multiply leaf shape of
`Vale/BN254.lean`. It is 6×u64 = 48 bytes.

The base-field element is modelled as `ZMod p` and the leaf denotation is
the Montgomery product `x · y · R⁻¹`, `R = 2^384`. That value is grounded
in the proven emitted 6-limb Montgomery multiply
`Curve6LimbTierA.p384_emit_montmul_runBlock`: the `runBlock` of the emitted
schoolbook product is `valLimbs x · valLimbs y`, and its `montgomeryReduce`
at `R = 2^384` satisfies `redc · 2^384 ≡ valLimbs x · valLimbs y (mod p)`.
Cast to `ZMod p` this is exactly `P384_fmul_denote`. The reduction law is
the prime-parametric `Number.montgomeryReduce_correct`, so the value holds
at the P-384 prime with the pinned modulus `Curve6LimbTierA.p384Limbs`.

## Leaf C signature (Rust `extern "C"` shape)

```c
extern void p384_fp_mul(uint64_t out[6], const uint64_t x[6], const uint64_t y[6]);
```

That is: `out = x · y · R⁻¹ mod p_{P-384}`, `R = 2^384`, over
Montgomery-form 6×u64 saturated LE buffers (48 bytes per operand).

## Provenance and link-time trust

* **fiat-rust source**: `p384_64.rs`, function `fiat_p384_mul`, generated by
  `word_by_word_montgomery --lang Rust p384 64 '2^384 - 2^128 - 2^96 + 2^32 - 1'`;
  safe-Rust wrapper `p384-safe-rust/src/lib.rs`, C export `p384_fp_mul`.
* **Symbol identity at link time**: the C symbol our jasmin/C-bridge calls
  is the fiat-crypto-generated `fiat_p384_mul`. Standard C-linker trust.
-/

namespace CatCrypt.Crypto.Vale.P384FieldMul

open CatCrypt.Crypto.Jasmin.LowCT
open CatCrypt.Crypto.Jasmin.LowCTReflect
open CatCrypt.Crypto.SecureCompilation.X86Backend.Jasmin
open CatCrypt.Crypto.SecureCompilation.X86Backend.Cios4LimbProven
open CatCrypt.Crypto.SecureCompilation.X86Backend.SchoolbookProductRunBlock
open CatCrypt.Crypto.SecureCompilation.X86Backend.Curve6LimbTierA

/-! ## §1. Surface type and modulus

The P-384 base prime as the little-endian `valLimbs` of the pinned six-limb
modulus `p384Limbs`, and the base field `ZMod p`. -/

/-- The NIST P-384 base prime `p = 2^384 − 2^128 − 2^96 + 2^32 − 1`, as the
    `valLimbs` of the pinned six-limb modulus `p384Limbs`. -/
def p384Prime : Nat := valLimbs p384Limbs

/-- `0 < p384Prime`. -/
theorem p384Prime_pos : 0 < p384Prime := by
  rw [p384Prime, show p384Limbs = (0x00000000ffffffff : BitVec 64) :: _ from rfl, valLimbs_cons]
  have : (0x00000000ffffffff : BitVec 64).toNat = 4294967295 := by decide
  omega

instance : NeZero p384Prime := ⟨by have := p384Prime_pos; omega⟩

/-- A NIST P-384 `Fp` field element (Montgomery-form residue, 6×u64 = 48
    bytes on the wire). -/
abbrev P384Fp : Type := ZMod p384Prime

-- grind reduces mod p in P384Fp: a literal characteristic (grind_char_numeral).
grind_char_numeral P384Fp

/-! ## §2. Montgomery radix and the leaf denotation -/

/-- The Montgomery radix `R = 2^384` as an element of `ZMod p384Prime`. -/
noncomputable def p384MontR : P384Fp := ((2 ^ 384 : ℕ) : ZMod p384Prime)

/-- `R = 2^384` is a unit in `ZMod p384Prime` (it is coprime to the odd
    modulus `p384Prime`). -/
theorem p384MontR_isUnit : IsUnit p384MontR := by
  have hodd : ¬ (2 ∣ p384Prime) := by
    rw [p384Prime, show p384Limbs = (0x00000000ffffffff : BitVec 64) :: _ from rfl, valLimbs_cons]
    have : (0x00000000ffffffff : BitVec 64).toNat = 4294967295 := by decide
    omega
  have h2 : Nat.Coprime 2 p384Prime := (Nat.prime_two.coprime_iff_not_dvd).mpr hodd
  have hpow : Nat.Coprime (2 ^ 384) p384Prime := h2.pow_left 384
  exact (ZMod.isUnit_iff_coprime (2 ^ 384) p384Prime).mpr hpow

/-- **Leaf denotation**: the P-384 Montgomery product `x · y · R⁻¹`,
    `R = 2^384`, on Montgomery-form residues. Grounded in the proven
    emitted 6-limb Montgomery multiply by `p384_fmul_denote_grounds_runBlock`. -/
noncomputable def P384_fmul_denote (x y : P384Fp) : P384Fp := x * y * p384MontR⁻¹

/-- The leaf denotation unfolds to the Montgomery product `x · y · R⁻¹`. -/
theorem p384_fmul_denote_spec (x y : P384Fp) :
    P384_fmul_denote x y = x * y * p384MontR⁻¹ := rfl

/-! ## §2b. Grounding in the proven emitted 6-limb multiply

`p384_emit_montmul_runBlock` (`Curve6LimbTierA`) proves, for reduced 6-limb
inputs and the full-radix Montgomery constant `Nprime384`, that the emitted
schoolbook product's `runBlock` value is `valLimbs x · valLimbs y` and that
its `montgomeryReduce` `redc` satisfies `redc · 2^384 ≡ valLimbs x · valLimbs y
(mod p)`. Cast to `ZMod p`, `redc` is `P384_fmul_denote`. -/

/-- The `montgomeryReduce` value of the emitted 6-limb product block — the
    proven `runBlock` value of `Curve6LimbTierA.p384_emit_montmul_runBlock` —
    casts in `ZMod p384Prime` to the leaf denotation `P384_fmul_denote`. -/
theorem p384_fmul_denote_grounds_runBlock
    (accs as ys : List String) (x yv : List (BitVec 64)) (hi lo : String)
    (s : JState 64) (Nprime384 : Nat)
    (haslen : as.length = x.length) (hyslen : ys.length = yv.length)
    (hcap : as.length + ys.length ≤ accs.length)
    (hfresh : ProdFresh accs as ys hi lo)
    (hx : as.map s.get = x) (hy : ys.map s.get = yv)
    (hacc0 : ∀ r ∈ accs, s.get r = 0)
    (hcf : s.flagB (·.cf) = false) (hof : s.flagB (·.of) = false)
    (hx_red : valLimbs x < valLimbs p384Limbs)
    (hy_red : valLimbs yv < valLimbs p384Limbs)
    (hNprime : (valLimbs p384Limbs * Nprime384) % 2 ^ 384 = 2 ^ 384 - 1) :
    ((Number.montgomeryReduce (valLimbs p384Limbs) (2 ^ 384) Nprime384
        (runBlockProductValue accs as ys hi lo s) : ℕ) : P384Fp)
      = P384_fmul_denote (valLimbs x : P384Fp) (valLimbs yv : P384Fp) := by
  obtain ⟨_, _, hcong⟩ := p384_emit_montmul_runBlock accs as ys x yv hi lo s Nprime384
    haslen hyslen hcap hfresh hx hy hacc0 hcf hof hx_red hy_red hNprime
  set redc := Number.montgomeryReduce (valLimbs p384Limbs) (2 ^ 384) Nprime384
    (runBlockProductValue accs as ys hi lo s)
  have hcast : (redc : P384Fp) * p384MontR = (valLimbs x : P384Fp) * (valLimbs yv : P384Fp) := by
    have h := (ZMod.natCast_eq_natCast_iff _ _ _).mpr hcong
    rw [Nat.cast_mul, Nat.cast_mul] at h
    exact h
  have hRR : p384MontR * p384MontR⁻¹ = 1 := ZMod.mul_inv_of_unit _ p384MontR_isUnit
  show (redc : P384Fp) = (valLimbs x : P384Fp) * (valLimbs yv : P384Fp) * p384MontR⁻¹
  calc (redc : P384Fp)
      = (redc : P384Fp) * (p384MontR * p384MontR⁻¹) := by rw [hRR, mul_one]
    _ = (redc : P384Fp) * p384MontR * p384MontR⁻¹ := by ring
    _ = (valLimbs x : P384Fp) * (valLimbs yv : P384Fp) * p384MontR⁻¹ := by rw [hcast]

/-! ## §3. `@[rust_cmd_pattern]` registration -/

/-- Register `P384_fmul_denote` → leaf `p384_fp_mul` (the C symbol
    exporting `fiat_p384_mul`). Argument shape `2 × TBytes 48`
    (two P-384 Fp elements). -/
@[rust_cmd_pattern]
def p384FmulPattern : LowCTPattern where
  name      := "p384_fp_mul"
  fnHead    := ``P384_fmul_denote
  arity     := 2
  towerType := .TBytes 48   -- 48-byte P-384 Fp Montgomery buffer (6×u64)

/-! ## §4. Tower-type abbreviation -/

/-- Tower type of a NIST P-384 Fp element (`TBytes 48`, 6×u64 saturated
    Montgomery form). -/
def p384FpTowerType : TowerType := .TBytes 48

/-! ## §5. `LeafSig` entry

The fiat-crypto leaf is non-aliasing: `out`, `x`, `y` are distinct
buffers in the Rust signature (`&mut [u64; 6]`, `&[u64; 6]`, `&[u64; 6]`
borrow-check as distinct). `destAliasOk := []` (the conservative
default). -/

/-- Per-leaf signature for `p384_fp_mul`: no aliasing permitted. -/
def p384FmulLeafSig : CatCrypt.Crypto.Jasmin.LeafSig where
  name        := "p384_fp_mul"
  destAliasOk := []

/-! ## §6. Pure-Lean wrapper — the spec

The body is the single cross-prover-cited leaf call. -/

/-- One NIST P-384 `Fp` Montgomery-multiply invocation. -/
noncomputable def p384FmulLean (x y : P384Fp) : P384Fp :=
  P384_fmul_denote x y

/-! ## §7. Hand-built `LowCT` body (front-end input)

The front-end `reifyLowCT%` macro reads `knownOps` only, so we hand-build
the single-`RCall` body the reifier would produce. -/

def loc (n : String) (t : TowerType) : Located :=
  { locVar := n, locSrc := t }

/-- The `LowCT` body for `p384FmulLean`. Shape:
    `RSeq RSkip (RCall "p384_fp_mul" __result [x, y])`. -/
def p384FmulBody : LowCT :=
  let x_l      := loc "x"        p384FpTowerType
  let y_l      := loc "y"        p384FpTowerType
  let result_l := loc "__result" p384FpTowerType
  .RSeq .RSkip
    (.RCall "p384_fp_mul" result_l [x_l, y_l])

/-- `ReifiedFunc` bundle for the fiat-crypto P-384 field-multiply leaf. -/
def p384FmulReified : ReifiedFunc :=
  { args    := [("x", p384FpTowerType), ("y", p384FpTowerType)]
    body    := p384FmulBody
    retName := "__result" }

/-! ## §8. Inspection -/

#eval p384FmulReified.args.map Prod.fst    -- [x, y]
#eval p384FmulReified.args.length          -- 2
#eval p384FmulReified.retName              -- __result

end CatCrypt.Crypto.Vale.P384FieldMul
