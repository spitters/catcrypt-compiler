@[expose] public section

set_option autoImplicit false

/-!
# fiat-crypto WordByWordMontgomery field-multiply leaf over `Fp_{Pallas}`

This module is the field-multiply leaf for the Pallas base prime
`p = 2^254 + 0x224698fc094cf91b992d30ed00000001`, wired into CatCrypt's
verified front via the extCall pattern (`Jasmin.LowCT` `RCall`), following
the field-multiply leaf shape of `Vale/BN254.lean`.

The companion `Vale/Pallas.lean` carries the Bernstein-Yang safegcd
inversion leaf; this module carries the Montgomery multiply. Pallas and
Vesta form the Pasta cycle (each prime is the other's scalar field); the
Vesta twin is `Vale/VestaFieldMul.lean`. Both are 4×u64 = 32 bytes.

## Value grounding

`Pallas_fmul_denote` is the Montgomery product `x · y · R⁻¹ mod p`,
`R = 2^256`, defined as `Number.montgomeryMul` at the Pallas base prime
(the modulus value `PastaBignumTierA.valLimbs pallasLimbs`, pinned to the Pallas
prime by `PastaBignumTierA.pallasLimbs_value`) and the
full-radix Montgomery constant `pallasNprime256 = −p⁻¹ mod 2^256`
(`pallasNprime256_pin`: `p · pallasNprime256 ≡ −1 mod 2^256`).
`Pallas_fmul_denote_spec` gives its range (`< 2·p`) and congruence
(`· 2^256 ≡ x · y mod p`) from `Number.montgomeryMul_correct` — the same
value core the owned-x86 Pasta Montgomery-multiply kernel
`PastaBignumTierA.pallas_emit_montmul_runBlock` proves for its emitted
`runBlock` output.

## The fiat-crypto / AUCurves provenance

* **fiat-rust source**: fiat-crypto's `fiat-rust/src/` (AUCurves)
  `pallas_64.rs`, function `fiat_pallas_mul`, generated by
  `word_by_word_montgomery --lang Rust pallas 64 '2^254 + 0x224698fc094cf91b992d30ed00000001'`.
  Header modulus
  `m = 0x40000000000000000000000000000000224698fc094cf91b992d30ed00000001`
  = `28948022309329048855892746252171976963363056481941560715954676764349967630337`.
* **Safe-Rust wrapper + C ABI**: `pallas-safe-rust/src/lib.rs`,
  `fp_mul(out, x, y) = fiat_pallas_mul(out, x, y)`, exported by
  `pallas-safe-rust/src/ffi.rs` as
  `#[no_mangle] pub unsafe extern "C" fn pallas_fp_mul(r, a, b)`.
* **Correctness (cross-prover)**: fiat-crypto's
  `Arithmetic/WordByWordMontgomery.v::mulmod_correct` (`Qed`) and its
  C-operation form `COperationSpecifications.v` module
  `WordByWordMontgomery`, `mul_correct`, instantiated at the Pallas
  prime (see `Vale/PallasFieldMulCoqAxioms.lean`).

## Leaf C signature

```c
extern void pallas_fp_mul(uint64_t out[4], const uint64_t x[4], const uint64_t y[4]);
```

That is: `out = x · y · R⁻¹ mod p_{Pallas}`, `R = 2^256`, over
Montgomery-form 4×u64 saturated LE buffers (32 bytes per operand). The
emitted call site is unchanged: `RCall "pallas_fp_mul"` binds the C symbol
(the fiat-crypto `fiat_pallas_mul` in the `pallas-safe-rust` staticlib);
symbol identity at link time is standard C-linker trust.
-/

namespace CatCrypt.Crypto.Vale.PallasFieldMul

open CatCrypt.Crypto.Jasmin.LowCT
open CatCrypt.Crypto.Jasmin.LowCTReflect
open CatCrypt.Crypto.SecureCompilation.X86Backend.Cios4LimbProven (valLimbs)
open CatCrypt.Crypto.SecureCompilation.X86Backend.PastaBignumTierA
  (pallasLimbs pallasLimbs_value)

/-! ## §1. The Pallas base prime and its full-radix Montgomery constant -/

/-- The Pallas base-field prime `p = 2^254 + 0x224698fc094cf91b992d30ed00000001`. -/
def pallasP : Nat := 2 ^ 254 + 0x224698fc094cf91b992d30ed00000001

/-- `pallasP` is the modulus value of the Pasta twin's `native_decide`-pinned
    limbs (`PastaBignumTierA.pallasLimbs_value`). -/
theorem pallasP_eq_twin : pallasP = valLimbs pallasLimbs := by
  unfold pallasP; exact pallasLimbs_value.symm

/-- The full-radix Montgomery constant `−p⁻¹ mod 2^256` for Pallas. -/
def pallasNprime256 : Nat :=
  61413975064413208899249498046427041956196333800155739387550011161905297620991

/-- `p · pallasNprime256 ≡ −1 (mod 2^256)` — the Montgomery-constant defining
    identity. -/
theorem pallasNprime256_pin :
    (pallasP * pallasNprime256) % 2 ^ 256 = 2 ^ 256 - 1 := by
  unfold pallasP pallasNprime256; rfl

/-! ## §2. Surface type -/

/-- A Pallas `Fp` field element: the integer value in `[0, p)` of the 4×u64
    saturated LE Montgomery-form buffer (32 bytes). -/
abbrev PallasFp : Type := Nat

/-- Zero inhabitant. -/
def PallasFp.default : PallasFp := 0

/-! ## §3. The field-multiply denotation (grounded in the Pasta twin) -/

/-- **Denotation**: the fiat-crypto `fiat_pallas_mul` leaf computes the Pallas
    base-field Montgomery multiplication `out = (x · y · R⁻¹) mod p`,
    `R = 2^256`. Defined as `Number.montgomeryMul` at the Pallas prime and
    `pallasNprime256`; its value spec is `Pallas_fmul_denote_spec`. -/
def Pallas_fmul_denote (x y : PallasFp) : PallasFp :=
  CatCrypt.Crypto.Number.montgomeryMul pallasP (2 ^ 256) pallasNprime256 x y

/-- **Value spec.** For reduced Montgomery-form inputs (`x, y < p`), the
    denotation lies in `[0, 2·p)` and satisfies `out · 2^256 ≡ x · y (mod p)`,
    i.e. `out ≡ x · y · R⁻¹ (mod p)`. Discharged by
    `Number.montgomeryMul_correct` — the value core of the owned-x86 Pasta
    Montgomery-multiply kernel `PastaBignumTierA.pallas_emit_montmul_runBlock`,
    and of fiat-crypto's `WordByWordMontgomery.mulmod_correct` at the Pallas
    prime. -/
theorem Pallas_fmul_denote_spec (x y : PallasFp)
    (hx : x < pallasP) (hy : y < pallasP) :
    Pallas_fmul_denote x y < 2 * pallasP ∧
    (Pallas_fmul_denote x y) * 2 ^ 256 ≡ x * y [MOD pallasP] := by
  have hN : 0 < pallasP := by unfold pallasP; norm_num
  have hNleR : pallasP ≤ 2 ^ 256 := by unfold pallasP; norm_num
  exact CatCrypt.Crypto.Number.montgomeryMul_correct pallasP (2 ^ 256) pallasNprime256 x y
    hN (by norm_num) hNleR pallasNprime256_pin hx hy

/-! ## §4. `@[rust_cmd_pattern]` registration -/

/-- Register `Pallas_fmul_denote` → leaf `pallas_fp_mul` (the
    `#[no_mangle] extern "C"` export of `fiat_pallas_mul`). -/
@[rust_cmd_pattern]
def pallasFmulPattern : LowCTPattern where
  name      := "pallas_fp_mul"
  fnHead    := ``Pallas_fmul_denote
  arity     := 2
  towerType := .TBytes 32   -- 32-byte Pallas Fp Montgomery buffer (4×u64)

/-! ## §5. Tower-type abbreviation -/

/-- Tower type of a Pallas Fp element (`TBytes 32`, 4×u64 saturated
    Montgomery form). -/
def pallasFpTowerType : TowerType := .TBytes 32

/-! ## §6. `LeafSig` entry -/

/-- Per-leaf signature for `pallas_fp_mul`: no aliasing permitted
    (out / x / y distinct in the Rust signature). -/
def pallasFmulLeafSig : CatCrypt.Crypto.Jasmin.LeafSig where
  name        := "pallas_fp_mul"
  destAliasOk := []

/-! ## §7. Pure-Lean wrapper -/

/-- One Pallas `Fp` Montgomery-multiply invocation. -/
def pallasFmulLean (x y : PallasFp) : PallasFp :=
  Pallas_fmul_denote x y

/-! ## §8. Hand-built `LowCT` body (front-end input) -/

def loc (n : String) (t : TowerType) : Located :=
  { locVar := n, locSrc := t }

/-- The `LowCT` body for `pallasFmulLean`. Shape:
    `RSeq RSkip (RCall "pallas_fp_mul" __result [x, y])`. -/
def pallasFmulBody : LowCT :=
  let x_l      := loc "x"        pallasFpTowerType
  let y_l      := loc "y"        pallasFpTowerType
  let result_l := loc "__result" pallasFpTowerType
  .RSeq .RSkip
    (.RCall "pallas_fp_mul" result_l [x_l, y_l])

/-- `ReifiedFunc` bundle for the fiat-crypto Pallas field-multiply leaf. -/
def pallasFmulReified : ReifiedFunc :=
  { args    := [("x", pallasFpTowerType), ("y", pallasFpTowerType)]
    body    := pallasFmulBody
    retName := "__result" }

/-! ## §9. Inspection -/

#eval pallasFmulReified.args.map Prod.fst   -- [x, y]
#eval pallasFmulReified.args.length         -- 2
#eval pallasFmulReified.retName             -- __result

end CatCrypt.Crypto.Vale.PallasFieldMul
