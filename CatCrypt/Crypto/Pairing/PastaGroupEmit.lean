/-!
# The Pasta group law emitted as a composition over field leaves

Pallas and Vesta are `y² = x³ + 5` over the primes `pallasQ` and `vestaQ`. This file
emits their point addition as straight-line `Com jasminDialect` kernels over three
base-field leaves (multiply, add, subtract), generated by the orchestration front
`buildOrchCom` from phase schedules, and proves that the emitted add, double and
double-and-add scalar multiplication compute the group law of Mathlib's
`WeierstrassCurve.Affine.Point` for all inputs, the identity and doubling included.

The formula is the complete projective addition of Renes, Costello and Batina for
`a = 0` (Algorithm 7) with `b₃ = 15`, computed as `16t − t` by four additions and a
subtraction. Its group-law correctness is `PastaCompleteAdd.rcb0Add_projRep`. The
development is parametric in the leaf symbols (`FieldLeaves`), so Pallas and Vesta
share every kernel and theorem; they differ in the leaf names and the base field.

## Kernels

Seven front-generated kernels, each one `buildOrchCom` schedule: `crossCom`
(`a₁b₂ + b₁a₂` as `(a₁+b₁)(a₂+b₂) − a₁a₂ − b₁b₂`), `m15Com` (`15t`), `tripleCom`
(`3x₁x₂`), `pm15Com` (`pq ± 15rs`) and `mmCom` (`pq ± rs`). `emittedAdd` composes nine
calls of them (54 field-leaf calls in total). Each kernel's denotation through
`jasminDenoteWith leafSem` is the corresponding `ArithOps` stage function over the leaf
arithmetic, by `rfl`.

## Hypotheses of the value theorems

* `FieldLeafAgrees L ops leafSem` — the leaf model `leafSem` computes the wire operations
  `ops` on the three leaf symbols of `L`.
* `OpsRealize ops dec` — read through the decoding `dec : FpWire → K`, the wire operations
  are the field operations of `K`.

Both are discharged for the canonical little-endian codec (`canonOps_realize`) and the
per-curve leaf oracles (`pallasFieldOracle_agrees`, `vestaFieldOracle_agrees`); the
theorems `pallas_emittedSmul_G` and `vesta_emittedSmul_G` carry no hypothesis. They say
what the emitted composition computes when each leaf computes its field operation, and
nothing about the machine code of the leaves.

## Main results

* `emittedAdd_value` — the emitted add, read through `dec`, is `rcb0Add 5`.
* `emittedAdd_projRep`, `emittedDbl_projRep`, `emittedSmul_projRep` — the emitted add,
  double and scalar multiplication represent `A + B`, `2 • A` and `bitsVal bits • A`.
* `pallas_emittedSmul_G`, `vesta_emittedSmul_G` — the scalar multiplication of the base
  point `(−1, 2)` on each curve.
-/

@[expose] public section

set_option autoImplicit false

namespace CatCrypt.Crypto.Pairing.PastaGroupEmit

open CatCrypt.Crypto.SecureCompilation.VIR
open CatCrypt.Crypto.SecureCompilation.VIR.JasminDialect
open CatCrypt.Crypto.SecureCompilation.Dialects.OrchestrationFront
open CatCrypt.Crypto.Pairing.PastaCompleteAdd
open CatCrypt.Crypto.SecureCompilation.RelationalFront (pallasQ vestaQ)

/-! ## 1. The stage functions over an abstract arithmetic -/

/-- Three binary operations on a carrier: multiply, add, subtract. -/
structure ArithOps (α : Type) where
  /-- Multiply. -/
  mul : α → α → α
  /-- Add. -/
  add : α → α → α
  /-- Subtract. -/
  sub : α → α → α

namespace ArithOps

variable {α : Type} (o : ArithOps α)

/-- `15 · t` as `16t − t`: four doublings and one subtraction. -/
def m15 (t : α) : α :=
  let t2 := o.add t t
  let t4 := o.add t2 t2
  let t8 := o.add t4 t4
  let t16 := o.add t8 t8
  o.sub t16 t

/-- `(a₁ + b₁)(a₂ + b₂) − (a₁a₂ + b₁b₂)`, which is `a₁b₂ + b₁a₂`. -/
def cross (a1 b1 a2 b2 : α) : α :=
  let p := o.mul a1 a2
  let q := o.mul b1 b2
  let s := o.mul (o.add a1 b1) (o.add a2 b2)
  o.sub s (o.add p q)

/-- `3 · x₁x₂`. -/
def triple (x1 x2 : α) : α :=
  let t := o.mul x1 x2
  o.add (o.add t t) t

/-- `p·q + 15·(r·s)`. -/
def pm15Add (p q r s : α) : α :=
  let u := o.mul p q
  let v := o.mul r s
  o.add u (o.m15 v)

/-- `p·q − 15·(r·s)`. -/
def pm15Sub (p q r s : α) : α :=
  let u := o.mul p q
  let v := o.mul r s
  o.sub u (o.m15 v)

/-- `p·q − r·s`. -/
def mulSub (p q r s : α) : α := o.sub (o.mul p q) (o.mul r s)

/-- `p·q + r·s`. -/
def mulAdd (p q r s : α) : α := o.add (o.mul p q) (o.mul r s)

/-- The complete addition for `y² = x³ + 5` (Renes–Costello–Batina Algorithm 7,
`b₃ = 15`), assembled from the stage functions over `o`. -/
def add5 (P Q : α × α × α) : α × α × α :=
  let a := o.cross P.1 P.2.1 Q.1 Q.2.1
  let b := o.cross P.2.1 P.2.2 Q.2.1 Q.2.2
  let y := o.m15 (o.cross P.1 P.2.2 Q.1 Q.2.2)
  let t0 := o.triple P.1 Q.1
  let z := o.pm15Add P.2.1 Q.2.1 P.2.2 Q.2.2
  let t1 := o.pm15Sub P.2.1 Q.2.1 P.2.2 Q.2.2
  (o.mulSub a t1 b y, o.mulAdd y t0 t1 z, o.mulAdd z b t0 a)

end ArithOps

/-! ## 2. Wire layout and leaf model -/

/-- A Pasta base-field element on the wire: 32 bytes (4 little-endian `u64` limbs). -/
def FESZ : Nat := 32

/-- The on-wire field-element type. -/
abbrev FpWire : Type := Fin FESZ → BitVec 8

/-- The leaf-semantics carrier, the shape of `jasminExtSem`. -/
abbrev LeafSem : Type :=
  (name : String) → (argTys : List JasminTy) → (retTy : JasminTy) →
    HVector (fun t => ⟦t⟧) argTys → ⟦retTy⟧

/-- Binary field-leaf signature. -/
def binArgTys : List JasminTy := [.stackArr 8 FESZ, .stackArr 8 FESZ]

/-- Every field leaf returns a field element. -/
def feRetTy : JasminTy := .stackArr 8 FESZ

/-- The three field-leaf symbols of one curve's base field. -/
structure FieldLeaves where
  /-- Field multiply. -/
  mul : String
  /-- Field add. -/
  add : String
  /-- Field subtract. -/
  sub : String

/-- The arithmetic a leaf model gives the three leaf symbols of `L`. -/
def leafOps (L : FieldLeaves) (leafSem : LeafSem) : ArithOps FpWire where
  mul a b := leafSem L.mul binArgTys feRetTy (.cons a (.cons b .nil))
  add a b := leafSem L.add binArgTys feRetTy (.cons a (.cons b .nil))
  sub a b := leafSem L.sub binArgTys feRetTy (.cons a (.cons b .nil))

/-- One binary field-leaf call on the root slots `i`, `j`. -/
def bin (leaf : String) (i j : Nat) : CallPhase :=
  { leaf := leaf, argTys := binArgTys, retTy := feRetTy, argSlots := [i, j] }

/-- Context of one field element. -/
def fe1 : Ctxt jasminDialect := [.stackArr 8 FESZ]

/-- Context of two field elements. -/
def fe2 : Ctxt jasminDialect := [.stackArr 8 FESZ, .stackArr 8 FESZ]

/-- Context of four field elements. -/
def fe4 : Ctxt jasminDialect :=
  [.stackArr 8 FESZ, .stackArr 8 FESZ, .stackArr 8 FESZ, .stackArr 8 FESZ]

/-! ## 3. The schedules and the front-generated kernels

Root slots count from the tail of the input context: over `[a, b, c, d]`, `a` is slot 3
and `d` is slot 0; the `k`-th call's result is slot `|Γ₀| + k`. -/

/-- `cross` over `[a₁, b₁, a₂, b₂]`. -/
def crossSched (L : FieldLeaves) : List CallPhase :=
  [bin L.mul 3 1, bin L.mul 2 0, bin L.add 3 2, bin L.add 1 0, bin L.mul 6 7,
    bin L.add 4 5, bin L.sub 8 9]

/-- `m15` over `[t]`. -/
def m15Sched (L : FieldLeaves) : List CallPhase :=
  [bin L.add 0 0, bin L.add 1 1, bin L.add 2 2, bin L.add 3 3, bin L.sub 4 0]

/-- `triple` over `[x₁, x₂]`. -/
def tripleSched (L : FieldLeaves) : List CallPhase :=
  [bin L.mul 1 0, bin L.add 2 2, bin L.add 3 2]

/-- `pm15Add` (`last = L.add`) or `pm15Sub` (`last = L.sub`) over `[p, q, r, s]`. -/
def pm15Sched (L : FieldLeaves) (last : String) : List CallPhase :=
  [bin L.mul 3 2, bin L.mul 1 0, bin L.add 5 5, bin L.add 6 6, bin L.add 7 7,
    bin L.add 8 8, bin L.sub 9 5, bin last 4 10]

/-- `mulAdd` (`last = L.add`) or `mulSub` (`last = L.sub`) over `[p, q, r, s]`. -/
def mmSched (L : FieldLeaves) (last : String) : List CallPhase :=
  [bin L.mul 3 2, bin L.mul 1 0, bin last 4 5]

/-- Generation gate: the front resolves the `cross` schedule. -/
theorem crossCom_isSome (L : FieldLeaves) :
    (buildOrchCom fe4 (crossSched L) 10 feRetTy).isSome = true := rfl

/-- Generation gate: the front resolves the `m15` schedule. -/
theorem m15Com_isSome (L : FieldLeaves) :
    (buildOrchCom fe1 (m15Sched L) 5 feRetTy).isSome = true := rfl

/-- Generation gate: the front resolves the `triple` schedule. -/
theorem tripleCom_isSome (L : FieldLeaves) :
    (buildOrchCom fe2 (tripleSched L) 4 feRetTy).isSome = true := rfl

/-- Generation gate: the front resolves the `pm15` schedule. -/
theorem pm15Com_isSome (L : FieldLeaves) (last : String) :
    (buildOrchCom fe4 (pm15Sched L last) 11 feRetTy).isSome = true := rfl

/-- Generation gate: the front resolves the `mm` schedule. -/
theorem mmCom_isSome (L : FieldLeaves) (last : String) :
    (buildOrchCom fe4 (mmSched L last) 6 feRetTy).isSome = true := rfl

/-- The `cross` kernel, generated by the orchestration front. -/
def crossCom (L : FieldLeaves) : Com jasminDialect fe4 feRetTy :=
  (buildOrchCom fe4 (crossSched L) 10 feRetTy).get (crossCom_isSome L)

/-- The `m15` kernel, generated by the orchestration front. -/
def m15Com (L : FieldLeaves) : Com jasminDialect fe1 feRetTy :=
  (buildOrchCom fe1 (m15Sched L) 5 feRetTy).get (m15Com_isSome L)

/-- The `triple` kernel, generated by the orchestration front. -/
def tripleCom (L : FieldLeaves) : Com jasminDialect fe2 feRetTy :=
  (buildOrchCom fe2 (tripleSched L) 4 feRetTy).get (tripleCom_isSome L)

/-- The `pm15Add` / `pm15Sub` kernel, generated by the orchestration front. -/
def pm15Com (L : FieldLeaves) (last : String) : Com jasminDialect fe4 feRetTy :=
  (buildOrchCom fe4 (pm15Sched L last) 11 feRetTy).get (pm15Com_isSome L last)

/-- The `mulAdd` / `mulSub` kernel, generated by the orchestration front. -/
def mmCom (L : FieldLeaves) (last : String) : Com jasminDialect fe4 feRetTy :=
  (buildOrchCom fe4 (mmSched L last) 6 feRetTy).get (mmCom_isSome L last)

/-- `crossCom` denotes `cross` over the leaf arithmetic. -/
theorem crossCom_denote (L : FieldLeaves) (leafSem : LeafSem) (a1 b1 a2 b2 : FpWire) :
    @Com.denote _ _ _ (jasminDenoteWith leafSem) _ _ (crossCom L)
        (.cons a1 (.cons b1 (.cons a2 (.cons b2 .nil))))
      = (leafOps L leafSem).cross a1 b1 a2 b2 := rfl

/-- `m15Com` denotes `m15` over the leaf arithmetic. -/
theorem m15Com_denote (L : FieldLeaves) (leafSem : LeafSem) (t : FpWire) :
    @Com.denote _ _ _ (jasminDenoteWith leafSem) _ _ (m15Com L) (.cons t .nil)
      = (leafOps L leafSem).m15 t := rfl

/-- `tripleCom` denotes `triple` over the leaf arithmetic. -/
theorem tripleCom_denote (L : FieldLeaves) (leafSem : LeafSem) (x1 x2 : FpWire) :
    @Com.denote _ _ _ (jasminDenoteWith leafSem) _ _ (tripleCom L) (.cons x1 (.cons x2 .nil))
      = (leafOps L leafSem).triple x1 x2 := rfl

/-- `pm15Com L L.add` denotes `pm15Add` over the leaf arithmetic. -/
theorem pm15Com_add_denote (L : FieldLeaves) (leafSem : LeafSem) (p q r s : FpWire) :
    @Com.denote _ _ _ (jasminDenoteWith leafSem) _ _ (pm15Com L L.add)
        (.cons p (.cons q (.cons r (.cons s .nil))))
      = (leafOps L leafSem).pm15Add p q r s := rfl

/-- `pm15Com L L.sub` denotes `pm15Sub` over the leaf arithmetic. -/
theorem pm15Com_sub_denote (L : FieldLeaves) (leafSem : LeafSem) (p q r s : FpWire) :
    @Com.denote _ _ _ (jasminDenoteWith leafSem) _ _ (pm15Com L L.sub)
        (.cons p (.cons q (.cons r (.cons s .nil))))
      = (leafOps L leafSem).pm15Sub p q r s := rfl

/-- `mmCom L L.add` denotes `mulAdd` over the leaf arithmetic. -/
theorem mmCom_add_denote (L : FieldLeaves) (leafSem : LeafSem) (p q r s : FpWire) :
    @Com.denote _ _ _ (jasminDenoteWith leafSem) _ _ (mmCom L L.add)
        (.cons p (.cons q (.cons r (.cons s .nil))))
      = (leafOps L leafSem).mulAdd p q r s := rfl

/-- `mmCom L L.sub` denotes `mulSub` over the leaf arithmetic. -/
theorem mmCom_sub_denote (L : FieldLeaves) (leafSem : LeafSem) (p q r s : FpWire) :
    @Com.denote _ _ _ (jasminDenoteWith leafSem) _ _ (mmCom L L.sub)
        (.cons p (.cons q (.cons r (.cons s .nil))))
      = (leafOps L leafSem).mulSub p q r s := rfl

/-! ## 4. The emitted point add and its value -/

/-- An on-wire projective point `(X, Y, Z)`. -/
abbrev WireTriple : Type := FpWire × FpWire × FpWire

/-- The emitted complete point add under the leaf model `leafSem`: nine calls of the
front-generated kernels, each denoted through `jasminDenoteWith leafSem`, composed as in
`ArithOps.add5`. -/
def emittedAdd (L : FieldLeaves) (leafSem : LeafSem) (P Q : WireTriple) : WireTriple :=
  let cr := fun (a1 b1 a2 b2 : FpWire) => @Com.denote _ _ _ (jasminDenoteWith leafSem) _ _
    (crossCom L) (.cons a1 (.cons b1 (.cons a2 (.cons b2 .nil))))
  let k4 := fun (c : Com jasminDialect fe4 feRetTy) (p q r s : FpWire) =>
    @Com.denote _ _ _ (jasminDenoteWith leafSem) _ _ c (.cons p (.cons q (.cons r (.cons s .nil))))
  let a := cr P.1 P.2.1 Q.1 Q.2.1
  let b := cr P.2.1 P.2.2 Q.2.1 Q.2.2
  let y := @Com.denote _ _ _ (jasminDenoteWith leafSem) _ _ (m15Com L)
    (.cons (cr P.1 P.2.2 Q.1 Q.2.2) .nil)
  let t0 := @Com.denote _ _ _ (jasminDenoteWith leafSem) _ _ (tripleCom L)
    (.cons P.1 (.cons Q.1 .nil))
  let z := k4 (pm15Com L L.add) P.2.1 Q.2.1 P.2.2 Q.2.2
  let t1 := k4 (pm15Com L L.sub) P.2.1 Q.2.1 P.2.2 Q.2.2
  (k4 (mmCom L L.sub) a t1 b y, k4 (mmCom L L.add) y t0 t1 z, k4 (mmCom L L.add) z b t0 a)

/-- The emitted add is the stage program `add5` over the leaf arithmetic. -/
theorem emittedAdd_eq (L : FieldLeaves) (leafSem : LeafSem) (P Q : WireTriple) :
    emittedAdd L leafSem P Q = (leafOps L leafSem).add5 P Q := rfl

/-- The leaf model `leafSem` computes the wire operations `ops` on the three leaf symbols
of `L`. -/
structure FieldLeafAgrees (L : FieldLeaves) (ops : ArithOps FpWire) (leafSem : LeafSem) :
    Prop where
  /-- The multiply leaf. -/
  mul : ∀ a b, leafSem L.mul binArgTys feRetTy (.cons a (.cons b .nil)) = ops.mul a b
  /-- The add leaf. -/
  add : ∀ a b, leafSem L.add binArgTys feRetTy (.cons a (.cons b .nil)) = ops.add a b
  /-- The subtract leaf. -/
  sub : ∀ a b, leafSem L.sub binArgTys feRetTy (.cons a (.cons b .nil)) = ops.sub a b

/-- Under the leaf agreement, the leaf arithmetic is `ops`. -/
theorem FieldLeafAgrees.leafOps_eq {L : FieldLeaves} {ops : ArithOps FpWire}
    {leafSem : LeafSem} (h : FieldLeafAgrees L ops leafSem) : leafOps L leafSem = ops := by
  obtain ⟨m, a, s⟩ := ops
  unfold leafOps
  congr 1 <;> funext x y
  · exact h.mul x y
  · exact h.add x y
  · exact h.sub x y

/-- The field arithmetic of `K` as `ArithOps`. -/
def ringOps (K : Type) [Field K] : ArithOps K := ⟨(· * ·), (· + ·), (· - ·)⟩

/-- Read through `dec`, the wire operations `ops` are the field operations of `K`. -/
structure OpsRealize {K : Type} [Field K] (ops : ArithOps FpWire) (dec : FpWire → K) :
    Prop where
  /-- Multiply. -/
  mul : ∀ a b, dec (ops.mul a b) = dec a * dec b
  /-- Add. -/
  add : ∀ a b, dec (ops.add a b) = dec a + dec b
  /-- Subtract. -/
  sub : ∀ a b, dec (ops.sub a b) = dec a - dec b

/-- Read a wire triple through `dec`. -/
def map3 {K : Type} (dec : FpWire → K) (t : WireTriple) : K × K × K :=
  (dec t.1, dec t.2.1, dec t.2.2)

/-- `add5` commutes with a decoding under which the wire operations are the field
operations. -/
theorem add5_realize {K : Type} [Field K] {ops : ArithOps FpWire} {dec : FpWire → K}
    (h : OpsRealize ops dec) (P Q : WireTriple) :
    map3 dec (ops.add5 P Q) = (ringOps K).add5 (map3 dec P) (map3 dec Q) := by
  simp only [map3, ArithOps.add5, ArithOps.mulSub, ArithOps.mulAdd, ArithOps.cross,
    ArithOps.m15, ArithOps.triple, ArithOps.pm15Add, ArithOps.pm15Sub, h.mul, h.add, h.sub,
    ringOps]

/-- Over a field, `add5` is the complete formula `rcb0Add 5`. -/
theorem ringOps_add5 {K : Type} [Field K] (P Q : K × K × K) :
    (ringOps K).add5 P Q = rcb0Add 5 P Q := by
  simp only [ringOps, ArithOps.add5, ArithOps.mulSub, ArithOps.mulAdd, ArithOps.cross,
    ArithOps.m15, ArithOps.triple, ArithOps.pm15Add, ArithOps.pm15Sub, rcb0Add, Prod.mk.injEq]
  refine ⟨by ring, by ring, by ring⟩

/-- The emitted add, read through `dec`, is the complete formula `rcb0Add 5` on the
decoded inputs. -/
theorem emittedAdd_value {K : Type} [Field K] {L : FieldLeaves} {leafSem : LeafSem}
    {ops : ArithOps FpWire} {dec : FpWire → K} (hLeaf : FieldLeafAgrees L ops leafSem)
    (hReal : OpsRealize ops dec) (P Q : WireTriple) :
    map3 dec (emittedAdd L leafSem P Q) = rcb0Add 5 (map3 dec P) (map3 dec Q) := by
  rw [emittedAdd_eq, hLeaf.leafOps_eq, add5_realize hReal, ringOps_add5]

/-! ## 5. The group law: add, double, scalar multiplication -/

section GroupLaw

variable {K : Type} [Field K] [DecidableEq K]

/-- **The emitted add computes the group law.** For all inputs representing `A` and `B`,
the emitted add represents `A + B`. -/
theorem emittedAdd_projRep (hb : ∀ x : K, x ^ 3 + 5 ≠ 0) (h2 : (2 : K) ≠ 0)
    {L : FieldLeaves} {leafSem : LeafSem} {ops : ArithOps FpWire} {dec : FpWire → K}
    (hLeaf : FieldLeafAgrees L ops leafSem) (hReal : OpsRealize ops dec)
    {P Q : WireTriple} {A B : (w0 (5 : K)).toAffine.Point}
    (hP : ProjRep0 5 (map3 dec P) A) (hQ : ProjRep0 5 (map3 dec Q) B) :
    ProjRep0 5 (map3 dec (emittedAdd L leafSem P Q)) (A + B) := by
  rw [emittedAdd_value hLeaf hReal]
  exact rcb0Add_projRep hb h2 hP hQ

/-- The emitted double: the complete add of a point with itself. -/
def emittedDbl (L : FieldLeaves) (leafSem : LeafSem) (P : WireTriple) : WireTriple :=
  emittedAdd L leafSem P P

/-- **The emitted double computes the group law.** For every input representing `A`, the
emitted double represents `2 • A`. -/
theorem emittedDbl_projRep (hb : ∀ x : K, x ^ 3 + 5 ≠ 0) (h2 : (2 : K) ≠ 0)
    {L : FieldLeaves} {leafSem : LeafSem} {ops : ArithOps FpWire} {dec : FpWire → K}
    (hLeaf : FieldLeafAgrees L ops leafSem) (hReal : OpsRealize ops dec)
    {P : WireTriple} {A : (w0 (5 : K)).toAffine.Point} (hP : ProjRep0 5 (map3 dec P) A) :
    ProjRep0 5 (map3 dec (emittedDbl L leafSem P)) (2 • A) := by
  rw [two_nsmul]
  exact emittedAdd_projRep hb h2 hLeaf hReal hP hP

/-- The value of a most-significant-first bit string. -/
def bitsVal (bits : List Bool) : ℕ :=
  bits.foldl (fun n bit => 2 * n + if bit then 1 else 0) 0

/-- One double-and-add step of the emitted scalar multiplication. -/
def smulStep (L : FieldLeaves) (leafSem : LeafSem) (P acc : WireTriple) (bit : Bool) :
    WireTriple :=
  let d := emittedDbl L leafSem acc
  if bit then emittedAdd L leafSem d P else d

/-- The emitted double-and-add scalar multiplication, most significant bit first, from the
wire triple `O`, with one emitted double and, on a set bit, one emitted add per bit. -/
def emittedSmul (L : FieldLeaves) (leafSem : LeafSem) (O P : WireTriple) (bits : List Bool) :
    WireTriple :=
  bits.foldl (smulStep L leafSem P) O

/-- The double-and-add loop invariant: from an accumulator representing `n • A`, the loop
over `bits` reaches a representation of the matching multiple of `A`. -/
theorem smul_foldl_projRep (hb : ∀ x : K, x ^ 3 + 5 ≠ 0) (h2 : (2 : K) ≠ 0)
    {L : FieldLeaves} {leafSem : LeafSem} {ops : ArithOps FpWire} {dec : FpWire → K}
    (hLeaf : FieldLeafAgrees L ops leafSem) (hReal : OpsRealize ops dec)
    {P : WireTriple} {A : (w0 (5 : K)).toAffine.Point} (hP : ProjRep0 5 (map3 dec P) A) :
    ∀ (bits : List Bool) (acc : WireTriple) (n : ℕ), ProjRep0 5 (map3 dec acc) (n • A) →
      ProjRep0 5 (map3 dec (bits.foldl (smulStep L leafSem P) acc))
        ((bits.foldl (fun n bit => 2 * n + if bit then 1 else 0) n) • A) := by
  intro bits
  induction bits with
  | nil => intro acc n h; exact h
  | cons bit bits ih =>
    intro acc n h
    simp only [List.foldl_cons]
    apply ih
    have hd := emittedDbl_projRep hb h2 hLeaf hReal h
    rw [← mul_nsmul'] at hd
    cases bit with
    | false => simpa [smulStep] using hd
    | true =>
      have ha := emittedAdd_projRep hb h2 hLeaf hReal hd hP
      simpa [smulStep, add_nsmul, mul_comm] using ha

/-- **The emitted scalar multiplication computes the group law.** When `O` represents the
identity and `P` represents `A`, the emitted double-and-add over `bits` represents
`bitsVal bits • A`, for every bit string. -/
theorem emittedSmul_projRep (hb : ∀ x : K, x ^ 3 + 5 ≠ 0) (h2 : (2 : K) ≠ 0)
    {L : FieldLeaves} {leafSem : LeafSem} {ops : ArithOps FpWire} {dec : FpWire → K}
    (hLeaf : FieldLeafAgrees L ops leafSem) (hReal : OpsRealize ops dec)
    {O P : WireTriple} {A : (w0 (5 : K)).toAffine.Point}
    (hO : ProjRep0 5 (map3 dec O) 0) (hP : ProjRep0 5 (map3 dec P) A) (bits : List Bool) :
    ProjRep0 5 (map3 dec (emittedSmul L leafSem O P bits)) (bitsVal bits • A) :=
  smul_foldl_projRep hb h2 hLeaf hReal hP bits O 0 (by rwa [zero_nsmul])

end GroupLaw

/-! ## 6. The canonical little-endian codec -/

/-- Little-endian value of an `n`-byte array. -/
def leDecode {n : ℕ} (w : Fin n → BitVec 8) : ℕ := ∑ i : Fin n, (w i).toNat * 256 ^ (i : ℕ)

/-- The `n` little-endian base-256 digits of `v`. -/
def leEncode (n v : ℕ) : Fin n → BitVec 8 :=
  fun i => BitVec.ofNat 8 (v / 256 ^ (i : ℕ) % 256)

/-- The first `n` base-256 digits of `v` recompose `v % 256 ^ n`. -/
theorem sum_digits (v : ℕ) :
    ∀ n : ℕ, ∑ i : Fin n, v / 256 ^ (i : ℕ) % 256 * 256 ^ (i : ℕ) = v % 256 ^ n := by
  intro n
  induction n with
  | zero => simp [Nat.mod_one]
  | succ n ih =>
    rw [Fin.sum_univ_castSucc]
    simp only [Fin.val_castSucc, Fin.val_last, ih]
    rw [Nat.mod_pow_succ]
    ring

/-- Decoding the encoding of `v` gives `v % 256 ^ n`. -/
theorem leDecode_leEncode (n v : ℕ) : leDecode (leEncode n v) = v % 256 ^ n := by
  unfold leDecode leEncode
  simp only [BitVec.toNat_ofNat]
  rw [← sum_digits v n]
  refine Finset.sum_congr rfl fun i _ => ?_
  norm_num [Nat.mod_mod]

/-- Decode a wire field element as a residue modulo `p`. -/
def canonDec (p : ℕ) (w : FpWire) : ZMod p := (leDecode w : ZMod p)

/-- Encode a residue modulo `p` as its canonical representative in little-endian bytes. -/
def canonEnc (p : ℕ) [NeZero p] (x : ZMod p) : FpWire := leEncode FESZ x.val

/-- `canonDec` inverts `canonEnc` when `p ≤ 256 ^ 32`. -/
theorem canonDec_canonEnc {p : ℕ} [NeZero p] (hp : p ≤ 256 ^ FESZ) (x : ZMod p) :
    canonDec p (canonEnc p x) = x := by
  unfold canonDec canonEnc
  rw [leDecode_leEncode, Nat.mod_eq_of_lt (lt_of_lt_of_le (ZMod.val_lt x) hp),
    ZMod.natCast_zmod_val]

/-- The wire arithmetic that decodes both operands, operates in `ZMod p`, and re-encodes. -/
def canonOps (p : ℕ) [NeZero p] : ArithOps FpWire where
  mul a b := canonEnc p (canonDec p a * canonDec p b)
  add a b := canonEnc p (canonDec p a + canonDec p b)
  sub a b := canonEnc p (canonDec p a - canonDec p b)

/-- Read through `canonDec p`, the canonical wire arithmetic is the field arithmetic of
`ZMod p`. -/
theorem canonOps_realize {p : ℕ} [Fact p.Prime] (hp : p ≤ 256 ^ FESZ) :
    OpsRealize (canonOps p) (canonDec p) where
  mul _ _ := canonDec_canonEnc hp _
  add _ _ := canonDec_canonEnc hp _
  sub _ _ := canonDec_canonEnc hp _

/-- Encode a coordinate triple. -/
def enc3 (p : ℕ) [NeZero p] (t : ZMod p × ZMod p × ZMod p) : WireTriple :=
  (canonEnc p t.1, canonEnc p t.2.1, canonEnc p t.2.2)

/-- `map3 (canonDec p)` inverts `enc3 p`. -/
theorem map3_enc3 {p : ℕ} [NeZero p] (hp : p ≤ 256 ^ FESZ) (t : ZMod p × ZMod p × ZMod p) :
    map3 (canonDec p) (enc3 p t) = t := by
  obtain ⟨a, b, c⟩ := t
  simp only [map3, enc3, canonDec_canonEnc hp]

/-! ## 7. Pallas and Vesta -/

/-- The Pallas base-field leaf symbols. -/
def pallasLeaves : FieldLeaves := ⟨"pallas_fp_mul", "pallas_fp_add", "pallas_fp_sub"⟩

/-- The Vesta base-field leaf symbols. -/
def vestaLeaves : FieldLeaves := ⟨"vesta_fp_mul", "vesta_fp_add", "vesta_fp_sub"⟩

/-- A leaf oracle computing `ops` on the three Pallas base-field leaf symbols, dispatched by
name and signature, and `JasminTy.default` on every other leaf. -/
def pallasFieldOracle (ops : ArithOps FpWire) : LeafSem :=
  fun name argTys retTy =>
    match name, argTys, retTy with
    | "pallas_fp_mul", [.stackArr 8 32, .stackArr 8 32], .stackArr 8 32 =>
        fun args => ops.mul args.head args.tail.head
    | "pallas_fp_add", [.stackArr 8 32, .stackArr 8 32], .stackArr 8 32 =>
        fun args => ops.add args.head args.tail.head
    | "pallas_fp_sub", [.stackArr 8 32, .stackArr 8 32], .stackArr 8 32 =>
        fun args => ops.sub args.head args.tail.head
    | _, _, retTy => fun _ => JasminTy.default retTy

/-- A leaf oracle computing `ops` on the three Vesta base-field leaf symbols, dispatched by
name and signature, and `JasminTy.default` on every other leaf. -/
def vestaFieldOracle (ops : ArithOps FpWire) : LeafSem :=
  fun name argTys retTy =>
    match name, argTys, retTy with
    | "vesta_fp_mul", [.stackArr 8 32, .stackArr 8 32], .stackArr 8 32 =>
        fun args => ops.mul args.head args.tail.head
    | "vesta_fp_add", [.stackArr 8 32, .stackArr 8 32], .stackArr 8 32 =>
        fun args => ops.add args.head args.tail.head
    | "vesta_fp_sub", [.stackArr 8 32, .stackArr 8 32], .stackArr 8 32 =>
        fun args => ops.sub args.head args.tail.head
    | _, _, retTy => fun _ => JasminTy.default retTy

/-- The Pallas oracle satisfies the leaf agreement for `ops`. -/
theorem pallasFieldOracle_agrees (ops : ArithOps FpWire) :
    FieldLeafAgrees pallasLeaves ops (pallasFieldOracle ops) :=
  ⟨fun _ _ => rfl, fun _ _ => rfl, fun _ _ => rfl⟩

/-- The Vesta oracle satisfies the leaf agreement for `ops`. -/
theorem vestaFieldOracle_agrees (ops : ArithOps FpWire) :
    FieldLeafAgrees vestaLeaves ops (vestaFieldOracle ops) :=
  ⟨fun _ _ => rfl, fun _ _ => rfl, fun _ _ => rfl⟩

/-- `pallasQ` fits in 32 bytes. -/
theorem pallasQ_le : pallasQ ≤ 256 ^ FESZ := by
  unfold pallasQ FESZ; norm_num

/-- `vestaQ` fits in 32 bytes. -/
theorem vestaQ_le : vestaQ ≤ 256 ^ FESZ := by
  unfold vestaQ FESZ; norm_num

/-- The Pasta base point `(−1, 2)` of `y² = x³ + 5`, over a field in which `x³ + 5` has no
root and `2 ≠ 0`. -/
def pastaG {K : Type} [Field K] (hb : ∀ x : K, x ^ 3 + 5 ≠ 0) (h2 : (2 : K) ≠ 0) :
    (w0 (5 : K)).toAffine.Point :=
  .some (x := -1) (y := 2) (w0_nonsingular hb h2 (by norm_num))

open scoped CatCrypt.Crypto.Pairing.PastaCompleteAdd

/-- The Pallas base point `(−1, 2)`. -/
def pallasG : (w0 (5 : ZMod pallasQ)).toAffine.Point :=
  pastaG pallas_cubic_no_root pallasQ_two_ne_zero

/-- The Vesta base point `(−1, 2)`. -/
def vestaG : (w0 (5 : ZMod vestaQ)).toAffine.Point :=
  pastaG vesta_cubic_no_root vestaQ_two_ne_zero

/-- The encoded identity `(0, 1, 0)` represents the identity. -/
theorem projRep_identity {p : ℕ} [Fact p.Prime] (hp : p ≤ 256 ^ FESZ) :
    ProjRep0 (5 : ZMod p) (map3 (canonDec p) (enc3 p (0, 1, 0))) 0 := by
  rw [map3_enc3 hp]
  exact ⟨rfl, rfl, one_ne_zero⟩

/-- The encoded triple `(−1, 2, 1)` represents the base point. -/
theorem projRep_pastaG {p : ℕ} [Fact p.Prime] (hp : p ≤ 256 ^ FESZ)
    (hb : ∀ x : ZMod p, x ^ 3 + 5 ≠ 0) (h2 : (2 : ZMod p) ≠ 0) :
    ProjRep0 (5 : ZMod p) (map3 (canonDec p) (enc3 p (-1, 2, 1))) (pastaG hb h2) := by
  rw [map3_enc3 hp]
  exact ⟨one_ne_zero, by ring, by ring⟩

/-- **Pallas scalar multiplication.** The emitted double-and-add over `bits`, from the
encoded identity and the encoded base point, under the Pallas field-leaf oracle for the
canonical field arithmetic, represents `bitsVal bits • G`. -/
theorem pallas_emittedSmul_G (bits : List Bool) :
    ProjRep0 (5 : ZMod pallasQ)
      (map3 (canonDec pallasQ)
        (emittedSmul pallasLeaves (pallasFieldOracle (canonOps pallasQ))
          (enc3 pallasQ (0, 1, 0)) (enc3 pallasQ (-1, 2, 1)) bits))
      (bitsVal bits • pallasG) :=
  emittedSmul_projRep pallas_cubic_no_root pallasQ_two_ne_zero
    (pallasFieldOracle_agrees _) (canonOps_realize pallasQ_le)
    (projRep_identity pallasQ_le) (projRep_pastaG pallasQ_le _ _) bits

/-- **Vesta scalar multiplication.** The emitted double-and-add over `bits`, from the
encoded identity and the encoded base point, under the Vesta field-leaf oracle for the
canonical field arithmetic, represents `bitsVal bits • G`. -/
theorem vesta_emittedSmul_G (bits : List Bool) :
    ProjRep0 (5 : ZMod vestaQ)
      (map3 (canonDec vestaQ)
        (emittedSmul vestaLeaves (vestaFieldOracle (canonOps vestaQ))
          (enc3 vestaQ (0, 1, 0)) (enc3 vestaQ (-1, 2, 1)) bits))
      (bitsVal bits • vestaG) :=
  emittedSmul_projRep vesta_cubic_no_root vestaQ_two_ne_zero
    (vestaFieldOracle_agrees _) (canonOps_realize vestaQ_le)
    (projRep_identity vestaQ_le) (projRep_pastaG vestaQ_le _ _) bits

/-- **Pallas point add.** Under the Pallas field-leaf oracle for the canonical field
arithmetic, the emitted add of wire triples representing `A` and `B` represents `A + B`,
for all points. -/
theorem pallas_emittedAdd_projRep {P Q : WireTriple}
    {A B : (w0 (5 : ZMod pallasQ)).toAffine.Point}
    (hP : ProjRep0 5 (map3 (canonDec pallasQ) P) A)
    (hQ : ProjRep0 5 (map3 (canonDec pallasQ) Q) B) :
    ProjRep0 5 (map3 (canonDec pallasQ)
      (emittedAdd pallasLeaves (pallasFieldOracle (canonOps pallasQ)) P Q)) (A + B) :=
  emittedAdd_projRep pallas_cubic_no_root pallasQ_two_ne_zero
    (pallasFieldOracle_agrees _) (canonOps_realize pallasQ_le) hP hQ

/-- **Vesta point add.** Under the Vesta field-leaf oracle for the canonical field
arithmetic, the emitted add of wire triples representing `A` and `B` represents `A + B`,
for all points. -/
theorem vesta_emittedAdd_projRep {P Q : WireTriple}
    {A B : (w0 (5 : ZMod vestaQ)).toAffine.Point}
    (hP : ProjRep0 5 (map3 (canonDec vestaQ) P) A)
    (hQ : ProjRep0 5 (map3 (canonDec vestaQ) Q) B) :
    ProjRep0 5 (map3 (canonDec vestaQ)
      (emittedAdd vestaLeaves (vestaFieldOracle (canonOps vestaQ)) P Q)) (A + B) :=
  emittedAdd_projRep vesta_cubic_no_root vestaQ_two_ne_zero
    (vestaFieldOracle_agrees _) (canonOps_realize vestaQ_le) hP hQ

end CatCrypt.Crypto.Pairing.PastaGroupEmit
