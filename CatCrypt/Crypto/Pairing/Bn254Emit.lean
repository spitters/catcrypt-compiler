/-!
# Production BN254 (alt-bn128) emit: G1/G2 group leaves, the pairing leaf, the
  G1 MSM reduction, and the EIP-197 pairing-product verifier

The BN254 analogue of `Bls12381Emit.lean`: the same
`VectorReduce.scalarFold_eq_hsum` core over the production BN254 G1 additive
group, the same opaque-leaf edge (`EcLeafAgrees`), plus the **pairing** (Miller
loop + final exponentiation) as a separate opaque leaf (`PairingLeafAgrees`).
With the pairing leaf in hand we emit the **EIP-197 pairing-product verifier**
(`Π_i e(P_i, Q_i) = 1`) as a straight-line `Com` of pairing / Fp12-multiply
leaves.

BN254 (alt-bn128) is the Ethereum precompile curve (EIP-196 `bn256Add`, EIP-197
`bn256Pairing`); it is also the pairing of choice for CP-ABE. The base field is
the 254-bit prime
`p = 21888242871839275222246405745257275088696311157297823662689037894645226208583`
and the curve is `y² = x³ + 3` with standard generator `G1 = (1, 2)`.

## No new machinery — the AUCurves-leaf story

The positioning is exactly the `Bls12381Emit` AUCurves-leaf pattern: the
field/group/pairing primitives are **leaves** (no new VIR machinery), emitted as
opaque `extCall`s whose *agreement* ties the opaque leaf to the abstract
primitive. The production witness is the AUCurves verified-bedrock2 BN254 tower
(AUCurves, `bn254-safe-rust` crate: the safe Rust `Fp/Fp2/Fp6/Fp12`
tower generated by `ToSafeRustBody.v` over the verified fiat leaves, plus
`miller_loop` / `pairing` / `pairing_optimal` / `fp12_mul`). The KAT
(`bench/bn254_compare/`) cross-checks the emitted-equation denotation against
that reference on the **published EIP-196 / EIP-197 vectors** (standard generator
`G1 = (1,2)`, the standard G2 generator, and the small multiples
`2G1, 3G1, 5G1, 10G1` from `bn254-safe-rust/tests/kat_vectors.rs`).

* the **G1 MSM reduction** (`g1MsmFold_eq_msm`) is `MsmReduce.msm_eq_scalarFold`
  at the production BN254 G1 `AddCommMonoid` lane — no new content;
* the **EIP-197 verifier** is a straight-line composition of pairing / Fp12-mul
  leaves, with a denotation-preservation theorem reducing the `Com` to the
  abstract product of pairings. The theorem takes the leaf model as a parameter
  `leafSem`, denotes the `Com` through `jasminDenoteWith leafSem`, and assumes the
  agreements at that `leafSem`; `Bn254Denote.bn254Oracle` satisfies them for every
  `prims`.

## What AUCurves verifies vs. what stays trusted

AUCurves verifies the **field/pairing tower** (the fiat `Fp` leaves + the
machine-extracted `Fp2/Fp6/Fp12` tower + `miller_loop` + final exp). The **G1/G2
group add law** is *built from* those verified field ops and stays the trusted
leaf edge (`EcLeafAgrees`), the same stance as `Bls12381Emit`.

NOTE (BN254 specifics): `bn254-safe-rust` ships two pairing entry points. The
optimal-ate `pairing_optimal` (with the Frobenius corrections fix) is the one
whose bilinearity / multi-pairing EIP-197 KAT vectors check; the non-optimal
`pairing` has a known make_line basis bug that cancels only in the negation
symmetry `e(P,Q)·e(−P,Q)=1`. The emitted verifier therefore binds the pairing
leaf to `pairing_optimal` (see `bench/bn254_compare/bn254_kat.rs`).

## Wire layout (production widths)

A BN254 base-field element `Fp` is 4 little-endian `u64` limbs = `32` bytes
(`FPSZ`), matching the AUCurves `Fp([u64;4])` layout. On the wire:
* a **G1 point** is `(x ‖ y)`, two `Fp`s = `2·FPSZ = 64` bytes;
* a **G2 point** is `(x ‖ y)` over `Fp2 = Fp × Fp`, four `Fp`s = `4·FPSZ = 128`
  bytes;
* the pairing output **GT = Fp12** is twelve `Fp`s = `12·FPSZ = 384` bytes.

All goals closed; the only hypotheses are the opaque-leaf agreements
(`EcLeafAgrees` / `PairingLeavesAgree`) at the leaf-model parameter `leafSem`.
-/

@[expose] public section

set_option autoImplicit false

namespace CatCrypt.Crypto.Pairing.Bn254Emit

open CatCrypt.Crypto.SecureCompilation.VIR
open CatCrypt.Crypto.SecureCompilation.VIR.JasminDialect
open CatCrypt.Crypto.SecureCompilation.VIR.VectorReduce
open CatCrypt.Crypto.SecureCompilation.Dialects.OrchestrationFront
open scoped BigOperators

/-! ## 1. Production wire widths -/

/-- A BN254 base-field element `Fp` on the wire: `32` bytes (4 little-endian `u64`
    limbs), matching the AUCurves `Fp([u64;4])` layout. -/
def FPSZ : Nat := 32

/-- A G1 point on the wire: `(x ‖ y)`, two `Fp`s = `64` bytes. -/
def G1SZ : Nat := 2 * FPSZ

/-- A G2 point on the wire: `(x ‖ y)` over `Fp2`, four `Fp`s = `128` bytes. -/
def G2SZ : Nat := 4 * FPSZ

/-- A GT element `Fp12` on the wire: twelve `Fp`s = `384` bytes. -/
def GTSZ : Nat := 12 * FPSZ

/-! ## 2. The G1 MSM reduction over the production group (the result) -/

section MSM

variable {G1 : Type*} [AddCommMonoid G1] {L : ℕ}

/-- The MSM as the **horizontal reduction** `hsum` over the BN254 G1 group. -/
def msm (k : Fin L → ℕ) (P : Fin L → G1) : G1 :=
  hsum (fun i => (k i) • (P i))

/-- The MSM as the **sequential left-fold** `scalarFold` the emitter produces. -/
def g1MsmFold (k : Fin L → ℕ) (P : Fin L → G1) : G1 :=
  scalarFold (fun i => (k i) • (P i))

/-- **THE RESULT (BN254 G1 lane).** The BN254 G1 MSM reduces to
    `scalarFold` over the production G1 `AddCommMonoid`. This is
    `VectorReduce.scalarFold_eq_hsum` at the BN254 G1 lane — no new content. -/
theorem g1MsmFold_eq_msm (k : Fin L → ℕ) (P : Fin L → G1) :
    g1MsmFold k P = msm k P :=
  scalarFold_eq_hsum (fun i => (k i) • (P i))

/-- The BN254 G1 MSM computes the mathematical multi-scalar multiplication
    `Σ_i k_i · P_i`. -/
theorem msm_isSum (k : Fin L → ℕ) (P : Fin L → G1) :
    msm k P = ∑ i, (k i) • (P i) := by
  simp only [msm, hsum]

end MSM

/-! ## 3. The EC + pairing leaf spec (opaque `extCall`, carried agreement) -/

/-- The leaf name the front emits for G1 point-add. -/
def g1AddLeafName : String := "bn254_g1_add"
/-- The leaf name the front emits for G1 scalar-multiply. -/
def g1MulLeafName : String := "bn254_g1_scalar_mul"
/-- The leaf name the front emits for G2 point-add. -/
def g2AddLeafName : String := "bn254_g2_add"
/-- The leaf name the front emits for G2 scalar-multiply. -/
def g2MulLeafName : String := "bn254_g2_scalar_mul"
/-- The leaf name the front emits for the BN254 pairing (Miller loop + final
    exp). The AUCurves verified witness is `pairing_optimal`. -/
def pairingLeafName : String := "bn254_pairing"
/-- The leaf name the front emits for the GT (`Fp12`) multiply (AUCurves
    `fp12_mul`). -/
def fp12MulLeafName : String := "bn254_fp12_mul"

/-! ### Dialect signatures (production widths) -/

/-- G1 point-add leaf signature. -/
def g1AddArgTys : List JasminTy := [.stackArr 8 G1SZ, .stackArr 8 G1SZ]
/-- G1 scalar-mul leaf signature. -/
def g1MulArgTys : List JasminTy := [.stackArr 8 FPSZ, .stackArr 8 G1SZ]
/-- Both G1 leaves return a G1 point. -/
def g1RetTy : JasminTy := .stackArr 8 G1SZ

/-- G2 point-add leaf signature. -/
def g2AddArgTys : List JasminTy := [.stackArr 8 G2SZ, .stackArr 8 G2SZ]
/-- G2 scalar-mul leaf signature. -/
def g2MulArgTys : List JasminTy := [.stackArr 8 FPSZ, .stackArr 8 G2SZ]
/-- Both G2 leaves return a G2 point. -/
def g2RetTy : JasminTy := .stackArr 8 G2SZ

/-- Pairing leaf signature: `(P : stackArr 8 G1SZ, Q : stackArr 8 G2SZ) → GT`. -/
def pairingArgTys : List JasminTy := [.stackArr 8 G1SZ, .stackArr 8 G2SZ]
/-- The pairing leaf returns a GT (`Fp12`) element. -/
def gtRetTy : JasminTy := .stackArr 8 GTSZ

/-- GT-multiply leaf signature. -/
def fp12MulArgTys : List JasminTy := [.stackArr 8 GTSZ, .stackArr 8 GTSZ]

/-- The leaf-semantics carrier (reusing `MsmReduce.EcLeafSem`). -/
abbrev LeafSem : Type := MsmReduce.EcLeafSem

/-- The abstract BN254 primitive interface: G1/G2 point-add + scalar-multiply, the
    pairing `e`, and the GT product, on the on-wire byte representations. -/
structure Bn254Primitives where
  /-- G1 point addition `P + Q`. -/
  g1Add : (Fin G1SZ → BitVec 8) → (Fin G1SZ → BitVec 8) → (Fin G1SZ → BitVec 8)
  /-- G1 scalar multiplication `k · P`. -/
  g1Mul : (Fin FPSZ → BitVec 8) → (Fin G1SZ → BitVec 8) → (Fin G1SZ → BitVec 8)
  /-- G2 point addition `P + Q`. -/
  g2Add : (Fin G2SZ → BitVec 8) → (Fin G2SZ → BitVec 8) → (Fin G2SZ → BitVec 8)
  /-- G2 scalar multiplication `k · P`. -/
  g2Mul : (Fin FPSZ → BitVec 8) → (Fin G2SZ → BitVec 8) → (Fin G2SZ → BitVec 8)
  /-- The BN254 pairing `e(P, Q) : GT` (Miller loop + final exponentiation). -/
  pairing : (Fin G1SZ → BitVec 8) → (Fin G2SZ → BitVec 8) → (Fin GTSZ → BitVec 8)
  /-- The GT (`Fp12`) product `a · b`. -/
  fp12Mul : (Fin GTSZ → BitVec 8) → (Fin GTSZ → BitVec 8) → (Fin GTSZ → BitVec 8)

/-! ### Per-leaf agreements (opaque leaf realises the abstract primitive) -/

/-- G1 point-add leaf agreement. -/
def G1AddLeafAgrees (prims : Bn254Primitives) (leafSem : LeafSem) : Prop :=
  ∀ args : HVector (fun t => ⟦t⟧) g1AddArgTys,
    leafSem g1AddLeafName g1AddArgTys g1RetTy args = prims.g1Add (args.head) (args.tail.head)

/-- G1 scalar-mul leaf agreement. -/
def G1MulLeafAgrees (prims : Bn254Primitives) (leafSem : LeafSem) : Prop :=
  ∀ args : HVector (fun t => ⟦t⟧) g1MulArgTys,
    leafSem g1MulLeafName g1MulArgTys g1RetTy args = prims.g1Mul (args.head) (args.tail.head)

/-- G2 point-add leaf agreement. -/
def G2AddLeafAgrees (prims : Bn254Primitives) (leafSem : LeafSem) : Prop :=
  ∀ args : HVector (fun t => ⟦t⟧) g2AddArgTys,
    leafSem g2AddLeafName g2AddArgTys g2RetTy args = prims.g2Add (args.head) (args.tail.head)

/-- G2 scalar-mul leaf agreement. -/
def G2MulLeafAgrees (prims : Bn254Primitives) (leafSem : LeafSem) : Prop :=
  ∀ args : HVector (fun t => ⟦t⟧) g2MulArgTys,
    leafSem g2MulLeafName g2MulArgTys g2RetTy args = prims.g2Mul (args.head) (args.tail.head)

/-- **Pairing leaf agreement.** On the `bn254_pairing` signature, the leaf
    semantics is `prims.pairing` of its G1 + G2 arguments — the opaque-leaf edge
    for the Miller loop + final exponentiation. The AUCurves verified
    `pairing_optimal` is the intended witness. -/
def PairingLeafAgrees (prims : Bn254Primitives) (leafSem : LeafSem) : Prop :=
  ∀ args : HVector (fun t => ⟦t⟧) pairingArgTys,
    leafSem pairingLeafName pairingArgTys gtRetTy args
      = prims.pairing (args.head) (args.tail.head)

/-- GT-multiply leaf agreement (the pairing-product accumulator). -/
def Fp12MulLeafAgrees (prims : Bn254Primitives) (leafSem : LeafSem) : Prop :=
  ∀ args : HVector (fun t => ⟦t⟧) fp12MulArgTys,
    leafSem fp12MulLeafName fp12MulArgTys gtRetTy args
      = prims.fp12Mul (args.head) (args.tail.head)

/-- The full EC-leaf agreement: the leaf realises G1 + G2 point-add and scalar-mul.
    The AUCurves-field-backed group leaves are the intended witness
    (`bench/bn254_compare/`). -/
def EcLeafAgrees (prims : Bn254Primitives) (leafSem : LeafSem) : Prop :=
  G1AddLeafAgrees prims leafSem ∧ G1MulLeafAgrees prims leafSem ∧
    G2AddLeafAgrees prims leafSem ∧ G2MulLeafAgrees prims leafSem

/-- The full pairing-side agreement: the pairing leaf and the GT-multiply leaf
    both agree with the abstract primitives. AUCurves `pairing_optimal` +
    `fp12_mul` are the intended witnesses. -/
def PairingLeavesAgree (prims : Bn254Primitives) (leafSem : LeafSem) : Prop :=
  PairingLeafAgrees prims leafSem ∧ Fp12MulLeafAgrees prims leafSem

/-! ## 4. Leaf `Expr` builders + denotation (the `extCall` bridge point) -/

/-- Build the G1 point-add leaf `Expr`. -/
def g1AddLeafExpr {Γ : Ctxt jasminDialect} (P Q : Ctxt.Var Γ (.stackArr 8 G1SZ)) :
    Expr jasminDialect Γ g1RetTy :=
  { op := .extCall g1AddLeafName g1AddArgTys g1RetTy, retTy_eq := rfl,
    args := .cons P (.cons Q .nil) }

/-- Build the G1 scalar-mul leaf `Expr`. -/
def g1MulLeafExpr {Γ : Ctxt jasminDialect}
    (k : Ctxt.Var Γ (.stackArr 8 FPSZ)) (P : Ctxt.Var Γ (.stackArr 8 G1SZ)) :
    Expr jasminDialect Γ g1RetTy :=
  { op := .extCall g1MulLeafName g1MulArgTys g1RetTy, retTy_eq := rfl,
    args := .cons k (.cons P .nil) }

/-- Build the BN254 pairing leaf `Expr` from a G1 point and a G2 point. -/
def pairingLeafExpr {Γ : Ctxt jasminDialect}
    (P : Ctxt.Var Γ (.stackArr 8 G1SZ)) (Q : Ctxt.Var Γ (.stackArr 8 G2SZ)) :
    Expr jasminDialect Γ gtRetTy :=
  { op := .extCall pairingLeafName pairingArgTys gtRetTy, retTy_eq := rfl,
    args := .cons P (.cons Q .nil) }

/-- Build the GT-multiply leaf `Expr` from two GT (`Fp12`) variables. -/
def fp12MulLeafExpr {Γ : Ctxt jasminDialect}
    (a b : Ctxt.Var Γ (.stackArr 8 GTSZ)) :
    Expr jasminDialect Γ gtRetTy :=
  { op := .extCall fp12MulLeafName fp12MulArgTys gtRetTy, retTy_eq := rfl,
    args := .cons a (.cons b .nil) }

/-- Denoted through `jasminDenoteWith leafSem`, the G1 point-add leaf `Expr` is
    `leafSem` of the looked-up points. By `rfl`. -/
theorem g1AddLeafExpr_denote (leafSem : LeafSem) {Γ : Ctxt jasminDialect}
    (P Q : Ctxt.Var Γ (.stackArr 8 G1SZ)) (V : Ctxt.Valuation Γ) :
    @Expr.denote _ _ _ (jasminDenoteWith leafSem) _ _ (g1AddLeafExpr P Q) V
      = leafSem g1AddLeafName g1AddArgTys g1RetTy
          (.cons (P.lookup V) (.cons (Q.lookup V) .nil)) :=
  rfl

/-- Denoted through `jasminDenoteWith leafSem`, the G1 scalar-mul leaf `Expr` is
    `leafSem` of the looked-up scalar and point. By `rfl`. -/
theorem g1MulLeafExpr_denote (leafSem : LeafSem) {Γ : Ctxt jasminDialect}
    (k : Ctxt.Var Γ (.stackArr 8 FPSZ)) (P : Ctxt.Var Γ (.stackArr 8 G1SZ))
    (V : Ctxt.Valuation Γ) :
    @Expr.denote _ _ _ (jasminDenoteWith leafSem) _ _ (g1MulLeafExpr k P) V
      = leafSem g1MulLeafName g1MulArgTys g1RetTy
          (.cons (k.lookup V) (.cons (P.lookup V) .nil)) :=
  rfl

/-- Denoted through `jasminDenoteWith leafSem`, the pairing leaf `Expr` is
    `leafSem` of the looked-up G1 and G2 points. By `rfl`; `PairingLeafAgrees`
    at `leafSem` rewrites it to `prims.pairing`. -/
theorem pairingLeafExpr_denote (leafSem : LeafSem) {Γ : Ctxt jasminDialect}
    (P : Ctxt.Var Γ (.stackArr 8 G1SZ)) (Q : Ctxt.Var Γ (.stackArr 8 G2SZ))
    (V : Ctxt.Valuation Γ) :
    @Expr.denote _ _ _ (jasminDenoteWith leafSem) _ _ (pairingLeafExpr P Q) V
      = leafSem pairingLeafName pairingArgTys gtRetTy
          (.cons (P.lookup V) (.cons (Q.lookup V) .nil)) :=
  rfl

/-- Denoted through `jasminDenoteWith leafSem`, the GT-multiply leaf `Expr` is
    `leafSem` of the looked-up GT operands. By `rfl`. -/
theorem fp12MulLeafExpr_denote (leafSem : LeafSem) {Γ : Ctxt jasminDialect}
    (a b : Ctxt.Var Γ (.stackArr 8 GTSZ)) (V : Ctxt.Valuation Γ) :
    @Expr.denote _ _ _ (jasminDenoteWith leafSem) _ _ (fp12MulLeafExpr a b) V
      = leafSem fp12MulLeafName fp12MulArgTys gtRetTy
          (.cons (a.lookup V) (.cons (b.lookup V) .nil)) :=
  rfl

/-! ## 5. One G1 MSM term, with the denotation carry -/

/-- One G1 MSM step as an orchestrating `Com` over `(acc, k, P)` — the
    hand-authored **shadow**. The `scalarFold` body `acc ↦ acc + k_i·P_i`, built
    from the two G1 leaves with explicit de-Bruijn operand chains. The deployed
    `g1MsmTermCom` below is front-sourced through `buildOrchCom` and proven equal
    to this shadow (`g1MsmTermCom_eq_shadow`), which carries the value semantics. -/
def g1MsmTermComShadow :
    Com jasminDialect
      [.stackArr 8 G1SZ, .stackArr 8 FPSZ, .stackArr 8 G1SZ]
      (.stackArr 8 G1SZ) :=
  .var (g1MulLeafExpr
          (Γ := [.stackArr 8 G1SZ, .stackArr 8 FPSZ, .stackArr 8 G1SZ])
          (.there .here) (.there (.there .here)))
    (.var (g1AddLeafExpr
            (Γ := [.stackArr 8 G1SZ, .stackArr 8 G1SZ,
                   .stackArr 8 FPSZ, .stackArr 8 G1SZ])
            (.there .here) .here)
      (.ret .here))

/-- Input buffer context for the MSM step: `[acc : G1, k : Fp, P : G1]` (root
    slots from the tail: `P = 0`, `k = 1`, `acc = 2`). -/
def g1MsmTermCtxt : Ctxt jasminDialect :=
  [.stackArr 8 G1SZ, .stackArr 8 FPSZ, .stackArr 8 G1SZ]

/-- The MSM step as a front phase schedule: `m = k·P`, `out = acc + m`. -/
def g1MsmTermSchedule : List CallPhase :=
  [ { leaf := g1MulLeafName, argTys := g1MulArgTys, retTy := g1RetTy,
      argSlots := [1, 0] }              -- m = k · P   (k = slot 1, P = slot 0)
  , { leaf := g1AddLeafName, argTys := g1AddArgTys, retTy := g1RetTy,
      argSlots := [2, 3] } ]           -- out = acc + m  (acc = slot 2, m = slot 3)

/-- **Generation gate.** The front resolves the MSM-term schedule. -/
theorem g1MsmTermCom_isSome :
    (buildOrchCom g1MsmTermCtxt g1MsmTermSchedule 4 g1RetTy).isSome = true := by
  rfl

/-- One G1 MSM step, **front-sourced** through `OrchestrationFront.buildOrchCom`
    (the deployed `Com` — `EcPairingEmit` lowers this via `toLprogArrAbi`).
    The de-Bruijn operand chains are resolved from the root-order slots, not
    hand-threaded. -/
def g1MsmTermCom : Com jasminDialect g1MsmTermCtxt g1RetTy :=
  (buildOrchCom g1MsmTermCtxt g1MsmTermSchedule 4 g1RetTy).get g1MsmTermCom_isSome

/-- **Exactness.** The front generates *definitionally* the hand-authored shadow,
    so the shadow's value semantics and the array-ABI lowering transfer verbatim. -/
theorem g1MsmTermCom_eq_shadow : g1MsmTermCom = g1MsmTermComShadow := by rfl

/-- **The deployed G1 MSM step, evaluated with a leaf oracle.** For a leaf oracle
    `leafSem` realising the G1 group primitives (`EcLeafAgrees prims leafSem`), the
    deployed `g1MsmTermCom`, denoted through `jasminDenoteWith leafSem`, computes
    `prims.g1Add acc (prims.g1Mul k P)` (the `scalarFold` step `acc + k·P`). The
    leaf model is the parameter `leafSem`; `Bn254Denote` instantiates it. -/
theorem g1MsmTermCom_denote (leafSem : LeafSem) (prims : Bn254Primitives)
    (hLeaf : EcLeafAgrees prims leafSem)
    (acc : Fin G1SZ → BitVec 8) (k : Fin FPSZ → BitVec 8) (P : Fin G1SZ → BitVec 8) :
    @Com.denote _ _ _ (jasminDenoteWith leafSem) _ _
        g1MsmTermCom (.cons acc (.cons k (.cons P .nil)))
      = prims.g1Add acc (prims.g1Mul k P) := by
  rw [g1MsmTermCom_eq_shadow]
  obtain ⟨hAdd, hMul, _, _⟩ := hLeaf
  show leafSem g1AddLeafName g1AddArgTys g1RetTy
        (.cons acc (.cons (leafSem g1MulLeafName g1MulArgTys g1RetTy
                            (.cons k (.cons P .nil))) .nil))
      = prims.g1Add acc (prims.g1Mul k P)
  rw [hMul (.cons k (.cons P .nil))]
  simp only [HVector.head, HVector.tail]
  rw [hAdd (.cons acc (.cons (prims.g1Mul k P) .nil))]
  rfl

/-! ## 6. The EIP-197 pairing-product verifier (straight-line `Com` of leaves)

The Ethereum `bn256Pairing` precompile (EIP-197) checks
`Π_{i} e(P_i, Q_i) = 1` in GT. We emit the canonical 2-pair check
`e(P₁,Q₁) · e(P₂,Q₂)` (the form used for `e(P,Q)·e(−P,Q) = 1`): two pairing
leaves accumulated by one `fp12_mul` leaf. Its denotation through
`jasminDenoteWith leafSem` reduces (under `PairingLeavesAgree prims leafSem`) to `prims.fp12Mul (e P₁ Q₁) (e P₂ Q₂)`; the
caller's final `= 1` test on the denoted GT value is the precompile's result. -/

/-- EIP-197 2-pair product `e(P₁,Q₁) · e(P₂,Q₂)` — the hand-authored **shadow**.
    Two pairing leaves followed by one GT-multiply, with explicit de-Bruijn
    operand chains. ABI: `Γ = [P₁, Q₁, P₂, Q₂]` (G1, G2, G1, G2). The deployed
    `eip197VerifyCom` below is front-sourced and proven equal to this shadow. -/
def eip197VerifyComShadow :
    Com jasminDialect
      [.stackArr 8 G1SZ, .stackArr 8 G2SZ, .stackArr 8 G1SZ, .stackArr 8 G2SZ]
      (.stackArr 8 GTSZ) :=
  -- Γ0 = [P1, Q1, P2, Q2]
  .var (pairingLeafExpr
          (Γ := [.stackArr 8 G1SZ, .stackArr 8 G2SZ, .stackArr 8 G1SZ, .stackArr 8 G2SZ])
          .here (.there .here))                                 -- e1 = e(P1, Q1)
    -- Γ1 = [e1, P1, Q1, P2, Q2]
    (.var (pairingLeafExpr
            (Γ := [.stackArr 8 GTSZ, .stackArr 8 G1SZ, .stackArr 8 G2SZ,
                   .stackArr 8 G1SZ, .stackArr 8 G2SZ])
            (.there (.there (.there .here)))                    -- P2
            (.there (.there (.there (.there .here)))))          -- Q2
      -- Γ2 = [e2, e1, P1, Q1, P2, Q2]
      (.var (fp12MulLeafExpr
              (Γ := [.stackArr 8 GTSZ, .stackArr 8 GTSZ, .stackArr 8 G1SZ,
                     .stackArr 8 G2SZ, .stackArr 8 G1SZ, .stackArr 8 G2SZ])
              (.there .here) .here)                             -- e1 · e2
        (.ret .here)))

/-- Input buffer context for the EIP-197 verifier: `[P₁, Q₁, P₂, Q₂]` (root slots
    from the tail: `Q₂ = 0`, `P₂ = 1`, `Q₁ = 2`, `P₁ = 3`). -/
def eip197VerifyCtxt : Ctxt jasminDialect :=
  [.stackArr 8 G1SZ, .stackArr 8 G2SZ, .stackArr 8 G1SZ, .stackArr 8 G2SZ]

/-- The EIP-197 verifier as a front phase schedule:
    `e₁ = e(P₁,Q₁)`, `e₂ = e(P₂,Q₂)`, `out = e₁ · e₂`. -/
def eip197VerifySchedule : List CallPhase :=
  [ { leaf := pairingLeafName, argTys := pairingArgTys, retTy := gtRetTy,
      argSlots := [3, 2] }              -- e₁ = e(P₁, Q₁)
  , { leaf := pairingLeafName, argTys := pairingArgTys, retTy := gtRetTy,
      argSlots := [1, 0] }              -- e₂ = e(P₂, Q₂)
  , { leaf := fp12MulLeafName, argTys := fp12MulArgTys, retTy := gtRetTy,
      argSlots := [4, 5] } ]           -- out = e₁ · e₂

/-- **Generation gate.** The front resolves the EIP-197 schedule. -/
theorem eip197VerifyCom_isSome :
    (buildOrchCom eip197VerifyCtxt eip197VerifySchedule 6 gtRetTy).isSome = true := by
  rfl

/-- EIP-197 2-pair product, **front-sourced** through
    `OrchestrationFront.buildOrchCom` (the deployed `Com`, lowered by
    `EcPairingEmit`). -/
def eip197VerifyCom : Com jasminDialect eip197VerifyCtxt (.stackArr 8 GTSZ) :=
  (buildOrchCom eip197VerifyCtxt eip197VerifySchedule 6 gtRetTy).get
    eip197VerifyCom_isSome

/-- **Exactness.** The front generates *definitionally* the hand-authored shadow. -/
theorem eip197VerifyCom_eq_shadow : eip197VerifyCom = eip197VerifyComShadow := by rfl

/-- **The deployed EIP-197 verifier, evaluated with a leaf oracle.** For a leaf
    oracle `leafSem` realising the pairing primitives
    (`PairingLeavesAgree prims leafSem`), the deployed `eip197VerifyCom`, denoted
    through `jasminDenoteWith leafSem`, computes
    `prims.fp12Mul (prims.pairing P₁ Q₁) (prims.pairing P₂ Q₂)`. The precompile
    accepts iff this equals `1` in GT. The two `pairing` and one `fp12_mul`
    `extCall` arms each unfold to a `leafSem` call, and the agreements rewrite
    them. The leaf model is the parameter `leafSem`; `Eip197Denote` and
    `Bn254PairingTransport` instantiate it. -/
theorem eip197VerifyCom_denote (leafSem : LeafSem) (prims : Bn254Primitives)
    (hPair : PairingLeavesAgree prims leafSem)
    (p1 : Fin G1SZ → BitVec 8) (q1 : Fin G2SZ → BitVec 8)
    (p2 : Fin G1SZ → BitVec 8) (q2 : Fin G2SZ → BitVec 8) :
    @Com.denote _ _ _ (jasminDenoteWith leafSem) _ _
        eip197VerifyCom (.cons p1 (.cons q1 (.cons p2 (.cons q2 .nil))))
      = prims.fp12Mul (prims.pairing p1 q1) (prims.pairing p2 q2) := by
  rw [eip197VerifyCom_eq_shadow]
  obtain ⟨hP, hM⟩ := hPair
  show leafSem fp12MulLeafName fp12MulArgTys gtRetTy
        (.cons (leafSem pairingLeafName pairingArgTys gtRetTy
                  (.cons p1 (.cons q1 .nil)))
          (.cons (leafSem pairingLeafName pairingArgTys gtRetTy
                    (.cons p2 (.cons q2 .nil))) .nil))
      = prims.fp12Mul (prims.pairing p1 q1) (prims.pairing p2 q2)
  rw [hP (.cons p1 (.cons q1 .nil)), hP (.cons p2 (.cons q2 .nil))]
  simp only [HVector.head, HVector.tail]
  rw [hM (.cons (prims.pairing p1 q1) (.cons (prims.pairing p2 q2) .nil))]
  rfl

/-! ### 6b. The single-pairing leaf (EIP-196 / Groth16-BN254 building block) -/

/-- A single BN254 pairing `e(P, Q)` — the hand-authored **shadow**: one pairing
    leaf. ABI: `Γ = [P : G1, Q : G2]`. The deployed `pairingCom` below is
    front-sourced and proven equal to this shadow. -/
def pairingComShadow :
    Com jasminDialect [.stackArr 8 G1SZ, .stackArr 8 G2SZ] (.stackArr 8 GTSZ) :=
  .var (pairingLeafExpr
          (Γ := [.stackArr 8 G1SZ, .stackArr 8 G2SZ]) .here (.there .here))
    (.ret .here)

/-- Input buffer context for the single pairing: `[P : G1, Q : G2]` (root slots
    from the tail: `Q = 0`, `P = 1`). -/
def pairingCtxt : Ctxt jasminDialect :=
  [.stackArr 8 G1SZ, .stackArr 8 G2SZ]

/-- The single pairing as a one-phase front schedule: `out = e(P, Q)`. -/
def pairingSchedule : List CallPhase :=
  [ { leaf := pairingLeafName, argTys := pairingArgTys, retTy := gtRetTy,
      argSlots := [1, 0] } ]            -- out = e(P, Q)

/-- **Generation gate.** The front resolves the single-pairing schedule. -/
theorem pairingCom_isSome :
    (buildOrchCom pairingCtxt pairingSchedule 2 gtRetTy).isSome = true := by
  rfl

/-- A single BN254 pairing `e(P, Q)`, **front-sourced** through
    `OrchestrationFront.buildOrchCom` (the deployed `Com`, lowered by
    `EcPairingEmit`). -/
def pairingCom : Com jasminDialect pairingCtxt (.stackArr 8 GTSZ) :=
  (buildOrchCom pairingCtxt pairingSchedule 2 gtRetTy).get pairingCom_isSome

/-- **Exactness.** The front generates *definitionally* the hand-authored shadow. -/
theorem pairingCom_eq_shadow : pairingCom = pairingComShadow := by rfl

/-- **The deployed single BN254 pairing, evaluated with a leaf oracle.** For a
    leaf oracle `leafSem` realising the pairing primitives
    (`PairingLeavesAgree prims leafSem`), the deployed `pairingCom`, denoted
    through `jasminDenoteWith leafSem`, computes `prims.pairing P Q`. The leaf
    model is the parameter `leafSem`; `Bn254Denote` instantiates it. -/
theorem pairingCom_denote (leafSem : LeafSem) (prims : Bn254Primitives)
    (hPair : PairingLeavesAgree prims leafSem)
    (p : Fin G1SZ → BitVec 8) (q : Fin G2SZ → BitVec 8) :
    @Com.denote _ _ _ (jasminDenoteWith leafSem) _ _
        pairingCom (.cons p (.cons q .nil))
      = prims.pairing p q := by
  rw [pairingCom_eq_shadow]
  obtain ⟨hP, _⟩ := hPair
  show leafSem pairingLeafName pairingArgTys gtRetTy (.cons p (.cons q .nil))
      = prims.pairing p q
  rw [hP (.cons p (.cons q .nil))]
  rfl

end CatCrypt.Crypto.Pairing.Bn254Emit
