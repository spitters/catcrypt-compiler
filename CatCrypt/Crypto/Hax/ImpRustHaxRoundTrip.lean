module

public import CatCrypt.Crypto.Hax.ImpRustHaxCheck
public import CatCrypt.Crypto.Hax.ImpRustHaxRoundTripExtracted

/-!
# The printed round-trip program, read back by the hax frontend

`roundTripExtracted` (`CatCrypt.Crypto.Hax.ImpRustHaxRoundTripExtracted`,
generated by `bench/hax_roundtrip/run.sh`) is the hax frontend's reading of the
Rust text that `ppImpRustFn` prints for `roundTripImp`.  `roundTrip_haxReadAgrees`
pins the printer against that reading: the check `haxReadAgrees` passes, by
kernel evaluation.  The check holds for the text the emit driver wrote when the
module was generated, and fails the build when a change of the printer, of
`roundTripImp` or of the frontend changes the reading.

`roundTrip_hax_simulates` composes the check with `lowCTToImp_simulates_frontNF`:
a run of the frontend's reading under hax-lean's semantics is simulated by
`RustExec` of `frontNF roundTripLowCT`.  The trusted parts are hax's frontend
(rustc's THIR and the JSON export), hax-lean's JSON adapter, and the builtin
table's reading of the frontend operator names (`HaxOpsAgree`).

## Main results

* `roundTrip_haxReadAgrees` — the check passes on the round-trip program.
* `roundTrip_hax_simulates` — the frontend's reading of the printed program is
  simulated by its `LowCT` source.
-/

@[expose] public section

set_option autoImplicit false

namespace CatCrypt.Crypto.Hax

open _root_.Hax (Value Env Builtins)
open CatCrypt.Crypto.Jasmin.LowCT (RustState RustExec LeafSpec)

/-- The frontend's reading of the printed round-trip program passes the
    check. -/
theorem roundTrip_haxReadAgrees : haxReadAgrees roundTripImp roundTripExtracted = true := by
  decide

/-- **The printed round-trip program, as the hax frontend reads it, is simulated
    by its `LowCT` source.**  A run of the frontend's reading under the source
    semantics of `lowCTToImp_simulates` is simulated by `RustExec` of
    `frontNF roundTripLowCT`, with the hypotheses of
    `lowCTToImp_simulates_frontNF` on the builtin table and the entry state, and
    `HaxOpsAgree bi`. -/
theorem roundTrip_hax_simulates
    (bridge : ValueTowerBridge) (bi : Builtins) (N : Nat) (leafSpec : LeafSpec)
    (hOps : HaxOpsAgree bi)
    (hLeaf : ∀ f, f ≠ "array_update" → f ≠ "index" → scalarCallName f = false →
      LeafCallAgreesArgs bi leafSpec f (towerOfCallName f) bridge)
    (hProj : TupleLoadAgrees bridge leafSpec)
    (hLit : LitStoreAgrees bridge leafSpec)
    (hIdx : IndexAgrees bridge bi leafSpec)
    (hUpd : ArrUpdateAgrees bridge bi leafSpec)
    (hSc : ScalarCallsAgree bi)
    (fuel : Nat) (env env' : Env) (rs : RustState) (v : Value)
    (hSB : ScopeBound rs rtEntryScope) (hSF : NamesFresh rs rtScalars)
    (hEval : evalImp bi fuel (forToLoop roundTripExtracted) env = some (v, env'))
    (hAgree : envAgreesRustT bridge env rs) (hInv : ScalarInv [] rtScalars env) :
    ∃ rs', RustExec N leafSpec (frontNF roundTripLowCT) rs rs' ∧
      envAgreesRustT bridge env' rs' ∧ ScopeBound rs' rtExitScope ∧
      NamesFresh rs' rtScalars ∧ ScalarInv [] rtScalars env' := by
  rw [haxReadAgrees_sound bi hOps _ _ roundTrip_haxReadAgrees] at hEval
  exact lowCTToImp_simulates_frontNF bridge bi N leafSpec [] rtScalars hLeaf hProj hLit hIdx
    hUpd hSc roundTripLowCT roundTripImp lowCTToImp_roundTripLowCT fuel rtEntryScope
    rtExitScope env env' rs v roundTripImp_simScope hSB hSF hEval hAgree hInv

end CatCrypt.Crypto.Hax
