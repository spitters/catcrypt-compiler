module

public import HaxLean.AST

/-!
# The hax frontend's reading of the printed round-trip program

Generated by `bench/hax_roundtrip/run.sh`; do not edit.  `roundTripExtracted` is
the body of `roundtrip_prog` in `bench/hax_roundtrip/crate/src/lib.rs` as
`cargo hax json` and `Hax.HaxAdapter.parseHaxExpr`, followed by
`reconstructForLoops` and `normalizeAssignOps`, read it.
-/

@[expose] public section

namespace CatCrypt.Crypto.Hax

/-- The hax frontend's reading of the printed round-trip program. -/
def roundTripExtracted : _root_.Hax.ImpExpr :=
  (.letBind "x"
    (.app "fp_mul"
      [(.var "a"), (.var "b")])
    (.seq
      (.forLoop "i"
        (.lit (.int (0)))
        (.lit (.int (4)))
        (.assign "x"
          (.app "fp_mul"
            [(.var "x"), (.var "b")])))
      (.letBind "s"
        (.app "Add"
          [(.var "c"), (.var "d")])
        .unitVal)))

end CatCrypt.Crypto.Hax
