def negacyclic_wrap_law {R : Type} [Inhabited R] [PolyRing R] : Bool :=
  if Hax.gt ((PolyRing.N (Self := R))) (1 : Int) then
    let one := (Field.ONE (Self := (PolyRing.Coeff R)))
    let x_top := with_coeff ((PolyRing.ZERO (Self := R))) (Hax.sub ((PolyRing.N (Self := R))) (1 : Int)) one
    let x := with_coeff ((PolyRing.ZERO (Self := R))) (1 : Int) one
    let minus_one := constant (sub ((Field.ZERO (Self := (PolyRing.Coeff R)))) one)
    Hax.beq (ntt_mul x_top x) minus_one
  else
    true

