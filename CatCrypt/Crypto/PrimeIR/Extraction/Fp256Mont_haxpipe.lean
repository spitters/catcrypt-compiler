def is_negative_bit_law {F : Type} [Inhabited F] [CtField F] (a : F) :=
Hax.le (is_negative a) (1 : Int)

def ct_abs_law {F : Type} [Inhabited F] [CtField F] (a : F) :=
  if Hax.beq (is_negative a) (1 : Int) then
    Hax.beq (ct_abs a) (neg a)
  else
    Hax.beq (ct_abs a) a

def sqrt_ratio_law {F : Type} [Inhabited F] [SqrtRatio F] (u : F) (v : F) :=
  if Hax.beq v ((Field.ZERO (Self := F))) then
    true
  else
    let (is_square, y) := sqrt_ratio u v
    let lhs := mul (square y) v
    if Hax.beq is_square (1 : Int) then
      Hax.beq lhs u
    else
      if Hax.beq is_square (0 : Int) then
        Hax.beq lhs (mul ((SqrtRatio.Z (Self := F))) u)
      else
        false

def schoolbook_negacyclic {R : Type} [Inhabited R] [PolyRing R] (a : R) (b : R) :=
  let out := (PolyRing.ZERO (Self := R))
  Hax.foldRange (0 : Int) ((PolyRing.N (Self := R))) out fun k out =>
    let acc := (Field.ZERO (Self := (PolyRing.Coeff R)))
    let acc := Hax.foldRange (0 : Int) (Hax.add k (1 : Int)) acc fun i acc =>
      add acc (mul (coeff a i) (coeff b (Hax.sub k i)))
    let acc := Hax.foldRange (Hax.add k (1 : Int)) ((PolyRing.N (Self := R))) acc fun i acc =>
      sub acc (mul (coeff a i) (coeff b (Hax.sub (Hax.add k ((PolyRing.N (Self := R)))) i)))
    let out := with_coeff out k acc
    out

