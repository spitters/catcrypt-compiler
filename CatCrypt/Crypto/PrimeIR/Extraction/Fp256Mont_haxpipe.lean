  let y1 := («Fp256Mont.mk» (pow_c1_limbs («Fp256Mont.0» tv1)) : Fp256Mont_T)
  let y1 := (Field_mul y1 tv2 : Fp256Mont_T)
  let y2 := (Field_mul y1 c2 : Fp256Mont_T)
  let tv3 := (Field_mul (Field_square y1) v : Fp256Mont_T)
  let is_qr := CtField_ct_eq tv3 u
  let y := (CtField_ct_select is_qr y1 y2 : Fp256Mont_T)
  (is_qr, y)

