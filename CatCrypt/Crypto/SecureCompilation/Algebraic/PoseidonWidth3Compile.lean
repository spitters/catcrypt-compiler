public import CatCrypt.Crypto.SecureCompilation.Algebraic.FieldExprCompile
public import CatCrypt.Crypto.Hash.Poseidon.Permutation

/-!
# The width-3 Poseidon permutation as a `fieldDialect` program

For a parameter record `P : Hash.Poseidon.Params p 3`, `permComAt P i` is a
`Com fieldDialect` program over the three input lanes that returns lane `i` of the
permutation. It is generated by the field-expression compiler
`FieldExprCompile.emit`: each round is four vectors of field expressions, each over
the variables bound by the previous one, emitted in order by `emitVec`.

* `arkExprs`: `sᵢ + rc k i`.
* `sqExprs`: the three lanes, then the square of each lane that the S-box applies to.
* `quintExprs`: `(x²)² · x` on the S-box lanes; the other lanes pass through.
* `mdsExprs`: `(M i 0 · s₀ + M i 1 · s₁) + M i 2 · s₂`.

An input or a pass-through lane is a variable and binds nothing; every constant,
sum and product is one `fConst`, `fAdd` or `fMul` binding. After the last round
three `fCopy` bindings copy lanes `0, 1, 2`, so the last three bindings of every
`permComAt P i` hold the three output lanes in order.

## Main definitions

* `emitVec`: a vector of expressions compiled in order.
* `GoodAMC p`: the operations `fAdd`, `fMul`, `fConst`, `fCopy`, `fSub`, `fNeg` at `p`
  (`emit` over a general `FExpr`; the Poseidon rounds use the first four).
* `roundK`, `roundsK`: one round and a list of rounds.
* `permComAt P i`: the permutation program returning lane `i`.

## Main results

* `emitVec_denote`, `emitVec_covered`: value and coverage of `emitVec`.
* `roundK_denote`: at `P.alpha = 5`, a round program computes `Hash.Poseidon.roundFn`.
* `permComAt_covered`: every binding of `permComAt P i` is `GoodAMC p`.
* `permComAt_denote`: at `P.alpha = 5`,
  `(permComAt P i).denote V = Hash.Poseidon.permute P (inputs V) i`.
-/

@[expose] public section

set_option autoImplicit false

namespace CatCrypt.Crypto.SecureCompilation.Algebraic.PoseidonWidth3

open CatCrypt.Crypto.SecureCompilation.VIR
open CatCrypt.Crypto.SecureCompilation.VIR.FieldDialect
open CatCrypt.Crypto.SecureCompilation.VIR.BlockLoweringCPS
open CatCrypt.Crypto.SecureCompilation.Algebraic.FieldExprCompile
open CatCrypt.Crypto.Hash.Poseidon

variable {p : Nat}

/-! ## 1. Emitting a vector of expressions -/

/-- The field type of every value. -/
abbrev FP (p : Nat) : FieldTy := .fp p

/-- The program of `m` expressions over `n` inputs, emitted in order, then the
    continuation on the renaming into its context and the `m` variables holding the
    values. -/
def emitVec {n : Nat} : (m : Nat) → (Fin m → FExpr p n) → {Γ : Ctxt fieldDialect} →
    (Fin n → Ctxt.Var Γ (FP p)) →
    ({Γ' : Ctxt fieldDialect} → Ren Γ Γ' → (Fin m → Ctxt.Var Γ' (FP p)) →
      Com fieldDialect Γ' (FP p)) →
    Com fieldDialect Γ (FP p)
  | 0, _, _, _, k => k id Fin.elim0
  | m + 1, es, _, env, k =>
    emit (es 0) env fun r₁ v =>
      emitVec m (fun j => es j.succ) (fun i => r₁ (env i)) fun r₂ vs =>
        k (fun w => r₂ (r₁ w)) (Fin.cons (r₂ v) vs)

/-- **Denotation of `emitVec`.** If `env` holds `x` under `V` and the continuation
    denotes `R` whenever its renaming preserves values and its variables hold the
    values of the expressions, then `emitVec m es env k` denotes `R`. -/
theorem emitVec_denote {n : Nat} (x : Fin n → ZMod p) :
    ∀ (m : Nat) (es : Fin m → FExpr p n) {Γ : Ctxt fieldDialect}
      (env : Fin n → Ctxt.Var Γ (FP p))
      (k : {Γ' : Ctxt fieldDialect} → Ren Γ Γ' → (Fin m → Ctxt.Var Γ' (FP p)) →
        Com fieldDialect Γ' (FP p))
      (V : Ctxt.Valuation Γ) (R : ZMod p), (∀ i, (env i).lookup V = x i) →
      (∀ {Γ' : Ctxt fieldDialect} (r : Ren Γ Γ') (V' : Ctxt.Valuation Γ')
        (ws : Fin m → Ctxt.Var Γ' (FP p)),
        (∀ {t : FieldTy} (v : Ctxt.Var Γ t), (r v).lookup V' = v.lookup V) →
        (∀ j, (ws j).lookup V' = (es j).eval x) → (k r ws).denote V' = R) →
      (emitVec m es env k).denote V = R
  | 0, _, _, _, _, V, _, _, hk => hk id V Fin.elim0 (fun _ => rfl) (fun j => j.elim0)
  | m + 1, es, _, env, k, V, R, hx, hk => by
    refine emit_denote x (es 0) env _ V R hx fun r₁ V₁ v h₁ hv => ?_
    refine emitVec_denote x m (fun j => es j.succ) (fun i => r₁ (env i)) _ V₁ R
      (fun i => (h₁ (env i)).trans (hx i)) fun r₂ V₂ vs h₂ hvs => ?_
    refine hk _ V₂ _ (fun w => (h₂ (r₁ w)).trans (h₁ w)) fun j => ?_
    refine Fin.cases ?_ (fun j => ?_) j
    · exact (h₂ v).trans hv
    · exact hvs j

variable (p) in
/-- The operations `fAdd`, `fMul`, `fConst` and `fCopy` at `p`. -/
def GoodAMC {Γ : Ctxt fieldDialect} {t : FieldTy} (e : Expr fieldDialect Γ t) : Prop :=
  e.op = .fAdd p ∨ e.op = .fMul p ∨ (∃ c : ZMod p, e.op = .fConst p c) ∨ e.op = .fCopy p ∨
    e.op = .fSub p ∨ e.op = .fNeg p

/-- **Coverage of `emit`**: every binding is a `GoodAMC p` operation. -/
theorem emit_goodAMC {n : Nat} (e : FExpr p n) {Γ : Ctxt fieldDialect}
    (env : Fin n → Ctxt.Var Γ (.fp p))
    (k : {Γ' : Ctxt fieldDialect} → Ren Γ Γ' → Ctxt.Var Γ' (.fp p) → Com fieldDialect Γ' (.fp p))
    (hk : ∀ {Γ' : Ctxt fieldDialect} (r : Ren Γ Γ') (w : Ctxt.Var Γ' (.fp p)),
      CoveredCom (GoodAMC p) (k r w)) :
    CoveredCom (GoodAMC p) (emit e env k) := by
  induction e generalizing Γ with
  | inp i => exact hk _ _
  | const c => exact ⟨Or.inr (Or.inr (Or.inl ⟨c, rfl⟩)), hk _ _⟩
  | add a b iha ihb => exact iha env _ fun r₁ va => ihb _ _ fun r₂ vb => ⟨Or.inl rfl, hk _ _⟩
  | sub a b iha ihb =>
    exact iha env _ fun r₁ va => ihb _ _ fun r₂ vb =>
      ⟨Or.inr (Or.inr (Or.inr (Or.inr (Or.inl rfl)))), hk _ _⟩
  | neg a iha =>
    exact iha env _ fun r₁ va => ⟨Or.inr (Or.inr (Or.inr (Or.inr (Or.inr rfl)))), hk _ _⟩
  | mul a b iha ihb =>
    exact iha env _ fun r₁ va => ihb _ _ fun r₂ vb => ⟨Or.inr (Or.inl rfl), hk _ _⟩

/-- **Coverage of `emitVec`.** -/
theorem emitVec_covered {n : Nat} :
    ∀ (m : Nat) (es : Fin m → FExpr p n) {Γ : Ctxt fieldDialect}
      (env : Fin n → Ctxt.Var Γ (FP p))
      (k : {Γ' : Ctxt fieldDialect} → Ren Γ Γ' → (Fin m → Ctxt.Var Γ' (FP p)) →
        Com fieldDialect Γ' (FP p)),
      (∀ {Γ' : Ctxt fieldDialect} (r : Ren Γ Γ') (ws : Fin m → Ctxt.Var Γ' (FP p)),
        CoveredCom (GoodAMC p) (k r ws)) →
      CoveredCom (GoodAMC p) (emitVec m es env k)
  | 0, _, _, _, _, hk => hk _ _
  | m + 1, es, _, env, _, hk =>
    emit_goodAMC (es 0) env _ fun r₁ _ =>
      emitVec_covered m (fun j => es j.succ) (fun i => r₁ (env i)) _ fun _ _ => hk _ _

/-! ## 2. The round stages -/

variable (P : Params p 3)

/-- Whether the S-box is applied to lane `i` in round `k`. -/
def active (k : Nat) (i : Fin 3) : Bool := P.isFull k || i.val = 0

/-- The round constants: `sᵢ + rc k i`. -/
def arkExprs (k : Nat) : Fin 3 → FExpr p 3 := fun i => .add (.inp i) (.const (P.rc k i))

/-- The squares: entries `0 … 2` pass the three lanes through, entry `3 + i` is the
    square of lane `i` when the S-box is applied to it and lane `i` otherwise. -/
def sqExprs (k : Nat) : Fin 6 → FExpr p 3 := fun j =>
  if h : j.val < 3 then .inp ⟨j.val, h⟩
  else
    let i : Fin 3 := ⟨j.val - 3, by omega⟩
    if active P k i then .mul (.inp i) (.inp i) else .inp i

/-- The fifth powers `(x²)² · x` of the S-box lanes; the other lanes pass through. -/
def quintExprs (k : Nat) : Fin 3 → FExpr p 6 := fun i =>
  if active P k i then
    .mul (.mul (.inp ⟨i.val + 3, by omega⟩) (.inp ⟨i.val + 3, by omega⟩)) (.inp ⟨i.val, by omega⟩)
  else .inp ⟨i.val, by omega⟩

/-- The MDS row `i`: `(M i 0 · s₀ + M i 1 · s₁) + M i 2 · s₂`. -/
def mdsExprs : Fin 3 → FExpr p 3 := fun i =>
  .add (.add (.mul (.const (P.mds i 0)) (.inp 0)) (.mul (.const (P.mds i 1)) (.inp 1)))
    (.mul (.const (P.mds i 2)) (.inp 2))

theorem sqExprs_eval_lo (k : Nat) (y : Fin 3 → ZMod p) (i : Fin 3) :
    (sqExprs P k ⟨i.val, by omega⟩).eval y = y i := by
  simp only [sqExprs, i.isLt, dite_true, FExpr.eval]

theorem sqExprs_eval_hi (k : Nat) (y : Fin 3 → ZMod p) (i : Fin 3) :
    (sqExprs P k ⟨i.val + 3, by omega⟩).eval y = if active P k i then y i * y i else y i := by
  simp only [sqExprs, show ¬ (i.val + 3 < 3) by omega, dite_false, Nat.add_sub_cancel]
  split <;> rfl

theorem quintExprs_eval (k : Nat) (y : Fin 3 → ZMod p) (i : Fin 3) :
    (quintExprs P k i).eval (fun j => (sqExprs P k j).eval y)
      = if active P k i then y i ^ 5 else y i := by
  unfold quintExprs
  by_cases ha : active P k i
  · simp only [ha, ite_true, FExpr.eval]
    rw [sqExprs_eval_hi, sqExprs_eval_lo, ite_eq_left ha]
    ring
  · simp only [ha]
    exact sqExprs_eval_lo P k y i

/-- Round `k` on the lane variables `env`: the four stages in order. -/
def roundK (k : Nat) {Γ : Ctxt fieldDialect} (env : Fin 3 → Ctxt.Var Γ (FP p))
    (kont : {Γ' : Ctxt fieldDialect} → Ren Γ Γ' → (Fin 3 → Ctxt.Var Γ' (FP p)) →
      Com fieldDialect Γ' (FP p)) : Com fieldDialect Γ (FP p) :=
  emitVec 3 (arkExprs P k) env fun r₁ a =>
  emitVec 6 (sqExprs P k) a fun r₂ b =>
  emitVec 3 (quintExprs P k) b fun r₃ c =>
  emitVec 3 (mdsExprs P) c fun r₄ d =>
  kont (fun w => r₄ (r₃ (r₂ (r₁ w)))) d

/-- The rounds `ks` in order. -/
def roundsK : List Nat → {Γ : Ctxt fieldDialect} → (Fin 3 → Ctxt.Var Γ (FP p)) →
    ({Γ' : Ctxt fieldDialect} → Ren Γ Γ' → (Fin 3 → Ctxt.Var Γ' (FP p)) →
      Com fieldDialect Γ' (FP p)) → Com fieldDialect Γ (FP p)
  | [], _, env, kont => kont id env
  | k :: ks, _, env, kont =>
    roundK P k env fun r₁ s => roundsK ks s fun r₂ t => kont (fun w => r₂ (r₁ w)) t

theorem roundK_denote (hα : P.alpha = 5) (k : Nat) (x : Fin 3 → ZMod p)
    {Γ : Ctxt fieldDialect} (env : Fin 3 → Ctxt.Var Γ (FP p))
    (kont : {Γ' : Ctxt fieldDialect} → Ren Γ Γ' → (Fin 3 → Ctxt.Var Γ' (FP p)) →
      Com fieldDialect Γ' (FP p))
    (V : Ctxt.Valuation Γ) (R : ZMod p) (hx : ∀ i, (env i).lookup V = x i)
    (hk : ∀ {Γ' : Ctxt fieldDialect} (r : Ren Γ Γ') (V' : Ctxt.Valuation Γ')
      (ws : Fin 3 → Ctxt.Var Γ' (FP p)),
      (∀ {t : FieldTy} (v : Ctxt.Var Γ t), (r v).lookup V' = v.lookup V) →
      (∀ j, (ws j).lookup V' = roundFn P k x j) → (kont r ws).denote V' = R) :
    (roundK P k env kont).denote V = R := by
  refine emitVec_denote x 3 _ env _ V R hx fun r₁ V₁ a h₁ ha => ?_
  refine emitVec_denote _ 6 _ a _ V₁ R ha fun r₂ V₂ b h₂ hb => ?_
  refine emitVec_denote _ 3 _ b _ V₂ R hb fun r₃ V₃ c h₃ hc => ?_
  refine emitVec_denote _ 3 _ c _ V₃ R hc fun r₄ V₄ d h₄ hd => ?_
  refine hk _ V₄ d (fun w => (h₄ _).trans ((h₃ _).trans ((h₂ _).trans (h₁ w)))) fun j => ?_
  rw [hd j]
  simp only [mdsExprs, FExpr.eval]
  rw [quintExprs_eval, quintExprs_eval, quintExprs_eval, roundFn, Fin.sum_univ_three]
  simp only [sboxLayer, arkExprs, FExpr.eval, active, hα]

theorem roundsK_denote (hα : P.alpha = 5) :
    ∀ (ks : List Nat) (x : Fin 3 → ZMod p) {Γ : Ctxt fieldDialect}
      (env : Fin 3 → Ctxt.Var Γ (FP p))
      (kont : {Γ' : Ctxt fieldDialect} → Ren Γ Γ' → (Fin 3 → Ctxt.Var Γ' (FP p)) →
        Com fieldDialect Γ' (FP p))
      (V : Ctxt.Valuation Γ) (R : ZMod p), (∀ i, (env i).lookup V = x i) →
      (∀ {Γ' : Ctxt fieldDialect} (r : Ren Γ Γ') (V' : Ctxt.Valuation Γ')
        (ws : Fin 3 → Ctxt.Var Γ' (FP p)),
        (∀ {t : FieldTy} (v : Ctxt.Var Γ t), (r v).lookup V' = v.lookup V) →
        (∀ j, (ws j).lookup V' = ks.foldl (fun s k => roundFn P k s) x j) →
        (kont r ws).denote V' = R) →
      (roundsK P ks env kont).denote V = R
  | [], x, _, env, kont, V, R, hx, hk => hk id V env (fun _ => rfl) hx
  | k :: ks, x, _, env, kont, V, R, hx, hk => by
    refine roundK_denote P hα k x env _ V R hx fun r₁ V₁ s h₁ hs => ?_
    exact roundsK_denote hα ks _ s _ V₁ R hs fun r₂ V₂ t h₂ ht =>
      hk _ V₂ t (fun w => (h₂ _).trans (h₁ w)) ht

theorem roundK_covered (k : Nat) {Γ : Ctxt fieldDialect} (env : Fin 3 → Ctxt.Var Γ (FP p))
    (kont : {Γ' : Ctxt fieldDialect} → Ren Γ Γ' → (Fin 3 → Ctxt.Var Γ' (FP p)) →
      Com fieldDialect Γ' (FP p))
    (hk : ∀ {Γ' : Ctxt fieldDialect} (r : Ren Γ Γ') (ws : Fin 3 → Ctxt.Var Γ' (FP p)),
      CoveredCom (GoodAMC p) (kont r ws)) :
    CoveredCom (GoodAMC p) (roundK P k env kont) :=
  emitVec_covered 3 _ env _ fun _ _ => emitVec_covered 6 _ _ _ fun _ _ =>
    emitVec_covered 3 _ _ _ fun _ _ => emitVec_covered 3 _ _ _ fun _ _ => hk _ _

theorem roundsK_covered :
    ∀ (ks : List Nat) {Γ : Ctxt fieldDialect} (env : Fin 3 → Ctxt.Var Γ (FP p))
      (kont : {Γ' : Ctxt fieldDialect} → Ren Γ Γ' → (Fin 3 → Ctxt.Var Γ' (FP p)) →
        Com fieldDialect Γ' (FP p)),
      (∀ {Γ' : Ctxt fieldDialect} (r : Ren Γ Γ') (ws : Fin 3 → Ctxt.Var Γ' (FP p)),
        CoveredCom (GoodAMC p) (kont r ws)) →
      CoveredCom (GoodAMC p) (roundsK P ks env kont)
  | [], _, _, _, hk => hk _ _
  | k :: ks, _, env, _, hk =>
    roundK_covered P k env _ fun _ s => roundsK_covered ks s _ fun _ _ => hk _ _

/-! ## 3. The permutation program -/

/-- Three `fCopy` bindings of the lanes `0, 1, 2` in order, then the copy of lane `i`.
    The last three bindings of the program hold the three output lanes. -/
def copyRet {Γ : Ctxt fieldDialect} (st : Fin 3 → Ctxt.Var Γ (FP p)) (i : Fin 3) :
    Com fieldDialect Γ (FP p) :=
  .var ⟨.fCopy p, rfl, .cons (st 0) .nil⟩ <|
  .var ⟨.fCopy p, rfl, .cons (st 1).there .nil⟩ <|
  .var ⟨.fCopy p, rfl, .cons (st 2).there.there .nil⟩ <|
  .ret (match i with
    | 0 => .there (.there .here)
    | 1 => .there .here
    | 2 => .here)

theorem copyRet_denote {Γ : Ctxt fieldDialect} (st : Fin 3 → Ctxt.Var Γ (FP p)) (i : Fin 3)
    (V : Ctxt.Valuation Γ) : (copyRet st i).denote V = (st i).lookup V := by
  fin_cases i <;> rfl

theorem copyRet_covered {Γ : Ctxt fieldDialect} (st : Fin 3 → Ctxt.Var Γ (FP p)) (i : Fin 3) :
    CoveredCom (GoodAMC p) (copyRet st i) :=
  ⟨Or.inr (Or.inr (Or.inr (Or.inl rfl))), Or.inr (Or.inr (Or.inr (Or.inl rfl))),
    Or.inr (Or.inr (Or.inr (Or.inl rfl))), trivial⟩

/-- **The width-3 Poseidon permutation program over the three input lanes, returning
    lane `i`.** The three programs `i = 0, 1, 2` share their bindings. -/
def permComAt (i : Fin 3) : Com fieldDialect (inCtxt p 3) (FP p) :=
  roundsK P (List.range P.rounds) (inVar 3) fun _ st => copyRet st i

theorem permComAt_covered (i : Fin 3) : CoveredCom (GoodAMC p) (permComAt P i) :=
  roundsK_covered P _ _ _ fun _ st => copyRet_covered st i

/-- **The permutation program computes the Poseidon permutation**, for an S-box
    exponent `5`: lane `i` of `permute P` on the inputs. -/
theorem permComAt_denote (hα : P.alpha = 5) (i : Fin 3) (V : Ctxt.Valuation (inCtxt p 3)) :
    (permComAt P i).denote V = permute P (inputs V) i :=
  roundsK_denote P hα _ (inputs V) (inVar 3) _ V _ (fun _ => rfl) fun _ V' ws _ hws => by
    rw [copyRet_denote, hws]
    rfl

end CatCrypt.Crypto.SecureCompilation.Algebraic.PoseidonWidth3
