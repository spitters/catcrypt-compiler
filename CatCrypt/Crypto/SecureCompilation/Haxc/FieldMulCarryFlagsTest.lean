/-- The literal `p256MulRef` is the reference of the region back half for `p256MulProg`. -/
theorem p256MulRef_eq :
    regionRef (fieldAbi2 4) ⟨"p256_mul", "", [], ["RDI", "RSI", "RDX"]⟩ p256MulProg =
      some (p256MulOuts, p256MulRef) := by
  native_decide

/-- **`ownedCheckMC` accepts the carries in flags against the materialised carries.** -/
theorem p256Mul_flags_accepted : ownedCheckMC p256MulOuts p256MulRef p256MulFlags = true := by
  native_decide

/-- The traced check, which also compares the leakage events, accepts the pair: the flag form
    adds no event. -/
theorem p256Mul_flags_leak : ownedCheckML p256MulOuts p256MulRef p256MulFlags = true := by
  native_decide

/-- Every halting checked run of the reference is matched by a halting checked run of the
    flag form from the same state, agreeing on the four limbs, the arrays and the memory. -/
theorem p256Mul_flags_sound (fn : String) (s t : JasminLsemMemFlagGuard.LstateMF)
    (hfn : s.prog.lfn = fn) (hpc : s.prog.base.reg.lpc = 0) (fuel : Nat)
    (hrun : JasminLsemMemChecked.lsemFuelMemFk true
      (JasminLsemMemLoop.singletonProgM fn p256MulRef) fuel s = some t) :
    ∃ fuel' t', JasminLsemMemChecked.lsemFuelMemFk true
        (JasminLsemMemLoop.singletonProgM fn p256MulFlags) fuel' s = some t' ∧
      X86Backend.OwnedLprogTV.Obs p256MulOuts t t' :=
  ownedCheckMC_sound p256Mul_flags_accepted fn s t hfn hpc fuel hrun

/-- An instruction `m` writing `d` from the sources `s`. -/
def op (d : List String) (m : String) (s : List LOperand) : LinstrRM :=
  (.Lopn (d.map .reg) m s, .reg none)

/-- A two-limb addition of start registers with materialised carries. -/
def twoLimbValue : List LinstrRM :=
  [ op ["z"] "MOV:64" [.imm 0],
    (.Lopn [.reg "c0"] "MOV^1" [.imm 0], .reg (some 1)),
    op ["r0"] "ADCX:64" [.reg "x0", .reg "y0", .reg "c0"],
    op ["c1"] "ADCXHI:64" [.reg "x0", .reg "y0", .reg "c0"],
    op ["r1"] "ADCX:64" [.reg "x1", .reg "y1", .reg "c1"] ]

/-- The same addition with its carry in the carry flag. -/
def twoLimbFlags : List LinstrRM :=
  [ op ["r0"] "ADD:64" [.reg "x0", .reg "y0"],
    op ["r1"] "ADC:64" [.reg "x1", .reg "y1"] ]

/-- The checker refuses the two-limb addition of start registers of unknown width. -/
theorem twoLimb_refused : ownedCheckMC ["r0", "r1"] twoLimbValue twoLimbFlags = false := by
  native_decide

end CatCrypt.Crypto.SecureCompilation.Haxc.FieldMulCarryFlagsTest
