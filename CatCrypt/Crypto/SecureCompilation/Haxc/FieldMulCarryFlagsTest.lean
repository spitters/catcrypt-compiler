/-- The observed names and the reference body that the image check `renImageB` of the region
    back half `regionBack` hands to `ownedCheckMC` for the program `p0`: the first argument of
    the check, `(regionCoParts σ exportReg b t codeC r.res cert callee).ref`, at the stages of
    `compileRegion` without linked functions. -/
def regionRef (σ : AbiLayout) (a : AbiNames) {Γ : Ctxt jasminDialect} {t : JasminTy}
    (p0 : NFProg jasminDialect Γ [t]) : Option (List String × List LinstrRM) := do
  let q ← VIR.NarrowWords.narrowPrep p0
  let p := legalizeRegion q
  let r0 ← exportR Γ.length a.fname p Γ.length 0
  let callee ← regionCallee [] p r0.code
  let r := regionWebsAt (regionWebsEx σ exportReg) callee r0
  let (P, cert) ← regionLprogC a p callee (regionWebsEx σ exportReg)
  let b ← firstBody (regionPrinted P)
  let d := regionCoParts σ exportReg b t (calleeCodeT callee r.code) r.res cert callee
  return (d.outs ++ d.cellOuts, d.ref)

/-- The template field multiply at the P-256 base prime, the program of
    `FieldInstances.p256_mul_correct_bytes`. -/
def p256MulProg :=
  NFProg.ofCom (fieldCom Mont4Instances.p256 (mulProg Mont4Instances.p256.p))

/-- The observed names of the reference: the four limbs of the result cell. -/
def p256MulOuts : List String := ["mem.k.1.0", "mem.k.1.8", "mem.k.1.16", "mem.k.1.24"]

