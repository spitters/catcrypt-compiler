/-!
# The secp256k1 `jacDbl` front body lies in the scalar covered fragment

`Secp256k1PointOpFront.jacDblBody` is a `seqAll` of a few thousand `LowCT`
commands generated by the 32-bit half-limb operand-scanning builders
(`genMul` / `genAdd` / `genFold` / `genSub`) threaded along the `dbl-2009-l`
schedule. This module proves that every one of those commands is an arm of
`TranslateDialectScalar.IsCoveredS`, so the front-preservation homomorphism
`translateDialectControl_denote_ctl` applies to the whole point-op body.

The proof is generator-level, not term-level: each builder's `Id.run do` loop is
mirrored by a named step function (tied to the builder by `rfl`), and the
coverage plus the non-temp-freshness of the builder's result names are carried
through the loop as an invariant (`forIn_range_inv`). Nothing reduces the
generated command list.

The name side condition of `IsCoveredS.rScalarSetExpr` is `srcClean`, which
requires every `SExpr` source variable to lie outside the front's reserved
`__sx` fresh-temp namespace. Every name the point op binds is a literal prefix
followed by decimal indices, so its first character decides the question
(`HeadOk`).

## Main results

* `HeadOk`, `HeadOk.notTmp`, `HeadOk.append` — first-character freshness hygiene.
* `forIn_range_inv` — a loop invariant for an `Id`-monad `forIn` over `[:n]`.
* `genMul_clean`, `genAdd_clean`, `genSub_clean`, `genFold_clean` — each limb
  builder emits covered commands and non-temp result names.
* `feMulHalves_clean`, `feAddHalves_clean`, `feSubHalves_clean` — the three
  field bricks.
* `runSchedule_clean` — a schedule of head-clean field ops emits covered commands.
* `jacDblBody_coveredS`, `jacDblBody_coveredSCtl` — the whole `jacDbl` front body.
-/

@[expose] public section

namespace CatCrypt.Crypto.SecureCompilation.Secp256k1PointOpFrontCovered

-- The operand-scanning state types and their `forIn` step/run functions live in
-- `Secp256k1FeMulFront`, where `genMul`/`genAdd`/`genSub` are projections of
-- them. Re-exported here so consumers opening this namespace resolve them.
export CatCrypt.Crypto.SecureCompilation.Secp256k1FeMulFront
  (MulI MulO AddS SubS genMulInnerStep genMulOuterStep genMulRun
   genAddStep genAddRun genSubStep genSubRun)

open CatCrypt.Crypto.Jasmin.LowCT (LowCT SExpr)
open CatCrypt.Crypto.SecureCompilation.Dialects.TranslateDialectScalar
open CatCrypt.Crypto.SecureCompilation.Secp256k1FeMulFront

/-! ## 1. Head-clean names

A name whose first character is not `'_'` is outside the `__sx` fresh-temp
namespace, and stays outside it under any suffix extension. `HeadOk`,
`HeadOk.notTmp`, `HeadOk.append`, `notTmp_of_len` and `notTmp_empty` are the
shared lemmas of `TranslateDialectScalarDenote`, re-exported here under this
namespace for the point-op modules that name them through it. -/

export CatCrypt.Crypto.SecureCompilation.Dialects.TranslateDialectScalar
  (HeadOk HeadOk.notTmp HeadOk.append notTmp_of_len notTmp_empty)

/-! ## 2. Name lists

A name list is clean when every index — including an out-of-range one, which
reads the `""` default — is outside the fresh-temp namespace. -/

/-- Every index of a name list reads a non-temp name. -/
def NamesClean (l : List String) : Prop := ∀ k : Nat, ¬ isTmpName (l[k]!)

theorem namesClean_getD (l : List String) (h : NamesClean l) (i : Nat) (d : String)
    (hd : ¬ isTmpName d) : ¬ isTmpName (l.getD i d) := by
  have hk := h i
  rw [List.getD_eq_getElem?_getD]
  rw [List.getElem!_eq_getElem?_getD] at hk
  cases hl : l[i]? with
  | none => simpa using hd
  | some v => rw [hl] at hk; simpa using hk

theorem namesClean_map_range (n : Nat) (f : Nat → String)
    (hf : ∀ k, ¬ isTmpName (f k)) : NamesClean ((List.range n).map f) := by
  intro k
  rw [List.getElem!_eq_getElem?_getD]
  cases hl : ((List.range n).map f)[k]? with
  | none => simpa using notTmp_empty
  | some v =>
      simp only [List.getElem?_map] at hl
      cases hr : (List.range n)[k]? with
      | none => rw [hr] at hl; simp at hl
      | some w =>
          rw [hr] at hl
          simp only [Option.map_some, Option.some.injEq] at hl
          have hw : w = k := by
            have := List.getElem?_eq_some_iff.mp hr
            obtain ⟨hk', hval⟩ := this
            simpa using hval.symm
          subst hw
          subst hl
          simpa using hf w

/-! ## 3. Loop invariants for the `Id`-monad generators

The limb builders are `Id.run do` blocks over `Std.Legacy.Range` loops with a
mutable `MProd` state. `forIn_range_inv` carries a state predicate across such a
loop; `arraySet_inv` and `arrayReplicate_inv` are its two `Array String`
side conditions. -/

theorem forIn_list_inv {σ α : Type} (P : σ → Prop) (f : α → σ → Id (ForInStep σ))
    (hstep : ∀ a s s', P s → f a s = ForInStep.yield s' → P s')
    (hdone : ∀ a s s', P s → f a s = ForInStep.done s' → P s') :
    ∀ (l : List α) (init : σ), P init → P (forIn l init f) := by
  intro l
  induction l with
  | nil => intro init h; exact h
  | cons a as ih =>
      intro init h
      rw [List.forIn_cons]
      show P (match f a init with | .done b => (pure b : Id σ) | .yield b => forIn as b f)
      cases hfa : f a init with
      | done b => exact hdone a init b h hfa
      | yield b => exact ih b (hstep a init b h hfa)

/-- A state predicate preserved by every step of an `Id`-monad `forIn` over
    `[:n]`, and holding at the initial state, holds at the loop result. -/
theorem forIn_range_inv {σ : Type} (P : σ → Prop) (n : Nat)
    (f : Nat → σ → Id (ForInStep σ)) (init : σ) (hinit : P init)
    (hstep : ∀ i s s', P s → f i s = ForInStep.yield s' → P s')
    (hdone : ∀ i s s', P s → f i s = ForInStep.done s' → P s') :
    P (forIn [:n] init f) := by
  rw [Std.Legacy.Range.forIn_eq_forIn_range']
  exact forIn_list_inv P f hstep hdone _ init hinit

theorem arraySet_inv (a : Array String) (p k : Nat) (v : String) (Q : String → Prop)
    (hq : ∀ j : Nat, Q (a[j]!)) (hv : Q v) : Q ((a.set! p v)[k]!) := by
  have hk := hq k
  show Q ((a.setIfInBounds p v)[k]!)
  by_cases h : k < a.size
  · rw [getElem!_pos (a.setIfInBounds p v) k (by simpa using h), Array.getElem_setIfInBounds]
    rw [getElem!_pos a k h] at hk
    split
    · exact hv
    · exact hk
  · rw [getElem!_neg (a.setIfInBounds p v) k (by simpa using h)]
    rw [getElem!_neg a k h] at hk
    exact hk

theorem arrayReplicate_inv (n : Nat) (v : String) (Q : String → Prop)
    (hv : Q v) (hd : Q "") : ∀ k : Nat, Q ((Array.replicate n v)[k]!) := by
  intro k
  by_cases h : k < n
  · rw [getElem!_pos _ k (by simpa using h), Array.getElem_replicate]
    exact hv
  · rw [getElem!_neg _ k (by simpa using h)]
    exact hd

theorem arrayToList_getBang (a : Array String) (k : Nat) : a.toList[k]! = a[k]! := by
  by_cases h : k < a.size
  · rw [getElem!_pos a.toList k (by simpa using h), getElem!_pos a k h]
    simp
  · rw [getElem!_neg a.toList k (by simpa using h), getElem!_neg a k h]

/-! ## 4. The operand-scanning multiply

`genMulInnerStep` / `genMulOuterStep` / `genMulRun` mirror `genMul`'s two nested
`do` loops; `genMul_eq` ties the mirror to the builder by `rfl`, so the invariant
proof never reduces the emitted command list. -/

/-- Every command of a list is in the straight-line scalar covered fragment. -/
def CmdsClean (l : List LowCT) : Prop := ∀ c ∈ l, IsCoveredS c

theorem cmdsClean_nil : CmdsClean [] := by intro c hc; cases hc

theorem cmdsClean_snoc {l : List LowCT} {c : LowCT} (hl : CmdsClean l)
    (hc : IsCoveredS c) : CmdsClean (l ++ [c]) := by
  intro d hd
  rcases List.mem_append.mp hd with h | h
  · exact hl d h
  · rcases List.mem_singleton.mp h with rfl; exact hc

theorem mask32_lt : mask32 < 2 ^ 64 := by norm_num [mask32]

theorem genMul_eq (zero : String) (aN bN : List String) (pfx : String) :
    genMul zero aN bN pfx =
      ((genMulRun zero aN bN pfx).snd, (genMulRun zero aN bN pfx).fst.toList) := rfl

abbrev QI : MulI → Prop :=
  fun r => (∀ k : Nat, ¬ isTmpName (r.fst[k]!)) ∧ ¬ isTmpName r.snd.fst
    ∧ CmdsClean r.snd.snd

abbrev QM : MulO → Prop :=
  fun r => (∀ k : Nat, ¬ isTmpName (r.fst[k]!)) ∧ CmdsClean r.snd

theorem genMulInner_step (zero : String) (aN bN : List String) (pfx : String) (i : Nat)
    (ha : NamesClean aN) (hb : NamesClean bN) (hp : HeadOk pfx) :
    ∀ (j : Nat) (s s' : MulI),
      QI s → genMulInnerStep zero aN bN pfx i j s = ForInStep.yield s' → QI s' := by
  intro j s s' hs hy
  simp only [genMulInnerStep] at hy
  injection hy with hy
  subst hy
  have htn : ¬ isTmpName (s!"{pfx}t{i}_{j}") :=
    HeadOk.notTmp (HeadOk.append (HeadOk.append (HeadOk.append (HeadOk.append hp _) _) _) _)
  have hpn : ¬ isTmpName (s!"{pfx}p{i}_{j}") :=
    HeadOk.notTmp (HeadOk.append (HeadOk.append (HeadOk.append (HeadOk.append hp _) _) _) _)
  have hkn : ¬ isTmpName (s!"{pfx}k{i}_{j}") :=
    HeadOk.notTmp (HeadOk.append (HeadOk.append (HeadOk.append (HeadOk.append hp _) _) _) _)
  have h32 : (32 : Nat) < 2 ^ 64 := by norm_num
  exact ⟨fun k => arraySet_inv s.fst (i + j) k _ (fun t => ¬ isTmpName t) hs.1 hpn, hkn,
    cmdsClean_snoc (cmdsClean_snoc (cmdsClean_snoc hs.2.2
        (.rScalarSetExpr _ _ ⟨⟨⟨ha i, hb j⟩, hs.1 (i + j)⟩, hs.2.1⟩))
      (.rScalarSetExpr _ _ ⟨htn, mask32_lt⟩))
    (.rScalarSetExpr _ _ ⟨htn, h32⟩)⟩

theorem genMulOuter_step (zero : String) (aN bN : List String) (pfx : String)
    (hz : ¬ isTmpName zero) (ha : NamesClean aN) (hb : NamesClean bN) (hp : HeadOk pfx) :
    ∀ (i : Nat) (s s' : MulO),
      QM s → genMulOuterStep zero aN bN pfx i s = ForInStep.yield s' → QM s' := by
  intro i s s' hs hy
  simp only [genMulOuterStep] at hy
  injection hy with hy
  subst hy
  have hinner : QI ((forIn [:bN.length] (⟨s.fst, zero, s.snd⟩)
      (genMulInnerStep zero aN bN pfx i) : Id _)) := by
    refine forIn_range_inv QI _ _ _ ⟨hs.1, hz, hs.2⟩
      (genMulInner_step zero aN bN pfx i ha hb hp) ?_
    intro j t t' _ hd
    simp only [genMulInnerStep] at hd
    injection hd
  exact ⟨fun k => arraySet_inv _ (i + bN.length) k _ (fun t => ¬ isTmpName t)
    hinner.1 hinner.2.1, hinner.2.2⟩

/-- **`genMul` emits covered commands and non-temp result names.** For a
    head-clean private prefix, a non-temp zero slot and non-temp operand name
    lists, every `RScalarSetExpr` the operand-scanning multiply emits is
    `srcClean`, and every accumulator name it returns is outside the fresh-temp
    namespace. -/
theorem genMul_clean (zero : String) (aN bN : List String) (pfx : String)
    (hz : ¬ isTmpName zero) (ha : NamesClean aN) (hb : NamesClean bN) (hp : HeadOk pfx) :
    CmdsClean (genMul zero aN bN pfx).1 ∧ NamesClean (genMul zero aN bN pfx).2 := by
  have key : QM (genMulRun zero aN bN pfx) := by
    unfold genMulRun
    refine forIn_range_inv QM aN.length (genMulOuterStep zero aN bN pfx)
      (⟨Array.replicate (aN.length + bN.length) zero, ([] : List LowCT)⟩)
      ⟨arrayReplicate_inv _ _ (fun t => ¬ isTmpName t) hz notTmp_empty, cmdsClean_nil⟩
      (genMulOuter_step zero aN bN pfx hz ha hb hp) ?_
    intro i t t' _ hd
    simp only [genMulOuterStep] at hd
    injection hd
  rw [genMul_eq]
  exact ⟨key.2, fun k => by rw [arrayToList_getBang]; exact key.1 k⟩

/-! ## 5. The operand-scanning add -/

theorem genAdd_eq (zero : String) (aN bN : List String) (pfx : String) :
    genAdd zero aN bN pfx =
      ((genAddRun zero aN bN pfx).snd.fst,
       ((genAddRun zero aN bN pfx).snd.snd.set! (max aN.length bN.length)
          (genAddRun zero aN bN pfx).fst).toList) := rfl

abbrev QA : AddS → Prop :=
  fun r => ¬ isTmpName r.fst ∧ CmdsClean r.snd.fst
    ∧ (∀ k : Nat, ¬ isTmpName (r.snd.snd[k]!))

/-- **`genAdd` emits covered commands and non-temp result names**, including the
    final carry limb the loop stores after the last trip. -/
theorem genAdd_clean (zero : String) (aN bN : List String) (pfx : String)
    (hz : ¬ isTmpName zero) (ha : NamesClean aN) (hb : NamesClean bN) (hp : HeadOk pfx) :
    CmdsClean (genAdd zero aN bN pfx).1 ∧ NamesClean (genAdd zero aN bN pfx).2 := by
  have hstep : ∀ (i : Nat) (s s' : AddS),
      QA s → genAddStep zero aN bN pfx i s = ForInStep.yield s' → QA s' := by
    intro i s s' hs hy
    simp only [genAddStep] at hy
    injection hy with hy
    subst hy
    have htn : ¬ isTmpName (s!"{pfx}t{i}") :=
      HeadOk.notTmp (HeadOk.append (HeadOk.append hp _) _)
    have hsn : ¬ isTmpName (s!"{pfx}s{i}") :=
      HeadOk.notTmp (HeadOk.append (HeadOk.append hp _) _)
    have hkn : ¬ isTmpName (s!"{pfx}k{i}") :=
      HeadOk.notTmp (HeadOk.append (HeadOk.append hp _) _)
    have h32 : (32 : Nat) < 2 ^ 64 := by norm_num
    exact ⟨hkn,
      cmdsClean_snoc (cmdsClean_snoc (cmdsClean_snoc hs.2.1
          (.rScalarSetExpr _ _ ⟨⟨namesClean_getD aN ha i zero hz,
            namesClean_getD bN hb i zero hz⟩, hs.1⟩))
        (.rScalarSetExpr _ _ ⟨htn, mask32_lt⟩))
      (.rScalarSetExpr _ _ ⟨htn, h32⟩),
      fun k => arraySet_inv s.snd.snd i k _ (fun t => ¬ isTmpName t) hs.2.2 hsn⟩
  have key : QA (genAddRun zero aN bN pfx) := by
    unfold genAddRun
    refine forIn_range_inv QA _ (genAddStep zero aN bN pfx) _
      ⟨hz, cmdsClean_nil, arrayReplicate_inv _ _ (fun t => ¬ isTmpName t) hz notTmp_empty⟩
      hstep ?_
    intro i t t' _ hd
    simp only [genAddStep] at hd
    injection hd
  rw [genAdd_eq]
  exact ⟨key.2.1, fun k => by
    rw [arrayToList_getBang]
    exact arraySet_inv _ _ k _ (fun t => ¬ isTmpName t) key.2.2 key.1⟩

/-! ## 6. The ripple subtract -/

theorem genSub_eq (zero : String) (aN pN : List String) (pfx : String) :
    genSub zero aN pN pfx =
      ((genSubRun zero aN pN pfx).snd.fst, (genSubRun zero aN pN pfx).snd.snd.toList,
       (genSubRun zero aN pN pfx).fst) := rfl

/-- **`genSub` emits covered commands, non-temp difference names, and a non-temp
    final-borrow name.** -/
theorem genSub_clean (zero : String) (aN pN : List String) (pfx : String)
    (hz : ¬ isTmpName zero) (ha : NamesClean aN) (hpN : NamesClean pN) (hp : HeadOk pfx) :
    CmdsClean (genSub zero aN pN pfx).1 ∧ NamesClean (genSub zero aN pN pfx).2.1
      ∧ ¬ isTmpName (genSub zero aN pN pfx).2.2 := by
  have hstep : ∀ (i : Nat) (s s' : SubS),
      QA s → genSubStep zero aN pN pfx i s = ForInStep.yield s' → QA s' := by
    intro i s s' hs hy
    simp only [genSubStep] at hy
    injection hy with hy
    subst hy
    have htn : ¬ isTmpName (s!"{pfx}t{i}") :=
      HeadOk.notTmp (HeadOk.append (HeadOk.append hp _) _)
    have hdn : ¬ isTmpName (s!"{pfx}d{i}") :=
      HeadOk.notTmp (HeadOk.append (HeadOk.append hp _) _)
    have hhn : ¬ isTmpName (s!"{pfx}h{i}") :=
      HeadOk.notTmp (HeadOk.append (HeadOk.append hp _) _)
    have hbn : ¬ isTmpName (s!"{pfx}b{i}") :=
      HeadOk.notTmp (HeadOk.append (HeadOk.append hp _) _)
    have h32 : (32 : Nat) < 2 ^ 64 := by norm_num
    have h1 : (1 : Nat) < 2 ^ 64 := by norm_num
    have hbig : (4294967296 : Nat) < 2 ^ 64 := by norm_num
    exact ⟨hbn,
      cmdsClean_snoc (cmdsClean_snoc (cmdsClean_snoc (cmdsClean_snoc hs.2.1
            (.rScalarSetExpr _ _ ⟨⟨⟨ha i, hbig⟩, namesClean_getD pN hpN i zero hz⟩, hs.1⟩))
          (.rScalarSetExpr _ _ ⟨htn, mask32_lt⟩))
        (.rScalarSetExpr _ _ ⟨htn, h32⟩))
      (.rScalarSetExpr _ _ ⟨h1, hhn⟩),
      fun k => arraySet_inv s.snd.snd i k _ (fun t => ¬ isTmpName t) hs.2.2 hdn⟩
  have key : QA (genSubRun zero aN pN pfx) := by
    unfold genSubRun
    refine forIn_range_inv QA _ (genSubStep zero aN pN pfx) _
      ⟨hz, cmdsClean_nil, arrayReplicate_inv _ _ (fun t => ¬ isTmpName t) hz notTmp_empty⟩
      hstep ?_
    intro i t t' _ hd
    simp only [genSubStep] at hd
    injection hd
  rw [genSub_eq]
  exact ⟨key.2.1, fun k => by rw [arrayToList_getBang]; exact key.2.2 k, key.1⟩

/-! ## 7. List helpers -/

theorem cmdsClean_append {l₁ l₂ : List LowCT} (h₁ : CmdsClean l₁) (h₂ : CmdsClean l₂) :
    CmdsClean (l₁ ++ l₂) := by
  intro d hd
  rcases List.mem_append.mp hd with h | h
  · exact h₁ d h
  · exact h₂ d h

theorem namesClean_take (l : List String) (h : NamesClean l) (n : Nat) :
    NamesClean (l.take n) := by
  intro k
  rw [List.getElem!_eq_getElem?_getD, List.getElem?_take]
  split
  · have hk := h k
    rw [List.getElem!_eq_getElem?_getD] at hk
    exact hk
  · simpa using notTmp_empty

theorem namesClean_drop (l : List String) (h : NamesClean l) (n : Nat) :
    NamesClean (l.drop n) := by
  intro k
  rw [List.getElem!_eq_getElem?_getD, List.getElem?_drop]
  have hk := h (n + k)
  rw [List.getElem!_eq_getElem?_getD] at hk
  exact hk

theorem namesClean_pair (a b : String) (ha : ¬ isTmpName a) (hb : ¬ isTmpName b) :
    NamesClean [a, b] := by
  intro k
  match k with
  | 0 => exact ha
  | 1 => exact hb
  | (n + 2) =>
      rw [List.getElem!_eq_getElem?_getD]
      simpa using notTmp_empty

/-! ## 8. The Solinas fold -/

/-- **`genFold` emits covered commands and non-temp result names.** The empty-high
    branch returns the input names unchanged; the folding branch composes
    `genMul` on the high limbs with `genAdd` against the low eight. -/
theorem genFold_clean (zero c0N c1N : String) (full : List String) (pfx : String)
    (hz : ¬ isTmpName zero) (hc0 : ¬ isTmpName c0N) (hc1 : ¬ isTmpName c1N)
    (hf : NamesClean full) (hp : HeadOk pfx) :
    CmdsClean (genFold zero c0N c1N full pfx).1
      ∧ NamesClean (genFold zero c0N c1N full pfx).2 := by
  have hgen : genFold zero c0N c1N full pfx =
      if (full.drop 8).isEmpty then ([], full)
      else ((genMul zero [c0N, c1N] (full.drop 8) (pfx ++ "m")).1
              ++ (genAdd zero (full.take 8)
                    (genMul zero [c0N, c1N] (full.drop 8) (pfx ++ "m")).2 (pfx ++ "a")).1,
            (genAdd zero (full.take 8)
              (genMul zero [c0N, c1N] (full.drop 8) (pfx ++ "m")).2 (pfx ++ "a")).2) := rfl
  rw [hgen]
  split
  · exact ⟨cmdsClean_nil, hf⟩
  · obtain ⟨hmc, hchi⟩ := genMul_clean zero [c0N, c1N] (full.drop 8) (pfx ++ "m") hz
      (namesClean_pair c0N c1N hc0 hc1) (namesClean_drop full hf 8) (HeadOk.append hp _)
    obtain ⟨hac, hres⟩ := genAdd_clean zero (full.take 8)
      (genMul zero [c0N, c1N] (full.drop 8) (pfx ++ "m")).2 (pfx ++ "a") hz
      (namesClean_take full hf 8) hchi (HeadOk.append hp _)
    exact ⟨cmdsClean_append hmc hac, hres⟩

/-! ## 9. The three field bricks

`feMulHalves` / `feAddHalves` / `feSubHalves` compose the builders with the
branch-free select tail, whose eight commands are emitted by a further
`for i in [0:8]` loop. -/

open CatCrypt.Crypto.SecureCompilation.Secp256k1PointOpFront

theorem notTmp_ZZ : ¬ isTmpName "ZZ" := notTmp_of_len _ (by decide)
theorem notTmp_CC0 : ¬ isTmpName "CC0" := notTmp_of_len _ (by decide)
theorem notTmp_CC1 : ¬ isTmpName "CC1" := notTmp_of_len _ (by decide)

theorem headOk_PL : HeadOk "PL" := ⟨'P', ['L'], rfl, by decide⟩

theorem namesClean_plNames : NamesClean plNames :=
  namesClean_map_range 8 _ (fun _ => HeadOk.notTmp (HeadOk.append headOk_PL _))

theorem cmdsClean_cons {c : LowCT} {l : List LowCT} (hc : IsCoveredS c)
    (hl : CmdsClean l) : CmdsClean (c :: l) := by
  intro d hd
  rcases List.mem_cons.mp hd with rfl | h
  · exact hc
  · exact hl d h

theorem lt64_zero : (0 : Nat) < 2 ^ 64 := by norm_num

/-- **The `feMul` brick emits covered commands and non-temp result names.** -/
theorem feMulHalves_clean (pfx : String) (A B : List String)
    (hA : NamesClean A) (hB : NamesClean B) (hp : HeadOk pfx) :
    CmdsClean (feMulHalves pfx A B).1 ∧ NamesClean (feMulHalves pfx A B).2 := by
  have hpfx1 : ∀ u : String, ¬ isTmpName (pfx ++ u) :=
    fun u => HeadOk.notTmp (HeadOk.append hp u)
  have hpfx2 : ∀ u v : String, ¬ isTmpName (pfx ++ u ++ v) :=
    fun u v => HeadOk.notTmp (HeadOk.append (HeadOk.append hp u) v)
  obtain ⟨hmc, hprod⟩ := genMul_clean "ZZ" A B (pfx ++ "M") notTmp_ZZ hA hB (HeadOk.append hp _)
  obtain ⟨hf1c, hr1⟩ := genFold_clean "ZZ" "CC0" "CC1" _ (pfx ++ "F1") notTmp_ZZ notTmp_CC0 notTmp_CC1
    hprod (HeadOk.append hp _)
  obtain ⟨hf2c, hr2⟩ := genFold_clean "ZZ" "CC0" "CC1" _ (pfx ++ "F2") notTmp_ZZ notTmp_CC0 notTmp_CC1
    hr1 (HeadOk.append hp _)
  obtain ⟨hf3c, hr3⟩ := genFold_clean "ZZ" "CC0" "CC1" _ (pfx ++ "F3") notTmp_ZZ notTmp_CC0 notTmp_CC1
    hr2 (HeadOk.append hp _)
  obtain ⟨hf4c, hr4⟩ := genFold_clean "ZZ" "CC0" "CC1" _ (pfx ++ "F4") notTmp_ZZ notTmp_CC0 notTmp_CC1
    hr3 (HeadOk.append hp _)
  obtain ⟨hsc, hdN, hbw⟩ := genSub_clean "ZZ" _ plNames (pfx ++ "S") notTmp_ZZ
    (namesClean_take _ hr4 8) namesClean_plNames (HeadOk.append hp _)
  have hlo8 := namesClean_take _ hr4 8
  unfold feMulHalves
  constructor
  · refine forIn_range_inv CmdsClean 8 _ _ ?_ ?_ ?_
    · exact cmdsClean_append
        (cmdsClean_append (cmdsClean_append (cmdsClean_append
          (cmdsClean_append (cmdsClean_append hmc hf1c) hf2c) hf3c) hf4c) hsc)
        (cmdsClean_cons (.rScalarSetExpr _ _ ⟨lt64_zero, hbw⟩)
          (cmdsClean_cons (.rScalarSetExpr _ _ ⟨hpfx1 _, mask32_lt⟩)
            (cmdsClean_cons (.rScalarSetExpr _ _ ⟨hpfx1 _, mask32_lt⟩) cmdsClean_nil)))
    · intro i s s' hsC hy
      injection hy with hy
      subst hy
      exact cmdsClean_snoc hsC
        (.rScalarSetExpr _ _ ⟨⟨hlo8 i, hpfx1 _⟩, ⟨hdN i, hpfx1 _⟩⟩)
    · intro i s s' _ hd
      injection hd
  · exact namesClean_map_range 8 _ (fun k => hpfx2 _ _)

theorem namesClean_append (l₁ l₂ : List String) (h₁ : NamesClean l₁) (h₂ : NamesClean l₂) :
    NamesClean (l₁ ++ l₂) := by
  intro k
  rw [List.getElem!_eq_getElem?_getD, List.getElem?_append]
  split
  · have hk := h₁ k
    rw [List.getElem!_eq_getElem?_getD] at hk
    exact hk
  · have hk := h₂ (k - l₁.length)
    rw [List.getElem!_eq_getElem?_getD] at hk
    exact hk

/-- **The `feAdd` brick emits covered commands and non-temp result names.** -/
theorem feAddHalves_clean (pfx : String) (A B : List String)
    (hA : NamesClean A) (hB : NamesClean B) (hp : HeadOk pfx) :
    CmdsClean (feAddHalves pfx A B).1 ∧ NamesClean (feAddHalves pfx A B).2 := by
  have hpfx1 : ∀ u : String, ¬ isTmpName (pfx ++ u) :=
    fun u => HeadOk.notTmp (HeadOk.append hp u)
  have hpfx2 : ∀ u v : String, ¬ isTmpName (pfx ++ u ++ v) :=
    fun u v => HeadOk.notTmp (HeadOk.append (HeadOk.append hp u) v)
  obtain ⟨hac, hs9⟩ := genAdd_clean "ZZ" A B (pfx ++ "A") notTmp_ZZ hA hB (HeadOk.append hp _)
  obtain ⟨hsc, hd9, hbw⟩ := genSub_clean "ZZ" _ (plNames ++ ["ZZ"]) (pfx ++ "S") notTmp_ZZ
    hs9 (namesClean_append _ _ namesClean_plNames
      (fun k => by
        match k with
        | 0 => exact notTmp_ZZ
        | (n + 1) => rw [List.getElem!_eq_getElem?_getD]; simpa using notTmp_empty))
    (HeadOk.append hp _)
  unfold feAddHalves
  constructor
  · refine forIn_range_inv CmdsClean 8 _ _ ?_ ?_ ?_
    · exact cmdsClean_append (cmdsClean_append hac hsc)
        (cmdsClean_cons (.rScalarSetExpr _ _ ⟨lt64_zero, hbw⟩)
          (cmdsClean_cons (.rScalarSetExpr _ _ ⟨hpfx1 _, mask32_lt⟩)
            (cmdsClean_cons (.rScalarSetExpr _ _ ⟨hpfx1 _, mask32_lt⟩) cmdsClean_nil)))
    · intro i s s' hsC hy
      injection hy with hy
      subst hy
      exact cmdsClean_snoc hsC
        (.rScalarSetExpr _ _ ⟨⟨hs9 i, hpfx1 _⟩, ⟨hd9 i, hpfx1 _⟩⟩)
    · intro i s s' _ hd
      injection hd
  · exact namesClean_map_range 8 _ (fun k => hpfx2 _ _)

/-- **The `feSub` brick emits covered commands and non-temp result names.** -/
theorem feSubHalves_clean (pfx : String) (A B : List String)
    (hA : NamesClean A) (hB : NamesClean B) (hp : HeadOk pfx) :
    CmdsClean (feSubHalves pfx A B).1 ∧ NamesClean (feSubHalves pfx A B).2 := by
  have hpfx1 : ∀ u : String, ¬ isTmpName (pfx ++ u) :=
    fun u => HeadOk.notTmp (HeadOk.append hp u)
  have hpfx2 : ∀ u v : String, ¬ isTmpName (pfx ++ u ++ v) :=
    fun u v => HeadOk.notTmp (HeadOk.append (HeadOk.append hp u) v)
  obtain ⟨hdc, hd8, hbw⟩ := genSub_clean "ZZ" A B (pfx ++ "S") notTmp_ZZ hA hB (HeadOk.append hp _)
  have hpm : NamesClean ((List.range 8).map (fun i => s!"{pfx}PM{i}")) :=
    namesClean_map_range 8 _ (fun k => hpfx2 _ _)
  obtain ⟨hacc, hr9⟩ := genAdd_clean "ZZ" _ _ (pfx ++ "A") notTmp_ZZ hd8 hpm (HeadOk.append hp _)
  unfold feSubHalves
  constructor
  · refine cmdsClean_append ?_ hacc
    refine forIn_range_inv CmdsClean 8 _ _ ?_ ?_ ?_
    · exact cmdsClean_append hdc
        (cmdsClean_cons (.rScalarSetExpr _ _ ⟨lt64_zero, hbw⟩)
          (cmdsClean_cons (.rScalarSetExpr _ _ ⟨hpfx1 _, mask32_lt⟩) cmdsClean_nil))
    · intro i s s' hsC hy
      injection hy with hy
      subst hy
      exact cmdsClean_snoc hsC
        (.rScalarSetExpr _ _ ⟨namesClean_plNames i, hpfx1 _⟩)
    · intro i s s' _ hd
      injection hd
  · exact namesClean_take _ hr9 8

/-! ## 10. The field-op schedule

A schedule entry names an output and two input field elements; the emitted brick
is covered when all three names are head-clean. `FOpOkB` is the decidable form,
so a concrete schedule discharges the side condition by `decide` on its 19
entries. -/

def headOkB (s : String) : Bool := match s.toList with | c :: _ => c != '_' | [] => false

theorem headOk_of_headOkB (s : String) (h : headOkB s = true) : HeadOk s := by
  unfold headOkB at h
  match hs : s.toList with
  | [] => rw [hs] at h; exact absurd h (by decide)
  | c :: t =>
      rw [hs] at h
      exact ⟨c, t, hs, by simpa using h⟩

/-- All three field-element names of a schedule entry are head-clean. -/
def FOpOkB : FOp → Bool
  | .mul o a b => headOkB o && headOkB a && headOkB b
  | .add o a b => headOkB o && headOkB a && headOkB b
  | .sub o a b => headOkB o && headOkB a && headOkB b

theorem cmdsClean_map_range' (n : Nat) (f : Nat → LowCT)
    (hf : ∀ i, i < n → IsCoveredS (f i)) : CmdsClean ((List.range n).map f) := by
  intro c hc
  obtain ⟨i, hi, rfl⟩ := List.mem_map.mp hc
  exact hf i (List.mem_range.mp hi)

theorem cmdsClean_flatMap_range (n : Nat) (f : Nat → List LowCT)
    (hf : ∀ i, i < n → CmdsClean (f i)) : CmdsClean ((List.range n).flatMap f) := by
  intro c hc
  obtain ⟨i, hi, hci⟩ := List.mem_flatMap.mp hc
  exact hf i (List.mem_range.mp hi) c hci

/-- A head-clean field-element name yields eight non-temp half-limb names. -/
theorem namesClean_feH (fe : String) (h : HeadOk fe) : NamesClean (feH fe) :=
  namesClean_map_range 8 _
    (fun _ => HeadOk.notTmp (HeadOk.append (HeadOk.append h _) _))

theorem headOk_op (idx : Nat) : HeadOk s!"op{idx}" :=
  HeadOk.append (⟨'o', ['p'], rfl, by decide⟩ : HeadOk "op") _

/-- **One schedule entry's brick emits covered commands** — the brick body plus
    the eight copies into the output field element's half-limb names. -/
theorem emitFOp_clean (idx : Nat) (op : FOp) (h : FOpOkB op = true) :
    CmdsClean (emitFOp idx op) := by
  have hop := headOk_op idx
  cases op with
  | mul o a b =>
      simp only [FOpOkB, Bool.and_eq_true] at h
      obtain ⟨hc, hn⟩ := feMulHalves_clean s!"op{idx}" (feH a) (feH b)
        (namesClean_feH a (headOk_of_headOkB a h.1.2))
        (namesClean_feH b (headOk_of_headOkB b h.2)) hop
      exact cmdsClean_append hc
        (cmdsClean_map_range' 8 _ (fun k _ => .rScalarSetExpr _ _ (hn k)))
  | add o a b =>
      simp only [FOpOkB, Bool.and_eq_true] at h
      obtain ⟨hc, hn⟩ := feAddHalves_clean s!"op{idx}" (feH a) (feH b)
        (namesClean_feH a (headOk_of_headOkB a h.1.2))
        (namesClean_feH b (headOk_of_headOkB b h.2)) hop
      exact cmdsClean_append hc
        (cmdsClean_map_range' 8 _ (fun k _ => .rScalarSetExpr _ _ (hn k)))
  | sub o a b =>
      simp only [FOpOkB, Bool.and_eq_true] at h
      obtain ⟨hc, hn⟩ := feSubHalves_clean s!"op{idx}" (feH a) (feH b)
        (namesClean_feH a (headOk_of_headOkB a h.1.2))
        (namesClean_feH b (headOk_of_headOkB b h.2)) hop
      exact cmdsClean_append hc
        (cmdsClean_map_range' 8 _ (fun k _ => .rScalarSetExpr _ _ (hn k)))

theorem cmdsClean_mapIdx : ∀ (ops : List FOp) (g : Nat → FOp → List LowCT),
    (∀ i op, op ∈ ops → CmdsClean (g i op)) → CmdsClean ((ops.mapIdx g).flatten) := by
  intro ops
  induction ops with
  | nil => intro g _; exact cmdsClean_nil
  | cons a l ih =>
      intro g hg
      rw [List.mapIdx_cons, List.flatten_cons]
      exact cmdsClean_append (hg 0 a (.head _))
        (ih (fun i => g (i + 1)) (fun i op hop => hg (i + 1) op (.tail _ hop)))

/-- **A whole schedule of head-clean field ops emits covered commands.** -/
theorem runSchedule_clean (ops : List FOp) (h : ∀ op ∈ ops, FOpOkB op = true) :
    CmdsClean (runSchedule ops) :=
  cmdsClean_mapIdx ops _ (fun i op hop => emitFOp_clean i op (h op hop))

/-! ## 11. Prologue, epilogue, and the whole body

The constants, the cell indices, the three coordinate loads and the three
coordinate stores surround the schedule; `seqAll` chains the flat command list
into the `RSeq` spine the front consumes. -/

theorem lt64_32 : (32 : Nat) < 2 ^ 64 := by norm_num

theorem pl32_mem_lt : ∀ v ∈ pl32, v < 2 ^ 64 := by
  intro v hv
  obtain ⟨i, _, rfl⟩ := List.mem_map.mp hv
  exact lt_of_le_of_lt Nat.and_le_right mask32_lt

theorem getD_lt_of_mem_lt {l : List Nat} {d : Nat} (h : ∀ v ∈ l, v < 2 ^ 64)
    (hd : d < 2 ^ 64) (i : Nat) : l.getD i d < 2 ^ 64 := by
  rw [List.getD_eq_getElem?_getD]
  cases hl : l[i]? with
  | none => simpa using hd
  | some v =>
      have : v ∈ l := List.mem_of_getElem? hl
      simpa using h v this

theorem idxInit_clean : CmdsClean idxInit :=
  cmdsClean_map_range' 12 _ (fun i hi =>
    .rScalarSetExpr _ _ (lt_trans hi (by norm_num)))

theorem constInit_clean :
    CmdsClean CatCrypt.Crypto.SecureCompilation.Secp256k1PointOpFront.constInit := by
  refine cmdsClean_append ?_ (cmdsClean_map_range' 8 _ (fun i _ =>
    .rScalarSetExpr _ _ (getD_lt_of_mem_lt (d := 0) pl32_mem_lt (by norm_num) i)))
  have h977 : (977 : Nat) < 2 ^ 64 := by norm_num
  have h1 : (1 : Nat) < 2 ^ 64 := by norm_num
  exact cmdsClean_cons (.rScalarSetExpr _ _ lt64_zero)
    (cmdsClean_cons (.rScalarSetExpr _ _ h977)
      (cmdsClean_cons (.rScalarSetExpr _ _ h1) cmdsClean_nil))

theorem loadField_clean (fw : Nat) (arr : String) (o : Nat) (fe : String)
    (h : HeadOk fe) : CmdsClean (loadField fw arr o fe) := by
  have hu : ∀ j : Nat, ¬ isTmpName (s!"{fe}u{j}") :=
    fun j => HeadOk.notTmp (HeadOk.append (HeadOk.append h _) _)
  refine cmdsClean_append (cmdsClean_map_range' 4 _ (fun j _ => .rArrLoad _ _ _)) ?_
  refine cmdsClean_flatMap_range 4 _ (fun j _ => ?_)
  exact cmdsClean_cons (.rScalarSetExpr _ _ ⟨hu j, mask32_lt⟩)
    (cmdsClean_cons (.rScalarSetExpr _ _ ⟨hu j, lt64_32⟩) cmdsClean_nil)

theorem storeField_clean (fw o : Nat) (fe : String) (h : HeadOk fe) :
    CmdsClean (storeField fw o fe) := by
  have hh : ∀ j : Nat, ¬ isTmpName (s!"{fe}h{j}") :=
    fun j => HeadOk.notTmp (HeadOk.append (HeadOk.append h _) _)
  refine cmdsClean_flatMap_range 4 _ (fun j _ => ?_)
  exact cmdsClean_cons (.rScalarSetExpr _ _ ⟨hh (2 * j), ⟨hh (2 * j + 1), lt64_32⟩⟩)
    (cmdsClean_cons (.rArrStore _ _ _) cmdsClean_nil)

/-- Coverage transports through the `RSeq` chaining of a command list. -/
theorem isCoveredS_seqAll : ∀ l : List LowCT, CmdsClean l → IsCoveredS (seqAll l) := by
  intro l
  induction l with
  | nil => intro _; exact .rSkip
  | cons c cs ih =>
      intro h
      cases cs with
      | nil => exact h c (.head _)
      | cons c' cs' =>
          show IsCoveredS (LowCT.RSeq c (seqAll (c' :: cs')))
          exact .rSeq (h c (.head _)) (ih (fun x hx => h x (.tail _ hx)))

/-- Every field-element name of the `dbl-2009-l` schedule is head-clean. -/
theorem jacDblSchedule_ok : ∀ op ∈ jacDblSchedule, FOpOkB op = true := by decide

theorem headOk_X : HeadOk "X" := ⟨'X', [], rfl, by decide⟩
theorem headOk_Y : HeadOk "Y" := ⟨'Y', [], rfl, by decide⟩
theorem headOk_Z : HeadOk "Z" := ⟨'Z', [], rfl, by decide⟩
theorem headOk_Xp : HeadOk "Xp" := ⟨'X', ['p'], rfl, by decide⟩
theorem headOk_Yp : HeadOk "Yp" := ⟨'Y', ['p'], rfl, by decide⟩
theorem headOk_Zp : HeadOk "Zp" := ⟨'Z', ['p'], rfl, by decide⟩

/-- **The `jacDbl` front body is in the straight-line scalar covered fragment.**
    Every command it emits — the index and reduction constants, the three
    coordinate loads, the nineteen field bricks, the three coordinate stores — is
    an `IsCoveredS` arm, with `srcClean` on every `RScalarSetExpr`. -/
theorem jacDblBody_coveredS : IsCoveredS jacDblBody :=
  isCoveredS_seqAll _
    (cmdsClean_append (cmdsClean_append (cmdsClean_append
      (cmdsClean_append (cmdsClean_append (cmdsClean_append (cmdsClean_append
        (cmdsClean_append idxInit_clean constInit_clean)
        (loadField_clean 96 "P" 0 "X" headOk_X))
        (loadField_clean 96 "P" 4 "Y" headOk_Y))
        (loadField_clean 96 "P" 8 "Z" headOk_Z))
        (runSchedule_clean jacDblSchedule jacDblSchedule_ok))
        (storeField_clean 96 0 "Xp" headOk_Xp))
        (storeField_clean 96 4 "Yp" headOk_Yp))
        (storeField_clean 96 8 "Zp" headOk_Zp))

/-- **The `jacDbl` front body is in the control-extended covered fragment**, the
    hypothesis `translateDialectControl_denote_ctl` takes. -/
theorem jacDblBody_coveredSCtl : IsCoveredSCtl jacDblBody :=
  .ofStraight jacDblBody_coveredS

theorem jacAddSchedule_ok : ∀ op ∈ jacAddSchedule, FOpOkB op = true := by decide

theorem headOk_X1 : HeadOk "X1" := ⟨'X', ['1'], rfl, by decide⟩
theorem headOk_Y1 : HeadOk "Y1" := ⟨'Y', ['1'], rfl, by decide⟩
theorem headOk_Z1 : HeadOk "Z1" := ⟨'Z', ['1'], rfl, by decide⟩
theorem headOk_X2 : HeadOk "X2" := ⟨'X', ['2'], rfl, by decide⟩
theorem headOk_Y2 : HeadOk "Y2" := ⟨'Y', ['2'], rfl, by decide⟩
theorem headOk_Z2 : HeadOk "Z2" := ⟨'Z', ['2'], rfl, by decide⟩

/-- **The `jacAdd` front body is in the straight-line scalar covered fragment.**
    The `jacDblBody_coveredS` shape with six coordinate loads out of two frames
    and the twenty-three-brick addition schedule. -/
theorem jacAddBody_coveredS : IsCoveredS jacAddBody :=
  isCoveredS_seqAll _
    (cmdsClean_append
      (cmdsClean_append
        (cmdsClean_append
          (cmdsClean_append
            (cmdsClean_append
              (cmdsClean_append
                (cmdsClean_append
                  (cmdsClean_append
                    (cmdsClean_append
                      (cmdsClean_append
                        (cmdsClean_append idxInit_clean constInit_clean)
                        (loadField_clean 96 "P1" 0 "X1" headOk_X1))
                      (loadField_clean 96 "P1" 4 "Y1" headOk_Y1))
                    (loadField_clean 96 "P1" 8 "Z1" headOk_Z1))
                  (loadField_clean 96 "P2" 0 "X2" headOk_X2))
                (loadField_clean 96 "P2" 4 "Y2" headOk_Y2))
              (loadField_clean 96 "P2" 8 "Z2" headOk_Z2))
            (runSchedule_clean jacAddSchedule jacAddSchedule_ok))
          (storeField_clean 96 0 "Xp" headOk_Xp))
        (storeField_clean 96 4 "Yp" headOk_Yp))
      (storeField_clean 96 8 "Zp" headOk_Zp))

/-- **The `jacAdd` front body is in the control-extended covered fragment.** -/
theorem jacAddBody_coveredSCtl : IsCoveredSCtl jacAddBody :=
  .ofStraight jacAddBody_coveredS


