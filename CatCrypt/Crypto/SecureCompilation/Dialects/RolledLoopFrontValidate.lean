import CatCrypt.Crypto.SecureCompilation.Dialects.TranslateDialectRolledLoop
import CatCrypt.Crypto.SecureCompilation.X86Backend.LprogAsmPrinter
import CatCrypt.Crypto.SecureCompilation.X86Backend.LprogOptPipeline

set_option autoImplicit false

/-!
# Validation: a GF(127) dot product front-compiled to a rolled `ComL.forLoopN`

This is the end-to-end witness for the rolled-loop front capability
(`TranslateDialectRolledLoop`). It authors the GF(127) dot product
`acc = Σ_i a[i]·b[i] (mod 127)` as a **LowCT loop body** (the covered fragment:
`RArrLoad`/`RScalarSetExpr`/`RArrStore`, with the loop counter `idx` as the array
index) and front-compiles it to a genuine `ComL.forLoopN` — ONE body copy + a real
back-edge — with the body generated by the verified front (no hand-authored `Com`);
this is the front route that replaced the retired hand-`Com` GF(127) dot module.

```
  dotBodyLowCT (RArrLoad a/b/out[idx] + RScalarSetExpr GF(127) math + RArrStore out[idx])
    --(front: translateDialectControl over [out, idx, a, b])-->  Com catCryptDialect
    --(cryptoDialectToJasminCom)----------------------------->  Com jasminDialect (= JLoopBodyN.update)
    --(ComL.forLoopN ⟨N, update⟩ out [a,b] (ret out))-------->  ComL  (ONE body copy + back-edge)
    --(ComL.toLprogPhysAbi [RDI,RSI,RDX] / renderLprogAtt)--->  qruov_dot_front.s
```

GF(127): `127 = 2⁷−1` is a Mersenne prime, so reduction is a data-independent
fold-and-conditional-subtract (all `SMul/SAdd/SSub/SAnd/SShr` — the `lowerSExpr`
alphabet). `condSub127(x)` for `x ∈ [0,253]` is the branch-free mask trick
`t := x−127; m := t>>63; r := t + (127 & (0−m))`.

The validation checks: (i) the front succeeds (`rolledForLoopN`); (ii) the
emitted body has a REAL back-edge (`Lcond`/`Llabel`) with ONE body copy (a
bounded number of `LOADIDX`/`STOREIDX`, NOT `3·N`/`N` unrolled); (iii)
`ComL.denote = the independent %127 dot spec`. The deployed-N C KAT lives at
`bench/qruov_compare/dot_front_kat.c` (driven by `dot_front_emit.lean`).

Invoke (in-model gate):  lake env lean CatCrypt/Crypto/SecureCompilation/Dialects/RolledLoopFrontValidate.lean
-/

namespace CatCrypt.Crypto.SecureCompilation.Dialects.RolledLoopFrontValidate

open CatCrypt.Crypto.SecureCompilation.CryptoSSA
open CatCrypt.Crypto.SecureCompilation.LowCTToCryptoSSA
open CatCrypt.Crypto.SecureCompilation.VIR
open CatCrypt.Crypto.SecureCompilation.VIR.JasminDialect
open CatCrypt.Crypto.SecureCompilation.VIR.JasminLprogExport
open CatCrypt.Crypto.SecureCompilation.Dialects.TranslateDialectRolledLoop
open CatCrypt.Crypto.SecureCompilation.X86Backend.LprogAsmPrinter (renderLprogAtt)
open CatCrypt.Crypto.Jasmin.LowCT (LowCT SExpr TowerType)

/-! ## 0. Dimensions -/

/-- The deployed dot length `B·ℓ = 12` (QR-UOV-Is), well within 64-bit margin
    (`126²·12 ≈ 1.9·10⁵ < 2⁶⁴`). -/
def paramN : Nat := 12

/-! ## 1. The GF(127) loop body, authored as covered LowCT

The loop body runs over the catCryptDialect context
`Γbody = [out:.memref 1, idx:.sword 64, a:.memref N, b:.memref N]` (accumulator
first, loop index next, the two input arrays as invariants). `idx` is the loop
binder; `RArrLoad … idx` resolves it as the dynamic index → `memrefGetDyn` →
`stackLoad` SIB `LOADIDX` at the runtime trip counter. -/

/-- `condSub127(srcName) → dstName`: branch-free `[0,253] → [0,126]` reduce. -/
def condSub127 (dst src : String) : LowCT :=
  .RSeq (.RScalarSetExpr "t" (.SSub (.SVar src) (.SLit 127)))
  (.RSeq (.RScalarSetExpr "m" (.SShr (.SVar "t") (.SLit 63)))
  (.RSeq (.RScalarSetExpr "mask" (.SSub (.SLit 0) (.SVar "m")))
  (.RScalarSetExpr dst (.SAdd (.SVar "t") (.SAnd (.SLit 127) (.SVar "mask"))))))

/-- Sequence a list of `LowCT` into an `RSeq` chain (avoids manual paren nesting). -/
def seqAll : List LowCT → LowCT
  | [] => .RSkip
  | [c] => c
  | c :: cs => .RSeq c (seqAll cs)

/-- One trip of the GF(127) dot accumulate over the loop index `idx`:
    `out[0] := condSub127( out[0] + condSub127²(a[idx]·b[idx] mod 127) )`. -/
def dotBodyLowCT : LowCT := seqAll [
  -- load a[idx], b[idx]
  .RArrLoad ⟨"ai", .TU64⟩ ⟨"a", .TBytes (8 * paramN)⟩ "idx",
  .RArrLoad ⟨"bi", .TU64⟩ ⟨"b", .TBytes (8 * paramN)⟩ "idx",
  -- p := ai * bi (≤ 126² = 15876)
  .RScalarSetExpr "p" (.SMul (.SVar "ai") (.SVar "bi")),
  -- p := (p & 127) + (p >> 7)  (1st Mersenne fold, ≤ 251)
  .RScalarSetExpr "p" (.SAdd (.SAnd (.SVar "p") (.SLit 127)) (.SShr (.SVar "p") (.SLit 7))),
  -- p := (p & 127) + (p >> 7)  (2nd fold, ≤ 127)
  .RScalarSetExpr "p" (.SAdd (.SAnd (.SVar "p") (.SLit 127)) (.SShr (.SVar "p") (.SLit 7))),
  -- r := condSub127(p)  (reduced product in [0,126])
  condSub127 "r" "p",
  -- acc0 := out[0]  (running accumulator)
  .RArrLoad ⟨"acc0", .TU64⟩ ⟨"out", .TBytes 8⟩ "z",
  -- s := acc0 + r  (≤ 252)
  .RScalarSetExpr "s" (.SAdd (.SVar "acc0") (.SVar "r")),
  -- res := condSub127(s)  (GF add result in [0,126])
  condSub127 "res" "s",
  -- out[0] := res
  .RArrStore ⟨"out", .TBytes 8⟩ "z" ⟨"res", .TU64⟩ ]

/-! ## 2. The body context + VarMap

`Γbody = [out, idx, a, b]` (head-first); `out` is the accumulator (`.here`), `idx`
the loop binder (`.there .here`), `a`/`b` the invariants (`.there² .here`,
`.there³ .here`). The VarMap binds those four names; `"z"` is a constant-zero
index slot for the `out[0]` access, materialised in the body. -/

/-- The body context: accumulator `out`, loop index `idx`, invariants `a`, `b`. -/
def Γbody : Ctx := [.memref 1, .sword 64, .memref paramN, .memref paramN]

/-- The body VarMap: `out ↦ .here`, `idx ↦ .there .here`, `a`/`b` deeper. The
    `"z"` zero-index slot is materialised as the first body binding. -/
def vmBody : VarMap Γbody :=
  ((((VarMap.empty.bind (t := .memref paramN) "b").bind (t := .memref paramN) "a").bind
      (t := .sword 64) "idx").bind (t := .memref 1) "out")

/-- The full body: declare the constant-zero index `z := 0`, then the GF dot. -/
def fullBody : LowCT := .RSeq (.RScalarSetExpr "z" (.SLit 0)) dotBodyLowCT

/-! ## 3. The outer program: front body → genuine `ComL.forLoopN`

Outer context `[out, a, b]` (jasmin types `[.stackArr 64 1, .stackArr 64 N,
.stackArr 64 N]`): `out` is the accumulator seed (`.here`), `a`/`b` the invariant
seeds. 3-pointer ABI `qruov_dot_front(out, a, b)`. -/

/-- The outer (kernel-argument) jasmin context. -/
def Γouter : Ctxt jasminDialect := [.stackArr 64 1, .stackArr 64 paramN, .stackArr 64 paramN]

/-- The front-compiled rolled `ComL.forLoopN` (one body copy + back-edge), or
    `none` if the front declines. -/
def dotComL : Option (ComL Γouter (.stackArr 64 1)) :=
  rolledForLoopN (Γouter := Γouter) (accCTy := .memref 1)
    (invCTys := [.memref paramN, .memref paramN])
    paramN vmBody "out" fullBody
    (init := .here)
    (invs := .cons (.there .here) (.cons (.there (.there .here)) .nil))

/-! ## 4. Gate: the front succeeds -/

/-- The GF(127) dot loop body front-compiles to a genuine `ComL.forLoopN`. -/
theorem dotComL_isSome : dotComL.isSome := by native_decide

/-! ## 5. denote = independent %127 dot spec -/

/-- INDEPENDENT plain-`Nat` `%127` schoolbook dot reference. -/
def natDot127 (a b : Fin paramN → BitVec 64) : Nat :=
  (List.range paramN).foldl
    (fun acc i => (acc + (a ⟨i % paramN, Nat.mod_lt _ (by decide)⟩).toNat
                        * (b ⟨i % paramN, Nat.mod_lt _ (by decide)⟩).toNat) % 127) 0

/-- Deterministic residue stream, both in `[0,126]` (the gmp/reference KAT seed). -/
def sampleA : Fin paramN → BitVec 64 := fun i => BitVec.ofNat 64 ((i.val * 37 + 5) % 127)
def sampleB : Fin paramN → BitVec 64 := fun i => BitVec.ofNat 64 ((i.val * 53 + 11) % 127)

/-- **denote = GF(127) dot spec.** The front-compiled rolled loop denotes the
    independent `%127` schoolbook dot on the sample residue stream (output slot 0). -/
theorem dotComL_denote :
    (dotComL.map (fun c =>
        (ComL.denote c
            (.cons (fun _ => (0 : BitVec 64)) (.cons sampleA (.cons sampleB .nil)))
          ⟨0, by decide⟩).toNat))
      = some (natDot127 sampleA sampleB) := by native_decide

/-! ## 6. Rolled lowering: real x86 back-edge, ONE body copy

3-pointer ABI `qruov_dot_front(out, a, b)` (`RDI = out`, `RSI = a`, `RDX = b`). -/

/-- The 3-pointer-ABI physical body of the front-compiled rolled loop. -/
def physBody : Option Lcmd :=
  dotComL.map (fun c =>
    (ComL.toLfundefPhysAbi c (argName 0) [argName 1, argName 2]
      (fun _ => none) (fun _ => none) ["RDI", "RSI", "RDX"] [64, 64, 64]).lfd_body)

/-- **Real back-edge:** the rolled body has both an internal `Llabel` and a `Lcond`
    (`jne .L<d>`) — a genuine counted loop, NOT an unrolled chain. -/
theorem physBody_has_backedge :
    physBody.map (fun b =>
      (b.any (fun i => match i.li_i with | .Lcond _ _ => true | _ => false))
        && (b.any (fun i => match i.li_i with | .Llabel _ _ => true | _ => false)))
      = some true := by native_decide

/-- **Bounded depth (ONE body copy):** the indexed loads (`a[idx]`, `b[idx]`,
    `out[0]`) appear a FIXED number of times, independent of the trip count `N` —
    NOT `3·N` unrolled copies. (Three `LOADIDX`: `a[idx]`, `b[idx]`, `out[0]`.) -/
theorem physBody_bounded_indexed_loads :
    physBody.map (fun b =>
      (b.filter (fun i => match i.li_i with
        | .Lopn _ "LOADIDX" _ => true | _ => false)).length)
      = some 3 := by native_decide

/-- **ONE indexed store** (`out[0]`), not `N` unrolled copies. -/
theorem physBody_one_indexed_store :
    physBody.map (fun b =>
      (b.filter (fun i => match i.li_i with
        | .Lopn _ "STOREIDX" _ => true | _ => false)).length)
      = some 1 := by native_decide

/-! ## 7. Emit driver -/

/-- The owned AT&T `.s` text for `qruov_dot_front` (front-compiled, rolled). -/
def kernelAsm : Option String :=
  dotComL.map (fun c =>
    CatCrypt.Crypto.SecureCompilation.X86Backend.LprogOptPipeline.renderOwned
      (ComL.toLprogPhysAbi c "qruov_dot_front" (argName 0) [argName 1, argName 2]
        (fun _ => none) (fun _ => none) ["RDI", "RSI", "RDX"] [64, 64, 64]))

/-- The emit renders. -/
theorem kernelAsm_isSome : kernelAsm.isSome := by native_decide

/-- Write the front-compiled rolled `.s`. -/
def emit (path : System.FilePath) : IO Unit :=
  match kernelAsm with
  | some asm => IO.FS.writeFile path asm
  | none => throw (IO.userError "front-compile of qruov_dot_front rolled loop failed")

end CatCrypt.Crypto.SecureCompilation.Dialects.RolledLoopFrontValidate
