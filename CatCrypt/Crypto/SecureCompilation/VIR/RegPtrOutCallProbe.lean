import CatCrypt.Crypto.SecureCompilation.Dialects.OrchestrationFront
import CatCrypt.Crypto.SecureCompilation.VIR.ArrAbiOrch
import CatCrypt.Crypto.SecureCompilation.X86Backend.LprogOptPipeline
import CatCrypt.Crypto.SecureCompilation.X86Backend.MpnMulBasecaseFrontEmit
import CatCrypt.Crypto.SecureCompilation.X86Backend.MpnAddNAdxRolledFrontEmit
import CatCrypt.Crypto.SecureCompilation.X86Backend.MpnMul2FixedFrontEmit
import CatCrypt.Crypto.SecureCompilation.X86Backend.MpnAdd4FixedFrontEmit

/-!
# Reg-ptr-out multi-buffer leaf-call probe (sub-quadratic-owned-emit Phase 3, step 1)

Phase 3 / step 1 of the sub-quadratic-owned-emit plan resolves the plan's
"biggest unknown": whether one straight-line owned orchestration can issue
SEVERAL reg-ptr-out (void-return, write-through-out-pointer) leaf `call`s with
computed sub-buffer pointers, keeping every callee's out / scratch / in pointer
correctly marshalled AND the caller's live pointers callee-save across every
call. The single-accumulator `u64 → u64` in-loop call is proven end-to-end
(`VIR.GgmNodeLoopEmit`); the multi-buffer multi-call orchestration is
execution-unverified and has a history of a silent dropped-arg-register bug
(the SDitH SHAKE reg-ptr-out permute that left `%rsi` unset — caught only by an
execution KAT, never by the denotation gate).

This module emits the smallest probe that stresses exactly that path:

* `probe_orch(out, inp)` — a two-`call` straight-line orchestration:
  1. `probe_mul2(scratch0, ap, bp)` — the 2×2 → 4-limb product into a frame
     scratch (out-pointer `scratch0`);
  2. `probe_add4(scratch1, scratch0, acc)` — accumulate the product into `acc`
     through pointers, into a second scratch;
  then scatters `scratch1` to the C out-pointer.

The reg-ptr-out hazard is present by construction: the C out-pointer (`RDI`,
saved to the frame, reloaded only in the scatter epilogue) is live across BOTH
calls; the `acc` input buffer is live across the first call (its address is
recomputed off the input pointer, itself call-clobbered and reloaded per call);
and `scratch0` is the out-pointer of call 0 and an in-pointer of call 1.

## Provenance (front-sourced, NOT hand-authored)

`probe_orch` is generated by the orchestration front
`Dialects.OrchestrationFront.buildOrchCom` from a `CallPhase` schedule — the
sanctioned replacement for hand-authored de-Bruijn operand chains — and lowered
by the array-ABI orchestration backend
`VIR.JasminLprogExport.Com.toLprogArrAbi` (`ArrAbiOrch`), the same reg-ptr-out
marshalling the BLS/pairing/EC emits use (`Pairing.Bls12381Emit`,
`Pairing.EcPairingEmit`, `ArrAbiOrch.emitOneCall`: `leaq scratch → RDI` out-ptr
first, `leaq operand → RSI/RDX`, `call leaf`, scatter to `[out]`). No `Com` /
`Lcmd` / `.s` is hand-authored.

The callees `probe_mul2` / `probe_add4` reuse the owned mpn front bodies
(`MpnMulBasecaseFrontEmit`, `MpnAddNAdxRolledFrontEmit`). See §3 for the ABI
constraint the array-ABI orchestration imposes on them (buffers-only, fixed
arity) and the current gap.

The execution check is the C byte-KAT `bench/regptr_out_probe/kat.c`, which links
the three emitted `.s` and checks the byte-exact product+accumulate against a
`__int128` reference — the instrument that catches a dropped arg register, which
the denotation gate demonstrably does not.

## Main results

* `probeOrchCom` / `probeOrchCom_isSome` — the two-call reg-ptr-out orchestration
  `Com`, front-generated by `buildOrchCom`, and its `.isSome` gate.
* `probeOrchLprog` / `probeOrchAsm` — the owned `Lprog` and rendered AT&T `.s` for
  `probe_orch`, via `Com.toLprogArrAbi` then `renderOwned`.
* `emitMain` — writes `probe_orch_owned.s` (and the callee `.s`) for the byte-KAT.
-/

set_option autoImplicit false

namespace CatCrypt.Crypto.SecureCompilation.VIR.RegPtrOutCallProbe

open CatCrypt.Crypto.SecureCompilation.VIR
open CatCrypt.Crypto.SecureCompilation.VIR.JasminDialect
open CatCrypt.Crypto.SecureCompilation.VIR.JasminLprogExport
open CatCrypt.Crypto.SecureCompilation.Dialects.OrchestrationFront

/-! ## 1. Buffer types and the orchestration argument context

Root-order slot convention (`OrchestrationFront` §Slot convention,
`ArrAbiOrch.exprArgSlots`): a root slot `s` sits at de-Bruijn index
`|Γ| - 1 - s`, so slot `0` is the OLDEST (tail) element of `Γ` and the newest
(head) element is the highest slot. The array-ABI backend packs argument buffer
`j` at `inArgOff j` in root order, so the C input pointer `inp` points at the
concatenation `[ap | bp | acc]` (slots `0 | 1 | 2`). -/

/-- A 2-limb operand buffer (`up` / `vp`), 16 bytes. -/
abbrev B2 : JasminTy := .stackArr 64 2

/-- A 4-limb buffer (product / accumulator / result), 32 bytes. -/
abbrev B4 : JasminTy := .stackArr 64 4

/-- The orchestration argument context, NEWEST FIRST. To place `ap` at root slot
    `0`, `bp` at `1`, `acc` at `2`, the oldest (tail) element must be `ap`, so the
    list newest-first is `[acc, bp, ap]`. -/
abbrev OrchΓ : Ctxt jasminDialect := [B4, B2, B2]

/-! ## 2. The phase schedule and the generated orchestration `Com`

Two leaf calls. Result slots continue the root order: with `nArgs = 3`, call `0`
binds its result at slot `3`, call `1` at slot `4`. -/

/-- The reg-ptr-out call schedule.

    * `probe_mul2(ap, bp) : B4` — operands at slots `0, 1`; result buffer at
      slot `3`. Marshalled `leaq scratch₀ → RDI`, `leaq ap → RSI`,
      `leaq bp → RDX`, `call probe_mul2` (a `probe_mul2(rp, up, vp)` reg-ptr-out
      callee).
    * `probe_add4(prod, acc) : B4` — operands at slots `3` (the product scratch)
      and `2` (`acc`); result buffer at slot `4`. Marshalled `leaq scratch₁ → RDI`,
      `leaq scratch₀ → RSI`, `leaq acc → RDX`, `call probe_add4`. -/
def probeSchedule : List CallPhase :=
  [ { leaf := "probe_mul2", argTys := [B2, B2], retTy := B4, argSlots := [0, 1] }
  , { leaf := "probe_add4", argTys := [B4, B4], retTy := B4, argSlots := [3, 2] } ]

/-- The generated straight-line orchestration `Com jasminDialect`. Returns the
    slot-`4` accumulate result (type `B4`). `none` only on an ill-typed / out-of-
    range slot — the `_isSome` gate below pins it to `some`. -/
def probeOrchCom : Option (Com jasminDialect OrchΓ B4) :=
  buildOrchCom OrchΓ probeSchedule 4 B4

/-- **Generation gate.** The schedule resolves to a well-typed orchestration
    `Com` — mirrors `OrchestrationFront.mixedSchedule_isSome`. Orchestrator-run. -/
theorem probeOrchCom_isSome : probeOrchCom.isSome = true := by rfl

/-! ## 3. The reg-ptr-out marshalled owned `.s` (array-ABI orchestration)

`Com.toLprogArrAbi` (`ArrAbiOrch.comToLfundefArrAbi`) lowers the orchestration
`Com` to the 2-pointer SysV `Lprog` `f(out = RDI, inp = RSI)`: a `FRAME` sizing
the two scratch buffers + the saved-pointer block, the save prologue
(`RDI`/`RSI` → frame), one gather/`call` per leaf (out-ptr `leaq → RDI` first,
operands `leaq → RSI/RDX`), and the scatter of the returned scratch to `[out]`.
`renderOwned` is the pure AT&T printer (no optimisation) over the physical
`Lprog`. -/

/-- The owned array-ABI `Lprog` for the orchestration, under the C symbol
    `probe_orch`. `none` mirrors `probeOrchCom`. -/
def probeOrchLprog : Option Lprog :=
  probeOrchCom.map (fun c => Com.toLprogArrAbi c "probe_orch")

/-- The rendered owned AT&T `.s`: real `leaq`/`call probe_mul2`/`call probe_add4`,
    the reg-ptr-out out-pointer marshalling and the scatter epilogue. -/
def probeOrchAsm : Option String :=
  probeOrchLprog.map
    CatCrypt.Crypto.SecureCompilation.X86Backend.LprogOptPipeline.renderOwned

/-! ### Emit-shape verification is the KAT's job, not an in-model render scan

The render-level properties (two real `call`s, no `# UNHANDLED-OP` sentinel, the
reg-ptr-out out-pointer marshalling, the byte-exact result) are gated by the C
byte-KAT `bench/regptr_out_probe/kat.c` on the emitted `.s`: a shadow, a
sentinel, or a dropped argument register cannot assemble/link into a passing
numeric check, so the KAT strictly subsumes any substring scan. An in-model
`#guard`/`native_decide` over `probeOrchAsm` is deliberately NOT stated — the
sibling `Dialects.StraightLineLeafCallEmit` records that kernel-reducing this
class of render under `lake build` trips an allocation-sensitive SIGSEGV in the
elaborating process (a toolchain artifact, not a content defect). The only
in-model gate here is `probeOrchCom_isSome` (over the `Com` structure, no
render). -/

/-! ## 3b. The callees — reg-ptr-out mpn leaves (owned, front-sourced)

The array-ABI orchestration marshals EVERY operand as a buffer address
(`leaq`), out-pointer in `RDI` first. It provides NO path to pass a scalar
immediate `n` into an argument register (`ArrAbiOrch.emitOneCall` emits only
`leaq buf → argReg` per operand + `call`, never a `mov argReg, $n`). CONFIRMED
front constraint: a callee reachable through this orchestration must have a
BUFFERS-ONLY, FIXED-ARITY ABI `(rp = RDI, up = RSI, vp = RDX)` with the limb
count baked in at compile time.

Every deployed mpn owned kernel is instead RUNTIME-`n` — it reads the trip count
from `RCX`/`R8` (`MpnMulBasecaseFrontEmit`: `RDI = rp, RSI = up, RDX = vp,
RCX = un, R8 = vn`; `MpnAddNAdxRolledFrontEmit`: `blk4` ABI with `n/4` in
`RCX`). Calling one through this orchestration with `RCX`/`R8` unset reads a
garbage trip count. Two ways to close the gap (see the report):

* **(A) fixed-`n` callees** — reroute the same mpn LowCT bodies through the
  compile-time-trip loop shape (`rolledForLoopN` / a fixed-`n` nested variant)
  and export with the buffers-only ABI `["RDI", "RSI", "RDX"]`. No fixed-`n` mpn
  kernel exists yet; this reroute is the primary build risk.
* **(B) scalar-arg marshalling** — extend `ArrAbiOrch.emitOneCall` /
  `CallPhase` with trailing scalar-immediate operands (`mov argReg, $n`) so the
  EXISTING runtime-`n` kernels are callable verbatim.

The drafts below take route (A): they reuse the mpn front's ComL programs and
re-export at a fixed arity. `probeMul2Asm` / `probeAdd4Asm` are `Option`-guarded
so a declined fixed-`n` reroute surfaces as `none` at the emit driver rather
than a build break, naming the gap precisely for the orchestrator. -/

/-- **`probe_mul2` — the 2×2 → 4-limb reg-ptr-out multiply.**

    The fixed-2 leaf from `MpnMul2FixedFrontEmit`: a loop-free 2×2→4 schoolbook
    multiply exported with the buffers-only ABI `["RDI", "RSI", "RDX"]`
    (rp, up, vp — no runtime `un`/`vn` scalars), matching the reg-ptr-out
    marshalling the orchestration emits for this call. Its standalone byte-KAT
    (`bench/regptr_out_probe/kat_mul2.c`) checks it against a 128×128→256
    reference. -/
def probeMul2Asm : Option String :=
  CatCrypt.Crypto.SecureCompilation.X86Backend.MpnMul2FixedFrontEmit.probeMul2Asm

/-- **`probe_add4` — the fixed 4-limb reg-ptr-out add.**

    The fixed-4 leaf from `MpnAdd4FixedFrontEmit`: a loop-free ripple-carry add
    exported with the buffers-only ABI `["RDI", "RSI", "RDX"]` (rp, ap, bp),
    matching the reg-ptr-out marshalling the orchestration emits for this call.
    Its standalone byte-KAT is `bench/regptr_out_probe/kat_add4.c`. -/
def probeAdd4Asm : Option String :=
  CatCrypt.Crypto.SecureCompilation.X86Backend.MpnAdd4FixedFrontEmit.probeAdd4Asm

/-! ## 4. Emit driver

`#eval emitMain` at module end is the established idiom (`lake` owns the emitted
artifact as a build output). Writes the three `.s` into `bench/regptr_out_probe/`
for the C byte-KAT to link. -/

/-- Write the orchestration and the two callee `.s` to the KAT gen directory. -/
def emitMain : IO Unit := do
  let dir := "bench/regptr_out_probe/gen_com"
  IO.FS.createDirAll dir
  match probeOrchAsm with
  | some s =>
      IO.FS.writeFile (dir ++ "/probe_orch_owned.s") s
      IO.println "WROTE bench/regptr_out_probe/gen_com/probe_orch_owned.s"
      IO.println "  array-ABI orchestration (buildOrchCom -> toLprogArrAbi -> renderOwned)"
      IO.println "  REAL call probe_mul2 / call probe_add4, reg-ptr-out marshalling, NO jasminc"
  | none => throw (IO.userError "buildOrchCom / toLprogArrAbi declined the probe orchestration")
  match probeMul2Asm with
  | some s =>
      IO.FS.writeFile (dir ++ "/probe_mul2_owned.s") s
      IO.println "WROTE bench/regptr_out_probe/gen_com/probe_mul2_owned.s"
      IO.println "  fixed-2 leaf (buffers-only ABI [RDI,RSI,RDX]); KAT bench/regptr_out_probe/kat_mul2.c"
  | none => IO.println "SKIP probe_mul2: fixed-2 schoolbook multiply front declined"
  match probeAdd4Asm with
  | some s =>
      IO.FS.writeFile (dir ++ "/probe_add4_owned.s") s
      IO.println "WROTE bench/regptr_out_probe/gen_com/probe_add4_owned.s"
      IO.println "  fixed-4 leaf (buffers-only ABI [RDI,RSI,RDX]); KAT bench/regptr_out_probe/kat_add4.c"
  | none => IO.println "SKIP probe_add4: fixed-4 ripple-carry add front declined"

#eval emitMain

end CatCrypt.Crypto.SecureCompilation.VIR.RegPtrOutCallProbe
