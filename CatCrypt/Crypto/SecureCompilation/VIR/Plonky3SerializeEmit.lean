/-! ## 0. Substring helper (mirrors `Plonky3OrchLoopsEmit.hasSub`) -/

/-- Substring test (`needle` occurs in `hay`). -/
def hasSub (hay needle : String) : Bool :=
  (List.range (hay.length + 1)).any (fun i =>
    needle == String.ofList (hay.toList.drop i |>.take needle.length))

/-! ## 0b. Front-sourced byte store (`memref .store 8` → `stackStore 8` → STOREIDX scale-1)

The per-byte store of the LE writers is not hand-authored: it is the export of the
width-parametric `memref` dialect's byte store `MemrefOp.store 8 n`
(`⟦.buf 8 n⟧ = Fin n → BitVec 8`, byte cells), lowered by the verified
`lowerMemrefToJasmin` to jasmin `stackStore 8 n`, then exported by `opToLinstrR`
to a SIB `STOREIDX` with **scale `8/8 = 1`** — the `uint8_t` stride the printer
renders as a width-exact `movb %v8, (%base,%idx,1)` (no overrun of the next stream
byte). The 64-bit array path (`memrefSetDyn`/`stackStore 64`) would export scale
**8** (`movq`), which clobbers the seven neighbouring stream bytes — wrong for a
byte serializer. This is why the serializer is sourced through the byte-capable
`memref` front rather than the 64-bit-cell `catCryptDialect` memref op. -/

/-- The `memref`-front byte store `out[i] := v` over a byte buffer `.buf 8 n`. One
    `MemrefOp.store 8 n`. Head-first de Bruijn: `out = .here`, `i = .there .here`,
    `v = .there (.there .here)`. -/
def serByteStoreKernel (n : Nat) :
    Com memrefDialect [.buf 8 n, .int 64, .int 8] (.buf 8 n) :=
  .var (.mk (.store 8 n) rfl
         (.cons .here (.cons (.there .here) (.cons (.there (.there .here)) .nil))))
    (.ret .here)

/-- **The byte store's front lowering preserves its byte semantics.** The jasmin
    image of the `memref` byte store denotes to `transTy` of the byte store's
    denotation (`stackSet` over `BitVec 8` — a width-exact one-cell update).
    Instance of the unconditional `lowerMemrefToJasmin_denote`. -/
theorem serByteStore_lowering_denote (n : Nat)
    (V : Ctxt.Valuation (d := memrefDialect) [.buf 8 n, .int 64, .int 8]) :
    (lowerMemrefToJasmin (serByteStoreKernel n)).denote (mapVal V)
      = transTy ((serByteStoreKernel n).denote V) :=
  lowerMemrefToJasmin_denote (serByteStoreKernel n) V

/-- Head op of a lowered jasmin `Com` (the store op we export). -/
def comHeadOp? {Γ : Ctxt jasminDialect} {t : JasminTy} :
    Com jasminDialect Γ t → Option JasminOp
  | .ret _ => none
  | .var e _ => some e.op

/-- **The `memref` byte store lowers to the byte-width jasmin op `stackStore 8 n`**
    (not the 64-bit `stackStore 64 n`). This is the op whose `opToLinstrR` export
    carries SIB scale 1. -/
theorem serByteStore_head_op (n : Nat) :
    comHeadOp? (lowerMemrefToJasmin (serByteStoreKernel n)) = some (.stackStore 8 n) := rfl

/-- The front-sourced per-byte store instruction: the `opToLinstrR` export of the
    byte-width jasmin store `stackStore 8 n` that `serByteStoreKernel` lowers to. -/
def frontByteStoreLinstr (outArr base idx val : String) (n : Nat) : LinstrR :=
  opToLinstrR (.stackStore 8 n) outArr [.reg base, .reg idx, .reg val]

/-- **The front byte store exports a `STOREIDX` at SIB scale 1** — the `uint8_t`
    stride the printer renders as `movb`. This is the byte store the audit
    requires (scale 1), NOT the covered 64-bit-array arm's scale 8. -/
theorem frontByteStore_storeidx_scale1 (outArr base idx val : String) (n : Nat) :
    frontByteStoreLinstr outArr base idx val n
      = .Lopn [.reg outArr] "STOREIDX" [.arrIdx base idx 1, .reg val] := rfl

/-- Contrast: the 64-bit array store (`stackStore 64`, the `catCryptDialect`
    `memrefSetDyn` image) exports SIB scale **8** — `movq`, which overruns the
    neighbouring stream bytes. The two widths diverge exactly at the SIB stride. -/
theorem wordArrStore_storeidx_scale8 (outArr base idx val : String) (n : Nat) :
    opToLinstrR (.stackStore 64 n) outArr [.reg base, .reg idx, .reg val]
      = .Lopn [.reg outArr] "STOREIDX" [.arrIdx base idx 8, .reg val] := rfl

/-! ## 1. The byte-writer step language `SerStep`

A little-endian writer's schedule is written in a step language rather than as an
`Lcmd` literal, in the shape `SpStep` (`Shake256SpongeFront`) and `OrchStep`
(`OrchFront`) use. `ctrl` embeds the shared branch/loop/word-memory step language
`BStep` (`QuerySampleBranchFront`), whose `loop` step is the verified `loopLcmd`
back-edge. The two remaining steps — the byte-split shift and the width-exact
indexed byte store — are the ones `BStep` does not carry; each renders through
`opToLinstrR`, the jasmin-op exporter, so no step is a raw `Lopn`. -/

/-- One step of a little-endian byte-writer schedule.

    * `ctrl` — a `BStep`: register/immediate moves, the word load
      `mem.<base>.<off>`, immediate add/sub, and the counted `loop` (`loopLcmd`).
    * `shrImm` — the byte-split shift `reg >>= imm`, the jasmin op
      `regArith .shr w`.
    * `storeIdxB` — the width-exact indexed byte store `outArr[base + idx] := val`
      over an `n`-cell byte buffer, the jasmin op `stackStore 8 n` whose SIB scale
      is `8/8 = 1`. -/
inductive SerStep where
  /-- A shared control step (moves, word load, add/sub, counted loop). -/
  | ctrl (b : BStep)
  /-- Immediate right shift `SHR reg, #imm`. -/
  | shrImm (reg : String) (imm : Nat)
  /-- Indexed byte store `STOREIDX (base, idx, 1) ← val`, naming the updated
      array `outArr`. -/
  | storeIdxB (outArr base idx val : String) (n : Nat)

/-- Render one `SerStep` to an owned-backend `Lcmd` at op width `w`. `ctrl` steps
    defer to `bstepToLcmd`; the two byte-writer steps are `opToLinstrR` exports of
    the jasmin ops they name. -/
def serstepToLcmd (w : Nat) : SerStep → Lcmd
  | .ctrl b => bstepToLcmd w b
  | .shrImm r v => [⟨0, opToLinstrR (.regArith .shr w) r [.reg r, .imm v]⟩]
  | .storeIdxB outArr base idx val n =>
      [⟨0, frontByteStoreLinstr outArr base idx val n⟩]

/-- Render a byte-writer schedule to an `Lcmd`. -/
def serband (w : Nat) (steps : List SerStep) : Lcmd := steps.flatMap (serstepToLcmd w)

/-! ## 2. The little-endian writer schedules

A LE writer of an `n`-byte value `v` (held in `%rdx`) to the output stream
(`%rdi`) emits, per byte: the width-exact byte store of the low byte of `v` to
`out` (`movb %dl, (%rdi)`, no overrun of the next stream position), the shift
that drops the stored byte, the one-byte output-pointer advance, and the counter
decrement `loopLcmd` requires.

The value register `%rdx`, the output pointer `%rdi`, and the byte counter `%r8`
are public (a length / a serialized field element — the proof is public by
construction), so the `loopLcmd` back-edge is a CT-admissible public branch. -/

/-- One little-endian byte-emit iteration: store the low byte of the value
    register `vReg` to the output stream at `(%outReg, %r9, 1)` (the `memref`
    byte store's SIB scale-1 export = `movb`, with a zero index `%r9` so the
    offset is carried by the advancing base `%outReg`), shift `vReg` right by 8,
    advance `outReg` by 1 byte, decrement the counter `%r8`. Byte and pointer
    arithmetic only — no field op. -/
def leByteSteps (outReg vReg : String) : List SerStep :=
  [ .storeIdxB outReg outReg "R9" vReg 8
  , .shrImm vReg 8
  , .ctrl (.addImm outReg 1)
  , .ctrl (.subImm "R8" 1) ]

/-- An `n`-byte LE writer schedule: load the value word `in[0]` into `vReg`, set
    the byte counter `%r8 = n` and the zero index `%r9 = 0`, then the counted
    byte-emit loop at top label `0`. -/
def leWriterSteps (n : Nat) (outReg vReg : String) : List SerStep :=
  [ .ctrl (.load vReg "RSI" 0)
  , .ctrl (.movImm "R8" n)
  , .ctrl (.movImm "R9" 0)
  , .ctrl (.loop 0 "R8" (serband 64 (leByteSteps outReg vReg))) ]

/-- The single-byte writer schedule: load the value word, store its low byte,
    advance the output pointer one byte. Straight-line, no loop. -/
def serU8Steps : List SerStep :=
  [ .ctrl (.load "RDX" "RSI" 0)
  , .ctrl (.movImm "R9" 0)
  , .storeIdxB "RDI" "RDI" "R9" "RDX" 8
  , .ctrl (.addImm "RDI" 1) ]

/-- The generated per-iteration byte-emit `Lcmd`. -/
def leByteBody (outReg vReg : String) : Lcmd := serband 64 (leByteSteps outReg vReg)

/-- The looped LE byte-emit: `leByteBody` wrapped once by `loopLcmd` at width 64,
    counter `%r8`, top label `0`. Constant-size in the byte count. -/
def leByteLoop (outReg vReg : String) : Lcmd :=
  loopLcmd 64 0 "R8" (leByteBody outReg vReg)

/-- A LE byte-writer driver of `n` bytes, generated from `leWriterSteps`. SysV
    args: `%rdi` = output stream pointer, `%rsi` = input value pointer. The
    output pointer advances `n` bytes (the caller resumes the stream there). -/
def leWriterFundef (n : Nat) : Lfundef :=
  { lfd_tyin := [64, 64], lfd_arg := ["RDI", "RSI"]
    lfd_body := serband 64 (leWriterSteps n "RDI" "RDX")
    lfd_tyout := [], lfd_res := [] }

/-- `w_u64`: serialize a `u64` length / fixint as 8 little-endian bytes. -/
def serU64Fundef : Lfundef := leWriterFundef 8

/-- `w_u32` (= the byte half of `w_fe`): serialize a `u32` (monty-form field
    element) as 4 little-endian bytes. -/
def serU32Fundef : Lfundef := leWriterFundef 4

/-- `w_u8`: serialize a single byte (`Option` tag / `log_arity`), generated from
    `serU8Steps`. -/
def serU8Fundef : Lfundef :=
  { lfd_tyin := [64, 64], lfd_arg := ["RDI", "RSI"]
    lfd_body := serband 64 serU8Steps
    lfd_tyout := [], lfd_res := [] }

/-! ## 3. The digest writer: the loop-over-call front at `p3_ser_u32_le`

`w_digest(d[8])` emits 8 field elements, each `w_fe` = `w_u32(monty(d[i]))`. The
caller has already put the 8 monty-form words contiguously; the digest writer is
the loop-over-call shape `OrchFront.buildOrchLoop` generates — a counter-init
prologue and a per-element body of `call <leaf>` plus operand-pointer stride,
wrapped once in the verified `loopLcmd` back-edge. -/

/-- The digest writer's loop-over-call spec: element counter `%rbx` (callee-saved,
    so it survives the inner `p3_ser_u32_le` call, which clobbers `%r8`/`%rdx`),
    body `call p3_ser_u32_le` then advance the input by one 8-byte word. The
    output pointer is advanced by the leaf itself, so the body does not re-advance
    it. -/
def digestSpec : OrchLoopSpec :=
  { counter := "RBX"
    prologue := [.movImm "RBX" 8]
    body := [.call "p3_ser_u32_le", .addImm "RSI" 8, .subImm "RBX" 1] }

/-- The digest spec passes the loop-over-call generation gate: the body carries a
    leaf `call` and ends with the counter decrement. -/
theorem digestSpec_wellFormed : digestSpec.wellFormed = true := rfl

/-- `w_digest`: serialize an 8-word digest as 8 monty-form `u32` LE field
    elements, generated by `buildOrchLoop` from `digestSpec`. SysV args:
    `%rdi` = output stream, `%rsi` = the 8 monty-form words. -/
def serDigestFundef : Lfundef := buildOrchLoop digestSpec

/-- The generated per-element `Lcmd` of the digest loop. -/
def digestBody : Lcmd := bandLcmd 64 digestSpec.body

/-- The looped digest writer: `digestBody` wrapped once by `loopLcmd`, counter
    `%rbx`, top label `0`. -/
def digestLoop : Lcmd := loopLcmd 64 0 "RBX" digestBody

/-! ## 4. Instruction-level validation of the generated schedules

Each generated band is pinned to the exact owned-backend instruction list the
emitted `.s` carries, so the schedules and the artifact are tied together at the
`Lcmd` level rather than through the printer. Each is a bounded `rfl` over at
most four instructions. -/

/-- The per-byte band: the width-exact indexed byte store (SIB scale 1 = `movb`),
    the byte-split shift, the output-pointer advance, the counter decrement. -/
theorem leByteBody_eq (outReg vReg : String) :
    leByteBody outReg vReg
      = [ ⟨0, .Lopn [.reg outReg] "STOREIDX" [.arrIdx outReg "R9" 1, .reg vReg]⟩
        , ⟨0, .Lopn [.reg vReg] "SHR:64" [.reg vReg, .imm 8]⟩
        , ⟨0, .Lopn [.reg outReg] "ADD:64" [.reg outReg, .imm 1]⟩
        , ⟨0, .Lopn [.reg "R8"] "SUB:64" [.reg "R8", .imm 1]⟩ ] := rfl

/-- The byte store of the generated band is the `opToLinstrR` export of the
    `memref` byte store `serByteStoreKernel` lowers to — the same instruction
    `frontByteStoreLinstr` names, hence SIB scale 1. -/
theorem leByteBody_head_is_front_byte_store (outReg vReg : String) :
    (leByteBody outReg vReg).head?
      = some ⟨0, frontByteStoreLinstr outReg outReg "R9" vReg 8⟩ := rfl

/-- The `n`-byte writer body: the value load, the byte counter, the zero index,
    then the counted byte-emit loop. -/
theorem leWriterFundef_body_eq (n : Nat) :
    (leWriterFundef n).lfd_body
      = (⟨0, .Lopn [.reg "RDX"] "LOAD:64" [.reg "mem.RSI.0"]⟩
          :: ⟨0, .Lopn [.reg "R8"] "MOV:64" [.imm n]⟩
          :: ⟨0, .Lopn [.reg "R9"] "MOV:64" [.imm 0]⟩
          :: leByteLoop "RDI" "RDX") := rfl

/-- The single-byte writer body: the value load, the zero index, the byte store,
    the output-pointer advance. -/
theorem serU8Fundef_body_eq :
    serU8Fundef.lfd_body
      = [ ⟨0, .Lopn [.reg "RDX"] "LOAD:64" [.reg "mem.RSI.0"]⟩
        , ⟨0, .Lopn [.reg "R9"] "MOV:64" [.imm 0]⟩
        , ⟨0, frontByteStoreLinstr "RDI" "RDI" "R9" "RDX" 8⟩
        , ⟨0, .Lopn [.reg "RDI"] "ADD:64" [.reg "RDI", .imm 1]⟩ ] := rfl

/-- The digest writer body: the element-counter init, then the `loopLcmd`
    back-edge over `call p3_ser_u32_le` plus the input-pointer stride. -/
theorem serDigestFundef_body_eq :
    serDigestFundef.lfd_body
      = (⟨0, .Lopn [.reg "RBX"] "MOV:64" [.imm 8]⟩ :: digestLoop) := rfl

/-- The digest writer's per-element band. -/
theorem digestBody_eq :
    digestBody
      = [ ⟨0, .Lcall none ("p3_ser_u32_le", 0)⟩
        , ⟨0, .Lopn [.reg "RSI"] "ADD:64" [.reg "RSI", .imm 8]⟩
        , ⟨0, .Lopn [.reg "RBX"] "SUB:64" [.reg "RBX", .imm 1]⟩ ] := rfl

/-- The SysV argument ABI of every writer: `%rdi` = output stream pointer,
    `%rsi` = input value pointer, both 64-bit. -/
theorem writer_abi (n : Nat) :
    (leWriterFundef n).lfd_arg = ["RDI", "RSI"]
      ∧ (leWriterFundef n).lfd_tyin = [64, 64]
      ∧ serU8Fundef.lfd_arg = ["RDI", "RSI"]
      ∧ serDigestFundef.lfd_arg = ["RDI", "RSI"] :=
  ⟨rfl, rfl, rfl, rfl⟩

/-! ## 5. The composed byte-packer `Lprog` (one `.s`) -/

/-- The bincode byte-packer functions: the LE `u64`/`u32`/`u8` writers and the
    digest writer (a `loopLcmd` over `p3_ser_u32_le`). One emitted object whose
    proof-serialization byte layout is owned `Lcmd` control flow. -/
def serFuncs : List (String × Lfundef) :=
  [ ("p3_ser_u64_le", serU64Fundef)
  , ("p3_ser_u32_le", serU32Fundef)
  , ("p3_ser_u8", serU8Fundef)
  , ("p3_ser_digest_le", serDigestFundef) ]

/-- The composed serialization `Lprog`. -/
def serializeLprog : Lprog := { lp_funcs := serFuncs }

def serializeAsm : String := renderLprogAtt serializeLprog

/-! ## 6. Shape lemmas: the byte-packer is owned byte-store control flow -/

/-- The per-byte band is four instructions: store, shift, pointer advance,
    counter decrement. -/
theorem leByteBody_length (outReg vReg : String) :
    (leByteBody outReg vReg).length = 4 := rfl

/-- The LE byte-emit loop is constant-size in the byte count: 4 body ops
    (store + shift + pointer advance + counter decrement) + 3 control ops
    (label, cmp, back-edge) = 7. Independent of `n`. -/
theorem leByteLoop_length (outReg vReg : String) :
    (leByteLoop outReg vReg).length = 7 := by
  rw [leByteLoop, loopLcmd_length]; rfl

/-- The looped byte writer is strictly shorter than the unrolled one for the real
    byte counts (`n ≥ 4`, body 4 ops ≥ 2): looped is `O(1)`, unrolled `O(n)`. -/
theorem leByteLoop_shorter_than_unrolled (outReg vReg : String) (n : Nat)
    (hn : 4 ≤ n) :
    (leByteLoop outReg vReg).length < (unrollLcmd n (leByteBody outReg vReg)).length :=
  looped_shorter_than_unrolled 64 0 "R8" (leByteBody outReg vReg) n hn
    (by simp [leByteBody_length])

/-- The byte-emit loop body begins with the front-sourced byte store (the
    SIB `STOREIDX` scale 1 = `movb`, per-iteration byte marshalling) right after
    the loop label. -/
theorem leByteLoop_stores_byte (outReg vReg : String) :
    (leByteLoop outReg vReg)[1]?
      = some ⟨0, .Lopn [.reg outReg] "STOREIDX" [.arrIdx outReg "R9" 1, .reg vReg]⟩ := by
  rfl

/- The `u64` LE writer renders the owned back-edge plus a width-exact byte store
    `movb` — the owned byte-marshalling control flow, not a C `for`. -/
#guard
  let s := renderLfundef "p3_ser_u64_le" serU64Fundef.lfd_body
  occursIn ".L0:" s && occursIn "cmpq $0, %r8" s
    && occursIn "jne .L0" s && occursIn "movb %dl," s

/- The `u32` LE writer renders the owned back-edge plus the byte store. -/
#guard
  let s := renderLfundef "p3_ser_u32_le" serU32Fundef.lfd_body
  occursIn ".L0:" s && occursIn "jne .L0" s && occursIn "movb %dl," s

/- The digest writer renders the owned back-edge plus the `call p3_ser_u32_le`
    body — the per-element field-element serialization. -/
#guard
  let s := renderLfundef "p3_ser_digest_le" serDigestFundef.lfd_body
  occursIn ".L0:" s && occursIn "jne .L0" s && occursIn "call p3_ser_u32_le" s

/- The byte writer shifts the value right by 8 after each byte store (the
    `(v >> 8i) & 0xff` LE split). -/
#guard (hasSub (renderLfundef "p3_ser_u64_le" serU64Fundef.lfd_body) "shrq $8, %rdx")

/-! ## 7. The composed object carries every writer, no unhandled op -/

theorem serialize_has_u64 :
    hasSub serializeAsm "p3_ser_u64_le" = true := by native_decide
theorem serialize_has_u32 :
    hasSub serializeAsm "p3_ser_u32_le" = true := by native_decide
#guard (hasSub serializeAsm "p3_ser_u8")
theorem serialize_has_digest :
    hasSub serializeAsm "p3_ser_digest_le" = true := by native_decide
theorem serialize_no_unhandled :
    hasSub serializeAsm "UNHANDLED" = false := by native_decide

/-- **Single-binary bincode byte-packer, owned.** The one composed `.s` carries
    the LE `u64`/`u32`/`u8` writers and the digest writer, each owned-backend
    byte-store / `loopLcmd` control flow with no unhandled op — the
    `Proof<SC>` bincode byte layout owned, not hand-written C. -/
theorem serialize_shape :
    hasSub serializeAsm "p3_ser_u64_le" = true
      ∧ hasSub serializeAsm "p3_ser_u32_le" = true
      ∧ hasSub serializeAsm "p3_ser_digest_le" = true
      ∧ hasSub serializeAsm "UNHANDLED" = false :=
  ⟨serialize_has_u64, serialize_has_u32, serialize_has_digest, serialize_no_unhandled⟩

theorem serialize_funcs_eq : serializeLprog.lp_funcs = serFuncs := rfl

/-! ## 8. Emit driver -/

def emitMain : IO Unit := do
  let dir := "bench/plonky3_compare/gen_com"
  IO.FS.createDirAll dir
  IO.FS.writeFile (dir ++ "/plonky3_serialize_owned.s") serializeAsm
  IO.println "WROTE bench/plonky3_compare/gen_com/plonky3_serialize_owned.s"
  IO.println "  ONE .s: bincode LE byte-packer (u64/u32/u8 writers + digest loop)"
  IO.println "  Proof<SC> byte layout is owned loopLcmd/byte-store control flow, NO C for"

end CatCrypt.Crypto.SecureCompilation.VIR.Plonky3SerializeEmit

/-- Top-level entry point for `lake exe plonky3serialize`. -/
def main : IO UInt32 := do
  CatCrypt.Crypto.SecureCompilation.VIR.Plonky3SerializeEmit.emitMain
  return 0
