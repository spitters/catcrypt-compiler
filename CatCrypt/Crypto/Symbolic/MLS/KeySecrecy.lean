module

public import CatCrypt.Crypto.Symbolic.MLS.Invariants

/-!
# MLS TreeKEM Key Secrecy

Theorem: The MLS epoch key is not known to the attacker unless one of
the group members is compromised.

## Main results

* `mls_epoch_key_secrecy` — epoch key secrecy for MLS TreeKEM

## Proof

Label analysis through the MLS key schedule:

```
epochKey = mlsKeySchedule(pathSecret, commitSecret, psk)
         = kdfExpand(kdfExtract(psk, kdfExtract(commitSecret, pathSecret)), "app", 32)

labelOf(epochKey)
  = labelOf(kdfExtract(psk, kdfExtract(commitSecret, pathSecret)))
  = meet(labelOf(psk), meet(labelOf(commitSecret), labelOf(pathSecret)))
```

If the path secret has label `groupLabel(members)` (= meet of all
member labels), then the epoch key's label includes `groupLabel(members)`.
The attacker can only know the key if some member is corrupted.

## References

* Wallez et al., IEEE S&P 2025 — TreeKEM key secrecy (Theorem 2)
* RFC 9420 Section 8 — Key Schedule
-/

@[expose] public section

namespace CatCrypt.Crypto.Symbolic.MLS

open CatCrypt.Crypto.Symbolic

/-! ## Label Analysis for MLS Key Schedule -/

/-- Label of the MLS key schedule:
    `meet(labelOf(psk), meet(labelOf(commitSecret), labelOf(pathSecret)))`. -/
theorem labelOf_mlsKeySchedule' (tr : Trace) (ps cs psk : Bytes) :
    labelOf tr (mlsKeySchedule ps cs psk) =
    .meet (labelOf tr psk) (.meet (labelOf tr cs) (labelOf tr ps)) := by
  rfl

/-! ## Key Secrecy Theorem -/

/-- **MLS Epoch Key Secrecy**: The epoch key derived from the MLS key
schedule is secret unless the committer is corrupted.

The committer's path secret has label `groupLabel(members)`. Since
`groupLabel` is the meet of all member labels, corruption of ANY
member would make this label corrupt. However, the path secret is
specifically labeled with `groupLabel(members)`, so the attacker
needs the committer to be corrupted (who generated the path secret).

More precisely: the epoch key's label includes `labelOf(pathSecret)`.
If `pathSecret` is labeled `groupLabel(members)`, the attacker can only
derive the epoch key if the group label is corrupt — which requires
corruption of some group member.

Parameters:
- `pathSecret`: the path secret generated by the committer
- `commitSecret`: the commit secret
- `committer`: the committer identity
- `hLabelPS`: the path secret has the committer's label -/
theorem mls_epoch_key_secrecy
    (tr : Trace) (committer : String) (epochKey : Bytes)
    (pathSecret commitSecret : Bytes)
    (hKey : epochKey = mlsKeySchedule pathSecret commitSecret (.literal "".toUTF8))
    (hLabelPS : hasLabel tr pathSecret (principalLabel committer)) :
    @traceInvariant mlsInvariants tr →
    AttackerKnows tr epochKey →
    tr.isCorruptAt committer (tr.length - 1) := by
  intro hInv hKnows
  have hPub := attacker_only_knows_publishable hInv hKnows
  rw [hKey] at hPub
  -- Extract that labelOf(pathSecret) is corrupt from the meet structure
  have hPSCorrupt : (labelOf tr pathSecret).isCorrupt tr.corruptSet := by
    unfold bytesPublishable at hPub
    rw [labelOf_mlsKeySchedule'] at hPub
    -- (.meet .top (.meet (labelOf cs) (labelOf ps))).isCorrupt corruptSet
    -- = True ∧ ((labelOf cs).isCorrupt _ ∧ (labelOf ps).isCorrupt _)
    exact hPub.2.2
  -- hasLabel means labelOf tr pathSecret = principalLabel committer
  rw [hLabelPS] at hPSCorrupt
  -- hPSCorrupt : (principalLabel committer).isCorrupt tr.corruptSet = tr.corruptSet committer
  simp only [principalLabel, Label.isCorrupt] at hPSCorrupt
  obtain ⟨j, hj, hentry⟩ := hPSCorrupt
  exact ⟨j, by omega, hentry⟩

/-- groupLabel corruption implies all members are in the corruption set.

`groupLabel ps = foldl (fun acc p => meet acc (principal p)) top ps`
is corrupt iff every member's principal label is corrupt, i.e. every
member is in the corruption set. -/
theorem groupLabel_foldl_isCorrupt (init : Label) (ps : List String)
    (C : String → Prop) :
    (ps.foldl (fun acc p => Label.meet acc (principalLabel p)) init).isCorrupt C ↔
    init.isCorrupt C ∧ ∀ p, p ∈ ps → C p := by
  induction ps generalizing init with
  | nil => simp
  | cons p ps ih =>
    simp only [List.foldl_cons]
    rw [ih]
    simp only [Label.isCorrupt, principalLabel, List.mem_cons]
    constructor
    · rintro ⟨⟨hinit, hp⟩, hps⟩
      exact ⟨hinit, fun q hq => hq.elim (fun heq => heq ▸ hp) (hps q)⟩
    · rintro ⟨hinit, hall⟩
      exact ⟨⟨hinit, hall p (.inl rfl)⟩, fun q hq => hall q (.inr hq)⟩

theorem groupLabel_isCorrupt (members : List String) (C : String → Prop) :
    (groupLabel members).isCorrupt C ↔ ∀ m, m ∈ members → C m := by
  unfold groupLabel
  rw [groupLabel_foldl_isCorrupt]
  simp [Label.isCorrupt]

/-- **MLS Epoch Key Secrecy (group label form)**: The epoch key is
secret unless some group member is corrupted.

When the path secret has `groupLabel(members)`, corruption of ANY
member suffices for the attacker to derive the key. -/
theorem mls_epoch_key_secrecy_group
    (tr : Trace) (members : List String) (epochKey : Bytes)
    (pathSecret commitSecret psk : Bytes)
    (hKey : epochKey = mlsKeySchedule pathSecret commitSecret psk)
    (hLabelPS : hasLabel tr pathSecret (groupLabel members))
    (hNE : members ≠ []) :
    @traceInvariant mlsInvariants tr →
    AttackerKnows tr epochKey →
    ∃ member, member ∈ members ∧ tr.isCorruptAt member (tr.length - 1) := by
  intro hInv hKnows
  have hPub := attacker_only_knows_publishable hInv hKnows
  rw [hKey] at hPub
  -- Extract that labelOf(pathSecret) is corrupt from the meet structure
  have hPSCorrupt : (labelOf tr pathSecret).isCorrupt tr.corruptSet := by
    unfold bytesPublishable at hPub
    rw [labelOf_mlsKeySchedule'] at hPub
    exact hPub.2.2
  -- Rewrite with hasLabel (equality) to get groupLabel corruption
  rw [hLabelPS] at hPSCorrupt
  -- groupLabel corrupt → all members are in corruptSet
  have hAll := (groupLabel_isCorrupt members tr.corruptSet).mp hPSCorrupt
  -- Pick the first member
  obtain ⟨m, ms, rfl⟩ := List.exists_cons_of_ne_nil hNE
  have hCorrupt := hAll m List.mem_cons_self
  -- Convert corruptSet to isCorruptAt
  obtain ⟨j, hj, hentry⟩ := hCorrupt
  exact ⟨m, List.mem_cons_self, j, by omega, hentry⟩

/-- Key secrecy as a `Secrecy` property. -/
theorem mls_key_secrecy_property
    (tr : Trace) (committer : String) (epochKey : Bytes)
    (pathSecret commitSecret : Bytes)
    (hKey : epochKey = mlsKeySchedule pathSecret commitSecret (.literal "".toUTF8))
    (hLabelPS : hasLabel tr pathSecret (principalLabel committer)) :
    Secrecy tr epochKey [committer] := by
  intro hInv hKnows
  exact ⟨committer, List.Mem.head _, mls_epoch_key_secrecy tr committer epochKey
    pathSecret commitSecret hKey hLabelPS hInv hKnows⟩

end CatCrypt.Crypto.Symbolic.MLS
