open CatCrypt.Quantum.ZXGraph (czGate_mul_self)
open CatCrypt.Quantum.Optimization.RoutingPerm (circuitUnitary)
open CatCrypt.Quantum.Optimization.MatrixSound

variable {n : ℕ}

/-! ## Items and atoms -/

/-- `g` is a gate diagonal on `q` that acts on no other qubit. -/
def isDiagOnB (q : Fin n) : Gate n → Bool
  | .Z i | .S i | .T i | .Tdg i | .Rz i _ | .RzQ i _ => decide (i = q)
  | _ => false

/-- A single gate, or an X-block `H q; ds; H q` with every gate of `ds` diagonal on `q`. -/
inductive Item (n : ℕ) where
  | gate (g : Gate n)
  | xblock (q : Fin n) (ds : List (Gate n)) (h : ds.all (isDiagOnB q) = true)

/-- The gates of an item. -/
def Item.gates : Item n → List (Gate n)
  | .gate g => [g]
  | .xblock q ds _ => Gate.H q :: (ds ++ [Gate.H q])

/-- The gate list of an item list. -/
def flat (l : List (Item n)) : List (Gate n) := l.flatMap Item.gates

/-- The kind of a one-qubit atom: diagonal, X-type (`H D H`, `D` diagonal), or arbitrary. -/
inductive Kind where
  | diag
  | xl
  | other
  deriving DecidableEq

/-- The atoms of a gate. -/
def gateAtoms : Gate n → List (Fin n × Kind)
  | .H q | .Y q => [(q, .other)]
  | .X q => [(q, .xl)]
  | .Z q | .S q | .T q | .Tdg q | .Rz q _ | .RzQ q _ => [(q, .diag)]
  | .CNOT c t => [(c, .diag), (t, .xl)]
  | .CZ a b => [(a, .diag), (b, .diag)]

/-- The atoms of an item. -/
def Item.atoms : Item n → List (Fin n × Kind)
  | .gate g => gateAtoms g
  | .xblock q _ _ => [(q, .xl)]

/-- Two atoms commute: different qubits, or the same kind other than arbitrary. -/
def atomCommB (a b : Fin n × Kind) : Bool :=
  decide (a.1 ≠ b.1) || (a.2 == b.2 && a.2 != .other)

/-- Two items commute when every pair of their atoms does. -/
def itemComm (x y : Item n) : Bool :=
  x.atoms.all fun a => y.atoms.all fun b => atomCommB a b

/-- What the gate pair `x; y` reduces to: nothing for an inverse pair, one `RzQ` for two
    rotations on the same qubit (nothing when the angles sum to `0`). -/
def absorb : Gate n → Gate n → Option (List (Gate n))
  | .H a, .H b | .X a, .X b | .Y a, .Y b | .Z a, .Z b
  | .T a, .Tdg b | .Tdg a, .T b => if a = b then some [] else none
  | .CNOT a b, .CNOT c d | .CZ a b, .CZ c d => if a = c ∧ b = d then some [] else none
  | .RzQ a θ, .RzQ b φ =>
    if a = b then some (if θ + φ = 0 then [] else [.RzQ a (θ + φ)]) else none
  | _, _ => none

/-- `absorb` against an item; an X-block absorbs nothing. -/
def absorbItem (x : Gate n) : Item n → Option (List (Gate n))
  | .gate g => absorb x g
  | .xblock .. => none

/-- The number of items a gate is moved across at most. -/
def commuteWindow : ℕ := 128

/-- Move `x` forward over commuting items until an item absorbs it. -/
def scan (x : Gate n) : ℕ → List (Item n) → Option (List (Item n))
  | 0, _ => none
  | _ + 1, [] => none
  | k + 1, y :: ys =>
    match absorbItem x y with
    | some r => some (r.map Item.gate ++ ys)
    | none => if itemComm (.gate x) y then (scan x k ys).map (y :: ·) else none

/-- One left-to-right sweep: each gate item is scanned forward and dropped when absorbed. -/
def cancelGo : ℕ → List (Item n) → List (Item n)
  | 0, l => l
  | _ + 1, [] => []
  | k + 1, x :: rest =>
    match x with
    | .gate g =>
      match scan g commuteWindow rest with
      | some rest' => cancelGo k rest'
      | none => .gate g :: cancelGo k rest
    | .xblock .. => x :: cancelGo k rest

/-- Read a gate list as items, grouping `H q; ds; H q` into an X-block. -/
def toItems : ℕ → List (Gate n) → List (Item n)
  | 0, l => l.map .gate
  | _ + 1, [] => []
  | k + 1, g :: rest =>
    match g with
    | .H q =>
      match h₁ : rest.takeWhile (isDiagOnB q), rest.dropWhile (isDiagOnB q) with
      | d :: ds, .H q' :: rest' =>
        if q' = q then
          .xblock q (d :: ds) (h₁ ▸ List.all_takeWhile) :: toItems k rest'
        else .gate g :: toItems k rest
      | _, _ => .gate g :: toItems k rest
    | _ => .gate g :: toItems k rest

/-- The pass on gate lists. -/
def commuteCancelList (l : List (Gate n)) : List (Gate n) :=
  let items := toItems l.length l
  flat (cancelGo items.length items)

/-- The pass on circuits. -/
def commuteCancel (c : Circuit n) : Circuit n :=
  Circuit.ofList (commuteCancelList (circuitToList c))

/-! ## The matrix of a gate list -/

noncomputable section

/-- The unitary of a gate list, head gate applied first. -/
def listU : List (Gate n) → Matrix.unitaryGroup (Fin (2 ^ n)) ℂ
  | [] => 1
  | g :: gs => listU gs * gateEmbedding_unitaryGroup g

/-- The matrix of a gate list. -/
abbrev listM (l : List (Gate n)) : Matrix (Fin (2 ^ n)) (Fin (2 ^ n)) ℂ := (listU l : _)

/-- Unfolding lemma of `listU` at the empty list. -/
theorem listM_nil : listM ([] : List (Gate n)) = 1 := rfl

/-- Unfolding lemma of `listU` at a cons. -/
theorem listM_cons (g : Gate n) (gs : List (Gate n)) :
    listM (g :: gs) = listM gs * gateEmbedding g := rfl

theorem listM_append (a b : List (Gate n)) : listM (a ++ b) = listM b * listM a := by
  induction a with
  | nil => simp [listM_nil]
  | cons g a ih => rw [List.cons_append, listM_cons, listM_cons, ih, mul_assoc]

theorem listM_single (g : Gate n) : listM [g] = gateEmbedding g := by
  rw [listM_cons, listM_nil, one_mul]

/-- The unitary of a gate list is `listU`. -/
theorem circuitUnitary_ofList_eq_listU (l : List (Gate n)) :
    circuitUnitary (Circuit.ofList l) = listU l := by
  induction l with
  | nil => rfl
  | cons g l ih => rw [circuitUnitary_ofList_cons, ih]; rfl

/-- The channel of a gate list is the unitary channel of its unitary. -/
theorem unitaryDenote_ofList_eq_channel_listU (gs : List (Gate n)) :
    unitaryDenote (Circuit.ofList gs) = unitaryChannel (listU gs) := by
  rw [RoutingPerm.unitaryDenote_eq_channel, circuitUnitary_ofList_eq_listU]

theorem unitaryDenote_ofList_congr {a b : List (Gate n)} (h : listM a = listM b) :
    unitaryDenote (Circuit.ofList a) = unitaryDenote (Circuit.ofList b) := by
  rw [unitaryDenote_ofList_eq_channel_listU, unitaryDenote_ofList_eq_channel_listU,
    Subtype.ext h]

theorem flat_cons (y : Item n) (ys : List (Item n)) : flat (y :: ys) = y.gates ++ flat ys := by
  simp [flat]

theorem listM_flat_cons (y : Item n) (ys : List (Item n)) :
    listM (flat (y :: ys)) = listM (flat ys) * listM y.gates := by
  rw [flat_cons, listM_append]

theorem flat_map_gate (r : List (Gate n)) : flat (r.map Item.gate) = r := by
  induction r with
  | nil => rfl
  | cons g r ih => rw [List.map_cons, flat_cons, ih]; rfl

/-! ## Diagonal and X-type matrices -/

theorem isDiagonal_mul {A B : Matrix (Fin 2) (Fin 2) ℂ} (hA : IsDiagonal A)
    (hB : IsDiagonal B) : IsDiagonal (A * B) := by
  intro r c hrc
  rw [Matrix.mul_apply]
  refine Finset.sum_eq_zero fun k _ => ?_
  by_cases hk : r = k
  · subst hk; rw [hB r c hrc, mul_zero]
  · rw [hA r k hk, zero_mul]

theorem isDiagonal_one : IsDiagonal (1 : Matrix (Fin 2) (Fin 2) ℂ) := by
  intro r c hrc
  exact Matrix.one_apply_ne hrc

theorem isDiagonal_diagB (b : ℂ) : IsDiagonal (CommuteSound.diagB b) := by
  intro r c hrc
  fin_cases r <;> fin_cases c <;> simp_all [CommuteSound.diagB]

theorem hadamard_conj_mul (D D' : Matrix (Fin 2) (Fin 2) ℂ) :
    hadamard * D * hadamard * (hadamard * D' * hadamard) = hadamard * (D * D') * hadamard := by
  have h : hadamard * D * hadamard * (hadamard * D' * hadamard)
      = hadamard * D * (hadamard * hadamard) * D' * hadamard := by
    simp only [mul_assoc]
  rw [h, hadamard_sq, mul_one, mul_assoc hadamard D D']

theorem pauliX_eq_hadamard_conj : pauliX = hadamard * pauliZ * hadamard := by
  rw [← hadamard_pauliX_hadamard]
  have h : hadamard * (hadamard * pauliX * hadamard) * hadamard
      = (hadamard * hadamard) * pauliX * (hadamard * hadamard) := by
    simp only [mul_assoc]
  rw [h, hadamard_sq, one_mul, mul_one]

/-- What an atom's `2 × 2` matrix is, by kind. -/
def KindOK : Kind → Matrix (Fin 2) (Fin 2) ℂ → Prop
  | .diag, G => IsDiagonal G
  | .xl, G => ∃ D, IsDiagonal D ∧ G = hadamard * D * hadamard
  | .other, _ => True

theorem kindOK_comm {k : Kind} (hk : k ≠ .other) {G G' : Matrix (Fin 2) (Fin 2) ℂ}
    (hG : KindOK k G) (hG' : KindOK k G') : G * G' = G' * G := by
  cases k with
  | diag => exact MixedCommute.isDiagonal_mul_comm hG hG'
  | xl =>
    obtain ⟨D, hD, rfl⟩ := hG
    obtain ⟨D', hD', rfl⟩ := hG'
    rw [hadamard_conj_mul, hadamard_conj_mul, MixedCommute.isDiagonal_mul_comm hD hD']
  | other => exact absurd rfl hk

/-- Embeddings of two atoms that `atomCommB` accepts commute. -/
theorem atom_commute {a b : Fin n × Kind} (h : atomCommB a b = true)
    {G G' : Matrix (Fin 2) (Fin 2) ℂ} (hG : KindOK a.2 G) (hG' : KindOK b.2 G') :
    Commute (embedGate1 n a.1 G) (embedGate1 n b.1 G') := by
  obtain ⟨q, k⟩ := a
  obtain ⟨q', k'⟩ := b
  simp only [atomCommB, Bool.or_eq_true, decide_eq_true_eq, Bool.and_eq_true, beq_iff_eq,
    bne_iff_ne, ne_eq] at h
  rcases h with hq | ⟨rfl, hk⟩
  · exact DisjointCommute.embedGate1_disjoint_comm hq G G'
  · by_cases hqq : q = q'
    · subst hqq
      change embedGate1 n q G * embedGate1 n q G' = embedGate1 n q G' * embedGate1 n q G
      rw [embedGate1_mul, embedGate1_mul, kindOK_comm hk hG hG']
    · exact DisjointCommute.embedGate1_disjoint_comm hqq G G'

/-- The matrices generated by one-qubit embeddings of the atoms `S`. -/
inductive Gen (S : List (Fin n × Kind)) : Matrix (Fin (2 ^ n)) (Fin (2 ^ n)) ℂ → Prop
  | atom {q : Fin n} {k : Kind} {G : Matrix (Fin 2) (Fin 2) ℂ} :
      (q, k) ∈ S → KindOK k G → Gen S (embedGate1 n q G)
  | add {A B : Matrix (Fin (2 ^ n)) (Fin (2 ^ n)) ℂ} : Gen S A → Gen S B → Gen S (A + B)
  | mul {A B : Matrix (Fin (2 ^ n)) (Fin (2 ^ n)) ℂ} : Gen S A → Gen S B → Gen S (A * B)

/-- Matrices generated by pairwise commuting atoms commute. -/
theorem gen_commute {S T : List (Fin n × Kind)}
    (hST : ∀ a ∈ S, ∀ b ∈ T, atomCommB a b = true)
    {M N : Matrix (Fin (2 ^ n)) (Fin (2 ^ n)) ℂ}
    (hM : Gen S M) (hN : Gen T N) : Commute M N := by
  induction hM with
  | atom ha hk =>
    induction hN with
    | atom hb hk' => exact atom_commute (hST _ ha _ hb) hk hk'
    | add _ _ ih₁ ih₂ => exact ih₁.add_right ih₂
    | mul _ _ ih₁ ih₂ => exact ih₁.mul_right ih₂
  | add _ _ ih₁ ih₂ => exact ih₁.add_left ih₂
  | mul _ _ ih₁ ih₂ => exact ih₁.mul_left ih₂

/-! ## Every item is generated by its atoms -/

theorem kindOK_pauliX : KindOK .xl pauliX :=
  ⟨pauliZ, isDiagonal_pauliZ, pauliX_eq_hadamard_conj⟩

theorem kindOK_xl_one : KindOK .xl 1 :=
  ⟨1, isDiagonal_one, by rw [mul_one, hadamard_sq]⟩

theorem gen_one {S : List (Fin n × Kind)} {q : Fin n} (hq : (q, Kind.diag) ∈ S) :
    Gen S (1 : Matrix (Fin (2 ^ n)) (Fin (2 ^ n)) ℂ) := by
  rw [← embedGate1_one n q]
  exact Gen.atom hq isDiagonal_one

theorem gateEmbedding_of_isDiagOnB {q : Fin n} {g : Gate n} (h : isDiagOnB q g = true) :
    ∃ D, IsDiagonal D ∧ gateEmbedding g = embedGate1 n q D := by
  cases g <;> simp only [isDiagOnB, decide_eq_true_eq, Bool.false_eq_true] at h <;> subst h
  · exact ⟨_, isDiagonal_pauliZ, rfl⟩
  · exact ⟨_, by rw [CommuteSound.tGate_eq_diagB]; exact isDiagonal_diagB _, rfl⟩
  · exact ⟨_, by rw [CommuteSound.tDaggerGate_eq_diagB]; exact isDiagonal_diagB _, rfl⟩
  · exact ⟨_, by rw [CommuteSound.phaseS_eq_diagB]; exact isDiagonal_diagB _, rfl⟩
  · exact ⟨_, by rw [CommuteSound.rzGate_eq_diagB]; exact isDiagonal_diagB _, rfl⟩
  · exact ⟨_, by rw [CommuteSound.rzGate_eq_diagB]; exact isDiagonal_diagB _, rfl⟩

theorem gen_diag {q : Fin n} {g : Gate n} (h : isDiagOnB q g = true) :
    Gen [(q, .diag)] (gateEmbedding g) := by
  obtain ⟨D, hD, he⟩ := gateEmbedding_of_isDiagOnB h
  rw [he]
  exact Gen.atom List.mem_cons_self hD

/-- A gate's embedding is generated by its atoms. -/
theorem gen_gate (g : Gate n) : Gen (gateAtoms g) (gateEmbedding g) := by
  cases g with
  | H q => exact Gen.atom (k := .other) List.mem_cons_self trivial
  | Y q => exact Gen.atom (k := .other) List.mem_cons_self trivial
  | X q => exact Gen.atom (k := .xl) List.mem_cons_self kindOK_pauliX
  | Z q => exact gen_diag (q := q) (by simp [isDiagOnB])
  | S q => exact gen_diag (q := q) (by simp [isDiagOnB])
  | T q => exact gen_diag (q := q) (by simp [isDiagOnB])
  | Tdg q => exact gen_diag (q := q) (by simp [isDiagOnB])
  | Rz q θ => exact gen_diag (q := q) (by simp [isDiagOnB])
  | RzQ q a => exact gen_diag (q := q) (by simp [isDiagOnB])
  | CNOT c t =>
    have h₁ : (c, Kind.diag) ∈ gateAtoms (Gate.CNOT c t) := List.mem_cons_self
    have h₂ : (t, Kind.xl) ∈ gateAtoms (Gate.CNOT c t) :=
      List.mem_cons_of_mem _ List.mem_cons_self
    by_cases hct : c = t
    · subst hct
      rw [show gateEmbedding (Gate.CNOT c c : Gate n) = 1 by simp [gateEmbedding]]
      exact gen_one h₁
    · rw [gateEmbedding_CNOT hct, ctrlMatrix]
      exact Gen.add (Gen.atom h₁ isDiagonal_proj0)
        (Gen.mul (Gen.atom h₁ isDiagonal_proj1) (Gen.atom h₂ kindOK_pauliX))
  | CZ a b =>
    have h₁ : (a, Kind.diag) ∈ gateAtoms (Gate.CZ a b) := List.mem_cons_self
    have h₂ : (b, Kind.diag) ∈ gateAtoms (Gate.CZ a b) :=
      List.mem_cons_of_mem _ List.mem_cons_self
    by_cases hab : a = b
    · subst hab
      rw [show gateEmbedding (Gate.CZ a a : Gate n) = 1 by simp [gateEmbedding]]
      exact gen_one h₁
    · rw [gateEmbedding_CZ hab, ctrlMatrix]
      exact Gen.add (Gen.atom h₁ isDiagonal_proj0)
        (Gen.mul (Gen.atom h₁ isDiagonal_proj1) (Gen.atom h₂ isDiagonal_pauliZ))

theorem listM_of_all_isDiagOnB {q : Fin n} :
    ∀ {ds : List (Gate n)}, ds.all (isDiagOnB q) = true →
      ∃ D, IsDiagonal D ∧ listM ds = embedGate1 n q D
  | [], _ => ⟨1, isDiagonal_one, by rw [listM_nil, embedGate1_one]⟩
  | g :: gs, h => by
    simp only [List.all_cons, Bool.and_eq_true] at h
    obtain ⟨D, hD, hgs⟩ := listM_of_all_isDiagOnB h.2
    obtain ⟨Dg, hDg, hg⟩ := gateEmbedding_of_isDiagOnB h.1
    exact ⟨D * Dg, isDiagonal_mul hD hDg, by rw [listM_cons, hgs, hg, embedGate1_mul]⟩

/-- An item's matrix is generated by its atoms; an X-block on `q` is `embedGate1 q (H D H)`. -/
theorem gen_item (x : Item n) : Gen x.atoms (listM x.gates) := by
  cases x with
  | gate g => rw [Item.gates, listM_single]; exact gen_gate g
  | xblock q ds h =>
    obtain ⟨D, hD, hds⟩ := listM_of_all_isDiagOnB h
    rw [Item.gates, listM_cons, listM_append, listM_single, hds]
    change Gen _ (embedGate1 n q hadamard * embedGate1 n q D * embedGate1 n q hadamard)
    rw [embedGate1_mul, embedGate1_mul]
    exact Gen.atom (k := .xl) (by simp [Item.atoms]) ⟨D, hD, rfl⟩

/-- **Soundness of the commutation test.** -/
theorem itemComm_sound {x y : Item n} (h : itemComm x y = true) :
    Commute (listM x.gates) (listM y.gates) := by
  refine gen_commute (fun a ha b hb => ?_) (gen_item x) (gen_item y)
  simp only [itemComm, List.all_eq_true] at h
  exact h a ha b hb

/-! ## Absorption -/

theorem rzGate_zero : rzGate 0 = 1 := by
  rw [CommuteSound.rzGate_eq_diagB]
  ext i j
  fin_cases i <;> fin_cases j <;> simp [CommuteSound.diagB]

theorem gateEmbedding_CNOT_mul_self (c t : Fin n) :
    gateEmbedding (Gate.CNOT c t) * gateEmbedding (Gate.CNOT c t) = 1 := by
  by_cases h : c = t
  · simp [gateEmbedding, h]
  · rw [gateEmbedding, dite_eq_right h, embedGate2_mul, cnot_sq, embedGate2_one]

theorem gateEmbedding_CZ_mul_self (a b : Fin n) :
    gateEmbedding (Gate.CZ a b) * gateEmbedding (Gate.CZ a b) = 1 := by
  by_cases h : a = b
  · simp [gateEmbedding, h]
  · rw [gateEmbedding, dite_eq_right h, embedGate2_mul, czGate_mul_self, embedGate2_one]

theorem gateEmbedding_RzQ_mul (q : Fin n) (θ φ : PiLin) :
    gateEmbedding (Gate.RzQ q φ) * gateEmbedding (Gate.RzQ q θ)
      = embedGate1 n q (rzGate (PiLin.toReal (θ + φ))) := by
  change embedGate1 n q _ * embedGate1 n q _ = _
  rw [embedGate1_mul, CommuteMergeSound.rzGate_mul_rzGate, PiLin.toReal_add, add_comm]

/-- What `absorb x y` returns has the matrix of `x; y`. -/
theorem absorb_sound {x y : Gate n} {r : List (Gate n)} (h : absorb x y = some r) :
    listM r = gateEmbedding y * gateEmbedding x := by
  have e1 : ∀ (q : Fin n) (G G' : Matrix (Fin 2) (Fin 2) ℂ), G' * G = 1 →
      embedGate1 n q G' * embedGate1 n q G = 1 := fun q G G' hG => by
    rw [embedGate1_mul, hG, embedGate1_one]
  cases x <;> cases y <;> simp only [absorb, reduceCtorEq] at h <;>
    split_ifs at h with hab <;> simp only [Option.some.injEq] at h <;> subst h
  · subst hab; exact (e1 _ _ _ hadamard_sq).symm
  · subst hab; exact (e1 _ _ _ pauliX_sq).symm
  · subst hab; exact (e1 _ _ _ pauliY_sq).symm
  · subst hab; exact (e1 _ _ _ pauliZ_sq).symm
  · subst hab; exact (e1 _ _ _ tDaggerGate_mul_tGate).symm
  · subst hab; exact (e1 _ _ _ tGate_mul_tDaggerGate).symm
  · obtain ⟨rfl, rfl⟩ := hab
    exact (gateEmbedding_CNOT_mul_self _ _).symm
  · obtain ⟨rfl, rfl⟩ := hab
    exact (gateEmbedding_CZ_mul_self _ _).symm
  · rename_i q θ q' φ hz
    subst hab
    rw [gateEmbedding_RzQ_mul, hz, PiLin.toReal_zero, rzGate_zero, embedGate1_one, listM_nil]
  · subst hab
    rw [listM_single, gateEmbedding_RzQ_mul]
    rfl

theorem absorb_length {x y : Gate n} {r : List (Gate n)} (h : absorb x y = some r) :
    r.length ≤ 1 := by
  cases x <;> cases y <;> simp only [absorb, reduceCtorEq] at h <;> grind

/-! ## The scan and the sweep -/

/-- A successful scan of `x` over `l` returns a list with the matrix of `x :: l` and no
    more gates than `l`. -/
theorem scan_sound (x : Gate n) :
    ∀ (k : ℕ) {l l' : List (Item n)}, scan x k l = some l' →
      listM (flat l') = listM (flat l) * gateEmbedding x ∧
        (flat l').length ≤ (flat l).length
  | 0, _, _, h => by simp [scan] at h
  | _ + 1, [], _, h => by simp [scan] at h
  | k + 1, y :: ys, l', h => by
    simp only [scan] at h
    split at h
    · next r hr =>
      cases y with
      | xblock => simp [absorbItem] at hr
      | gate g =>
        simp only [absorbItem] at hr
        simp only [Option.some.injEq] at h
        subst h
        refine ⟨?_, ?_⟩
        · rw [flat, List.flatMap_append, ← flat, ← flat, flat_map_gate, listM_append,
            listM_flat_cons, Item.gates, listM_single, absorb_sound hr, mul_assoc]
        · have := absorb_length hr
          simp only [flat, List.flatMap_append, List.flatMap_cons, Item.gates,
            List.length_append] at this ⊢
          rw [← flat, flat_map_gate] at *
          grind
    · split at h
      · next hc =>
        obtain ⟨r, hr, rfl⟩ := Option.map_eq_some_iff.mp h
        obtain ⟨ih₁, ih₂⟩ := scan_sound x k hr
        refine ⟨?_, ?_⟩
        · have hcomm := itemComm_sound hc
          rw [Item.gates, listM_single] at hcomm
          rw [listM_flat_cons, listM_flat_cons, ih₁, mul_assoc, mul_assoc, hcomm.eq]
        · simp only [flat_cons, List.length_append]; omega
      · simp at h

/-- The sweep preserves the matrix and does not add gates. -/
theorem cancelGo_sound :
    ∀ (k : ℕ) (l : List (Item n)),
      listM (flat (cancelGo k l)) = listM (flat l) ∧
        (flat (cancelGo k l)).length ≤ (flat l).length
  | 0, l => by simp [cancelGo]
  | _ + 1, [] => by simp [cancelGo]
  | k + 1, x :: rest => by
    cases x with
    | gate g =>
      simp only [cancelGo]
      split
      · next rest' hs =>
        obtain ⟨h₁, h₂⟩ := scan_sound g commuteWindow hs
        obtain ⟨ih₁, ih₂⟩ := cancelGo_sound k rest'
        refine ⟨?_, ?_⟩
        · rw [ih₁, h₁, listM_flat_cons, Item.gates, listM_single]
        · simp only [flat_cons, Item.gates, List.length_append, List.length_singleton]; omega
      · obtain ⟨ih₁, ih₂⟩ := cancelGo_sound k rest
        refine ⟨?_, ?_⟩
        · rw [listM_flat_cons, listM_flat_cons, ih₁]
        · simp only [flat_cons, List.length_append]; omega
    | xblock q ds hd =>
      simp only [cancelGo]
      obtain ⟨ih₁, ih₂⟩ := cancelGo_sound k rest
      refine ⟨?_, ?_⟩
      · rw [listM_flat_cons, listM_flat_cons, ih₁]
      · simp only [flat_cons, List.length_append]; omega

/-- Reading a gate list as items loses and adds no gate. -/
theorem flat_toItems : ∀ (k : ℕ) (l : List (Gate n)), flat (toItems k l) = l
  | 0, l => flat_map_gate l
  | _ + 1, [] => rfl
  | k + 1, g :: rest => by
    cases g
    case H q =>
      simp only [toItems]
      split
      · next d ds q' rest' h₁ h₂ =>
        split_ifs with hq
        · subst hq
          have hs := List.takeWhile_append_dropWhile (p := isDiagOnB q') (l := rest)
          rw [h₁, h₂] at hs
          rw [flat_cons, flat_toItems k rest', Item.gates, ← hs]
          simp
        · rw [flat_cons, flat_toItems]; rfl
      · rw [flat_cons, flat_toItems]; rfl
    all_goals (simp only [toItems]; rw [flat_cons, flat_toItems]; rfl)

/-! ## The pass -/

theorem listM_commuteCancelList (l : List (Gate n)) : listM (commuteCancelList l) = listM l := by
  unfold commuteCancelList
  rw [(cancelGo_sound _ _).1, flat_toItems]

theorem length_commuteCancelList_le (l : List (Gate n)) :
    (commuteCancelList l).length ≤ l.length := by
  unfold commuteCancelList
  have := (cancelGo_sound (toItems l.length l).length (toItems l.length l)).2
  rwa [flat_toItems] at this

/-- `commuteCancel` preserves `circuitUnitary`. -/
theorem commuteCancel_matrixCorrect :
    MatrixCorrect (commuteCancel : Circuit n → Circuit n) := by
  intro c
  have hl : listU (commuteCancelList (circuitToList c)) = listU (circuitToList c) :=
    Subtype.ext (listM_commuteCancelList _)
  unfold commuteCancel
  rw [circuitUnitary_ofList_eq_listU, hl, ← circuitUnitary_ofList_eq_listU,
    circuitUnitary_ofList_flatten _ rfl (fun _ _ => rfl) (fun _ _ => rfl) c]

/-- **The pass preserves the unitary-channel semantics.** -/
theorem unitaryDenote_commuteCancel (c : Circuit n) :
    unitaryDenote (commuteCancel c) = unitaryDenote c :=
  unitaryDenote_eq_of_circuitUnitary_eq (commuteCancel_matrixCorrect c)

/-- **The pass does not increase the gate count.** -/
theorem gateCount_commuteCancel_le (c : Circuit n) :
    (commuteCancel c).gateCount ≤ c.gateCount := by
  unfold commuteCancel
  rw [gateCount_ofList, ← circuitToList_length]
  exact length_commuteCancelList_le _

end

/-! ## The pass fires

A `CNOT` pair around an X-block on its target cancels; so does a pair around a rotation
on its control, and a pair across a `CNOT` sharing the target and an `X` on it, while two
opposite `RzQ` rotations vanish. -/

set_option linter.hashCommand false in
#guard (commuteCancelList [Gate.CNOT (0 : Fin 2) 1, Gate.H 1,
  Gate.RzQ 1 (1 / 4), Gate.H 1, Gate.CNOT 0 1]).length = 3

set_option linter.hashCommand false in
#guard (commuteCancelList [Gate.CNOT (0 : Fin 2) 1, Gate.RzQ 0 (1 / 3),
  Gate.CNOT 0 1]).length = 1

set_option linter.hashCommand false in
#guard (commuteCancelList [Gate.CNOT (0 : Fin 3) 2, Gate.CNOT 1 2, Gate.X 2,
  Gate.CNOT 0 2, Gate.RzQ 1 (1 / 2), Gate.RzQ 1 (-(1 / 2))]).length = 2

end CatCrypt.Quantum.Optimization.CommuteCancel
