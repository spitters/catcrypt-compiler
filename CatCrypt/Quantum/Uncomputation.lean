open CatCrypt.Quantum.QFT (listMatrix listMatrix_nil listMatrix_cons listMatrix_append invGate
  invGates listMatrix_invGates gateEmbedding_invGate)

namespace CatCrypt.Quantum.QCircuit.Gate

variable {n : ℕ}

/-- The qubits a gate acts on. -/
def support : Gate n → List (Fin n)
  | .H i | .X i | .Y i | .Z i | .T i | .Tdg i | .S i => [i]
  | .Rz i _ | .RzQ i _ => [i]
  | .CNOT i j | .CZ i j => [i, j]

/-- A gate is qfree: it maps basis states to phased basis states. Every gate but `H`. -/
def qfree : Gate n → Bool
  | .H _ => false
  | _ => true

/-- A gate is permeable on `q`: it avoids `q`, is diagonal, or is a `CNOT` with `q` not its
    target. -/
def permeable (q : Fin n) : Gate n → Bool
  | .H i | .X i | .Y i => decide (i ≠ q)
  | .CNOT _ j => decide (j ≠ q)
  | _ => true

end CatCrypt.Quantum.QCircuit.Gate

namespace CatCrypt.Quantum.Uncomputation

variable {n : ℕ}

/-! ## Reversible atoms and the check -/

/-- The reversible atoms: a gate, the multi-controlled `X` with controls `cs` and target `t`,
    and the relative-phase Toffoli with controls `c₁`, `c₂` and target `t`. -/
inductive RevOp (n : ℕ) : Type where
  | gate (g : Gate n) : RevOp n
  | mcx (cs : List (Fin n)) (t : Fin n) : RevOp n
  | rtof (c₁ c₂ t : Fin n) : RevOp n

namespace RevOp

/-- The gate list of an atom. -/
def gates : RevOp n → List (Gate n)
  | gate g => [g]
  | mcx cs t => mctrlGates cs (.X t)
  | rtof c₁ c₂ t => rtofGates c₁ c₂ t

/-- The inverse of an atom: the inverse gate, the multi-controlled `X` itself, and the inverse
    gates of the relative-phase Toffoli. -/
def inv : RevOp n → List (RevOp n)
  | gate g => [gate (invGate g)]
  | mcx cs t => [mcx cs t]
  | rtof c₁ c₂ t => (invGates (rtofGates c₁ c₂ t)).map gate

/-- An atom is well formed: distinct controls, and a target that is not a control. -/
def wf : RevOp n → Bool
  | gate _ => true
  | mcx cs t => decide cs.Nodup && decide (t ∉ cs)
  | rtof c₁ c₂ t => decide (c₁ ≠ c₂) && decide (c₁ ≠ t) && decide (c₂ ≠ t)

/-- An atom is qfree: a qfree gate, or a well-formed multi-controlled `X` or relative-phase
    Toffoli. -/
def qfree : RevOp n → Bool
  | gate g => g.qfree
  | mcx cs t => (mcx cs t).wf
  | rtof c₁ c₂ t => (rtof c₁ c₂ t).wf

/-- An atom is permeable on `q`: a permeable gate, or a well-formed multi-controlled `X` or
    relative-phase Toffoli whose target is not `q`. -/
def permeable (q : Fin n) : RevOp n → Bool
  | gate g => g.permeable q
  | mcx cs t => (mcx cs t).wf && decide (t ≠ q)
  | rtof c₁ c₂ t => (rtof c₁ c₂ t).wf && decide (t ≠ q)

/-- An atom acts only on the qubits `S`. -/
def within (S : List (Fin n)) : RevOp n → Bool
  | gate g => g.support.all fun q => decide (q ∈ S)
  | mcx cs t => cs.all (fun q => decide (q ∈ S)) && decide (t ∈ S)
  | rtof c₁ c₂ t => decide (c₁ ∈ S) && decide (c₂ ∈ S) && decide (t ∈ S)

end RevOp

/-- The gate list of a list of atoms. -/
def revGates (l : List (RevOp n)) : List (Gate n) := l.flatMap RevOp.gates

/-- The uncomputation check: the ancilla `a` is not an input, the compute block `C` is qfree,
    acts only on `a :: ins` and is permeable on the inputs, and the use block `U` is permeable
    on the ancilla and the inputs. -/
def uncomputable (a : Fin n) (ins : List (Fin n)) (C U : List (RevOp n)) : Bool :=
  decide (a ∉ ins) && decide ins.Nodup && C.all RevOp.qfree && C.all (RevOp.within (a :: ins))
    && C.all (fun o => ins.all fun q => o.permeable q)
    && U.all (fun o => (a :: ins).all fun q => o.permeable q)

/-- Unfolding lemma of `revGates` at the empty list. -/
theorem revGates_nil : revGates ([] : List (RevOp n)) = [] := rfl

/-- `revGates` of a cons is the atom's gate list followed by the rest. -/
theorem revGates_cons (o : RevOp n) (l : List (RevOp n)) :
    revGates (o :: l) = o.gates ++ revGates l := List.flatMap_cons

/-- `revGates` maps concatenation to concatenation. -/
theorem revGates_append (l₁ l₂ : List (RevOp n)) :
    revGates (l₁ ++ l₂) = revGates l₁ ++ revGates l₂ := List.flatMap_append

/-- A gate list read as gate atoms lowers to itself. -/
theorem revGates_map_gate (l : List (Gate n)) : revGates (l.map RevOp.gate) = l := by
  induction l with
  | nil => rfl
  | cons g l ih => rw [List.map_cons, revGates_cons, ih]; rfl

noncomputable section

/-! ## Phases generated by diagonal operators -/

/-- A scalar multiple of a phase on `S` is a phase on `S`. -/
theorem phaseOn_smul {S : List (Fin n)} {D : Matrix (Fin (2 ^ n)) (Fin (2 ^ n)) ℂ} (c : ℂ)
    (hD : PhaseOn S D) : PhaseOn S (c • D) := by
  obtain ⟨f, rfl, hf⟩ := hD
  exact ⟨c • f, (Matrix.diagonal_smul c f).symm, fun x y h => by
    simp only [Pi.smul_apply, hf x y h]⟩

/-- A phase is diagonal, so it keeps every bit. -/
theorem _root_.CatCrypt.Quantum.AndAncilla.PhaseOn.keepsBits {S T : List (Fin n)}
    {D : Matrix (Fin (2 ^ n)) (Fin (2 ^ n)) ℂ}
    (hD : PhaseOn T D) : KeepsBits S D := by
  obtain ⟨f, rfl, -⟩ := hD
  intro x y h q _
  by_cases hxy : x = y
  · rw [hxy]
  · exact absurd (Matrix.diagonal_apply_ne f hxy) h

/-- The phases generated by diagonal single-qubit operators on qubits of `S` under sums,
    products and scalars. -/
inductive PhaseGen (S : List (Fin n)) : Matrix (Fin (2 ^ n)) (Fin (2 ^ n)) ℂ → Prop
  | one : PhaseGen S 1
  | gate {q : Fin n} {G : Matrix (Fin 2) (Fin 2) ℂ} :
      q ∈ S → IsDiagonal G → PhaseGen S (embedGate1 n q G)
  | add {D E : Matrix (Fin (2 ^ n)) (Fin (2 ^ n)) ℂ} :
      PhaseGen S D → PhaseGen S E → PhaseGen S (D + E)
  | mul {D E : Matrix (Fin (2 ^ n)) (Fin (2 ^ n)) ℂ} :
      PhaseGen S D → PhaseGen S E → PhaseGen S (D * E)
  | smul (c : ℂ) {D : Matrix (Fin (2 ^ n)) (Fin (2 ^ n)) ℂ} :
      PhaseGen S D → PhaseGen S (c • D)

/-- `X` conjugates a diagonal single-qubit matrix into a diagonal one. -/
theorem isDiagonal_pauliX_conj {G : Matrix (Fin 2) (Fin 2) ℂ} (hG : IsDiagonal G) :
    IsDiagonal (pauliX * G * pauliX) := by
  have h01 := hG 0 1 (by decide)
  have h10 := hG 1 0 (by decide)
  intro r c h
  rw [Matrix.mul_apply, Fin.sum_univ_two, Matrix.mul_apply, Matrix.mul_apply, Fin.sum_univ_two,
    Fin.sum_univ_two]
  fin_cases r <;> fin_cases c <;> simp_all [pauliX]

/-- `X_a` is an involution. -/
theorem embedGate1_pauliX_mul_self (a : Fin n) :
    embedGate1 n a pauliX * embedGate1 n a pauliX = 1 := by
  rw [embedGate1_mul, pauliX_sq, embedGate1_one]

namespace PhaseGen

variable {S T : List (Fin n)} {D E : Matrix (Fin (2 ^ n)) (Fin (2 ^ n)) ℂ}

/-- A generated phase is a phase. -/
theorem phaseOn (h : PhaseGen S D) : PhaseOn S D := by
  induction h with
  | one => exact phaseOn_one S
  | gate hq hG => exact phaseOn_embedGate1 hq hG
  | add _ _ ih₁ ih₂ => exact ih₁.add ih₂
  | mul _ _ ih₁ ih₂ => exact ih₁.mul ih₂
  | smul c _ ih => exact phaseOn_smul c ih

/-- A phase generated on `S` is generated on every superset of `S`. -/
theorem mono (h : PhaseGen S D) (hST : S ⊆ T) : PhaseGen T D := by
  induction h with
  | one => exact .one
  | gate hq hG => exact .gate (hST hq) hG
  | add _ _ ih₁ ih₂ => exact .add ih₁ ih₂
  | mul _ _ ih₁ ih₂ => exact .mul ih₁ ih₂
  | smul c _ ih => exact .smul c ih

/-- The zero matrix is a generated phase. -/
theorem zero : PhaseGen S 0 := by
  simpa using PhaseGen.smul (S := S) 0 .one

/-- A difference of generated phases is a generated phase. -/
theorem sub (hD : PhaseGen S D) (hE : PhaseGen S E) : PhaseGen S (D - E) := by
  rw [sub_eq_add_neg, ← neg_one_smul ℂ E]
  exact .add hD (.smul _ hE)

/-- Conjugation by `X_a` keeps a generated phase generated. -/
theorem pauliX_conj (a : Fin n) (h : PhaseGen S D) :
    PhaseGen S (embedGate1 n a pauliX * D * embedGate1 n a pauliX) := by
  have hXX := embedGate1_pauliX_mul_self a
  induction h with
  | one => rw [mul_one, hXX]; exact .one
  | @gate q G hq hG =>
    by_cases hqa : q = a
    · subst hqa
      rw [embedGate1_mul, embedGate1_mul]
      exact .gate hq (isDiagonal_pauliX_conj hG)
    · rw [mul_assoc, embedGate1_disjoint_comm hqa G pauliX, ← mul_assoc, hXX, one_mul]
      exact .gate hq hG
  | add _ _ ih₁ ih₂ => rw [mul_add, add_mul]; exact .add ih₁ ih₂
  | mul _ _ ih₁ ih₂ => rw [conj_involution_mul hXX]; exact .mul ih₁ ih₂
  | smul c _ ih => rw [Matrix.mul_smul, Matrix.smul_mul]; exact .smul c ih

/-- A phase generated away from `a` commutes with `X_a`. -/
theorem commute_pauliX {a : Fin n} (ha : a ∉ S) (h : PhaseGen S D) :
    Commute D (embedGate1 n a pauliX) :=
  h.phaseOn.commute_of_keepsBits
    (keepsBits_embedGate1 (fun q hq hq' => by subst hq'; exact ha hq) _)

end PhaseGen

/-- The product of the `|1⟩` projectors of the qubits `cs ⊆ S` is generated on `S`. -/
theorem phaseGen_prod_proj1 {S : List (Fin n)} :
    ∀ {cs : List (Fin n)}, cs ⊆ S → PhaseGen S (cs.map fun c => embedGate1 n c proj1).prod
  | [], _ => by rw [List.map_nil, List.prod_nil]; exact .one
  | c :: cs, h => by
    rw [List.map_cons, List.prod_cons]
    exact .mul (.gate (h List.mem_cons_self) isDiagonal_proj1)
      (phaseGen_prod_proj1 fun q hq => h (List.mem_cons_of_mem c hq))

/-- The phase of the relative-phase Toffoli is generated on every set holding its qubits. -/
theorem phaseGen_rtofPhase {S : List (Fin n)} {c₁ c₂ t : Fin n} (h₁ : c₁ ∈ S) (h₂ : c₂ ∈ S)
    (ht : t ∈ S) : PhaseGen S (rtofPhase c₁ c₂ t) := by
  have hZ : IsDiagonal ((-Complex.I) • pauliZ) := fun r c h => by
    simp [isDiagonal_pauliZ r c h]
  simp only [rtofPhase, ctrlMatrix, branchMatrix]
  exact .add (.gate h₁ isDiagonal_proj0) (.mul (.gate h₁ isDiagonal_proj1)
    (.add (.mul (.gate h₂ isDiagonal_proj0) (.gate ht isDiagonal_pauliZ))
      (.mul (.gate h₂ isDiagonal_proj1) (.gate ht hZ))))

/-- The exclusive or of two commuting predicate projectors is a projector. -/
theorem xor_mul_self {S T : List (Fin n)} {p q : Matrix (Fin (2 ^ n)) (Fin (2 ^ n)) ℂ}
    (hp : PhaseOn S p) (hq : PhaseOn T q) (hp2 : p * p = p) (hq2 : q * q = q) :
    (p + q - (p * q + p * q)) * (p + q - (p * q + p * q)) = p + q - (p * q + p * q) := by
  obtain ⟨f, rfl, -⟩ := hp
  obtain ⟨g, rfl, -⟩ := hq
  rw [Matrix.diagonal_mul_diagonal] at hp2 hq2
  have hf : ∀ x, f x * f x = f x := fun x => congrFun (Matrix.diagonal_injective hp2) x
  have hg : ∀ x, g x * g x = g x := fun x => congrFun (Matrix.diagonal_injective hq2) x
  simp only [Matrix.diagonal_mul_diagonal, Matrix.diagonal_add, Matrix.diagonal_sub]
  congr 1
  funext x
  linear_combination (1 + 4 * (g x * g x - g x)) * hf x + hg x

/-! ## The matrices that write a predicate into the ancilla -/

/-- `M = D (1 + Π (X_a - 1))` with `D` a generated phase on `a :: ins` and `Π` a generated
    projector on `ins`: on basis states, `M` flips the ancilla `a` where the predicate `Π` of
    the inputs holds, up to the phase `D`. -/
def RevForm (a : Fin n) (ins : List (Fin n)) (M : Matrix (Fin (2 ^ n)) (Fin (2 ^ n)) ℂ) :
    Prop :=
  ∃ D P, PhaseGen (a :: ins) D ∧ PhaseGen ins P ∧ P * P = P ∧
    M = D * (1 + P * (embedGate1 n a pauliX - 1))

/-- Two controlled flips of an involution compose to the flip controlled on the exclusive or. -/
theorem flip_mul_flip {R : Type*} [Ring R] {p q x : R} (hqx : Commute q x) (hx : x * x = 1) :
    (1 + p * (x - 1)) * (1 + q * (x - 1)) = 1 + (p + q - (p * q + p * q)) * (x - 1) := by
  have h1 : (x - 1) * q = q * (x - 1) := (hqx.sub_right (Commute.one_right q)).eq.symm
  have h2 : (x - 1) * (x - 1) = -(x - 1) - (x - 1) := by
    have e : (x - 1) * (x - 1) = x * x - x - x + 1 := by noncomm_ring
    rw [e, hx]
    abel
  calc (1 + p * (x - 1)) * (1 + q * (x - 1))
      = 1 + p * (x - 1) + q * (x - 1) + p * ((x - 1) * q) * (x - 1) := by noncomm_ring
    _ = 1 + p * (x - 1) + q * (x - 1) + p * q * ((x - 1) * (x - 1)) := by
        rw [h1]; noncomm_ring
    _ = 1 + (p + q - (p * q + p * q)) * (x - 1) := by rw [h2]; noncomm_ring

/-- A controlled flip moves past a phase `d` by conjugating `d` with the flip where the control
    holds. -/
theorem flip_mul_comm {R : Type*} [Ring R] {p x d : R} (hp : p * p = p) (hpx : Commute p x)
    (hpd : Commute p d) (hx : x * x = 1) :
    (1 + p * (x - 1)) * d = (p * (x * d * x) + (1 - p) * d) * (1 + p * (x - 1)) := by
  have c1 : Commute p (x * d * x) := (hpx.mul_right hpd).mul_right hpx
  have hp1 : (1 - p) * p = 0 := by rw [sub_mul, one_mul, hp, sub_self]
  have e : x * d * x * (x - 1) = x * d - x * d * x := by
    rw [mul_sub, mul_one, mul_assoc (x * d), hx, mul_one]
  symm
  calc (p * (x * d * x) + (1 - p) * d) * (1 + p * (x - 1))
      = p * (x * d * x) + p * ((x * d * x) * p) * (x - 1) + (1 - p) * d
          + (1 - p) * (d * p) * (x - 1) := by noncomm_ring
    _ = p * (x * d * x) + (p * p) * (x * d * x * (x - 1)) + (1 - p) * d
          + ((1 - p) * p) * d * (x - 1) := by
        rw [← c1.eq, ← hpd.eq]; noncomm_ring
    _ = (1 + p * (x - 1)) * d := by rw [hp, hp1, e]; noncomm_ring

/-- The matrices writing a predicate into the ancilla are closed under products. -/
theorem RevForm.mul {a : Fin n} {ins : List (Fin n)}
    {M N : Matrix (Fin (2 ^ n)) (Fin (2 ^ n)) ℂ} (ha : a ∉ ins)
    (hM : RevForm a ins M) (hN : RevForm a ins N) : RevForm a ins (M * N) := by
  obtain ⟨D, p, hD, hp, hp2, rfl⟩ := hM
  obtain ⟨E, q, hE, hq, hq2, rfl⟩ := hN
  have hXX := embedGate1_pauliX_mul_self a
  have hpE : Commute p E := hp.phaseOn.commute hE.phaseOn
  have hp' := hp.mono (List.subset_cons_self a ins)
  refine ⟨D * (p * (embedGate1 n a pauliX * E * embedGate1 n a pauliX) + (1 - p) * E),
    p + q - (p * q + p * q), .mul hD (.add (.mul hp' (hE.pauliX_conj a)) (.mul (.sub .one hp')
    hE)), .sub (.add hp hq) (.add (.mul hp hq) (.mul hp hq)),
    xor_mul_self hp.phaseOn hq.phaseOn hp2 hq2, ?_⟩
  rw [mul_assoc D, ← mul_assoc _ E, flip_mul_comm hp2 (hp.commute_pauliX ha) hpE hXX,
    ← flip_mul_flip (hq.commute_pauliX ha) hXX]
  simp only [mul_assoc]

/-- A generated phase on `a :: ins` writes the constant false predicate. -/
theorem revForm_phase {a : Fin n} {ins : List (Fin n)} {D : Matrix (Fin (2 ^ n)) (Fin (2 ^ n)) ℂ}
    (hD : PhaseGen (a :: ins) D) : RevForm a ins D :=
  ⟨D, 0, hD, .zero, by rw [mul_zero], by rw [zero_mul, add_zero, mul_one]⟩

/-- The matrix of a one-gate list is the gate's matrix. -/
theorem listMatrix_singleton (g : Gate n) : listMatrix [g] = gateEmbedding g := by
  rw [listMatrix_cons, listMatrix_nil, one_mul]

/-- `Y = diag(-i, i) X`. -/
theorem pauliY_eq_mul_pauliX :
    pauliY = Matrix.of ![![-Complex.I, 0], ![0, Complex.I]] * pauliX := by
  ext i j
  fin_cases i <;> fin_cases j <;> simp [pauliY, pauliX, Matrix.mul_apply, Fin.sum_univ_two]

/-- A qfree gate acting on `a :: ins` and permeable on `ins` writes a predicate into `a`. -/
theorem revForm_gate {a : Fin n} {ins : List (Fin n)} {g : Gate n} (ha : a ∉ ins)
    (hq : g.qfree = true) (hw : ∀ q ∈ g.support, q ∈ a :: ins)
    (hp : ∀ q ∈ ins, g.permeable q = true) : RevForm a ins (gateEmbedding g) := by
  have hdiag : ∀ {i : Fin n} {G : Matrix (Fin 2) (Fin 2) ℂ}, i ∈ g.support → IsDiagonal G →
      RevForm a ins (embedGate1 n i G) := fun hi hG => revForm_phase (.gate (hw _ hi) hG)
  cases g with
  | H i => simp [Gate.qfree] at hq
  | X i =>
    have hi : i ∉ ins := fun h => by simpa [Gate.permeable] using hp i h
    obtain rfl : i = a := (List.mem_cons.mp (hw i (by simp [Gate.support]))).resolve_right hi
    exact ⟨1, 1, .one, .one, mul_one 1, by simp [gateEmbedding]⟩
  | Y i =>
    have hi : i ∉ ins := fun h => by simpa [Gate.permeable] using hp i h
    obtain rfl : i = a := (List.mem_cons.mp (hw i (by simp [Gate.support]))).resolve_right hi
    refine ⟨embedGate1 n i (Matrix.of ![![-Complex.I, 0], ![0, Complex.I]]), 1,
      .gate List.mem_cons_self ?_, .one, mul_one 1, ?_⟩
    · intro r c h
      fin_cases r <;> fin_cases c <;> simp_all
    · change embedGate1 n i pauliY = _
      rw [one_mul, add_sub_cancel, embedGate1_mul, ← pauliY_eq_mul_pauliX]
  | Z i => exact hdiag (by simp [Gate.support]) isDiagonal_pauliZ
  | T i => exact hdiag (by simp [Gate.support]) (by
      intro r c h; fin_cases r <;> fin_cases c <;> simp_all [tGate])
  | Tdg i => exact hdiag (by simp [Gate.support]) (by
      intro r c h; fin_cases r <;> fin_cases c <;> simp_all [tDaggerGate])
  | S i => exact hdiag (by simp [Gate.support]) (by
      intro r c h; fin_cases r <;> fin_cases c <;> simp_all [phaseS])
  | Rz i θ => exact hdiag (by simp [Gate.support]) (isDiagonal_rzGate θ)
  | RzQ i q => exact hdiag (by simp [Gate.support]) (isDiagonal_rzGate _)
  | CNOT i j =>
    by_cases hij : i = j
    · simp only [gateEmbedding, dite_eq_left hij]
      exact revForm_phase .one
    · have hj : j ∉ ins := fun h => by simpa [Gate.permeable] using hp j h
      obtain rfl : j = a :=
        (List.mem_cons.mp (hw j (by simp [Gate.support]))).resolve_right hj
      have hi : i ∈ ins :=
        (List.mem_cons.mp (hw i (by simp [Gate.support]))).resolve_left hij
      rw [gateEmbedding_CNOT hij, ctrlMatrix_eq_one_add]
      exact ⟨1, embedGate1 n i proj1, .one, .gate hi isDiagonal_proj1,
        by rw [embedGate1_mul, proj1_mul_proj1], (one_mul _).symm⟩
  | CZ i j =>
    by_cases hij : i = j
    · simp only [gateEmbedding, dite_eq_left hij]
      exact revForm_phase .one
    · have hi := hw i (by simp [Gate.support])
      have hj := hw j (by simp [Gate.support])
      rw [gateEmbedding_CZ hij, ctrlMatrix]
      exact revForm_phase (.add (.gate hi isDiagonal_proj0)
        (.mul (.gate hi isDiagonal_proj1) (.gate hj isDiagonal_pauliZ)))

/-- The matrix of a well-formed multi-controlled `X`. -/
theorem listMatrix_mcx {cs : List (Fin n)} {t : Fin n} (hnd : cs.Nodup) (ht : t ∉ cs) :
    listMatrix (RevOp.mcx cs t).gates
      = 1 + (cs.map fun c => embedGate1 n c proj1).prod * (embedGate1 n t pauliX - 1) := by
  rw [RevOp.gates, listMatrix_mctrlGates (g := Gate.X t) hnd fun c hc =>
      (by rintro rfl; exact ht hc : t ≠ c),
    mctrlMatrix_eq]
  rfl

/-- The matrix of a well-formed relative-phase Toffoli. -/
theorem listMatrix_rtof {c₁ c₂ t : Fin n} (h12 : c₁ ≠ c₂) (h1t : c₁ ≠ t) (h2t : c₂ ≠ t) :
    listMatrix (RevOp.rtof c₁ c₂ t).gates = rtofPhase c₁ c₂ t
      * (1 + ([c₁, c₂].map fun c => embedGate1 n c proj1).prod
        * (embedGate1 n t pauliX - 1)) := by
  rw [RevOp.gates, listMatrix_rtofGates h12 h1t h2t, listMatrix_toffoliGates h12 h1t h2t,
    embedGate2_cnot h2t, ← mctrlMatrix_eq]
  rfl

/-- A qfree atom acting on `a :: ins` and permeable on `ins` writes a predicate into `a`. -/
theorem revForm_op {a : Fin n} {ins : List (Fin n)} {o : RevOp n} (ha : a ∉ ins)
    (hq : o.qfree = true) (hw : o.within (a :: ins) = true)
    (hp : ∀ q ∈ ins, o.permeable q = true) : RevForm a ins (listMatrix o.gates) := by
  cases o with
  | gate g =>
    rw [RevOp.gates, listMatrix_singleton]
    exact revForm_gate ha (by simpa [RevOp.qfree] using hq)
      (by simpa [RevOp.within] using hw) fun q hq' => by simpa [RevOp.permeable] using hp q hq'
  | mcx cs t =>
    simp only [RevOp.qfree, RevOp.wf, Bool.and_eq_true, decide_eq_true_eq] at hq
    simp only [RevOp.within, Bool.and_eq_true, List.all_eq_true, decide_eq_true_eq] at hw
    have ht : t ∉ ins := fun h => by simpa [RevOp.permeable] using hp t h
    obtain rfl : t = a := (List.mem_cons.mp hw.2).resolve_right ht
    have hsub : cs ⊆ ins := fun c hc =>
      (List.mem_cons.mp (hw.1 c hc)).resolve_left fun h => hq.2 (h ▸ hc)
    rw [listMatrix_mcx hq.1 hq.2]
    exact ⟨1, _, .one, phaseGen_prod_proj1 hsub, (isPred_prod_proj1 cs).2, (one_mul _).symm⟩
  | rtof c₁ c₂ t =>
    simp only [RevOp.qfree, RevOp.wf, Bool.and_eq_true, decide_eq_true_eq] at hq
    simp only [RevOp.within, Bool.and_eq_true, decide_eq_true_eq] at hw
    have ht : t ∉ ins := fun h => by simpa [RevOp.permeable] using hp t h
    obtain rfl : t = a := (List.mem_cons.mp hw.2).resolve_right ht
    have h1 : c₁ ∈ ins := (List.mem_cons.mp hw.1.1).resolve_left hq.1.2
    have h2 : c₂ ∈ ins := (List.mem_cons.mp hw.1.2).resolve_left hq.2
    rw [listMatrix_rtof hq.1.1 hq.1.2 hq.2]
    have hsub : [c₁, c₂] ⊆ ins := by
      intro c hc
      rcases List.mem_pair.mp hc with rfl | rfl
      · exact h1
      · exact h2
    exact ⟨rtofPhase c₁ c₂ t, ([c₁, c₂].map fun c => embedGate1 n c proj1).prod,
      phaseGen_rtofPhase hw.1.1 hw.1.2 List.mem_cons_self, phaseGen_prod_proj1 hsub,
      (isPred_prod_proj1 _).2, rfl⟩

/-- A list of atoms passing the compute check writes a predicate into `a`. -/
theorem revForm_revGates {a : Fin n} {ins : List (Fin n)} (ha : a ∉ ins) :
    ∀ {C : List (RevOp n)}, (∀ o ∈ C, o.qfree = true) → (∀ o ∈ C, o.within (a :: ins) = true) →
      (∀ o ∈ C, ∀ q ∈ ins, o.permeable q = true) → RevForm a ins (listMatrix (revGates C))
  | [], _, _, _ => by rw [revGates_nil, listMatrix_nil]; exact revForm_phase .one
  | o :: C, hq, hw, hp => by
    rw [revGates_cons, listMatrix_append]
    exact (revForm_revGates ha (fun o' h => hq o' (List.mem_cons_of_mem o h))
      (fun o' h => hw o' (List.mem_cons_of_mem o h))
      (fun o' h => hp o' (List.mem_cons_of_mem o h))).mul ha
      (revForm_op ha (hq o List.mem_cons_self) (hw o List.mem_cons_self)
        (hp o List.mem_cons_self))

/-- **The compute check is sound.** A list of atoms that is qfree, acts only on `a :: ins`
    and is permeable on `ins` writes a Boolean function of `ins` into the ancilla `a` up to a
    phase on `a :: ins`: its matrix on ancilla `|0⟩` has the form that
    `listMatrix_predAncilla_conj` takes. -/
theorem computes_of_check {a : Fin n} {ins : List (Fin n)} {C : List (RevOp n)} (ha : a ∉ ins)
    (hq : C.all RevOp.qfree = true) (hw : C.all (RevOp.within (a :: ins)) = true)
    (hp : C.all (fun o => ins.all fun q => o.permeable q) = true) :
    ∃ D P, PhaseOn (a :: ins) D ∧ IsPred ins P ∧
      listMatrix (revGates C) * embedGate1 n a proj0
        = D * (1 + P * (embedGate1 n a pauliX - 1)) * embedGate1 n a proj0 := by
  simp only [List.all_eq_true] at hq hw hp
  obtain ⟨D, P, hD, hP, hP2, hM⟩ := revForm_revGates ha hq hw hp
  exact ⟨D, P, hD.phaseOn, ⟨hP.phaseOn, hP2⟩, by rw [hM]⟩

/-! ## Permeability -/

/-- A sum of matrices keeping the bits at `S` keeps them. -/
theorem _root_.CatCrypt.Quantum.AndAncilla.KeepsBits.add {S : List (Fin n)}
    {M N : Matrix (Fin (2 ^ n)) (Fin (2 ^ n)) ℂ}
    (hM : KeepsBits S M) (hN : KeepsBits S N) : KeepsBits S (M + N) := by
  intro x y h q hq
  rw [Matrix.add_apply] at h
  by_cases hm : M x y = 0
  · rw [hm, zero_add] at h
    exact hN x y h q hq
  · exact hM x y hm q hq

/-- A difference of matrices keeping the bits at `S` keeps them. -/
theorem _root_.CatCrypt.Quantum.AndAncilla.KeepsBits.sub {S : List (Fin n)}
    {M N : Matrix (Fin (2 ^ n)) (Fin (2 ^ n)) ℂ}
    (hM : KeepsBits S M) (hN : KeepsBits S N) : KeepsBits S (M - N) := by
  intro x y h q hq
  rw [Matrix.sub_apply] at h
  by_cases hm : M x y = 0
  · rw [hm, zero_sub, neg_ne_zero] at h
    exact hN x y h q hq
  · exact hM x y hm q hq

/-- A matrix keeping each bit of `S` keeps the bits at `S`. -/
theorem keepsBits_of_forall {S : List (Fin n)} {M : Matrix (Fin (2 ^ n)) (Fin (2 ^ n)) ℂ}
    (h : ∀ q ∈ S, KeepsBits [q] M) : KeepsBits S M :=
  fun x y hxy q hq => h q hq x y hxy q List.mem_cons_self

/-- A phase times a flip of a target other than `q` keeps the bit at `q`. -/
theorem keepsBits_flip {S T : List (Fin n)} {q t : Fin n}
    {D P : Matrix (Fin (2 ^ n)) (Fin (2 ^ n)) ℂ} (hD : PhaseOn S D) (hP : PhaseOn T P)
    (ht : t ≠ q) : KeepsBits [q] (D * (1 + P * (embedGate1 n t pauliX - 1))) :=
  hD.keepsBits.mul ((keepsBits_one _).add (hP.keepsBits.mul
    ((keepsBits_embedGate1 (by simpa using ht) _).sub (keepsBits_one _))))

/-- The matrix of an atom permeable on `q` keeps the bit at `q`. -/
theorem RevOp.keepsBits_of_permeable {q : Fin n} {o : RevOp n} (h : o.permeable q = true) :
    KeepsBits [q] (listMatrix o.gates) := by
  cases o with
  | gate g =>
    rw [RevOp.gates, listMatrix_singleton]
    have hg : g.permeable q = true := by simpa [RevOp.permeable] using h
    cases g with
    | H i =>
      exact keepsBits_gateEmbedding (by simpa [Avoids, Gate.permeable] using hg)
    | X i =>
      exact keepsBits_gateEmbedding (by simpa [Avoids, Gate.permeable] using hg)
    | Y i =>
      exact keepsBits_gateEmbedding (by simpa [Avoids, Gate.permeable] using hg)
    | Z i => exact (phaseOn_embedGate1 (S := [i]) List.mem_cons_self isDiagonal_pauliZ).keepsBits
    | T i =>
      exact (phaseOn_embedGate1 (S := [i]) List.mem_cons_self (by
        intro r c h; fin_cases r <;> fin_cases c <;> simp_all [tGate])).keepsBits
    | Tdg i =>
      exact (phaseOn_embedGate1 (S := [i]) List.mem_cons_self (by
        intro r c h; fin_cases r <;> fin_cases c <;> simp_all [tDaggerGate])).keepsBits
    | S i =>
      exact (phaseOn_embedGate1 (S := [i]) List.mem_cons_self (by
        intro r c h; fin_cases r <;> fin_cases c <;> simp_all [phaseS])).keepsBits
    | Rz i θ =>
      exact (phaseOn_embedGate1 (S := [i]) List.mem_cons_self (isDiagonal_rzGate θ)).keepsBits
    | RzQ i r =>
      exact (phaseOn_embedGate1 (S := [i]) List.mem_cons_self (isDiagonal_rzGate _)).keepsBits
    | CNOT i j =>
      by_cases hij : i = j
      · simp only [gateEmbedding, dite_eq_left hij]
        exact keepsBits_one _
      · have hj : j ≠ q := by simpa [Gate.permeable] using hg
        rw [gateEmbedding_CNOT hij, ctrlMatrix_eq_one_add, ← one_mul (1 + _)]
        exact keepsBits_flip (phaseOn_one []) (phaseOn_embedGate1 (S := [i]) List.mem_cons_self
          isDiagonal_proj1) hj
    | CZ i j =>
      by_cases hij : i = j
      · simp only [gateEmbedding, dite_eq_left hij]
        exact keepsBits_one _
      · rw [gateEmbedding_CZ hij, ctrlMatrix]
        exact (PhaseGen.add (S := [i, j]) (.gate List.mem_cons_self isDiagonal_proj0)
          (.mul (.gate List.mem_cons_self isDiagonal_proj1)
            (.gate (q := j) (by simp) isDiagonal_pauliZ))).phaseOn.keepsBits
  | mcx cs t =>
    simp only [RevOp.permeable, RevOp.wf, Bool.and_eq_true, decide_eq_true_eq] at h
    rw [listMatrix_mcx h.1.1 h.1.2, ← one_mul (1 + _)]
    exact keepsBits_flip (phaseOn_one []) (isPred_prod_proj1 cs).1 h.2
  | rtof c₁ c₂ t =>
    simp only [RevOp.permeable, RevOp.wf, Bool.and_eq_true, decide_eq_true_eq] at h
    rw [listMatrix_rtof h.1.1.1 h.1.1.2 h.1.2]
    exact keepsBits_flip (phaseOn_rtofPhase c₁ c₂ t) (isPred_prod_proj1 _).1 h.2

/-- **Permeable atoms commute with `Z`.** The matrix of an atom permeable on `q` commutes with
    `Z_q`. -/
theorem RevOp.commute_Z_of_permeable {q : Fin n} {o : RevOp n} (h : o.permeable q = true) :
    Commute (listMatrix o.gates) (embedGate1 n q pauliZ) :=
  ((phaseOn_embedGate1 (S := [q]) List.mem_cons_self isDiagonal_pauliZ).commute_of_keepsBits
    (RevOp.keepsBits_of_permeable h)).symm

/-- The matrix of a list of atoms permeable on `q` keeps the bit at `q`. -/
theorem keepsBits_revGates {q : Fin n} :
    ∀ {U : List (RevOp n)}, (∀ o ∈ U, o.permeable q = true) →
      KeepsBits [q] (listMatrix (revGates U))
  | [], _ => by rw [revGates_nil, listMatrix_nil]; exact keepsBits_one _
  | o :: U, h => by
    rw [revGates_cons, listMatrix_append]
    exact (keepsBits_revGates fun o' h' => h o' (List.mem_cons_of_mem o h')).mul
      (RevOp.keepsBits_of_permeable (h o List.mem_cons_self))

/-! ## Two branches on the ancilla -/

/-- `X|0⟩⟨0|X` has no `|0⟩⟨0|` block: `|0⟩⟨0| X |0⟩⟨0| = 0`. -/
theorem proj0_pauliX_proj0 : proj0 * pauliX * proj0 = 0 := by
  ext i j
  fin_cases i <;> fin_cases j <;> simp [proj0, pauliX, Matrix.mul_apply, Fin.sum_univ_two]

/-- `|1⟩⟨1| X |1⟩⟨1| = 0`. -/
theorem proj1_pauliX_proj1 : proj1 * pauliX * proj1 = 0 := by
  ext i j
  fin_cases i <;> fin_cases j <;> simp [proj1, pauliX, Matrix.mul_apply, Fin.sum_univ_two]

/-- `X |0⟩⟨0| = |1⟩⟨1| X`. -/
theorem pauliX_mul_proj0 : pauliX * proj0 = proj1 * pauliX := by
  ext i j
  fin_cases i <;> fin_cases j <;> simp [proj0, proj1, pauliX, Matrix.mul_apply, Fin.sum_univ_two]

/-- The `Π` branch of `M`, extended by `X` to the other branch, commutes with `X` and `Π`, and
    agrees with `M` on `Π`. -/
theorem proj_branch_ring {R : Type*} [Ring R] {M P X : R} (hM : Commute M P) (hP : P * P = P)
    (hPXP : P * X * P = 0) (hX : X * X = 1) :
    Commute (M * P + X * (M * P) * X) X ∧ Commute (M * P + X * (M * P) * X) P ∧
      P * (M * P + X * (M * P) * X) = M * P := by
  have hX' : ∀ y, X * (X * y) = y := fun y => by rw [← mul_assoc, hX, one_mul]
  have e1 : P * (X * (M * P) * X) = 0 := by
    rw [hM.eq]
    calc P * (X * (P * M) * X) = (P * X * P) * M * X := by noncomm_ring
      _ = 0 := by rw [hPXP, zero_mul, zero_mul]
  have e2 : X * (M * P) * X * P = 0 := by
    calc X * (M * P) * X * P = X * M * (P * X * P) := by noncomm_ring
      _ = 0 := by rw [hPXP, mul_zero]
  have e3 : P * (M * P) = M * P := by rw [hM.eq, ← mul_assoc, hP]
  have e4 : M * P * P = M * P := by rw [mul_assoc, hP]
  have hPU : P * (M * P + X * (M * P) * X) = M * P := by rw [mul_add, e3, e1, add_zero]
  have hUP : (M * P + X * (M * P) * X) * P = M * P := by rw [add_mul, e4, e2, add_zero]
  refine ⟨?_, hUP.trans hPU.symm, hPU⟩
  change (M * P + X * (M * P) * X) * X = X * (M * P + X * (M * P) * X)
  simp only [add_mul, mul_add, mul_assoc, hX, mul_one, hX']
  rw [add_comm]

/-- A matrix commuting with `|0⟩⟨0|_a` and `X_a` commutes with every operator on `a`. -/
theorem commOn_of_commute {a : Fin n} {M : Matrix (Fin (2 ^ n)) (Fin (2 ^ n)) ℂ}
    (h0 : Commute M (embedGate1 n a proj0)) (hX : Commute M (embedGate1 n a pauliX)) :
    CommOn a M := by
  intro G
  have hG : G = G 0 0 • proj0 + G 0 1 • (proj0 * pauliX) + G 1 0 • (pauliX * proj0)
      + G 1 1 • (pauliX * proj0 * pauliX) := by
    ext i j
    fin_cases i <;> fin_cases j <;> simp [proj0, pauliX]
  rw [hG]
  simp only [embedGate1_map_add, embedGate1_smul, ← embedGate1_mul]
  exact ((((h0.smul_right _).add_right ((h0.mul_right hX).smul_right _)).add_right
    ((hX.mul_right h0).smul_right _)).add_right
    (((hX.mul_right h0).mul_right hX).smul_right _)).eq.symm

/-- A matrix commuting with `|0⟩⟨0|_a` is a two-branch matrix on `a`. -/
theorem eq_branchMatrix_of_commute {a : Fin n} {M : Matrix (Fin (2 ^ n)) (Fin (2 ^ n)) ℂ}
    (hM : Commute M (embedGate1 n a proj0)) :
    ∃ U₀ U₁, CommOn a U₀ ∧ CommOn a U₁ ∧ M = branchMatrix a U₀ U₁ := by
  have hXX := embedGate1_pauliX_mul_self a
  have h01 : embedGate1 n a proj1 = 1 - embedGate1 n a proj0 := by
    rw [← embedGate1_proj0_add_proj1 a]; abel
  have h10 : embedGate1 n a proj0 = 1 - embedGate1 n a proj1 := by
    rw [← embedGate1_proj0_add_proj1 a]; abel
  have hM1 : Commute M (embedGate1 n a proj1) := by
    rw [h01]; exact (Commute.one_right M).sub_right hM
  obtain ⟨a0, b0, c0⟩ := proj_branch_ring hM (by rw [embedGate1_mul, proj0_mul_proj0])
    (by rw [embedGate1_mul, embedGate1_mul, proj0_pauliX_proj0, embedGate1_map_zero]) hXX
  obtain ⟨a1, b1, c1⟩ := proj_branch_ring hM1 (by rw [embedGate1_mul, proj1_mul_proj1])
    (by rw [embedGate1_mul, embedGate1_mul, proj1_pauliX_proj1, embedGate1_map_zero]) hXX
  refine ⟨_, _, commOn_of_commute b0 a0, commOn_of_commute ?_ a1, ?_⟩
  · rw [h10]; exact (Commute.one_right _).sub_right b1
  · rw [branchMatrix, c0, c1, ← mul_add, embedGate1_proj0_add_proj1, mul_one]

/-- **Permeable lists branch on the ancilla.** The matrix of a list of atoms permeable on `a`
    is a two-branch matrix on `a` with branches commuting with every operator on `a`. -/
theorem branch_of_permeable {a : Fin n} {U : List (RevOp n)}
    (h : ∀ o ∈ U, o.permeable a = true) :
    ∃ U₀ U₁, CommOn a U₀ ∧ CommOn a U₁ ∧ listMatrix (revGates U) = branchMatrix a U₀ U₁ :=
  eq_branchMatrix_of_commute ((phaseOn_embedGate1 (S := [a]) List.mem_cons_self
    isDiagonal_proj0).commute_of_keepsBits (keepsBits_revGates h)).symm

/-! ## The inverse -/

/-- The inverse of a qfree atom inverts its matrix. -/
theorem RevOp.listMatrix_inv_mul {o : RevOp n} (hq : o.qfree = true) :
    listMatrix (revGates o.inv) * listMatrix o.gates = 1 := by
  cases o with
  | gate g =>
    simp only [RevOp.inv, revGates_cons, revGates_nil, List.append_nil, RevOp.gates,
      listMatrix_singleton, gateEmbedding_invGate]
    exact gateEmbedding_conjTranspose_mul g
  | mcx cs t =>
    simp only [RevOp.qfree, RevOp.wf, Bool.and_eq_true, decide_eq_true_eq] at hq
    simp only [RevOp.inv, revGates_cons, revGates_nil, List.append_nil]
    have hp := isPred_prod_proj1 (n := n) cs
    rw [listMatrix_mcx hq.1 hq.2, flip_mul_flip ((phaseGen_prod_proj1 (S := cs)
      (List.Subset.refl cs)).commute_pauliX hq.2) (embedGate1_pauliX_mul_self t), hp.2,
      sub_self, zero_mul, add_zero]
  | rtof c₁ c₂ t =>
    rw [RevOp.inv, revGates_map_gate, listMatrix_invGates, RevOp.gates]
    exact listMatrix_conjTranspose_mul _

/-- The reversed inverse list of a qfree list inverts its matrix. -/
theorem listMatrix_inv_revGates :
    ∀ {C : List (RevOp n)}, (∀ o ∈ C, o.qfree = true) →
      listMatrix (revGates (C.reverse.flatMap RevOp.inv)) * listMatrix (revGates C) = 1
  | [], _ => by simp [revGates, listMatrix_nil]
  | o :: C, hq => by
    rw [List.reverse_cons, List.flatMap_append, revGates_append, revGates_cons,
      listMatrix_append, listMatrix_append, List.flatMap_singleton, mul_assoc,
      ← mul_assoc (listMatrix (revGates (C.reverse.flatMap RevOp.inv))),
      listMatrix_inv_revGates fun o' h => hq o' (List.mem_cons_of_mem o h), one_mul]
    exact RevOp.listMatrix_inv_mul (hq o List.mem_cons_self)

/-! ## Compute; use; uncompute -/

/-- The algebra of compute; use; uncompute in a ring: `V` writes `Pr` into the ancilla up to
    the phase `D` on `P₀`, `Vs` inverts `V`, and `M` is the two-branch matrix `P₀ U₀ + P₁ U₁`
    commuting with `D` and `Pr`. -/
theorem uncompute_ring {R : Type*} [Ring R] {Vs V M D Pr P₀ P₁ X U₀ U₁ : R}
    (hVs : Vs * V = 1) (hV : V * P₀ = D * (1 + Pr * (X - 1)) * P₀)
    (hMD : Commute M D) (hMPr : Commute M Pr) (hM : M = P₀ * U₀ + P₁ * U₁)
    (h00 : Commute U₀ P₀) (h01 : Commute U₀ P₁) (h10 : Commute U₁ P₀) (h11 : Commute U₁ P₁)
    (h1X : Commute U₁ X) (hPrX : Commute Pr X) (hPr0 : Commute Pr P₀) (hPr1 : Commute Pr P₁)
    (hPr : Pr * Pr = Pr) (hP00 : P₀ * P₀ = P₀) (hP11 : P₁ * P₁ = P₁) (hP01 : P₀ * P₁ = 0)
    (hP10 : P₁ * P₀ = 0) (hXP : X * P₀ = P₁ * X) :
    Vs * M * V * P₀ = ((1 - Pr) * U₀ + Pr * U₁) * P₀ ∧
      P₁ * (Vs * M * V) * P₀ = 0 := by
  have hMP0 : M * P₀ = U₀ * P₀ := by
    calc M * P₀ = P₀ * (U₀ * P₀) + P₁ * (U₁ * P₀) := by rw [hM]; noncomm_ring
      _ = (P₀ * P₀) * U₀ + (P₁ * P₀) * U₁ := by rw [h00.eq, h10.eq]; noncomm_ring
      _ = U₀ * P₀ := by rw [hP00, hP10, zero_mul, add_zero, h00.eq]
  have hMP1 : M * P₁ = U₁ * P₁ := by
    calc M * P₁ = P₀ * (U₀ * P₁) + P₁ * (U₁ * P₁) := by rw [hM]; noncomm_ring
      _ = (P₀ * P₁) * U₀ + (P₁ * P₁) * U₁ := by rw [h01.eq, h11.eq]; noncomm_ring
      _ = U₁ * P₁ := by rw [hP11, hP01, zero_mul, zero_add, h11.eq]
  have hPXP : Pr * X * Pr = Pr * X := by rw [mul_assoc, ← hPrX.eq, ← mul_assoc, hPr]
  have hY : M * (1 + Pr * (X - 1)) * P₀
      = (1 + Pr * (X - 1)) * ((1 - Pr) * U₀ + Pr * U₁) * P₀ := by
    have eL : M * (1 + Pr * (X - 1)) * P₀
        = U₀ * P₀ - Pr * (U₀ * P₀) + Pr * (X * (U₁ * P₀)) := by
      calc M * (1 + Pr * (X - 1)) * P₀
          = M * P₀ + (M * Pr) * (X * P₀) - (M * Pr) * P₀ := by noncomm_ring
        _ = M * P₀ + Pr * ((M * P₁) * X) - Pr * (M * P₀) := by
            rw [hMPr.eq, hXP]; noncomm_ring
        _ = U₀ * P₀ - Pr * (U₀ * P₀) + Pr * ((U₁ * P₁) * X) := by
            rw [hMP0, hMP1]; noncomm_ring
        _ = U₀ * P₀ - Pr * (U₀ * P₀) + Pr * (X * (U₁ * P₀)) := by
            rw [mul_assoc U₁, ← hXP, ← mul_assoc U₁, h1X.eq, mul_assoc]
    rw [eL]
    symm
    calc (1 + Pr * (X - 1)) * ((1 - Pr) * U₀ + Pr * U₁) * P₀
        = U₀ * P₀ - Pr * (U₀ * P₀) + Pr * (U₁ * P₀) + Pr * X * (U₀ * P₀)
          - (Pr * X * Pr) * (U₀ * P₀) + (Pr * X * Pr) * (U₁ * P₀) - Pr * (U₀ * P₀)
          + (Pr * Pr) * (U₀ * P₀) - (Pr * Pr) * (U₁ * P₀) := by noncomm_ring
      _ = U₀ * P₀ - Pr * (U₀ * P₀) + Pr * (X * (U₁ * P₀)) := by
          rw [hPXP, hPr]; noncomm_ring
  have hN0 : Commute ((1 - Pr) * U₀ + Pr * U₁) P₀ :=
    (((Commute.one_left P₀).sub_left hPr0).mul_left h00).add_left (hPr0.mul_left h10)
  have hN1 : Commute ((1 - Pr) * U₀ + Pr * U₁) P₁ :=
    (((Commute.one_left P₁).sub_left hPr1).mul_left h01).add_left (hPr1.mul_left h11)
  have h1 : Vs * M * V * P₀ = ((1 - Pr) * U₀ + Pr * U₁) * P₀ := by
    calc Vs * M * V * P₀ = Vs * (M * (V * P₀)) := by simp only [mul_assoc]
      _ = Vs * (D * (M * (1 + Pr * (X - 1)) * P₀)) := by
          rw [hV]; simp only [← mul_assoc]; rw [mul_assoc Vs M D, hMD.eq, ← mul_assoc]
      _ = Vs * (D * (1 + Pr * (X - 1)) * P₀) * ((1 - Pr) * U₀ + Pr * U₁) := by
          rw [hY, mul_assoc _ _ P₀, hN0.eq]; simp only [mul_assoc]
      _ = ((1 - Pr) * U₀ + Pr * U₁) * P₀ := by
          rw [← hV, ← mul_assoc, hVs, one_mul, hN0.eq]
  refine ⟨h1, ?_⟩
  rw [mul_assoc, h1, ← mul_assoc, ← hN1.eq, mul_assoc, hP10, mul_zero]

/-- **Compute; use; uncompute.** For a compute block `C` and a use block `U` passing the
    check, with `C` writing the predicate `P` into the ancilla up to the phase `D`
    (`computes_of_check`) and `U` the two-branch matrix of `U₀`, `U₁` on the ancilla
    (`branch_of_permeable`): on ancilla `|0⟩`, `C; U; C⁻¹` applies `U₀` where `P` fails and
    `U₁` where it holds, and it returns the ancilla to `|0⟩`. -/
theorem listMatrix_uncompute {a : Fin n} {ins : List (Fin n)} {C U : List (RevOp n)}
    {D P U₀ U₁ : Matrix (Fin (2 ^ n)) (Fin (2 ^ n)) ℂ} (hchk : uncomputable a ins C U = true)
    (hD : PhaseOn (a :: ins) D) (hP : IsPred ins P)
    (hC : listMatrix (revGates C) * embedGate1 n a proj0
      = D * (1 + P * (embedGate1 n a pauliX - 1)) * embedGate1 n a proj0)
    (h₀ : CommOn a U₀) (h₁ : CommOn a U₁) (hU : listMatrix (revGates U) = branchMatrix a U₀ U₁) :
    listMatrix (revGates (C ++ U ++ C.reverse.flatMap RevOp.inv)) * embedGate1 n a proj0
        = ((1 - P) * U₀ + P * U₁) * embedGate1 n a proj0 ∧
      embedGate1 n a proj1 * listMatrix (revGates (C ++ U ++ C.reverse.flatMap RevOp.inv))
        * embedGate1 n a proj0 = 0 := by
  simp only [uncomputable, Bool.and_eq_true, decide_eq_true_eq, List.all_eq_true] at hchk
  obtain ⟨⟨⟨⟨⟨ha, -⟩, hq⟩, -⟩, -⟩, hUp⟩ := hchk
  have hKB : KeepsBits (a :: ins) (listMatrix (revGates U)) :=
    keepsBits_of_forall fun q hq' => keepsBits_revGates fun o ho => hUp o ho q hq'
  have hK : listMatrix (revGates (C ++ U ++ C.reverse.flatMap RevOp.inv))
      = listMatrix (revGates (C.reverse.flatMap RevOp.inv)) * listMatrix (revGates U)
        * listMatrix (revGates C) := by
    rw [revGates_append, revGates_append, listMatrix_append, listMatrix_append, mul_assoc]
  have hP0 : PhaseOn [a] (embedGate1 n a proj0) :=
    phaseOn_embedGate1 List.mem_cons_self isDiagonal_proj0
  have hP1 : PhaseOn [a] (embedGate1 n a proj1) :=
    phaseOn_embedGate1 List.mem_cons_self isDiagonal_proj1
  rw [hK]
  exact uncompute_ring (listMatrix_inv_revGates hq) hC (hD.commute_of_keepsBits hKB).symm
    ((hP.1.mono (List.subset_cons_self a ins)).commute_of_keepsBits hKB).symm hU
    (CommOn.commute h₀ proj0) (CommOn.commute h₀ proj1) (CommOn.commute h₁ proj0)
    (CommOn.commute h₁ proj1) (CommOn.commute h₁ pauliX)
    (hP.1.commute_of_keepsBits
      (keepsBits_embedGate1 (fun q hq' h => by subst h; exact ha hq') _))
    (hP.1.commute hP0) (hP.1.commute hP1) hP.2
    (by rw [embedGate1_mul, proj0_mul_proj0]) (by rw [embedGate1_mul, proj1_mul_proj1])
    (by rw [embedGate1_mul, proj0_mul_proj1, embedGate1_map_zero])
    (by rw [embedGate1_mul, proj1_mul_proj0, embedGate1_map_zero])
    (by rw [embedGate1_mul, embedGate1_mul, pauliX_mul_proj0])

/-- **Compute; controlled use; uncompute.** For a compute block `C` passing the check and a
    gate list `W` avoiding the ancilla and the inputs, `C; (W controlled on a); C⁻¹` applies
    `W` exactly where the predicate computed by `C` holds and returns the ancilla to `|0⟩`:
    the clean controlled program, by `listMatrix_predAncilla_conj` and
    `predAncilla_restores`. -/
theorem listMatrix_uncompute_ctrl {a : Fin n} {ins : List (Fin n)} {C : List (RevOp n)}
    {W : List (Gate n)} (ha : a ∉ ins) (hq : C.all RevOp.qfree = true)
    (hw : C.all (RevOp.within (a :: ins)) = true)
    (hp : C.all (fun o => ins.all fun q => o.permeable q) = true)
    (hW : ∀ g ∈ W, Avoids a g ∧ ∀ c ∈ ins, Avoids c g) :
    ∃ P, IsPred ins P ∧
      listMatrix (revGates C ++ ctrlList a W ++ revGates (C.reverse.flatMap RevOp.inv))
          * embedGate1 n a proj0 = (1 + P * (listMatrix W - 1)) * embedGate1 n a proj0 ∧
      embedGate1 n a proj1
          * listMatrix (revGates C ++ ctrlList a W ++ revGates (C.reverse.flatMap RevOp.inv))
          * embedGate1 n a proj0 = 0 := by
  obtain ⟨D, P, hD, hP, hV⟩ := computes_of_check ha hq hw hp
  have hinv : listMatrix (revGates (C.reverse.flatMap RevOp.inv))
      = listMatrix (invGates (revGates C)) := by
    rw [listMatrix_invGates]
    have h1 := listMatrix_inv_revGates (by simpa only [List.all_eq_true] using hq)
    have h2 : listMatrix (revGates C) * (listMatrix (revGates C))ᴴ = 1 :=
      mul_eq_one_comm.mp (listMatrix_conjTranspose_mul _)
    calc listMatrix (revGates (C.reverse.flatMap RevOp.inv))
        = listMatrix (revGates (C.reverse.flatMap RevOp.inv))
          * (listMatrix (revGates C) * (listMatrix (revGates C))ᴴ) := by rw [h2, mul_one]
      _ = (listMatrix (revGates C))ᴴ := by rw [← mul_assoc, h1, one_mul]
  have hK : listMatrix (revGates C ++ ctrlList a W ++ revGates (C.reverse.flatMap RevOp.inv))
      = listMatrix (ancillaCtrlGates (revGates C) a W) := by
    rw [ancillaCtrlGates, listMatrix_append, listMatrix_append, listMatrix_append,
      listMatrix_append, hinv]
  exact ⟨P, hP, by rw [hK]; exact listMatrix_predAncilla_conj ha hP hD hV hW,
    by rw [hK]; exact predAncilla_restores ha hP hD hV hW⟩

/-! ## Completeness on the compute constructs -/

/-- The multi-controlled `X` into a fresh ancilla passes the check, for every use block
    permeable on the ancilla and the controls. -/
theorem uncomputable_mcx {a : Fin n} {cs : List (Fin n)} {U : List (RevOp n)} (hnd : cs.Nodup)
    (ha : a ∉ cs) (hU : ∀ o ∈ U, ∀ q ∈ a :: cs, o.permeable q = true) :
    uncomputable a cs [RevOp.mcx cs a] U = true := by
  simp only [uncomputable, RevOp.qfree, RevOp.wf, RevOp.within, RevOp.permeable,
    Bool.and_eq_true, decide_eq_true_eq, List.all_eq_true, List.mem_singleton, forall_eq]
  exact ⟨⟨⟨⟨⟨ha, hnd⟩, hnd, ha⟩, fun q hq => List.mem_cons_of_mem a hq, List.mem_cons_self⟩,
    fun q hq => ⟨⟨hnd, ha⟩, fun h => ha (h ▸ hq)⟩⟩, hU⟩

/-- The relative-phase Toffoli into a fresh ancilla passes the check, for every use block
    permeable on the ancilla and the controls. -/
theorem uncomputable_rtof {a c₁ c₂ : Fin n} {U : List (RevOp n)} (h12 : c₁ ≠ c₂)
    (h1a : c₁ ≠ a) (h2a : c₂ ≠ a) (hU : ∀ o ∈ U, ∀ q ∈ [a, c₁, c₂], o.permeable q = true) :
    uncomputable a [c₁, c₂] [RevOp.rtof c₁ c₂ a] U = true := by
  refine Bool.and_eq_true_iff.mpr ⟨?_, List.all_eq_true.mpr fun o ho =>
    List.all_eq_true.mpr (hU o ho)⟩
  simp [RevOp.qfree, RevOp.wf, RevOp.within, RevOp.permeable, h12, h1a, h2a, Ne.symm h1a,
    Ne.symm h2a]

end

end CatCrypt.Quantum.Uncomputation
