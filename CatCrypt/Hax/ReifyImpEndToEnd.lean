module

public import CatCrypt.Hax.ReifyImpBridge
public import CatCrypt.Hax.ReifyImpPilotExtracted

/-!
# The pilot of `reifyImp%`, read back by the hax frontend

`edwardsAddExtracted` (`CatCrypt.Hax.ReifyImpPilotExtracted`, generated by
`scripts/reify-roundtrip.sh`) is the hax frontend's reading of the Rust function
`edwards_add` that `Crypto.Hax.ppImpRustFnRet` prints for `edwardsAddImp`, compiled in a
crate whose leaf functions `d`, `mul`, `add`, `sub`, `double` are trusted stand-ins.
`edwardsAddExtracted_eq` pins the printer against that reading: the reading is the
literal `edwardsAddImp` itself, by a definitional check. It fails the build when a change
of the reifier, the printer or the frontend changes the reading.

`edwardsAdd_endToEnd` composes the pin with `edwardsAdd_evalImp`: the `evalImp` run of
the frontend's reading under the table `edBi` returns the encoding of `edwardsAddLean`.
The trusted parts are hax's frontend (rustc's THIR and the JSON export) and hax-lean's JSON
adapter; the leaf bodies of the crate do not enter the statement, which interprets each
leaf call by `edBi`.

## Main results

* `edwardsAddExtracted_eq` — the frontend's reading of the printed pilot is the pilot
  literal
* `edwardsAdd_endToEnd` — the frontend's reading of the printed pilot computes
  `edwardsAddLean`
-/

@[expose] public section

set_option autoImplicit false

namespace CatCrypt.Hax.ReifyImp

open _root_.Hax _root_.Hax.Ascent
open CatCrypt.Crypto.Hax (forToLoop evalImp)

/-- The frontend's reading of the printed pilot is the pilot literal. -/
theorem edwardsAddExtracted_eq : edwardsAddExtracted = edwardsAddImp := rfl

variable {α : Type} [HaxEnc α] [HaxEnc.Inj α] [HaxEnc.Plain α]

/-- **The printed pilot, as the hax frontend reads it, computes `edwardsAddLean`.** From
    the environment binding `p` and `q`, when the encoding of `α` carries no control-flow
    value, the `evalImp` run of `forToLoop edwardsAddExtracted` under `edBi` returns the
    encoding of `edwardsAddLean`, from some fuel on. -/
theorem edwardsAdd_endToEnd (hα : ∀ x : α, (enc x).deepNoControlFlow = true)
    (mul add sub : α → α → α) (double neg : α → α) (d : α) (p q : α × α × α × α) :
    ∃ fuel₀, ∀ fuel, fuel₀ ≤ fuel → ∃ env',
      evalImp (edBi mul add sub double neg d) fuel (forToLoop edwardsAddExtracted)
          (bindParams [("p", enc p), ("q", enc q)]) =
        some (enc (edwardsAddLean mul add sub double d p q), env') := by
  rw [edwardsAddExtracted_eq]
  exact edwardsAdd_evalImp hα mul add sub double neg d p q

end CatCrypt.Hax.ReifyImp

end
