module

public import CatCrypt.Hax.ReifyImpDecode
public import CatCrypt.Hax.ReifyImpDecodeExtracted

/-!
# The decode pilot of `reifyImp%`, read back by the hax frontend

`decodeExtracted` (`CatCrypt.Hax.ReifyImpDecodeExtracted`, generated by
`scripts/reify-roundtrip.sh`) is the hax frontend's reading of the Rust function `decode`
that `Crypto.Hax.ppImpRustFnRet` prints for `decodeImp`, compiled in a crate whose leaf
functions `mul` and `isZero` are stubs. `decodeExtracted_eq` pins the printer against that
reading: the reading is the literal `decodeImp` itself, by a definitional check, so the
frontend reads the printed `None` and `Some ( p )` as the calls `None` and `Some` of the
literal.

`decode_endToEnd` composes the pin with `decode_evalImp`. The trusted parts are hax's
frontend and hax-lean's JSON adapter; the stub bodies do not enter the statement, which
interprets each leaf call by `decBi`.

## Main results

* `decodeExtracted_eq` — the frontend's reading of the printed pilot is the pilot literal
* `decode_endToEnd` — the frontend's reading of the printed pilot computes `decodeLean`
-/

@[expose] public section

set_option autoImplicit false

namespace CatCrypt.Hax.ReifyImp

open _root_.Hax _root_.Hax.Ascent
open CatCrypt.Crypto.Hax (forToLoop evalImp)

/-- The frontend's reading of the printed decode pilot is the pilot literal. -/
theorem decodeExtracted_eq : decodeExtracted = decodeImp := rfl

variable {α : Type} [HaxEnc α] [HaxEnc.Inj α] [HaxEnc.Plain α]

/-- **The printed decode pilot, as the hax frontend reads it, computes `decodeLean`.** From
    the environment binding `p`, when the encoding of `α` carries no control-flow value, the
    `evalImp` run of `forToLoop decodeExtracted` under `decBi` returns the encoding of
    `decodeLean`, from some fuel on. -/
theorem decode_endToEnd (hα : ∀ x : α, (enc x).deepNoControlFlow = true)
    (mul : α → α → α) (isZero : α → Bool) (p : α × α × α × α) :
    ∃ fuel₀, ∀ fuel, fuel₀ ≤ fuel → ∃ env',
      evalImp (decBi mul isZero) fuel (forToLoop decodeExtracted) (bindParams [("p", enc p)]) =
        some (enc (decodeLean mul isZero p), env') := by
  rw [decodeExtracted_eq]
  exact decode_evalImp hα mul isZero p

end CatCrypt.Hax.ReifyImp

end
